# Copy to .env and fill in. .env is gitignored.
# cp .env.example .env

# AWS RDS PostgreSQL. Create these three databases on the instance before boot.
# Use a database user that is not the RDS master. Grant it CONNECT, CREATE, and
# normal table rights on each database. Do not make it rds_superuser.
DB_HOST=your-instance.xxxxxxxxxxxx.ap-southeast-2.rds.amazonaws.com
DB_PORT=5432
DB_NAME=sacpad_production
CACHE_DB_NAME=sacpad_production_cache
CABLE_DB_NAME=sacpad_production_cable
DB_USERNAME=sacpad
DB_PASSWORD=replace-with-at-least-12-characters

# verify-full checks the RDS certificate against the bundle baked into the image.
DB_SSLMODE=verify-full
DB_SSLROOTCERT=/rails/config/certs/rds-global-bundle.pem

# Decrypts config/credentials.yml.enc.
RAILS_MASTER_KEY=

# Voter and token encryption. Generate once. Rotating these makes old rows unreadable.
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

# At least 20 characters, no spaces. Leave REDIS_URL unset to use the Redis
# container in docker-compose. For ElastiCache, set a rediss:// URL instead.
REDIS_PASSWORD=replace-with-a-long-random-password
# REDIS_URL=rediss://:password@your-cache.xxxxxx.cache.amazonaws.com:6379/0

# Active Storage. Prefer an IAM task role. If you use keys, scope them to this bucket.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-2
AWS_S3_BUCKET=politomatrix-storage-production

BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=
MAIL_FROM=Politomatrix <no-reply@politomatrix.com>

RAILS_LOG_LEVEL=info
RAILS_MAX_THREADS=5
WEB_CONCURRENCY=1
SIDEKIQ_CONCURRENCY=5
