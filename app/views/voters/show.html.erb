<% voter_name = begin
     "#{@voter.first_name} #{@voter.last_name}"
   rescue ActiveRecord::Encryption::Errors::Decryption
     "Voter (unable to decrypt)"
   end %>
<div class="space-y-6">
  <%= render layout: "ui/campaign_hero", locals: {
        kicker: "Voters",
        title: voter_name,
        meta: current_user.organization.name
      } do %><% end %>
  <div class="flex justify-end">
    <%= link_to "Back to list", voters_path, class: "#{ta_btn_secondary} inline-flex min-h-11 items-center" %>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
    <!-- Voter Info -->
    <div class="rounded-lg border border-gray-200 bg-white shadow-sm dark:border-gray-800 dark:bg-gray-950">
      <div class="border-b border-gray-200 px-6 py-4 dark:border-gray-800">
        <h2 class="text-lg font-semibold text-gray-900 dark:text-white">Voter Information</h2>
      </div>
      <div class="px-6 py-4 space-y-4">
        <div>
          <label class="text-xs font-medium uppercase text-gray-500 dark:text-gray-400">Voter ID</label>
          <p class="mt-1 text-sm font-mono text-gray-900 dark:text-white">
            <% begin %>
              <%= @voter.voter_id %>
            <% rescue ActiveRecord::Encryption::Errors::Decryption %>
              <span class="text-gray-400">—</span>
            <% end %>
          </p>
        </div>
        <div>
          <label class="text-xs font-medium uppercase text-gray-500 dark:text-gray-400">Full Name</label>
          <p class="mt-1 text-sm text-gray-900 dark:text-white">
            <% begin %>
              <%= [@voter.first_name, @voter.middle_name, @voter.last_name].compact.join(" ") %>
            <% rescue ActiveRecord::Encryption::Errors::Decryption %>
              <span class="text-gray-400">—</span>
            <% end %>
          </p>
        </div>
        <% begin %>
          <% if @voter.mobile.present? %>
            <div>
              <label class="text-xs font-medium uppercase text-gray-500 dark:text-gray-400">Mobile</label>
              <p class="mt-1 text-sm font-mono text-gray-900 dark:text-white"><%= @voter.mobile %></p>
            </div>
          <% end %>
        <% rescue ActiveRecord::Encryption::Errors::Decryption %>
        <% end %>
        <div>
          <label class="text-xs font-medium uppercase text-gray-500 dark:text-gray-400">Village</label>
          <p class="mt-1 text-sm text-gray-900 dark:text-white"><%= @voter.village&.name || "—" %></p>
        </div>
        <div>
          <label class="text-xs font-medium uppercase text-gray-500 dark:text-gray-400">Created</label>
          <p class="mt-1 text-sm text-gray-900 dark:text-white"><%= @voter.created_at.strftime("%b %d, %Y") %></p>
        </div>
      </div>
    </div>

    <!-- Sentiment Tracking -->
    <div class="rounded-lg border border-gray-200 bg-white shadow-sm dark:border-gray-800 dark:bg-gray-950">
      <div class="border-b border-gray-200 px-6 py-4 dark:border-gray-800">
        <h2 class="text-lg font-semibold text-gray-900 dark:text-white">Sentiment</h2>
      </div>
      <div class="px-6 py-4 space-y-4">
        <div>
          <label class="text-xs font-medium uppercase text-gray-500 dark:text-gray-400">Current Status</label>
          <% if @voter_sentiment&.sentiment_status %>
            <% color_map = { "pleased" => "green", "transit" => "amber", "displeased" => "red" } %>
            <% color = color_map[@voter_sentiment.sentiment_status] || "gray" %>
            <p class="mt-2">
              <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-<%= color %>-100 text-<%= color %>-800 dark:bg-<%= color %>-900/30 dark:text-<%= color %>-400">
                <%= @voter_sentiment.sentiment_status.upcase %>
              </span>
            </p>
          <% else %>
            <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Not recorded yet</p>
          <% end %>
        </div>

        <!-- Update Sentiment Form -->
        <div class="border-t border-gray-200 pt-4 dark:border-gray-700">
          <label class="text-xs font-medium uppercase text-gray-500 dark:text-gray-400">Update Sentiment</label>
          <%= form_with url: update_sentiment_voter_path(@voter), method: :patch, local: true, class: "mt-3 space-y-2" do |f| %>
            <div class="grid grid-cols-3 gap-2">
              <% [["Pleased", "pleased"], ["Transit", "transit"], ["Displeased", "displeased"]].each do |label, value| %>
                <button type="submit"
                        name="sentiment_status"
                        value="<%= value %>"
                        class="rounded-lg px-3 py-2 text-sm font-medium transition <%= @voter_sentiment&.sentiment_status == value ? "bg-blue-600 text-white" : "bg-gray-100 text-gray-700 hover:bg-gray-200 dark:bg-gray-800 dark:text-white dark:hover:bg-gray-700" %>">
                  <%= label %>
                </button>
              <% end %>
            </div>
          <% end %>
        </div>

        <!-- Last Updated -->
        <% if @voter_sentiment&.sentiment_updated_at %>
          <div class="text-xs text-gray-500 dark:text-gray-400 border-t border-gray-200 pt-4 dark:border-gray-700">
            <p>Last updated: <%= @voter_sentiment.sentiment_updated_at.strftime("%b %d, %Y at %H:%M") %></p>
            <% if @voter_sentiment.sentiment_updated_by_id %>
              <p>By: User <%= @voter_sentiment.sentiment_updated_by_id %></p>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
