<% field = "mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 text-gray-900 dark:border-gray-600 dark:bg-gray-800 dark:text-white" %>
<% label = "block text-sm font-medium text-gray-700 dark:text-gray-300" %>

<div class="space-y-6">
  <%= render layout: "ui/campaign_hero", locals: { kicker: "Platform Console", title: "Edit #{@voter.name}" } do %><% end %>
  <div class="flex justify-end">
    <%= link_to "Back", console_voter_path(@voter), class: ta_btn_secondary %>
  </div>

  <div class="rounded-lg border border-gray-200 bg-white p-6 shadow-sm dark:border-gray-800 dark:bg-gray-950">
    <%= form_with model: [:console, @voter], class: "space-y-6" do |f| %>
      <% if @voter.errors.any? %>
        <div class="rounded-lg bg-red-50 p-4 text-sm text-red-700 dark:bg-red-900/20 dark:text-red-300">
          <%= @voter.errors.full_messages.to_sentence %>
        </div>
      <% end %>

      <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
        <div>
          <%= f.label :voter_id, "Voter ID", class: label %>
          <%= f.text_field :voter_id, class: field %>
        </div>
        <div>
          <%= f.label :mobile, class: label %>
          <%= f.text_field :mobile, class: field %>
        </div>
        <div>
          <%= f.label :first_name, class: label %>
          <%= f.text_field :first_name, class: field %>
        </div>
        <div>
          <%= f.label :middle_name, class: label %>
          <%= f.text_field :middle_name, class: field %>
        </div>
        <div>
          <%= f.label :last_name, class: label %>
          <%= f.text_field :last_name, class: field %>
        </div>
        <div>
          <%= f.label :age, class: label %>
          <%= f.number_field :age, min: 0, class: field %>
        </div>
        <div>
          <%= f.label :gender, class: label %>
          <%= f.text_field :gender, class: field %>
        </div>
        <div>
          <%= f.label :house_no, "House No.", class: label %>
          <%= f.text_field :house_no, class: field %>
        </div>
        <div>
          <%= f.label :sr_no, "Serial no.", class: label %>
          <%= f.number_field :sr_no, min: 0, class: field %>
        </div>
        <div>
          <%= f.label :booth_id, "Booth", class: label %>
          <%= f.select :booth_id, @booth_options, { include_blank: "No booth" }, class: field %>
        </div>
      </div>

      <div class="flex gap-3">
        <%= f.submit "Save voter", class: ta_btn_primary %>
        <%= link_to "Cancel", console_voter_path(@voter), class: ta_btn_secondary %>
      </div>
    <% end %>
  </div>
</div>
