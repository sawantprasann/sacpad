<div class="space-y-6">
  <%= render layout: "ui/campaign_hero", locals: { kicker: "Platform Console", title: "Voters", subtitle: "Global electoral roll, shared across organizations" } do %><% end %>

  <section aria-label="Voter coverage" class="rounded-lg border border-gray-200 bg-white shadow-sm dark:border-gray-800 dark:bg-gray-950">
    <div class="border-b border-gray-200 px-6 py-4 dark:border-gray-800">
      <h2 class="text-base font-semibold text-gray-900 dark:text-white">Voter coverage</h2>
      <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Fetched voters compared with the male, female, and other counts stored from booth roll PDFs. Missing is the PDF count minus fetched.</p>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-gray-200 text-left text-xs font-medium uppercase tracking-wider text-gray-500 dark:border-gray-800 dark:text-gray-400">
            <th class="px-6 py-3"></th>
            <th class="px-6 py-3">Fetched</th>
            <th class="px-6 py-3">In PDF</th>
            <th class="px-6 py-3">Missing</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100 dark:divide-gray-800">
          <% [ [ "Total", :total ], [ "Male", :male ], [ "Female", :female ], [ "Others", :others ] ].each do |label, key| %>
            <% fetched = @coverage[:fetched][key] %>
            <% pdf = @coverage[:pdf]&.[](key) %>
            <% missing = pdf.nil? ? nil : pdf - fetched %>
            <tr>
              <th class="px-6 py-3 text-left text-gray-900 dark:text-white <%= key == :total ? "font-semibold" : "font-medium" %>"><%= label %></th>
              <td class="px-6 py-3 tabular-nums text-gray-900 dark:text-white" data-coverage="fetched-<%= key %>"><%= number_with_delimiter(fetched) %></td>
              <td class="px-6 py-3 tabular-nums text-gray-700 dark:text-gray-300" data-coverage="pdf-<%= key %>"><%= pdf.nil? ? "—" : number_with_delimiter(pdf) %></td>
              <td class="px-6 py-3 tabular-nums font-medium <%= missing&.nonzero? ? "text-amber-700 dark:text-amber-300" : "text-gray-700 dark:text-gray-300" %>" data-coverage="missing-<%= key %>"><%= missing.nil? ? "—" : number_with_delimiter(missing) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <% if @coverage[:fetched][:unspecified].positive? %>
      <p class="border-t border-gray-100 px-6 py-3 text-sm text-gray-500 dark:border-gray-800 dark:text-gray-400"><%= pluralize(@coverage[:fetched][:unspecified], "fetched voter") %> with no gender <%= @coverage[:fetched][:unspecified] == 1 ? "is" : "are" %> included in the total only.</p>
    <% end %>
  </section>

  <div class="campaign-sheet">
    <%= render "console/filters",
          url: console_voters_path,
          fields: [
            [ :voter_id, "Voter ID" ],
            [ :sr_no, "Sr no" ],
            [ :name, "Name" ],
            [ :village_id, "Village", @villages.map { |village| [ village.name, village.id ] } ],
            [ :booth, "Booth number" ]
          ],
          hint: @search_hint %>

    <div class="overflow-x-auto">
      <table class="campaign-table w-full">
        <thead>
          <tr class="border-b border-gray-200 bg-gray-50 dark:border-gray-800 dark:bg-gray-900/50">
            <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-600 dark:text-gray-400">Sr no</th>
            <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-600 dark:text-gray-400">Voter ID</th>
            <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-600 dark:text-gray-400">Name</th>
            <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-600 dark:text-gray-400">Mobile</th>
            <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-600 dark:text-gray-400">Village</th>
            <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-600 dark:text-gray-400">Booth</th>
            <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-600 dark:text-gray-400">Created</th>
            <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-600 dark:text-gray-400"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200 dark:divide-gray-800">
          <% @voters.each do |voter| %>
            <tr class="hover:bg-gray-50 dark:hover:bg-gray-900/50">
              <td class="px-6 py-4 text-sm tabular-nums text-gray-700 dark:text-gray-300"><%= voter.sr_no || "—" %></td>
              <td class="px-6 py-4 text-sm font-medium text-gray-900 dark:text-white"><%= link_to voter.voter_id, console_voter_path(voter), class: ta_text_link %></td>
              <td class="px-6 py-4 text-sm text-gray-700 dark:text-gray-300">
                <%= "#{voter.first_name} #{voter.last_name}" %>
                <% if voter.middle_name.present? %>
                  <span class="text-gray-500">(<%= voter.middle_name %>)</span>
                <% end %>
              </td>
              <td class="px-6 py-4 text-sm text-gray-700 dark:text-gray-300"><%= voter.mobile %></td>
              <td class="px-6 py-4 text-sm text-gray-700 dark:text-gray-300"><%= voter.village&.name || "—" %></td>
              <td class="px-6 py-4 text-sm text-gray-700 dark:text-gray-300">
                <% if voter.booth %>
                  <%= link_to "Booth #{voter.booth.number}", console_booth_path(voter.booth), class: ta_text_link %>
                <% else %>
                  <span class="text-gray-400">—</span>
                <% end %>
              </td>
              <td class="px-6 py-4 text-sm text-gray-500 dark:text-gray-400"><%= voter.created_at.strftime("%b %d, %Y") %></td>
              <td class="px-6 py-4 text-right text-sm whitespace-nowrap">
                <div class="inline-flex items-center justify-end gap-1">
                  <%= icon_action_link :view, console_voter_path(voter) %>
                  <%= icon_action_link :edit, edit_console_voter_path(voter) %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <%= render "ui/pagination", pagy: @pagy %>
  </div>
</div>
