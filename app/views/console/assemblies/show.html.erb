<% content_for :title, @record.name %>
<% breadcrumb "Loksabhas", console_loksabhas_path %>
<% breadcrumb @loksabha.name, console_loksabha_path(@loksabha) %>
<% breadcrumb @record.name %>

<div class="mb-6 flex items-center justify-between">
  <div>
    <h1 class="<%= ta_page_title %>"><%= @record.name %></h1>
    <p class="mt-1 text-sm text-gray-500 dark:text-gray-400"><%= link_to @loksabha.name, console_loksabha_path(@loksabha), class: "text-brand-500 hover:text-brand-600" %></p>
  </div>
  <%= link_to "Edit", edit_console_loksabha_assembly_path(@loksabha, @record), class: ta_btn_secondary %>
</div>

<div class="<%= ta_card_classes %> mb-6 p-6">
  <dl class="grid gap-4 sm:grid-cols-3">
    <div>
      <dt class="text-xs font-medium uppercase text-gray-500 dark:text-gray-400">Constituency no</dt>
      <dd class="mt-1 text-sm text-gray-800 dark:text-white/90"><%= @record.constituency_no %></dd>
    </div>
    <div>
      <dt class="text-xs font-medium uppercase text-gray-500 dark:text-gray-400">Villages</dt>
      <dd class="mt-1 text-sm text-gray-800 dark:text-white/90"><%= @village_total %></dd>
    </div>
  </dl>
</div>

<div class="<%= ta_card_classes %> overflow-hidden">
  <div class="flex items-center justify-between gap-3 border-b border-gray-200 px-5 py-4 dark:border-gray-800">
    <h2 class="text-base font-semibold text-gray-900 dark:text-white/90">Villages</h2>
    <%= link_to "New Village", new_console_loksabha_assembly_village_path(@loksabha, @record), class: ta_btn_primary %>
  </div>
  <%= render "console/filters", url: console_loksabha_assembly_path(@loksabha, @record), fields: [ [ :name, "Name" ], [ :taluka, "Taluka" ], [ :police_station, "Police station" ], [ :pin_code, "Pin code" ] ] %>
  <div class="overflow-x-auto">
    <table class="w-full text-sm">
      <thead class="border-b border-gray-200 text-left text-gray-500 dark:border-gray-800 dark:text-gray-400">
        <tr>
          <th class="px-5 py-3 font-medium">Name</th>
          <th class="px-5 py-3 font-medium">Taluka</th>
          <th class="px-5 py-3 font-medium">Voters</th>
          <th class="px-5 py-3 font-medium">Police station</th>
          <th class="px-5 py-3 font-medium">Pin code</th>
          <th class="px-5 py-3"></th>
        </tr>
      </thead>
      <tbody>
        <% @villages.each do |village| %>
          <tr class="border-b border-gray-100 last:border-0 dark:border-gray-800">
            <td class="px-5 py-3 text-gray-700 dark:text-gray-300"><%= link_to village.name, console_loksabha_assembly_village_path(@loksabha, @record, village), class: "text-brand-500 hover:text-brand-600" %></td>
            <td class="px-5 py-3 text-gray-700 dark:text-gray-300"><%= village.taluka_name.presence || "—" %></td>
            <td class="px-5 py-3 text-gray-700 dark:text-gray-300"><%= village.voters_count %></td>
            <td class="px-5 py-3 text-gray-700 dark:text-gray-300"><%= village.police_station.presence || "—" %></td>
            <td class="px-5 py-3 text-gray-700 dark:text-gray-300"><%= village.pin_code.presence || "—" %></td>
            <td class="px-5 py-3 text-right whitespace-nowrap">
              <%= link_to "Edit", edit_console_loksabha_assembly_village_path(@loksabha, @record, village), class: "text-brand-500 hover:text-brand-600" %>
              <%= button_to "Delete", console_loksabha_assembly_village_path(@loksabha, @record, village), method: :delete,
                    class: "ml-3 text-error-500 hover:text-error-600", form: { style: "display:inline" } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <% if @villages.empty? %>
      <p class="px-5 py-10 text-center text-sm text-gray-400"><%= village_filters.values.any?(&:present?) ? "No villages match." : "No villages yet." %></p>
    <% end %>
  </div>
</div>
