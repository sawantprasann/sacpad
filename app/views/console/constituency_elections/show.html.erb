<% content_for :title, @election.heading %>
<% breadcrumb "Loksabhas", console_loksabhas_path %>
<% breadcrumb @loksabha.name, console_loksabha_path(@loksabha) %>
<% if @assembly %>
  <% breadcrumb @assembly.name, console_loksabha_assembly_path(@loksabha, @assembly) %>
<% end %>
<% breadcrumb @election.year.to_s %>

<%= render layout: "ui/campaign_hero", locals: { kicker: "Platform Console", title: @election.heading, subtitle: @constituency.name } do %><% end %>
<div class="mt-4 mb-6 flex justify-end">
  <%= icon_action_link :edit, edit_console_election_result_path(@election) %>
</div>

<%= render "constituency_elections/result_table", election: @election %>
