<div class="<%= ta_card_classes %> p-6">
  <%= form_with model: [ :console, @loksabha, @assembly, @election ].compact do |f| %>
    <% if @election.errors.any? %>
      <div class="mb-4 rounded-lg border border-error-500/30 bg-error-50 px-4 py-2 text-sm text-error-500"><%= @election.errors.full_messages.to_sentence %></div>
    <% end %>

    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <div>
        <label class="<%= ta_label_classes %>">Year</label>
        <%= f.number_field :year, class: ta_field_classes %>
      </div>
      <div>
        <label class="<%= ta_label_classes %>">Result</label>
        <%= f.select :outcome, ConstituencyElection.outcomes.keys.map { |key| [ key.humanize, key ] }, { include_blank: "Result" }, class: ta_field_classes %>
      </div>
      <div>
        <label class="<%= ta_label_classes %>">Gained from party</label>
        <%= f.select :gained_from_party_id, @parties.map { |party| [ party_choice_label(party), party.id ] }, { include_blank: "—" }, class: ta_field_classes %>
      </div>
      <div class="sm:col-span-2 lg:col-span-3">
        <label class="<%= ta_label_classes %>">Title</label>
        <%= f.text_field :title, class: ta_field_classes, placeholder: "2024 Maharashtra Legislative Assembly election : Paranda" %>
      </div>
      <div>
        <label class="<%= ta_label_classes %>">Swing</label>
        <%= f.number_field :swing, step: 0.01, class: ta_field_classes %>
      </div>
      <div>
        <label class="<%= ta_label_classes %>">Margin of victory (votes)</label>
        <%= f.number_field :margin_votes, class: ta_field_classes %>
      </div>
      <div>
        <label class="<%= ta_label_classes %>">Margin %</label>
        <%= f.number_field :margin_percent, step: 0.01, class: ta_field_classes %>
      </div>
      <div>
        <label class="<%= ta_label_classes %>">Margin change</label>
        <%= f.number_field :margin_change, step: 0.01, class: ta_field_classes %>
      </div>
      <div>
        <label class="<%= ta_label_classes %>">Turnout (votes)</label>
        <%= f.number_field :turnout_votes, class: ta_field_classes %>
      </div>
      <div>
        <label class="<%= ta_label_classes %>">Turnout %</label>
        <%= f.number_field :turnout_percent, step: 0.01, class: ta_field_classes %>
      </div>
      <div>
        <label class="<%= ta_label_classes %>">Turnout change</label>
        <%= f.number_field :turnout_change, step: 0.01, class: ta_field_classes %>
      </div>
      <div>
        <label class="<%= ta_label_classes %>">Total valid votes</label>
        <%= f.number_field :valid_votes, class: ta_field_classes %>
      </div>
      <div>
        <label class="<%= ta_label_classes %>">Registered electors</label>
        <%= f.number_field :registered_electors, class: ta_field_classes %>
      </div>
      <div>
        <label class="<%= ta_label_classes %>">Electors change</label>
        <%= f.number_field :electors_change, step: 0.01, class: ta_field_classes %>
      </div>
    </div>

    <h2 class="mt-8 text-sm font-semibold text-gray-900 dark:text-white/90">Candidates</h2>
    <p class="mt-1 text-xs text-gray-500">Leave unused rows blank. Mark New when that party did not contest the previous election. Add NOTA and Independent as parties first if you need them. Use the order number to match the published table.</p>

    <div class="mt-4 overflow-x-auto">
      <table class="w-full min-w-[64rem] text-sm">
        <thead class="text-left text-gray-500 dark:text-gray-400">
          <tr>
            <th class="px-2 py-2 font-medium">#</th>
            <th class="px-2 py-2 font-medium">Party</th>
            <th class="px-2 py-2 font-medium">Candidate</th>
            <th class="px-2 py-2 font-medium">Votes</th>
            <th class="px-2 py-2 font-medium">%</th>
            <th class="px-2 py-2 font-medium">±%</th>
            <th class="px-2 py-2 font-medium">New</th>
            <th class="px-2 py-2 font-medium">Winner</th>
            <th class="px-2 py-2 font-medium">Remove</th>
          </tr>
        </thead>
        <tbody>
          <%= f.fields_for :candidates do |candidate_form| %>
            <tr class="border-t border-gray-100 dark:border-gray-800">
              <td class="px-2 py-2 align-top"><%= candidate_form.number_field :position, class: "#{ta_field_classes} w-16" %></td>
              <td class="px-2 py-2 align-top"><%= candidate_form.select :party_id, @parties.map { |party| [ party_choice_label(party), party.id ] }, { include_blank: "Party" }, class: ta_field_classes %></td>
              <td class="px-2 py-2 align-top"><%= candidate_form.text_field :candidate_name, class: ta_field_classes %></td>
              <td class="px-2 py-2 align-top"><%= candidate_form.number_field :votes, class: ta_field_classes %></td>
              <td class="px-2 py-2 align-top"><%= candidate_form.number_field :vote_percent, step: 0.01, class: ta_field_classes %></td>
              <td class="px-2 py-2 align-top"><%= candidate_form.number_field :vote_change, step: 0.01, class: ta_field_classes %></td>
              <td class="px-2 py-2 align-top"><%= candidate_form.check_box :new_contestant, class: "mt-3 h-4 w-4 rounded border-gray-300 text-brand-500" %></td>
              <td class="px-2 py-2 align-top"><%= candidate_form.check_box :winner, class: "mt-3 h-4 w-4 rounded border-gray-300 text-brand-500" %></td>
              <td class="px-2 py-2 align-top">
                <% if candidate_form.object.persisted? %>
                  <%= candidate_form.check_box :_destroy, class: "mt-3 h-4 w-4 rounded border-gray-300 text-brand-500" %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="mt-6 flex items-center gap-3">
      <%= f.submit(@election.persisted? ? "Update election result" : "Save election result", class: ta_btn_primary) %>
      <%= link_to "Cancel", constituency_console_path(@constituency), class: ta_btn_secondary %>
    </div>
  <% end %>
</div>
