<% content_for :title, "Edit #{@election.year}" %>
<% breadcrumb "Loksabhas", console_loksabhas_path %>
<% breadcrumb @loksabha.name, console_loksabha_path(@loksabha) %>
<% if @assembly %>
  <% breadcrumb @assembly.name, console_loksabha_assembly_path(@loksabha, @assembly) %>
<% end %>
<% breadcrumb @election.year.to_s, console_election_result_path(@election) %>
<% breadcrumb "Edit" %>

<%= render layout: "ui/campaign_hero", locals: { kicker: "Platform Console", title: "Edit #{@election.year}", subtitle: @constituency.name } do %><% end %>
<div class="mt-6">
  <%= render "form" %>
</div>
