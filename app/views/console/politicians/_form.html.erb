<%= form_with model: @politician,
      url: (@politician.persisted? ? console_organization_politician_path(@organization, @politician) : console_organization_politicians_path(@organization)) do |f| %>
  <% if @politician.errors.any? %>
    <div class="mb-3 text-sm text-rose-700"><%= @politician.errors.full_messages.to_sentence %></div>
  <% end %>
  <div class="mb-3"><label class="block text-sm text-gray-600">Name</label><%= f.text_field :name, class: "rounded border px-2 py-1" %></div>
  <div class="mb-3"><label class="block text-sm text-gray-600">Party</label><%= f.collection_select :party_id, Party.order(:name), :id, :name, { include_blank: "—" }, class: "rounded border px-2 py-1" %></div>
  <div class="mb-3"><label class="text-sm text-gray-600"><%= f.check_box :is_own_politician %> Own candidate</label></div>
  <%= f.submit class: "rounded bg-gray-900 px-3 py-1 text-sm text-white" %>
<% end %>
