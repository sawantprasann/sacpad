<div class="space-y-6">
  <%= render layout: "ui/campaign_hero", locals: { kicker: "Platform Console", title: "Import Voters", subtitle: "Upload a CSV file to add voters to the global electoral roll" } do %><% end %>
  <div class="flex justify-end">
    <%= link_to "Back to list", console_voter_imports_path, class: ta_btn_secondary %>
  </div>

  <div class="rounded-lg border border-gray-200 bg-white shadow-sm dark:border-gray-800 dark:bg-gray-950 p-6">
    <%= form_with url: console_voter_imports_path, method: :post, multipart: true, local: true, class: "space-y-6" do |f| %>
      <!-- File Upload -->
      <div>
        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300">CSV File</label>
        <div class="mt-2 rounded-lg border-2 border-dashed border-gray-300 p-6 text-center dark:border-gray-600">
          <%= f.file_field :file,
                accept: ".csv",
                class: "block w-full cursor-pointer text-sm text-gray-600 file:mr-3 file:min-h-10 file:cursor-pointer file:rounded-lg file:border-0 file:bg-[#c2410c] file:px-4 file:py-2 file:text-sm file:font-medium file:text-white hover:file:bg-[#9a3412] dark:text-gray-300" %>
          <p class="mt-2 text-xs text-gray-500 dark:text-gray-400">CSV format only (.csv)</p>
        </div>
      </div>

      <!-- Format Info -->
      <div class="rounded-lg bg-gray-50 p-4 dark:bg-gray-900/50">
        <h3 class="font-medium text-gray-900 dark:text-white">Required Columns</h3>
        <ul class="mt-2 space-y-1 text-sm text-gray-600 dark:text-gray-400">
          <li>• <code class="bg-white px-1 rounded dark:bg-gray-800">voter_id</code> — Voter ID (required, unique)</li>
          <li>• <code class="bg-white px-1 rounded dark:bg-gray-800">first_name</code> — First name (required)</li>
          <li>• <code class="bg-white px-1 rounded dark:bg-gray-800">last_name</code> — Last name (required)</li>
          <li>• <code class="bg-white px-1 rounded dark:bg-gray-800">middle_name</code> — Middle name (optional)</li>
          <li>• <code class="bg-white px-1 rounded dark:bg-gray-800">mobile</code> — Phone number (optional)</li>
          <li>• <code class="bg-white px-1 rounded dark:bg-gray-800">booth_id</code> — Booth ID (optional)</li>
          <li>• <code class="bg-white px-1 rounded dark:bg-gray-800">state</code> — State name (optional)</li>
          <li>• <code class="bg-white px-1 rounded dark:bg-gray-800">loksabha</code> — Lok Sabha name (optional)</li>
          <li>• <code class="bg-white px-1 rounded dark:bg-gray-800">assembly</code> — Assembly name (optional)</li>
          <li>• <code class="bg-white px-1 rounded dark:bg-gray-800">village</code> — Village name (optional)</li>
        </ul>
      </div>

      <!-- Example -->
      <div class="rounded-lg bg-amber-50 p-4 dark:bg-amber-900/20">
        <h3 class="font-medium text-amber-900 dark:text-amber-200">Example CSV</h3>
        <pre class="mt-2 overflow-x-auto text-xs text-amber-800 dark:text-amber-300"><code>voter_id,first_name,last_name,middle_name,mobile,booth_id,state,loksabha,assembly,village
VTR001,John,Doe,Kumar,9876543210,1,Maharashtra,Mumbai North,North Mumbai,Dombivli
VTR002,Jane,Smith,Sarah,9876543211,2,Maharashtra,Mumbai North,North Mumbai,Dombivli
VTR003,Bob,Johnson,,9876543212,3,Maharashtra,Mumbai South,South Mumbai,Mahim</code></pre>
      </div>

      <!-- Submit -->
      <div class="flex gap-3 border-t border-gray-200 pt-6 dark:border-gray-800">
        <%= f.submit "Upload & Import", class: ta_btn_primary %>
        <%= link_to "Cancel", console_voter_imports_path, class: "rounded-lg bg-gray-200 px-4 py-2 text-sm font-medium text-gray-900 hover:bg-gray-300 dark:bg-gray-700 dark:text-white dark:hover:bg-gray-600" %>
      </div>
    <% end %>
  </div>

  <!-- Processing Info -->
  <div class="rounded-lg border border-blue-200 bg-blue-50 p-4 dark:border-blue-900/30 dark:bg-blue-900/20">
    <h3 class="font-medium text-blue-900 dark:text-blue-200">⏱️ Processing</h3>
    <p class="mt-2 text-sm text-blue-800 dark:text-blue-300">
      Large files are processed in the background. You'll receive an email with results when complete.
    </p>
  </div>
</div>
