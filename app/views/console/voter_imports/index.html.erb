<div class="space-y-6">
  <%= render layout: "ui/campaign_hero", locals: { kicker: "Platform Console", title: "Voter Bulk Import", subtitle: "Upload a CSV to add voters to the global electoral roll" } do %><% end %>
  <div class="flex justify-end">
    <%= link_to "Import Voters", new_console_voter_import_path, class: ta_btn_primary %>
  </div>

  <!-- Instructions -->
  <div class="rounded-lg border border-blue-200 bg-blue-50 p-4 dark:border-blue-900/30 dark:bg-blue-900/20">
    <h3 class="font-medium text-blue-900 dark:text-blue-200">CSV Format Required</h3>
    <p class="mt-2 text-sm text-blue-800 dark:text-blue-300">
      Required columns: <code class="bg-blue-100 px-2 py-1 rounded dark:bg-blue-900">voter_id</code>,
      <code class="bg-blue-100 px-2 py-1 rounded dark:bg-blue-900">first_name</code>,
      <code class="bg-blue-100 px-2 py-1 rounded dark:bg-blue-900">last_name</code>
    </p>
    <p class="mt-2 text-sm text-blue-800 dark:text-blue-300">
      Optional columns: <code class="bg-blue-100 px-2 py-1 rounded dark:bg-blue-900">middle_name</code>,
      <code class="bg-blue-100 px-2 py-1 rounded dark:bg-blue-900">mobile</code>,
      <code class="bg-blue-100 px-2 py-1 rounded dark:bg-blue-900">booth_id</code>,
      <code class="bg-blue-100 px-2 py-1 rounded dark:bg-blue-900">state</code>,
      <code class="bg-blue-100 px-2 py-1 rounded dark:bg-blue-900">loksabha</code>,
      <code class="bg-blue-100 px-2 py-1 rounded dark:bg-blue-900">assembly</code>,
      <code class="bg-blue-100 px-2 py-1 rounded dark:bg-blue-900">village</code>
    </p>
  </div>

  <!-- Sample CSV Download -->
  <div class="rounded-lg border border-gray-200 bg-white p-6 dark:border-gray-800 dark:bg-gray-950">
    <h3 class="font-medium text-gray-900 dark:text-white">Sample CSV</h3>
    <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">
      Download a template to see the expected format:
    </p>
    <button class="mt-3 rounded-lg bg-gray-100 px-3 py-2 text-sm font-medium text-gray-900 hover:bg-gray-200 dark:bg-gray-800 dark:text-white dark:hover:bg-gray-700">
      📥 Download Template
    </button>
  </div>

  <!-- Recent Imports -->
  <div class="rounded-lg border border-gray-200 bg-white dark:border-gray-800 dark:bg-gray-950">
    <div class="border-b border-gray-200 px-6 py-4 dark:border-gray-800">
      <h2 class="text-lg font-semibold text-gray-900 dark:text-white">Recent Imports</h2>
    </div>
    <div class="px-6 py-4">
      <% if @recent_imports.empty? %>
        <p class="text-sm text-gray-500 dark:text-gray-400">No imports yet. Start by uploading a voter CSV file.</p>
      <% else %>
        <!-- Import history table will go here -->
      <% end %>
    </div>
  </div>

  <!-- Total Voters Count -->
  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    <div class="rounded-lg border border-gray-200 bg-white p-6 dark:border-gray-800 dark:bg-gray-950">
      <p class="text-sm font-medium text-gray-600 dark:text-gray-400">Total Voters</p>
      <p class="mt-2 text-3xl font-bold text-gray-900 dark:text-white"><%= Voter.count %></p>
    </div>
  </div>
</div>
