<div class="<%= ta_card_classes %> p-6">
  <%= form_with model: @role, url: (@role.persisted? ? console_role_path(@role) : console_roles_path) do |f| %>
    <% if @role.errors.any? %>
      <div class="mb-4 rounded-lg border border-error-500/30 bg-error-50 px-4 py-2 text-sm text-error-500"><%= @role.errors.full_messages.to_sentence %></div>
    <% end %>
    <div class="grid gap-4 sm:grid-cols-2">
      <div>
        <label class="<%= ta_label_classes %>">Name</label>
        <%= f.text_field :name, class: ta_field_classes %>
      </div>
      <div>
        <label class="<%= ta_label_classes %>">Slug</label>
        <%= f.text_field :slug, class: ta_field_classes %>
      </div>
    </div>
    <label class="mt-4 flex items-center gap-2 text-sm text-gray-700 dark:text-gray-400">
      <%= f.check_box :can_create_users, class: "h-4 w-4 rounded border-gray-300 text-brand-500 focus:ring-brand-500/20" %>
      Can create users
    </label>

    <p class="mt-6 mb-2 text-sm font-semibold text-gray-700 dark:text-gray-300">Module permissions</p>
    <div class="<%= ta_card_classes %> overflow-hidden">
      <table class="w-full text-sm">
        <thead class="border-b border-gray-200 text-left text-gray-500 dark:border-gray-800">
          <tr><th class="px-5 py-2.5 font-medium">Module</th><th class="px-5 py-2.5 font-medium">Access</th></tr>
        </thead>
        <tbody>
          <%= f.fields_for :role_permissions do |pf| %>
            <tr class="border-b border-gray-100 last:border-0 dark:border-gray-800">
              <td class="px-5 py-2.5 text-gray-700 dark:text-gray-300"><%= pf.object.module_name.humanize %><%= pf.hidden_field :module_name %><%= pf.hidden_field :id %></td>
              <td class="px-5 py-2.5"><%= pf.select :access_level, RolePermission.access_levels.keys, {}, class: "rounded-lg border border-gray-300 px-3 py-1.5 text-sm dark:border-gray-700 dark:bg-gray-900" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="mt-6"><%= f.submit class: ta_btn_primary %></div>
  <% end %>
</div>
