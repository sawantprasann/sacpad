<%= form_with model: @role, url: (@role.persisted? ? console_role_path(@role) : console_roles_path) do |f| %>
  <% if @role.errors.any? %>
    <div class="mb-3 text-sm text-rose-700"><%= @role.errors.full_messages.to_sentence %></div>
  <% end %>
  <div class="mb-3">
    <label class="block text-sm text-gray-600">Name</label>
    <%= f.text_field :name, class: "rounded border px-2 py-1" %>
  </div>
  <div class="mb-3">
    <label class="block text-sm text-gray-600">Slug</label>
    <%= f.text_field :slug, class: "rounded border px-2 py-1" %>
  </div>
  <div class="mb-3">
    <label class="text-sm text-gray-600"><%= f.check_box :can_create_users %> Can create users</label>
  </div>

  <p class="mt-4 text-sm font-medium text-gray-700">Module permissions</p>
  <table class="mt-2 w-full text-sm">
    <%= f.fields_for :role_permissions do |pf| %>
      <tr class="border-t">
        <td class="py-1"><%= pf.object.module_name.humanize %><%= pf.hidden_field :module_name %><%= pf.hidden_field :id %></td>
        <td class="py-1"><%= pf.select :access_level, RolePermission.access_levels.keys, {}, class: "rounded border px-2 py-1" %></td>
      </tr>
    <% end %>
  </table>

  <div class="mt-4"><%= f.submit class: "rounded bg-gray-900 px-3 py-1 text-sm text-white" %></div>
<% end %>
