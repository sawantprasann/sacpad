<% content_for :title, "Roles" %>
<%= render layout: "ui/campaign_hero", locals: { kicker: "Platform Console", title: "Roles" } do %><% end %>
<div class="mt-4 mb-6 flex justify-end">
  <%= link_to "New Role", new_console_role_path, class: ta_btn_primary %>
</div>

<div class="campaign-sheet">
  <div class="overflow-x-auto">
    <table class="campaign-table w-full text-sm">
      <thead class="border-b border-gray-200 text-left text-gray-500 dark:border-gray-800 dark:text-gray-400">
        <tr>
          <th class="px-5 py-3 font-medium">Name</th>
          <th class="px-5 py-3 font-medium">Slug</th>
          <th class="px-5 py-3 font-medium">System</th>
          <th class="px-5 py-3 font-medium">Can create users</th>
          <th class="px-5 py-3 font-medium">Can import</th>
          <th class="px-5 py-3"></th>
        </tr>
      </thead>
      <tbody>
        <% @roles.each do |role| %>
          <tr class="border-b border-gray-100 last:border-0 dark:border-gray-800">
            <td class="px-5 py-3 font-medium text-gray-800 dark:text-white/90"><%= role.name %></td>
            <td class="px-5 py-3 text-gray-500"><%= role.slug %></td>
            <td class="px-5 py-3"><%= render "ui/badge", label: (role.is_system? ? "system" : "custom"), tone: (role.is_system? ? "brand" : "gray") %></td>
            <td class="px-5 py-3 text-gray-700 dark:text-gray-300"><%= role.can_create_users? ? "Yes" : "No" %></td>
            <td class="px-5 py-3 text-gray-700 dark:text-gray-300"><%= role.can_import? ? "Yes" : "No" %></td>
            <td class="px-5 py-3 text-right whitespace-nowrap">
              <div class="inline-flex items-center justify-end gap-1">
                <%= icon_action_link :edit, edit_console_role_path(role) %>
                <% unless role.is_system? %>
                  <%= icon_action_button :delete, console_role_path(role) %>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
