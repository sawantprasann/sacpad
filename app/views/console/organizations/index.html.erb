<% content_for :title, "Organizations" %>
<%= render layout: "ui/campaign_hero", locals: { kicker: "Platform Console", title: "Organizations" } do %><% end %>
<div class="mt-4 mb-6 flex justify-end">
  <%= link_to "Onboard organization", new_console_organization_path, class: ta_btn_primary %>
</div>

<div class="campaign-sheet">
  <div class="overflow-x-auto">
    <table class="campaign-table w-full text-sm">
      <thead class="border-b border-gray-200 text-left text-gray-500 dark:border-gray-800 dark:text-gray-400">
        <tr>
          <th class="px-5 py-3 font-medium">Name</th>
          <th class="px-5 py-3 font-medium">Status</th>
          <th class="px-5 py-3 font-medium">Users</th>
          <th class="px-5 py-3 font-medium">Last activity</th>
          <th class="px-5 py-3"></th>
        </tr>
      </thead>
      <tbody>
        <% @organizations.each do |org| %>
          <tr class="border-b border-gray-100 last:border-0 dark:border-gray-800">
            <td class="px-5 py-3"><%= link_to org.name, console_organization_path(org), class: "font-medium text-gray-800 hover:text-brand-600 dark:text-white/90" %></td>
            <td class="px-5 py-3"><%= render "ui/badge", label: (org.active? ? "active" : "inactive"), tone: (org.active? ? "green" : "gray") %></td>
            <td class="px-5 py-3 tabular-nums text-gray-700 dark:text-gray-300"><%= org.users.count %></td>
            <td class="px-5 py-3 text-gray-500"><%= org.users.maximum(:current_sign_in_at)&.strftime("%d %b %H:%M") || "—" %></td>
            <td class="px-5 py-3 text-right whitespace-nowrap">
              <%= link_to "Edit", edit_console_organization_path(org), class: "mr-3 text-brand-500 hover:text-brand-600" %>
              <% if org.active? %>
                <%= button_to "Deactivate", deactivate_console_organization_path(org), method: :patch, class: "text-error-500 hover:text-error-600", form: { style: "display:inline" } %>
              <% else %>
                <%= button_to "Reactivate", reactivate_console_organization_path(org), method: :patch, class: "text-success-600 hover:text-success-700", form: { style: "display:inline" } %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <% if @organizations.empty? %><p class="px-5 py-10 text-center text-sm text-gray-400">No organizations yet — onboard one.</p><% end %>
  </div>
</div>
