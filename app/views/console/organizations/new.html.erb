<% content_for :title, "Onboard organization" %>
<div class="mx-auto max-w-3xl">
  <h1 class="text-xl font-semibold text-gray-900">Onboard organization</h1>
  <%= form_with model: @organization, url: console_organizations_path do |f| %>
    <p class="mt-3 text-sm font-medium text-gray-700">Organization</p>
    <div class="mb-3"><label class="block text-sm text-gray-600">Name (Politician / campaign)</label><%= f.text_field :name, class: "rounded border px-2 py-1" %></div>
    <div class="mb-3">
      <label class="block text-sm text-gray-600">Constituency level (set once)</label>
      <%= f.select :constituency_type, %w[Loksabha Assembly], { include_blank: true }, class: "rounded border px-2 py-1" %>
    </div>
    <div class="mb-3"><label class="block text-sm text-gray-600">Constituency id</label><%= f.number_field :constituency_id, class: "rounded border px-2 py-1" %></div>
    <div class="mb-3">
      <label class="block text-sm text-gray-600">Party (optional — blank = Independent)</label>
      <%= f.collection_select :current_party_id, Party.order(:name), :id, :name, { include_blank: "Independent" }, class: "rounded border px-2 py-1" %>
    </div>

    <p class="mt-5 text-sm font-medium text-gray-700">Initial Org Admin (required)</p>
    <div class="mb-3"><label class="block text-sm text-gray-600">Name</label><%= text_field_tag "org_admin[name]", nil, class: "rounded border px-2 py-1" %></div>
    <div class="mb-3"><label class="block text-sm text-gray-600">Email</label><%= email_field_tag "org_admin[email]", nil, class: "rounded border px-2 py-1" %></div>
    <div class="mb-3"><label class="block text-sm text-gray-600">Initial password</label><%= password_field_tag "org_admin[password]", nil, class: "rounded border px-2 py-1" %></div>

    <%= f.submit "Onboard", class: "mt-2 rounded bg-gray-900 px-3 py-1 text-sm text-white" %>
  <% end %>
</div>
