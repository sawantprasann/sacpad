<% content_for :title, "Onboard organization" %>
<%= render layout: "ui/campaign_hero", locals: { kicker: "Platform Console", title: "Onboard organization", subtitle: "Name the campaign and its first administrator." } do %><% end %>

<div class="mt-6 <%= ta_card_classes %> p-6">
  <%= form_with model: @organization, url: console_organizations_path do |f| %>
    <%= render "fields", f: f %>

    <p class="mt-6 mb-3 text-sm font-semibold text-gray-700 dark:text-gray-300">Initial Org Admin (required)</p>
    <p class="mb-3 text-sm text-gray-500 dark:text-gray-400">They receive an email invite and choose a password before they can sign in.</p>
    <div class="grid gap-4 sm:grid-cols-2">
      <div><label class="<%= ta_label_classes %>">Name</label><%= text_field_tag "org_admin[name]", nil, class: ta_field_classes %></div>
      <div><label class="<%= ta_label_classes %>">Email</label><%= email_field_tag "org_admin[email]", nil, required: true, class: ta_field_classes %></div>
    </div>

    <div class="mt-6"><%= f.submit "Onboard", class: ta_btn_primary %></div>
  <% end %>
</div>
