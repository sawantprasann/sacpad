<% content_for :title, "Onboard organization" %>
<div class="mb-6"><h1 class="<%= ta_page_title %>">Onboard organization</h1></div>

<div class="<%= ta_card_classes %> p-6">
  <%= form_with model: @organization, url: console_organizations_path do |f| %>
    <p class="mb-3 text-sm font-semibold text-gray-700 dark:text-gray-300">Organization</p>
    <div class="grid gap-4 sm:grid-cols-2">
      <div><label class="<%= ta_label_classes %>">Name (Politician / campaign)</label><%= f.text_field :name, class: ta_field_classes %></div>
      <div><label class="<%= ta_label_classes %>">Party (blank = Independent)</label><%= f.collection_select :current_party_id, Party.order(:name), :id, :name, { include_blank: "Independent" }, class: ta_field_classes %></div>

      <%# Constituency = the seat this campaign contests (set once). Pick the level, then the
          actual Loksabha/Assembly by name — both selects share constituency_id; the hidden one
          is disabled so it isn't submitted. %>
      <div class="sm:col-span-2" x-data="{ ctype: '<%= @organization.constituency_type %>' }">
        <label class="<%= ta_label_classes %>">Constituency — the seat this campaign contests (set once)</label>
        <div class="grid gap-4 sm:grid-cols-2">
          <select name="organization[constituency_type]" x-model="ctype" class="<%= ta_field_classes %>">
            <option value="">Select level…</option>
            <option value="Loksabha">Loksabha (parliamentary)</option>
            <option value="Assembly">Assembly (state)</option>
          </select>
          <div>
            <%# Only the select matching the chosen level carries the submit name (the other gets
                name removed via :name=null), so the visible dropdown is always enabled/usable. %>
            <select x-show="ctype === 'Loksabha'" :name="ctype === 'Loksabha' ? 'organization[constituency_id]' : null" class="<%= ta_field_classes %>">
              <option value="">Select Loksabha…</option>
              <% Loksabha.order(:name).each do |l| %><option value="<%= l.id %>" <%= "selected" if @organization.constituency_type == "Loksabha" && @organization.constituency_id == l.id %>><%= l.name %></option><% end %>
            </select>
            <select x-show="ctype === 'Assembly'" :name="ctype === 'Assembly' ? 'organization[constituency_id]' : null" x-cloak class="<%= ta_field_classes %>">
              <option value="">Select Assembly…</option>
              <% Assembly.order(:name).each do |a| %><option value="<%= a.id %>" <%= "selected" if @organization.constituency_type == "Assembly" && @organization.constituency_id == a.id %>><%= a.name %></option><% end %>
            </select>
            <p x-show="!ctype" class="mt-1 text-xs text-gray-400">Pick a level first. (Seed geography under Reference data if the list is empty.)</p>
          </div>
        </div>
      </div>
    </div>

    <p class="mt-6 mb-3 text-sm font-semibold text-gray-700 dark:text-gray-300">Initial Org Admin (required)</p>
    <div class="grid gap-4 sm:grid-cols-3">
      <div><label class="<%= ta_label_classes %>">Name</label><%= text_field_tag "org_admin[name]", nil, class: ta_field_classes %></div>
      <div><label class="<%= ta_label_classes %>">Email</label><%= email_field_tag "org_admin[email]", nil, class: ta_field_classes %></div>
      <div><label class="<%= ta_label_classes %>">Initial password</label><%= password_field_tag "org_admin[password]", nil, class: ta_field_classes %></div>
    </div>

    <div class="mt-6"><%= f.submit "Onboard", class: ta_btn_primary %></div>
  <% end %>
</div>
