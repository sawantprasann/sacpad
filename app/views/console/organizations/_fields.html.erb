<p class="mb-3 text-sm font-semibold text-gray-700 dark:text-gray-300">Organization</p>
<div class="grid gap-4 sm:grid-cols-2">
  <div><label class="<%= ta_label_classes %>">Name (Politician / campaign)</label><%= f.text_field :name, class: ta_field_classes %></div>
  <div><label class="<%= ta_label_classes %>">Party (blank = Independent)</label><%= f.collection_select :current_party_id, Party.order(:name), :id, :name, { include_blank: "Independent" }, class: ta_field_classes %></div>

  <div class="sm:col-span-2" x-data="{ ctype: '<%= @organization.constituency_type %>' }">
    <label class="<%= ta_label_classes %>">Constituency — the seat this campaign contests</label>
    <div class="grid gap-4 sm:grid-cols-2">
      <select name="organization[constituency_type]" x-model="ctype" class="<%= ta_field_classes %>">
        <option value="">Select level…</option>
        <option value="Loksabha">Loksabha (parliamentary)</option>
        <option value="Assembly">Assembly (state)</option>
      </select>
      <div>
        <select x-show="ctype === 'Loksabha'" :name="ctype === 'Loksabha' ? 'organization[constituency_id]' : null" class="<%= ta_field_classes %>">
          <option value="">Select Loksabha…</option>
          <% Loksabha.order(:name).each do |l| %><option value="<%= l.id %>" <%= "selected" if @organization.constituency_type == "Loksabha" && @organization.constituency_id == l.id %>><%= l.name %></option><% end %>
        </select>
        <select x-show="ctype === 'Assembly'" :name="ctype === 'Assembly' ? 'organization[constituency_id]' : null" x-cloak class="<%= ta_field_classes %>">
          <option value="">Select Assembly…</option>
          <% Assembly.order(:name).each do |a| %><option value="<%= a.id %>" <%= "selected" if @organization.constituency_type == "Assembly" && @organization.constituency_id == a.id %>><%= a.name %></option><% end %>
        </select>
        <p x-show="!ctype" class="mt-1 text-xs text-gray-400">Pick a level first. (Seed geography under Reference data if the list is empty.)</p>
      </div>
    </div>
  </div>

  <div class="sm:col-span-2">
    <label class="<%= ta_label_classes %>" for="organization_banner_photo">Banner photo</label>
    <p class="mb-2 text-xs text-gray-500 dark:text-gray-400">Shown at the same size on the right of every page banner. The whole photo stays visible, including the edges. A white or checkerboard backdrop on a PNG is removed.</p>
    <% if @organization.persisted? && @organization.banner_photo.attached? && @organization.banner_photo.blob&.persisted? %>
      <div class="relative mb-3 inline-flex h-24 w-40 items-center justify-center overflow-hidden rounded-lg"
           style="background: linear-gradient(125deg, #06eff4 0%, #ea580c 48%, #f59e0b 100%);"
           x-data="{ removed: false }"
           x-show="!removed">
        <%= image_tag @organization.banner_photo, class: "max-h-full max-w-full object-contain", style: "background: transparent;", alt: @organization.name %>
        <button type="button"
                class="absolute top-1 right-1 inline-flex h-7 w-7 items-center justify-center rounded-full bg-gray-900/80 text-white shadow-sm hover:bg-gray-900"
                @click="removed = true"
                aria-label="Remove banner photo">
          <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
            <path stroke-linecap="round" d="M6 6l12 12M18 6L6 18"></path>
          </svg>
        </button>
        <input type="hidden" name="organization[remove_banner_photo]" :value="removed ? '1' : '0'">
      </div>
    <% end %>
    <%= f.file_field :banner_photo, accept: "image/jpeg,image/png,image/gif,image/webp",
          class: "block w-full cursor-pointer text-sm text-gray-600 file:mr-3 file:min-h-11 file:cursor-pointer file:rounded-lg file:border-0 file:bg-gray-100 file:px-4 file:py-2 file:text-sm file:font-medium dark:text-gray-300 dark:file:bg-white/10" %>
  </div>
</div>
