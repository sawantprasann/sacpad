<% content_for :title, @organization.name %>
<div class="mx-auto max-w-3xl">
  <h1 class="text-xl font-semibold text-gray-900"><%= @organization.name %></h1>
  <p class="mt-2 text-sm text-gray-500">
    Status: <%= @organization.active? ? "active" : "inactive" %> ·
    Constituency: <%= @organization.constituency_type || "—" %> #<%= @organization.constituency_id || "—" %> ·
    Users: <span class="tabular-nums"><%= @organization.users.count %></span>
  </p>
  <%# The persistent logged-access banner (Story 0.11) will render here when an Admin views org data. %>
</div>
