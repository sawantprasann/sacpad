<% content_for :title, @organization.name %>
<%= render layout: "ui/campaign_hero", locals: {
      kicker: "Platform Console",
      title: @organization.name,
      subtitle: "You're viewing this organization's data. This access is logged."
    } do %><% end %>
<div class="mt-4 mb-8 flex justify-end">
  <%= link_to "Edit organization", edit_console_organization_path(@organization), class: ta_btn_primary %>
</div>

<%# Clear Tab Navigation -%>
<div class="mb-8">
  <div class="flex gap-1 border-b-2 border-gray-200 dark:border-gray-700">
    <% current_tab = params[:tab].presence || 'overview' %>

    <a href="<%= console_organization_path(@organization) %>"
       class="px-6 py-4 font-semibold border-b-4 transition-all <%= current_tab == 'overview' ? 'campaign-tab-active' : 'text-gray-700 border-transparent dark:text-gray-300 hover:text-gray-900 dark:hover:text-gray-100' %>">
      Overview
    </a>

    <a href="<%= console_organization_path(@organization, tab: 'kitchen_cabinet') %>"
       class="px-6 py-4 font-semibold border-b-4 transition-all <%= current_tab == 'kitchen_cabinet' ? 'campaign-tab-active' : 'text-gray-700 border-transparent dark:text-gray-300 hover:text-gray-900 dark:hover:text-gray-100' %>">
      Kitchen Cabinet
    </a>

    <a href="<%= console_organization_path(@organization, tab: 'cadre') %>"
       class="px-6 py-4 font-semibold border-b-4 transition-all <%= current_tab == 'cadre' ? 'campaign-tab-active' : 'text-gray-700 border-transparent dark:text-gray-300 hover:text-gray-900 dark:hover:text-gray-100' %>">
      Cadre Program
    </a>
  </div>
</div>

<%# Overview Tab -%>
<% if current_tab == 'overview' %>
  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-4 mb-8">
    <div class="bg-white dark:bg-gray-900 rounded-lg border border-gray-200 dark:border-gray-700 p-6">
      <p class="text-sm font-semibold text-gray-600 dark:text-gray-400">STATUS</p>
      <div class="mt-3"><%= render "ui/badge", label: (@organization.active? ? "active" : "inactive"), tone: (@organization.active? ? "green" : "gray") %></div>
    </div>

    <div class="bg-white dark:bg-gray-900 rounded-lg border border-gray-200 dark:border-gray-700 p-6">
      <p class="text-sm font-semibold text-gray-600 dark:text-gray-400">CONSTITUENCY</p>
      <p class="mt-3 text-2xl font-bold text-gray-900 dark:text-white"><%= @organization.constituency_type %> #<%= @organization.constituency_id %></p>
    </div>

    <div class="bg-white dark:bg-gray-900 rounded-lg border border-gray-200 dark:border-gray-700 p-6">
      <p class="text-sm font-semibold text-gray-600 dark:text-gray-400">TOTAL USERS</p>
      <p class="mt-3 text-2xl font-bold text-gray-900 dark:text-white tabular-nums"><%= @organization.users.count %></p>
    </div>

    <div class="bg-white dark:bg-gray-900 rounded-lg border border-gray-200 dark:border-gray-700 p-6">
      <p class="text-sm font-semibold text-gray-600 dark:text-gray-400">PARTY</p>
      <p class="mt-3 text-2xl font-bold text-gray-900 dark:text-white"><%= @organization.current_party&.name || "Independent" %></p>
    </div>
  </div>

  <div class="campaign-sheet mb-8">
    <div class="flex flex-wrap items-end justify-between gap-3 border-b border-gray-200 px-6 py-5 dark:border-gray-700">
      <div>
        <h3 class="text-xl font-bold text-gray-900 dark:text-white">Users</h3>
        <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Every login account in this organization.</p>
      </div>
      <p class="text-sm font-semibold tabular-nums text-gray-700 dark:text-gray-300"><%= pluralize(@users.size, "user") %></p>
    </div>

    <% if @users.any? %>
      <div class="overflow-x-auto">
        <table class="campaign-table w-full text-sm">
          <thead class="bg-gray-100 text-left dark:bg-gray-800">
            <tr>
              <th class="px-6 py-3 font-bold text-gray-700 dark:text-gray-300">Name</th>
              <th class="px-6 py-3 font-bold text-gray-700 dark:text-gray-300">Email</th>
              <th class="px-6 py-3 font-bold text-gray-700 dark:text-gray-300">Role</th>
              <th class="px-6 py-3 font-bold text-gray-700 dark:text-gray-300">Reports to</th>
              <th class="px-6 py-3 font-bold text-gray-700 dark:text-gray-300">Status</th>
              <th class="px-6 py-3 font-bold text-gray-700 dark:text-gray-300">Last sign in</th>
              <th class="px-6 py-3 font-bold text-gray-700 dark:text-gray-300">Password</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
            <% @users.each do |user| %>
              <tr>
                <td class="px-6 py-4 font-medium text-gray-900 dark:text-white"><%= user.name %></td>
                <td class="px-6 py-4 text-gray-700 dark:text-gray-300"><%= user.email %></td>
                <td class="px-6 py-4 text-gray-700 dark:text-gray-300"><%= user.role.name %></td>
                <td class="px-6 py-4 text-gray-500"><%= user.parent&.name || "—" %></td>
                <td class="px-6 py-4"><%= render "ui/badge", label: (user.active? ? "active" : "inactive"), tone: (user.active? ? "green" : "gray") %></td>
                <td class="px-6 py-4 tabular-nums text-gray-500"><%= user.current_sign_in_at&.strftime("%d %b %Y %H:%M") || "Never" %></td>
                <td class="px-6 py-4" x-data="{ open: false }">
                  <button type="button" @click="open = true"
                          class="campaign-btn inline-flex h-8 cursor-pointer items-center rounded-lg px-3 text-xs font-semibold text-white">
                    Reset
                  </button>
                  <template x-teleport="body">
                    <div x-show="open" x-cloak @keydown.escape.window="open = false"
                         class="fixed inset-0 z-[9999] flex items-center justify-center p-4">
                      <div class="absolute inset-0 bg-gray-900/50" @click="open = false"></div>
                      <div role="dialog" aria-modal="true" aria-labelledby="reset-title-<%= user.id %>"
                           class="relative w-full max-w-md rounded-2xl bg-white p-6 shadow-theme-xl dark:bg-gray-900">
                        <h4 id="reset-title-<%= user.id %>" class="text-lg font-bold text-gray-900 dark:text-white">Reset password</h4>
                        <p class="mt-1 text-sm text-gray-500 dark:text-gray-400"><%= user.name %> · <%= user.email %></p>
                        <%= form_with url: reset_password_console_organization_org_user_path(@organization, user), method: :patch, class: "mt-5 space-y-3" do %>
                          <div>
                            <label class="<%= ta_label_classes %>">New password</label>
                            <%= password_field_tag "user[password]", nil, placeholder: "At least 6 characters", autocomplete: "new-password", required: true, minlength: 6, class: ta_field_classes %>
                          </div>
                          <div>
                            <label class="<%= ta_label_classes %>">Confirm password</label>
                            <%= password_field_tag "user[password_confirmation]", nil, placeholder: "Type it again", autocomplete: "new-password", required: true, minlength: 6, class: ta_field_classes %>
                          </div>
                          <div class="flex items-center justify-end gap-2 pt-2">
                            <button type="button" @click="open = false" class="<%= ta_btn_secondary %>">Cancel</button>
                            <%= submit_tag "Set password", class: ta_btn_primary + " cursor-pointer" %>
                          </div>
                        <% end %>
                        <div class="mt-4 border-t border-gray-200 pt-4 dark:border-gray-700">
                          <%= button_to "Email a reset link instead", send_reset_console_organization_org_user_path(@organization, user),
                                class: "text-sm font-semibold text-blue-600 hover:text-blue-700" %>
                        </div>
                      </div>
                    </div>
                  </template>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="px-6 py-10 text-center text-sm text-gray-500">No users in this organization yet.</p>
    <% end %>
  </div>

  <div class="bg-white dark:bg-gray-900 rounded-lg border border-gray-200 dark:border-gray-700 p-8">
    <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-6">Administration</h3>
    <%= link_to "Manage Politicians", console_organization_politicians_path(@organization), class: "campaign-btn inline-block rounded-lg px-6 py-2 text-sm font-semibold text-white" %>
  </div>
<% end %>

<%# Kitchen Cabinet Tab (Story 0.16, AC 1) -%>
<% if current_tab == 'kitchen_cabinet' %>
  <% ActsAsTenant.with_tenant(@organization) do %>
    <%# Filter Section -%>
    <div class="bg-white dark:bg-gray-900 rounded-lg border border-gray-200 dark:border-gray-700 p-6 mb-6">
      <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-4">Filters</h3>

      <%= form_with url: console_organization_path(@organization, tab: 'kitchen_cabinet'), method: :get, class: "space-y-4", local: true do %>
        <div class="grid grid-cols-1 gap-4 md:grid-cols-4">
          <div>
            <label class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-2">Search</label>
            <%= text_field_tag :q, params[:q], placeholder: "Person or village...", class: "w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg dark:bg-gray-800 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500" %>
          </div>

          <div>
            <label class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-2">Category</label>
            <%= select_tag :category,
                  options_for_select([ [ "All Categories", "" ] ] + TicketCategory.active.order(:name).map { |c| [ c.name, c.slug ] }, params[:category]),
                  class: "w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg dark:bg-gray-800 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500" %>
          </div>

          <div>
            <label class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-2">Status</label>
            <%= select_tag :status,
                  options_for_select([ [ "All Statuses", "" ] ] + KitchenCabinet::Ticket.statuses.keys.map { |s| [ s.humanize, s ] }, params[:status]),
                  class: "w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg dark:bg-gray-800 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500" %>
          </div>

          <div class="flex items-end gap-2">
            <%= submit_tag "Search", class: "campaign-btn w-full rounded-lg px-4 py-2 text-sm font-semibold text-white" %>
            <% if params[:q].present? || params[:category].present? || params[:status].present? %>
              <%= link_to "Clear", console_organization_path(@organization, tab: 'kitchen_cabinet'), class: "w-full bg-gray-400 hover:bg-gray-500 text-white font-semibold px-4 py-2 rounded-lg transition-colors text-center" %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>

    <%# Results Count -%>
    <% if @tickets && @pagy && @pagy.count %>
      <div class="mb-4 px-2">
        <p class="text-gray-700 dark:text-gray-300"><strong><%= @pagy.count %> tickets</strong> found</p>
      </div>
    <% end %>

    <%# Desktop Table -%>
    <div class="campaign-sheet hidden lg:block">
      <table class="campaign-table w-full">
        <thead class="bg-gray-100 dark:bg-gray-800 border-b border-gray-200 dark:border-gray-700">
          <tr>
            <th class="px-6 py-3 text-left text-sm font-bold text-gray-700 dark:text-gray-300">TICKET #</th>
            <th class="px-6 py-3 text-left text-sm font-bold text-gray-700 dark:text-gray-300">PERSON / VILLAGE</th>
            <th class="px-6 py-3 text-left text-sm font-bold text-gray-700 dark:text-gray-300">OWNER</th>
            <th class="px-6 py-3 text-left text-sm font-bold text-gray-700 dark:text-gray-300">CATEGORY</th>
            <th class="px-6 py-3 text-left text-sm font-bold text-gray-700 dark:text-gray-300">STATUS</th>
            <th class="px-6 py-3 text-left text-sm font-bold text-gray-700 dark:text-gray-300">REPORTED DATE</th>
            <th class="px-6 py-3 text-left text-sm font-bold text-gray-700 dark:text-gray-300">ACTIONS</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
          <% if @tickets.any? %>
            <% @tickets.each do |ticket| %>
              <tr class="hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors">
                <td class="px-6 py-4 text-sm font-semibold text-gray-900 dark:text-white"><%= ticket.ticket_number %></td>
                <td class="px-6 py-4">
                  <div class="text-sm font-medium text-gray-900 dark:text-white"><%= ticket.person_name %></div>
                  <div class="text-xs text-gray-500 dark:text-gray-400"><%= ticket.village.presence || "—" %></div>
                </td>
                <td class="px-6 py-4 text-sm text-gray-700 dark:text-gray-300"><%= ticket.owner.name %></td>
                <td class="px-6 py-4 text-sm text-gray-700 dark:text-gray-300"><%= ticket.ticket_category.name %></td>
                <td class="px-6 py-4"><%= render "ui/status_pill", status: ticket.status %></td>
                <td class="px-6 py-4 text-sm text-gray-700 dark:text-gray-300 tabular-nums"><%= ticket.reported_at&.strftime("%d %b %Y") %></td>
                <td class="px-6 py-4 text-sm">
                  <div class="flex gap-3">
                    <%= link_to "Edit", edit_console_organization_org_ticket_path(@organization, ticket), class: "text-blue-600 hover:text-blue-700 font-semibold" %>
                    <%= link_to "Delete", console_organization_org_ticket_path(@organization, ticket), method: :delete, data: { confirm: "Are you sure?" }, class: "text-red-600 hover:text-red-700 font-semibold" %>
                  </div>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="6" class="px-6 py-12 text-center text-gray-500 dark:text-gray-400">
                No tickets found. Try adjusting your filters.
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <%# Mobile Cards -%>
    <div class="space-y-3 lg:hidden">
      <% if @tickets.any? %>
        <% @tickets.each do |ticket| %>
          <div class="bg-white dark:bg-gray-900 rounded-lg border border-gray-200 dark:border-gray-700 p-4">
            <div class="flex justify-between items-start mb-3">
              <div>
                <p class="font-bold text-gray-900 dark:text-white"><%= ticket.person_name %></p>
                <p class="text-xs text-gray-500 dark:text-gray-400"><%= ticket.village.presence || "—" %></p>
                <p class="text-xs text-gray-600 dark:text-gray-400 mt-1">Ticket: <strong><%= ticket.ticket_number %></strong></p>
              </div>
              <%= render "ui/status_pill", status: ticket.status %>
            </div>
            <div class="flex gap-2 text-xs text-gray-600 dark:text-gray-400 mb-3">
              <span class="bg-gray-100 dark:bg-gray-800 px-2 py-1 rounded"><%= ticket.ticket_category.name %></span>
              <span>Owner: <%= ticket.owner.name %></span>
              <span><%= ticket.reported_at&.strftime("%d %b") %></span>
            </div>
            <div class="flex gap-3 text-sm border-t border-gray-200 dark:border-gray-700 pt-3">
              <%= link_to "Edit", edit_console_organization_org_ticket_path(@organization, ticket), class: "text-blue-600 hover:text-blue-700 font-semibold" %>
              <%= link_to "Delete", console_organization_org_ticket_path(@organization, ticket), method: :delete, data: { confirm: "Are you sure?" }, class: "text-red-600 hover:text-red-700 font-semibold" %>
            </div>
          </div>
        <% end %>
      <% else %>
        <div class="bg-white dark:bg-gray-900 rounded-lg border border-gray-200 dark:border-gray-700 p-8 text-center">
          <p class="text-gray-500 dark:text-gray-400">No tickets found. Try adjusting your filters.</p>
        </div>
      <% end %>
    </div>

    <%# Pagination -%>
    <% if @pagy && @pagy.last > 1 %>
      <div class="mt-6 flex items-center justify-between">
        <div>
          <% if @pagy.previous %>
            <%= link_to "← Previous", console_organization_path(@organization, tab: 'kitchen_cabinet', category: params[:category], status: params[:status], q: params[:q], page: @pagy.previous), class: "px-4 py-2 bg-gray-300 dark:bg-gray-600 text-gray-800 dark:text-white font-semibold rounded-lg hover:bg-gray-400 dark:hover:bg-gray-700 transition-colors" %>
          <% else %>
            <button class="px-4 py-2 bg-gray-200 dark:bg-gray-700 text-gray-500 dark:text-gray-400 font-semibold rounded-lg cursor-not-allowed">← Previous</button>
          <% end %>
        </div>

        <p class="text-sm font-semibold text-gray-700 dark:text-gray-300">Page <span class="tabular-nums"><%= @pagy.page %></span> of <span class="tabular-nums"><%= @pagy.last %></span></p>

        <div>
          <% if @pagy.next %>
            <%= link_to "Next →", console_organization_path(@organization, tab: 'kitchen_cabinet', category: params[:category], status: params[:status], q: params[:q], page: @pagy.next), class: "campaign-btn rounded-lg px-4 py-2 text-sm font-semibold text-white" %>
          <% else %>
            <button class="px-4 py-2 bg-gray-200 dark:bg-gray-700 text-gray-500 dark:text-gray-400 font-semibold rounded-lg cursor-not-allowed">Next →</button>
          <% end %>
        </div>
      </div>
    <% end %>
  <% end %>
<% end %>

<%# Cadre Program Tab -%>
<% if current_tab == 'cadre' %>
  <div class="bg-white dark:bg-gray-900 rounded-lg border border-gray-200 dark:border-gray-700 p-12 text-center">
    <h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-2">Cadre Program</h3>
    <p class="text-gray-600 dark:text-gray-400">Activity tracking and management coming in the next release.</p>
  </div>
<% end %>
