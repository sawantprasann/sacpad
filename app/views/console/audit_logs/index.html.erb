<% content_for :title, "Audit log" %>
<%= render layout: "ui/campaign_hero", locals: { kicker: "Platform Console", title: "Audit log" } do %><% end %>
<div class="mt-6">

<div class="campaign-sheet">
  <div class="overflow-x-auto">
    <table class="campaign-table w-full text-sm">
      <thead class="border-b border-gray-200 text-left text-gray-500 dark:border-gray-800 dark:text-gray-400">
        <tr>
          <th class="px-5 py-3 font-medium">When</th>
          <th class="px-5 py-3 font-medium">Actor</th>
          <th class="px-5 py-3 font-medium">Action</th>
          <th class="px-5 py-3 font-medium">Org</th>
          <th class="px-5 py-3 font-medium">Record</th>
        </tr>
      </thead>
      <tbody>
        <% @logs.each do |log| %>
          <tr class="border-b border-gray-100 last:border-0 dark:border-gray-800">
            <td class="px-5 py-3 whitespace-nowrap text-gray-500"><%= log.created_at.strftime("%d %b %H:%M") %></td>
            <td class="px-5 py-3 text-gray-700 dark:text-gray-300"><%= log.actor_type %> #<%= log.actor_id %></td>
            <td class="px-5 py-3"><%= render "ui/badge", label: log.action, tone: "brand" %></td>
            <td class="px-5 py-3 tabular-nums text-gray-500"><%= log.organization_id || "—" %></td>
            <td class="px-5 py-3 text-gray-500"><%= log.record_type ? "#{log.record_type} ##{log.record_id}" : "—" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <% if @logs.empty? %><p class="px-5 py-10 text-center text-sm text-gray-400">No activity logged yet.</p><% end %>
  </div>
</div>
</div>
