<%= form_with model: [:console, @booth], local: true, class: "space-y-6" do |f| %>
  <% if @booth.errors.any? %>
    <div class="rounded-lg bg-red-50 p-4 dark:bg-red-900/20">
      <h3 class="text-sm font-medium text-red-800 dark:text-red-400">
        <%= pluralize(@booth.errors.count, "error") %> prevented this booth from being saved:
      </h3>
      <ul class="mt-2 space-y-1 text-sm text-red-700 dark:text-red-300">
        <% @booth.errors.full_messages.each do |message| %>
          <li>• <%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= searchable_collection_select(f, :village_id, Village.order(:name), :id, :name, label: "Village") %>
    <% if @booth.errors[:village_id].any? %>
      <p class="mt-1 text-sm text-red-600 dark:text-red-400"><%= @booth.errors[:village_id].first %></p>
    <% end %>
  </div>

  <div>
    <%= f.label :number, "Booth Number", class: "block text-sm font-medium text-gray-700 dark:text-gray-300" %>
    <%= f.text_field :number, placeholder: "e.g., 001, 042", class: "mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 text-gray-900 placeholder:text-gray-400 dark:border-gray-600 dark:bg-gray-800 dark:text-white" %>
    <% if @booth.errors[:number].any? %>
      <p class="mt-1 text-sm text-red-600 dark:text-red-400"><%= @booth.errors[:number].first %></p>
    <% end %>
  </div>

  <div class="flex gap-3">
    <%= f.submit @booth.new_record? ? "Create Booth" : "Update Booth", class: "rounded-lg bg-blue-600 px-4 py-2 text-sm font-medium text-white hover:bg-blue-700" %>
    <%= link_to "Cancel", console_booths_path, class: "rounded-lg bg-gray-200 px-4 py-2 text-sm font-medium text-gray-900 hover:bg-gray-300 dark:bg-gray-700 dark:text-white dark:hover:bg-gray-600" %>
  </div>
<% end %>
