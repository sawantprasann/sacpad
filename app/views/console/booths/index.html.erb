<div class="space-y-6">
  <%= render layout: "ui/campaign_hero", locals: { kicker: "Platform Console", title: "Booths", subtitle: "Polling booth reference catalog" } do %><% end %>
  <div class="flex justify-end">
    <%= link_to "New Booth", new_console_booth_path, class: ta_btn_primary %>
  </div>

  <div class="campaign-sheet">
    <%= render "console/filters",
          url: console_booths_path,
          fields: [ [ :booth_number, "Booth number" ], [ :village, "Village" ] ],
          hint: @pagy.count > 0 ? nil : "No booths found. Create one to get started." %>

    <div class="overflow-x-auto">
      <table class="campaign-table w-full">
        <thead>
          <tr class="border-b border-gray-200 bg-gray-50 dark:border-gray-800 dark:bg-gray-900/50">
            <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-600 dark:text-gray-400">Booth #</th>
            <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-600 dark:text-gray-400">Village</th>
            <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-600 dark:text-gray-400">Taluka</th>
            <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-600 dark:text-gray-400">District</th>
            <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-600 dark:text-gray-400">State</th>
            <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-600 dark:text-gray-400"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200 dark:divide-gray-800">
          <% @booths.each do |booth| %>
            <tr class="hover:bg-gray-50 dark:hover:bg-gray-900/50">
              <td class="px-6 py-4 text-sm font-medium text-gray-900 dark:text-white">
                <%= link_to booth.number, console_booth_path(booth), class: "text-blue-600 hover:underline dark:text-blue-400" %>
              </td>
              <td class="px-6 py-4 text-sm text-gray-700 dark:text-gray-300">
                <%= booth.village&.name || "—" %>
              </td>
              <td class="px-6 py-4 text-sm text-gray-700 dark:text-gray-300">
                <% if booth.village&.taluka %>
                  <%= link_to booth.village.taluka.name, console_taluka_path(booth.village.taluka), class: "text-blue-600 hover:underline dark:text-blue-400" %>
                <% else %>
                  —
                <% end %>
              </td>
              <td class="px-6 py-4 text-sm text-gray-700 dark:text-gray-300">
                <% if booth.village&.taluka&.district %>
                  <%= link_to booth.village.taluka.district.name, console_district_path(booth.village.taluka.district), class: "text-blue-600 hover:underline dark:text-blue-400" %>
                <% else %>
                  —
                <% end %>
              </td>
              <td class="px-6 py-4 text-sm text-gray-700 dark:text-gray-300">
                <% if booth.village&.taluka&.district&.state %>
                  <%= link_to booth.village.taluka.district.state.name, console_state_path(booth.village.taluka.district.state), class: "text-blue-600 hover:underline dark:text-blue-400" %>
                <% else %>
                  —
                <% end %>
              </td>
              <td class="px-6 py-4 text-right text-sm">
                <div class="inline-flex items-center justify-end gap-1">
                  <%= icon_action_link :view, console_booth_path(booth) %>
                  <%= icon_action_link :edit, edit_console_booth_path(booth) %>
                  <%= icon_action_button :delete, console_booth_path(booth) %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <%= render "ui/pagination", pagy: @pagy %>
  </div>

  <div class="text-sm text-gray-600 dark:text-gray-400">
    Total: <strong><%= Booth.count %></strong> booths
  </div>
</div>
