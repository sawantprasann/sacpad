<div class="space-y-6">
  <%= render layout: "ui/campaign_hero", locals: { kicker: "Platform Console", title: "Booth #{@booth.number}" } do %><% end %>
  <div class="flex justify-end">
    <%= link_to "Back to list", console_booths_path, class: ta_btn_secondary %>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
    <!-- Booth Details -->
    <div class="rounded-lg border border-gray-200 bg-white shadow-sm dark:border-gray-800 dark:bg-gray-950">
      <div class="border-b border-gray-200 px-6 py-4 dark:border-gray-800">
        <h2 class="text-lg font-semibold text-gray-900 dark:text-white">Booth Information</h2>
      </div>
      <div class="px-6 py-4 space-y-4">
        <div>
          <label class="text-xs font-medium uppercase text-gray-500 dark:text-gray-400">Booth Number</label>
          <p class="mt-1 text-sm font-mono text-gray-900 dark:text-white"><%= @booth.number %></p>
        </div>
        <div>
          <label class="text-xs font-medium uppercase text-gray-500 dark:text-gray-400">Village</label>
          <p class="mt-1 text-sm text-gray-900 dark:text-white"><%= @booth.village&.name || "—" %></p>
        </div>
        <div>
          <label class="text-xs font-medium uppercase text-gray-500 dark:text-gray-400">Taluka</label>
          <% if @booth.village&.taluka %>
            <p class="mt-1 text-sm">
              <%= link_to @booth.village.taluka.name, console_taluka_path(@booth.village.taluka), class: "text-blue-600 hover:underline dark:text-blue-400" %>
            </p>
          <% else %>
            <p class="mt-1 text-sm text-gray-400">—</p>
          <% end %>
        </div>
        <div>
          <label class="text-xs font-medium uppercase text-gray-500 dark:text-gray-400">District</label>
          <% if @booth.village&.taluka&.district %>
            <p class="mt-1 text-sm">
              <%= link_to @booth.village.taluka.district.name, console_district_path(@booth.village.taluka.district), class: "text-blue-600 hover:underline dark:text-blue-400" %>
            </p>
          <% else %>
            <p class="mt-1 text-sm text-gray-400">—</p>
          <% end %>
        </div>
        <div>
          <label class="text-xs font-medium uppercase text-gray-500 dark:text-gray-400">State</label>
          <% if @booth.village&.taluka&.district&.state %>
            <p class="mt-1 text-sm">
              <%= link_to @booth.village.taluka.district.state.name, console_state_path(@booth.village.taluka.district.state), class: "text-blue-600 hover:underline dark:text-blue-400" %>
            </p>
          <% else %>
            <p class="mt-1 text-sm text-gray-400">—</p>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Actions -->
    <div class="rounded-lg border border-gray-200 bg-white shadow-sm dark:border-gray-800 dark:bg-gray-950">
      <div class="border-b border-gray-200 px-6 py-4 dark:border-gray-800">
        <h2 class="text-lg font-semibold text-gray-900 dark:text-white">Actions</h2>
      </div>
      <div class="px-6 py-4 space-y-3">
        <%= link_to "Edit Booth", edit_console_booth_path(@booth), class: "#{ta_btn_primary} block text-center" %>
        <%= button_to "Delete Booth", console_booth_path(@booth), method: :delete, class: "block rounded-lg bg-red-600 px-4 py-2 text-center text-sm font-medium text-white hover:bg-red-700", form: { onsubmit: "return confirm('Are you sure?')" } %>
      </div>
    </div>
  </div>

  <div class="campaign-sheet">
    <div class="border-b border-gray-200 px-5 py-4 dark:border-gray-800">
      <h2 class="text-base font-semibold text-gray-900 dark:text-white/90">Voters</h2>
      <p class="mt-1 text-sm text-gray-500 dark:text-gray-400"><%= @voter_total %> registered at this booth</p>
    </div>
    <%= render "console/filters", url: console_booth_path(@booth), fields: [ [ :voter_id, "Voter ID" ], [ :name, "Name" ], [ :age, "Age" ], [ :gender, "Gender" ], [ :house_no, "House no" ] ] %>
    <div class="overflow-x-auto">
      <table class="campaign-table w-full text-sm">
        <thead class="border-b border-gray-200 text-left text-gray-500 dark:border-gray-800 dark:text-gray-400">
          <tr>
            <th class="px-5 py-3 font-medium">Voter ID</th>
            <th class="px-5 py-3 font-medium">Name</th>
            <th class="px-5 py-3 font-medium">Age</th>
            <th class="px-5 py-3 font-medium">Gender</th>
            <th class="px-5 py-3 font-medium">House no</th>
          </tr>
        </thead>
        <tbody>
          <% @voters.each do |voter| %>
            <tr class="border-b border-gray-100 last:border-0 dark:border-gray-800">
              <td class="px-5 py-3"><%= link_to voter.voter_id, console_voter_path(voter), class: "text-brand-500 hover:text-brand-600" %></td>
              <td class="px-5 py-3 text-gray-700 dark:text-gray-300"><%= voter.name %></td>
              <td class="px-5 py-3 text-gray-700 dark:text-gray-300"><%= voter.age || "—" %></td>
              <td class="px-5 py-3 text-gray-700 dark:text-gray-300"><%= voter.gender.presence || "—" %></td>
              <td class="px-5 py-3 text-gray-700 dark:text-gray-300"><%= voter.house_no.presence || "—" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
      <% if @voters.empty? %>
        <p class="px-5 py-10 text-center text-sm text-gray-400"><%= voter_filters.values.any?(&:present?) ? "No voters match." : "No voters yet." %></p>
      <% end %>
    </div>
    <% if @pagy.last > 1 %>
      <div class="flex items-center justify-between border-t border-gray-200 px-5 py-4 text-sm dark:border-gray-800">
        <p class="text-gray-500 dark:text-gray-400">Page <%= @pagy.page %> of <%= @pagy.last %></p>
        <div class="flex gap-2">
          <% if @pagy.previous %>
            <%= link_to "← Prev", console_booth_path(@booth, voter_filters.merge(page: @pagy.previous)), class: "text-brand-500 hover:text-brand-600" %>
          <% end %>
          <% if @pagy.next %>
            <%= link_to "Next →", console_booth_path(@booth, voter_filters.merge(page: @pagy.next)), class: "text-brand-500 hover:text-brand-600" %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>
