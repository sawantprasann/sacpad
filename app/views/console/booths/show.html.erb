<div class="space-y-6">
  <%= render layout: "ui/campaign_hero", locals: { kicker: "Platform Console", title: "Booth #{@booth.number}" } do %><% end %>
  <div class="flex justify-end">
    <%= link_to "Back to list", console_booths_path, class: ta_btn_secondary %>
  </div>

  <div class="rounded-lg border border-gray-200 bg-white shadow-sm dark:border-gray-800 dark:bg-gray-950">
    <div class="border-b border-gray-200 px-6 py-4 dark:border-gray-800">
      <h2 class="text-lg font-semibold text-gray-900 dark:text-white">Booth Information</h2>
    </div>
    <div class="grid grid-cols-1 gap-4 px-6 py-4 sm:grid-cols-2 lg:grid-cols-3">
        <div>
          <label class="text-xs font-medium uppercase text-gray-500 dark:text-gray-400">Booth Number</label>
          <p class="mt-1 text-sm font-mono text-gray-900 dark:text-white"><%= @booth.number %></p>
        </div>
        <div>
          <label class="text-xs font-medium uppercase text-gray-500 dark:text-gray-400">Village</label>
          <p class="mt-1 text-sm text-gray-900 dark:text-white"><%= @booth.village&.name || "—" %></p>
        </div>
        <div>
          <label class="text-xs font-medium uppercase text-gray-500 dark:text-gray-400">Taluka</label>
          <% if @booth.village&.taluka %>
            <p class="mt-1 text-sm">
              <%= link_to @booth.village.taluka.name, console_taluka_path(@booth.village.taluka), class: ta_text_link %>
            </p>
          <% else %>
            <p class="mt-1 text-sm text-gray-400">—</p>
          <% end %>
        </div>
        <div>
          <label class="text-xs font-medium uppercase text-gray-500 dark:text-gray-400">District</label>
          <% if @booth.village&.taluka&.district %>
            <p class="mt-1 text-sm">
              <%= link_to @booth.village.taluka.district.name, console_district_path(@booth.village.taluka.district), class: ta_text_link %>
            </p>
          <% else %>
            <p class="mt-1 text-sm text-gray-400">—</p>
          <% end %>
        </div>
        <div>
          <label class="text-xs font-medium uppercase text-gray-500 dark:text-gray-400">State</label>
          <% if @booth.village&.taluka&.district&.state %>
            <p class="mt-1 text-sm">
              <%= link_to @booth.village.taluka.district.state.name, console_state_path(@booth.village.taluka.district.state), class: ta_text_link %>
            </p>
          <% else %>
            <p class="mt-1 text-sm text-gray-400">—</p>
          <% end %>
        </div>
    </div>
  </div>

  <section class="space-y-4">
    <div>
      <h2 class="text-base font-semibold text-gray-900 dark:text-white">From the roll</h2>
      <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Male, female, and other electors read from the roll PDF.</p>
    </div>
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
      <% [ [ "Male", @booth.male_electors ], [ "Female", @booth.female_electors ], [ "Others", @booth.other_electors ] ].each do |label, count| %>
        <div class="rounded-lg border border-gray-200 bg-white px-5 py-4 shadow-sm dark:border-gray-800 dark:bg-gray-950">
          <p class="text-xs font-medium uppercase text-gray-500 dark:text-gray-400"><%= label %></p>
          <p class="mt-1 text-2xl font-semibold tabular-nums text-gray-900 dark:text-white"><%= count.nil? ? "—" : count %></p>
        </div>
      <% end %>
    </div>

    <div>
      <h2 class="text-base font-semibold text-gray-900 dark:text-white">Voters on file</h2>
      <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Counted from the voters stored for this booth.</p>
    </div>
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
      <% [ [ "Male", :male, @booth.male_electors ], [ "Female", :female, @booth.female_electors ], [ "Others", :others, @booth.other_electors ] ].each do |label, key, roll_count| %>
        <% actual = @gender_counts[key] %>
        <% mismatch = !roll_count.nil? && actual != roll_count %>
        <div class="rounded-lg border bg-white px-5 py-4 shadow-sm dark:bg-gray-950 <%= mismatch ? "border-amber-300 dark:border-amber-700" : "border-gray-200 dark:border-gray-800" %>">
          <p class="text-xs font-medium uppercase text-gray-500 dark:text-gray-400"><%= label %></p>
          <p class="mt-1 text-2xl font-semibold tabular-nums text-gray-900 dark:text-white"><%= actual %></p>
          <% if mismatch %>
            <p class="mt-1 text-xs font-medium text-amber-700 dark:text-amber-300">Does not match the roll</p>
          <% end %>
        </div>
      <% end %>
    </div>
    <% if @gender_counts[:unspecified].positive? %>
      <p class="text-sm text-gray-500 dark:text-gray-400"><%= pluralize(@gender_counts[:unspecified], "voter") %> with no gender <%= @gender_counts[:unspecified] == 1 ? "is" : "are" %> not included above.</p>
    <% end %>
  </section>

  <div class="campaign-sheet">
    <div class="border-b border-gray-200 px-5 py-4 dark:border-gray-800">
      <h2 class="text-base font-semibold text-gray-900 dark:text-white/90">Voters</h2>
      <p class="mt-1 text-sm text-gray-500 dark:text-gray-400"><%= @voter_total %> registered at this booth</p>
    </div>
    <%= render "console/filters", url: console_booth_path(@booth), fields: [
          [ :voter_id, "Voter ID" ],
          [ :sr_no, "Sr no" ],
          [ :name, "Name" ],
          [ :age, "Age" ],
          [ :gender, "Gender", [ [ "Male", "Male" ], [ "Female", "Female" ], [ "Others", "Others" ] ] ],
          [ :house_no, "House no" ]
        ] %>
    <div class="overflow-x-auto">
      <table class="campaign-table w-full text-sm">
        <thead class="border-b border-gray-200 text-left text-gray-500 dark:border-gray-800 dark:text-gray-400">
          <tr>
            <th class="px-5 py-3 font-medium">Sr no</th>
            <th class="px-5 py-3 font-medium">Voter ID</th>
            <th class="px-5 py-3 font-medium">Name</th>
            <th class="px-5 py-3 font-medium">Age</th>
            <th class="px-5 py-3 font-medium">Gender</th>
            <th class="px-5 py-3 font-medium">House no</th>
          </tr>
        </thead>
        <tbody>
          <% @voters.each do |voter| %>
            <tr class="border-b border-gray-100 last:border-0 dark:border-gray-800">
              <td class="px-5 py-3 tabular-nums text-gray-700 dark:text-gray-300"><%= voter.sr_no || "—" %></td>
              <td class="px-5 py-3"><%= link_to voter.voter_id, console_voter_path(voter), class: ta_text_link %></td>
              <td class="px-5 py-3 text-gray-700 dark:text-gray-300"><%= voter.name %></td>
              <td class="px-5 py-3 text-gray-700 dark:text-gray-300"><%= voter.age || "—" %></td>
              <td class="px-5 py-3 text-gray-700 dark:text-gray-300"><%= voter.gender.presence || "—" %></td>
              <td class="px-5 py-3 text-gray-700 dark:text-gray-300"><%= voter.house_no.presence || "—" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
      <% if @voters.empty? %>
        <p class="px-5 py-10 text-center text-sm text-gray-400"><%= voter_filters.values.any?(&:present?) ? "No voters match." : "No voters yet." %></p>
      <% end %>
    </div>
    <%= render "ui/pagination", pagy: @pagy %>
  </div>
</div>
