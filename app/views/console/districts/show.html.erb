<% content_for :title, @record.name %>
<% breadcrumb "Districts", console_districts_path %>
<% breadcrumb @record.name %>

<%= render layout: "ui/campaign_hero", locals: { kicker: "Platform Console", title: @record.name, subtitle: @record.state.name } do %><% end %>
<div class="mt-4 mb-6 flex justify-end">
  <%= icon_action_link :edit, edit_console_district_path(@record) %>
</div>

<div class="<%= ta_card_classes %> mb-6 p-6">
  <dl class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    <div>
      <dt class="text-xs font-medium uppercase text-gray-500 dark:text-gray-400">State</dt>
      <dd class="mt-1 text-sm text-gray-800 dark:text-white/90"><%= @record.state.name %></dd>
    </div>
    <div>
      <dt class="text-xs font-medium uppercase text-gray-500 dark:text-gray-400">Code</dt>
      <dd class="mt-1 text-sm text-gray-800 dark:text-white/90"><%= @record.cd.presence || "—" %></dd>
    </div>
    <div>
      <dt class="text-xs font-medium uppercase text-gray-500 dark:text-gray-400">Talukas</dt>
      <dd class="mt-1 text-sm text-gray-800 dark:text-white/90"><%= @taluka_total %></dd>
    </div>
    <div>
      <dt class="text-xs font-medium uppercase text-gray-500 dark:text-gray-400">Loksabhas</dt>
      <dd class="mt-1 text-sm text-gray-800 dark:text-white/90"><%= @loksabha_total %></dd>
    </div>
  </dl>
</div>

<div class="campaign-sheet mb-6">
  <div class="flex items-center justify-between gap-3 border-b border-gray-200 px-5 py-4 dark:border-gray-800">
    <h2 class="text-base font-semibold text-gray-900 dark:text-white/90">Talukas</h2>
    <%= link_to "New Taluka", new_console_taluka_path(district_id: @record.id), class: ta_btn_primary %>
  </div>
  <%= render "console/filters",
        url: console_district_path(@record),
        fields: [ [ :taluka_id, "Taluka", @taluka_choices.map { |taluka| [ taluka.name, taluka.id ] } ] ] %>
  <div class="overflow-x-auto">
    <table class="campaign-table w-full text-sm">
      <thead class="border-b border-gray-200 text-left text-gray-500 dark:border-gray-800 dark:text-gray-400">
        <tr>
          <th class="px-5 py-3 font-medium">Name</th>
          <th class="px-5 py-3 font-medium">Villages</th>
          <th class="px-5 py-3"></th>
        </tr>
      </thead>
      <tbody>
        <% @talukas.each do |taluka| %>
          <tr class="border-b border-gray-100 last:border-0 dark:border-gray-800">
            <td class="px-5 py-3 text-gray-700 dark:text-gray-300"><%= link_to taluka.name, console_taluka_path(taluka), class: ta_text_link %></td>
            <td class="px-5 py-3 text-gray-700 dark:text-gray-300"><%= taluka.villages_count %></td>
            <td class="px-5 py-3 text-right whitespace-nowrap">
              <%= icon_action_link :edit, edit_console_taluka_path(taluka) %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <% if @talukas.empty? %>
      <p class="px-5 py-10 text-center text-sm text-gray-400"><%= taluka_filters.values.any?(&:present?) ? "No talukas match." : "No talukas yet." %></p>
    <% end %>
  </div>
</div>

<div class="campaign-sheet">
  <div class="border-b border-gray-200 px-5 py-4 dark:border-gray-800">
    <h2 class="text-base font-semibold text-gray-900 dark:text-white/90">Loksabhas</h2>
  </div>
  <div class="overflow-x-auto">
    <table class="campaign-table w-full text-sm">
      <thead class="border-b border-gray-200 text-left text-gray-500 dark:border-gray-800 dark:text-gray-400">
        <tr>
          <th class="px-5 py-3 font-medium">Name</th>
          <th class="px-5 py-3 font-medium">Constituency no</th>
          <th class="px-5 py-3 font-medium">Assemblies</th>
        </tr>
      </thead>
      <tbody>
        <% @loksabhas.each do |loksabha| %>
          <tr class="border-b border-gray-100 last:border-0 dark:border-gray-800">
            <td class="px-5 py-3 text-gray-700 dark:text-gray-300"><%= link_to loksabha.name, console_loksabha_path(loksabha), class: ta_text_link %></td>
            <td class="px-5 py-3 text-gray-700 dark:text-gray-300"><%= loksabha.constituency_no %></td>
            <td class="px-5 py-3 text-gray-700 dark:text-gray-300"><%= loksabha.assemblies_count %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <% if @loksabhas.empty? %>
      <p class="px-5 py-10 text-center text-sm text-gray-400">No loksabhas yet.</p>
    <% end %>
  </div>
</div>
