<% columns = case fields.size
     when 0..2 then "sm:grid-cols-2"
     when 3..4 then "sm:grid-cols-2 xl:grid-cols-4"
     else "sm:grid-cols-2 lg:grid-cols-3"
     end %>
<% active = fields.any? { |name, _label| params[name].present? } %>
<div class="border-b border-gray-200 px-5 py-3 dark:border-gray-800">
  <%= form_with url: url, method: :get, class: "flex flex-col gap-2 lg:flex-row lg:items-end" do %>
    <div class="grid min-w-0 flex-1 grid-cols-1 gap-2 <%= columns %>">
      <% fields.each do |name, label| %>
        <%= text_field_tag name, params[name],
              placeholder: label,
              aria: { label: label },
              autocomplete: "off",
              class: "h-10 w-full rounded-lg border border-gray-200 bg-gray-50 px-3 text-sm text-gray-800 placeholder:text-gray-400 focus:border-brand-300 focus:bg-white focus:ring-3 focus:ring-brand-500/10 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/90 dark:placeholder:text-gray-500 dark:focus:bg-gray-900" %>
      <% end %>
    </div>
    <div class="flex shrink-0 items-center gap-1">
      <%= submit_tag "Search", class: "campaign-btn inline-flex h-10 cursor-pointer items-center justify-center rounded-lg px-4 text-sm font-medium text-white transition" %>
      <% if active %>
        <%= link_to "Clear", url, class: "inline-flex h-10 items-center rounded-lg px-3 text-sm font-medium text-gray-500 transition hover:bg-white hover:text-gray-800 dark:text-gray-400 dark:hover:bg-white/5 dark:hover:text-white/90" %>
      <% end %>
    </div>
  <% end %>
  <% if local_assigns[:hint].present? %>
    <p class="mt-2 text-xs text-gray-500 dark:text-gray-400"><%= hint %></p>
  <% end %>
</div>
