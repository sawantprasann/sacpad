<% content_for :title, managed_title.pluralize %>
<div class="mb-6 flex items-center justify-between">
  <h1 class="<%= ta_page_title %>"><%= managed_title.pluralize %></h1>
  <%= link_to "New #{managed_title}", url_for(action: :new), class: ta_btn_primary %>
</div>

<div class="<%= ta_card_classes %> overflow-hidden">
  <div class="overflow-x-auto">
    <table class="w-full text-sm">
      <thead class="border-b border-gray-200 text-left text-gray-500 dark:border-gray-800 dark:text-gray-400">
        <tr>
          <% managed_fields.each { |f| %><th class="px-5 py-3 font-medium"><%= f.to_s.humanize %></th><% } %>
          <th class="px-5 py-3"></th>
        </tr>
      </thead>
      <tbody>
        <% @records.each do |record| %>
          <tr class="border-b border-gray-100 last:border-0 dark:border-gray-800">
            <% managed_fields.each { |f| %><td class="px-5 py-3 text-gray-700 dark:text-gray-300"><%= record.public_send(f) %></td><% } %>
            <td class="px-5 py-3 text-right whitespace-nowrap">
              <% if record.is_a?(Loksabha) %>
                <%= button_to "Fetch data", fetch_roll_console_loksabha_path(record),
                      method: :post,
                      class: "mr-3 text-brand-500 hover:text-brand-600",
                      form: { style: "display:inline" },
                      data: { turbo_confirm: "Fetch assemblies, villages, booths, and voters for #{record.name}?", turbo_submits_with: "Fetching…" } %>
              <% elsif record.is_a?(Assembly) %>
                <%= button_to "Sync", sync_voters_console_assembly_path(record),
                      method: :post,
                      class: "mr-3 text-brand-500 hover:text-brand-600",
                      form: { style: "display:inline" },
                      data: { turbo_confirm: "Sync voters for #{record.name}? This reads each booth PDF in the background.", turbo_submits_with: "Syncing…" } %>
              <% end %>
              <%= link_to "Edit", url_for(action: :edit, id: record), class: "text-brand-500 hover:text-brand-600" %>
              <%= button_to "Delete", url_for(action: :destroy, id: record), method: :delete,
                    class: "ml-3 text-error-500 hover:text-error-600", form: { style: "display:inline" } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <% if @records.empty? %>
      <p class="px-5 py-10 text-center text-sm text-gray-400">No <%= managed_title.pluralize.downcase %> yet.</p>
    <% end %>
  </div>
</div>
