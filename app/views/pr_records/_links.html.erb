<% urls = record.entries.flat_map { |entry| entry.links.map(&:url) }.select(&:present?) %>
<% urls = record.entries.map(&:url).select(&:present?) if urls.empty? %>
<% if urls.any? %>
  <div class="space-y-1">
    <% urls.each do |url| %>
      <%= link_to truncate(url, length: 48), url, target: "_blank", rel: "noopener noreferrer", title: url, class: "#{ta_text_link} break-all text-sm" %>
    <% end %>
  </div>
<% else %>
  <span class="text-gray-400">—</span>
<% end %>
