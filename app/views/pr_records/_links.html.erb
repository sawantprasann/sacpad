<% urls = pr_entry_urls(entry) %>
<% if urls.any? %>
  <div class="space-y-1">
    <% urls.each do |url| %>
      <%= link_to pr_link_label(url), url, target: "_blank", rel: "noopener noreferrer", title: url, class: "#{ta_text_link} break-all text-sm" %>
    <% end %>
  </div>
<% else %>
  <span class="text-gray-400">—</span>
<% end %>
