<% urls = record.links.map(&:url).select(&:present?) %>
<% urls = [ record.url ] if urls.empty? && record.url.present? %>
<% if urls.any? %>
  <div class="space-y-1">
    <% urls.each do |url| %>
      <%= link_to truncate(url, length: 48), url, target: "_blank", rel: "noopener noreferrer", title: url, class: "#{ta_text_link} break-all text-sm" %>
    <% end %>
  </div>
<% else %>
  <span class="text-gray-400">—</span>
<% end %>