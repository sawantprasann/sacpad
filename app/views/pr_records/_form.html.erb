<% action_label = @record.persisted? ? t("common.save_changes") : t("pr.log_generic") %>
<div class="mt-6 <%= ta_card_classes %> p-6 md:p-8"
     data-controller="pr-record-form"
     data-pr-record-form-thumbnail-url-value="<%= thumbnail_pr_records_path %>"
     data-action="change->pr-record-form#categoryChanged"
     data-pr-record-form-checking-value="<%= t("pr.checking") %>"
     data-pr-record-form-no-thumbnail-value="<%= t("pr.no_thumbnail") %>"
     data-pr-record-form-thumbnail-filled-value="<%= t("pr.thumbnail_filled") %>"
     data-pr-record-form-choose-first-value="<%= t("pr.choose_category_first") %>">
  <%= form_with model: @record, multipart: true do |f| %>
    <% if @record.errors.any? %>
      <div class="mb-6 rounded-lg border border-error-500/30 bg-error-50 px-4 py-2 text-sm text-error-500"><%= @record.errors.full_messages.to_sentence %></div>
    <% end %>

    <div class="mb-6">
      <%= f.label :title, t("pr.headline"), class: ta_label_classes %>
      <%= f.text_field :title, class: "#{ta_field_classes} min-h-11", autofocus: true %>
    </div>

    <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
      <p class="text-sm text-gray-500 dark:text-gray-400"><%= t("pr.add_category_hint") %></p>
      <button type="button" class="<%= ta_btn_primary %> min-h-11 cursor-pointer" data-action="pr-record-form#addEntry"
              style="background: var(--org-party-color); color: var(--org-party-contrast)"><%= t("pr.add_category") %></button>
      <p data-pr-record-form-target="categoryNotice" class="hidden w-full text-sm text-error-500"></p>
    </div>

    <div class="space-y-4">
      <div data-pr-record-form-target="newEntryRows" class="space-y-4 empty:hidden"></div>
      <div data-pr-record-form-target="entryRows" class="space-y-4 empty:hidden">
        <%= f.fields_for :entries do |entry_form| %>
          <%= render "pr_records/entry_fields", f: entry_form %>
        <% end %>
      </div>
    </div>

    <% template_entry = PrRecordEntry.new(published_on: Date.current, sentiment: :neutral) %>
    <% template_entry.links.build %>
    <% template_entry.outdoor_ad_counts.build %>
    <template data-pr-record-form-target="entryTemplate">
      <%= f.fields_for :entries, template_entry, child_index: "__ENTRY__" do |entry_form| %>
        <%= render "pr_records/entry_fields", f: entry_form %>
      <% end %>
    </template>

    <div class="mt-6 flex flex-wrap gap-3 border-t border-gray-100 pt-6 dark:border-gray-800">
      <button type="submit" class="<%= ta_btn_primary %> min-h-11 cursor-pointer"
              style="background: var(--org-party-color); color: var(--org-party-contrast)"><%= action_label %></button>
      <%= link_to t("common.cancel"), (@record.persisted? ? pr_record_path(@record) : pr_records_path), class: "#{ta_btn_secondary} inline-flex min-h-11 items-center" %>
    </div>
  <% end %>
</div>
