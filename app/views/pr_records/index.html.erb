<% content_for :title, @category ? "PR Records — #{@category.name}" : "PR Records" %>
<% new_path = @category ? new_pr_record_path(category: @category.slug) : new_pr_record_path %>
<% th = "border-b border-gray-200 px-6 py-3 text-left text-xs font-medium text-gray-500 dark:border-gray-800 dark:text-gray-400" %>
<% td = "border-b border-gray-100 px-6 py-4 align-middle dark:border-gray-800" %>

<div class="mb-6 flex flex-wrap items-center justify-between gap-4">
  <div class="min-w-0">
    <h1 class="<%= ta_page_title %>">PR Records</h1>
    <p class="mt-1 text-sm text-gray-500 dark:text-gray-400"><%= @category ? "#{@category.name} — " : "" %><%= pluralize(@pagy.count, "record") %></p>
  </div>
  <%= render "ui/module_toolbar",
        export_url: pr_records_path(format: :xlsx, category: @category&.slug),
        new_url: (new_path if current_user.role.can_write?("pr")),
        new_label: (@category ? "Log #{@category.name}" : "Log record") %>
</div>

<% if @category %>
  <div class="<%= ta_card_classes %> overflow-hidden">
    <div class="hidden xl:block">
      <table class="w-full text-sm">
        <thead class="bg-gray-50 dark:bg-white/[0.03]">
          <tr>
            <th class="<%= th %>">Title</th>
            <th class="<%= th %>">Platform</th>
            <th class="<%= th %>">Sentiment</th>
            <th class="<%= th %>">Logged by</th>
            <th class="<%= th %> text-right">Published</th>
            <th class="<%= th %> w-12"><span class="sr-only">Open</span></th>
          </tr>
        </thead>
        <tbody>
          <% @records.each do |record| %>
            <tr class="group hover:bg-gray-50 last:[&>td]:border-b-0 dark:hover:bg-white/[0.03]">
              <td class="<%= td %> max-w-xs">
                <%= link_to record.title, pr_record_path(record),
                      class: "font-medium text-gray-900 dark:text-white/90" %>
              </td>
              <td class="<%= td %> text-gray-600 dark:text-gray-300"><%= record.media_platform&.name || record.media_platform_name %></td>
              <td class="<%= td %>">
                <span class="inline-flex items-center px-2 py-1 text-xs font-medium rounded-full
                  <%= record.sentiment == 'positive' ? 'bg-green-100 text-green-800 dark:bg-green-900/20 dark:text-green-400' : record.sentiment == 'negative' ? 'bg-red-100 text-red-800 dark:bg-red-900/20 dark:text-red-400' : 'bg-gray-100 text-gray-800 dark:bg-gray-800 dark:text-gray-300' %>">
                  <%= record.sentiment.humanize %>
                </span>
              </td>
              <td class="<%= td %> text-gray-700 dark:text-gray-300"><%= record.owner.name %></td>
              <td class="<%= td %> text-right tabular-nums text-gray-500"><%= record.published_on.strftime("%d %b %Y") %></td>
              <td class="<%= td %> text-right">
                <%= link_to pr_record_path(record), class: "inline-flex text-gray-300 group-hover:text-gray-500", aria: { label: "Open #{record.title}" } do %>
                  <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd"/></svg>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
      <% if @records.empty? %>
        <p class="px-6 py-16 text-center text-sm text-gray-400">No records yet.</p>
      <% end %>
    </div>

    <div class="divide-y divide-gray-100 xl:hidden dark:divide-gray-800">
      <% @records.each do |record| %>
        <%= link_to pr_record_path(record), class: "block px-6 py-4 hover:bg-gray-50 dark:hover:bg-white/[0.03]" do %>
          <div class="flex items-start justify-between gap-3">
            <div class="min-w-0">
              <p class="truncate font-medium text-gray-900 dark:text-white/90"><%= record.title %></p>
              <p class="mt-1 text-xs text-gray-500"><%= record.record_number %></p>
            </div>
            <span class="inline-flex items-center px-2 py-1 text-xs font-medium rounded-full shrink-0
              <%= record.sentiment == 'positive' ? 'bg-green-100 text-green-800 dark:bg-green-900/20 dark:text-green-400' : record.sentiment == 'negative' ? 'bg-red-100 text-red-800 dark:bg-red-900/20 dark:text-red-400' : 'bg-gray-100 text-gray-800 dark:bg-gray-800 dark:text-gray-300' %>">
              <%= record.sentiment.humanize %>
            </span>
          </div>
          <p class="mt-2 text-sm text-gray-600 dark:text-gray-300"><strong><%= record.media_platform&.name || record.media_platform_name %></strong></p>
          <p class="mt-2 text-xs text-gray-500"><%= record.owner.name %> · <%= record.published_on.strftime("%d %b %Y") %></p>
        <% end %>
      <% end %>
      <% if @records.empty? %>
        <p class="px-6 py-16 text-center text-sm text-gray-400">No records yet.</p>
      <% end %>
    </div>

    <% if @pagy.last > 1 %>
      <div class="flex items-center justify-between border-t border-gray-100 bg-white px-6 py-4 dark:border-gray-800 dark:bg-white/[0.02]">
        <div>
          <% if @pagy.previous %>
            <%= link_to "← Previous", pr_records_path(category: @category.slug, page: @pagy.previous), class: "#{ta_btn_secondary}" %>
          <% else %>
            <button class="text-gray-300 cursor-not-allowed">← Previous</button>
          <% end %>
        </div>
        <p class="text-sm font-medium text-gray-600 dark:text-gray-400">Page <span class="tabular-nums"><%= @pagy.page %></span> of <span class="tabular-nums"><%= @pagy.last %></span></p>
        <div>
          <% if @pagy.next %>
            <%= link_to "Next →", pr_records_path(category: @category.slug, page: @pagy.next), class: "#{ta_btn_secondary}" %>
          <% else %>
            <button class="text-gray-300 cursor-not-allowed">Next →</button>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="<%= ta_card_classes %> p-12 text-center">
    <p class="text-gray-500 dark:text-gray-400">Select a category from the sidebar to view records.</p>
  </div>
<% end %>
