<% content_for :title, @category ? "#{t("pr.kicker")} — #{@category.name}" : t("pr.kicker") %>
<% list_params = request.query_parameters.slice("category", "q") %>
<% th = "border-b border-gray-200 px-6 py-3 text-left text-xs font-medium text-gray-500 dark:border-gray-800 dark:text-gray-400" %>
<% td = "border-b border-gray-100 px-6 py-4 align-middle dark:border-gray-800" %>
<% sub = "border-b border-gray-100 px-6 py-3 align-middle dark:border-gray-800" %>

<%= render layout: "ui/campaign_hero", locals: {
      kicker: t("pr.kicker"),
      title: t("pr.kicker"),
      subtitle: [ @category&.name, t("pr.count_label", count: @pagy.count) ].compact.join(" · "),
      meta: current_user.organization.name
    } do %><% end %>

<div class="mt-4 flex flex-wrap items-center justify-end gap-2">
  <%= render "ui/module_toolbar",
        export_url: pr_records_path(list_params.merge(format: :xlsx)),
        new_url: (new_pr_record_path(category: @category&.slug) if current_user.role.can_write?("pr")),
        new_label: t("pr.log_record"),
        accent: org_accent_color,
        accent_ink: org_accent_foreground %>
</div>

<%= form_with url: pr_records_path, method: :get, class: "mt-6 #{ta_card_classes} p-4 md:p-5" do %>
  <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
    <div>
      <%= label_tag :category, t("common.category"), class: ta_label_classes %>
      <%= select_tag :category,
            options_from_collection_for_select(@categories, :slug, :name, params[:category]),
            include_blank: t("pr.any_category"),
            class: ta_field_classes %>
    </div>
    <div>
      <%= label_tag :q, t("common.title"), class: ta_label_classes %>
      <%= text_field_tag :q, params[:q], class: ta_field_classes, placeholder: t("pr.search_placeholder") %>
    </div>
    <div class="flex items-end gap-2">
      <button type="submit" class="<%= ta_btn_primary %> min-h-11 cursor-pointer"
              style="background: var(--org-party-color); color: var(--org-party-contrast)"><%= t("common.filter") %></button>
      <%= link_to t("common.clear"), pr_records_path, class: "#{ta_btn_secondary} inline-flex min-h-11 items-center" %>
    </div>
  </div>
<% end %>

<div class="mt-6 <%= ta_card_classes %> overflow-hidden">
  <div class="hidden xl:block">
    <table class="w-full text-sm">
      <thead class="bg-gray-50 dark:bg-white/[0.03]">
        <tr>
          <th class="<%= th %>"><%= t("common.title") %></th>
          <th class="<%= th %>"><%= t("common.category") %></th>
          <th class="<%= th %>"><%= t("pr.platform") %></th>
          <th class="<%= th %>"><%= t("pr.links") %></th>
          <th class="<%= th %>"><%= t("common.sentiment") %></th>
          <th class="<%= th %> text-right"><%= t("pr.published") %></th>
        </tr>
      </thead>
      <tbody>
        <% @records.each_with_index do |record, record_index| %>
          <% entries = pr_index_entries(record, @category) %>
          <% band = record_index.even? ? "bg-white dark:bg-transparent" : "bg-gray-50/70 dark:bg-white/[0.02]" %>
          <% entries.each_with_index do |entry, index| %>
            <tr class="<%= band %> hover:bg-gray-50 dark:hover:bg-white/[0.04]">
              <% if index.zero? %>
                <td rowspan="<%= entries.size %>" class="<%= td %> max-w-xs align-top <%= band %>">
                  <%= link_to record.title, pr_record_path(record), class: ta_text_link %>
                  <p class="mt-1 text-xs text-gray-500 dark:text-gray-400"><%= t("common.logged_by") %> · <%= record.owner.name %></p>
                </td>
              <% end %>
              <td class="<%= sub %> text-gray-700 dark:text-gray-300"><%= entry.pr_category.name %></td>
              <td class="<%= sub %> text-gray-600 dark:text-gray-300"><%= entry.platform_name.presence || "—" %></td>
              <td class="<%= sub %> max-w-xs"><%= render "pr_records/links", entry: entry %></td>
              <td class="<%= sub %>"><%= render "ui/badge", label: t("pr.sentiments.#{entry.sentiment}"), tone: pr_sentiment_tone(entry.sentiment) %></td>
              <td class="<%= sub %> text-right tabular-nums text-gray-500"><%= l_day(entry.published_on) %></td>
            </tr>
          <% end %>
        <% end %>
      </tbody>
    </table>
    <% if @records.empty? %>
      <p class="px-6 py-16 text-center text-sm text-gray-400"><%= t("pr.none") %></p>
    <% end %>
  </div>

  <div class="divide-y divide-gray-100 xl:hidden dark:divide-gray-800">
    <% @records.each do |record| %>
      <div class="px-6 py-4">
        <%= link_to record.title, pr_record_path(record), class: ta_text_link %>
        <p class="mt-1 text-xs text-gray-500"><%= t("common.logged_by") %> · <%= record.owner.name %></p>
        <ul class="mt-3 divide-y divide-gray-100 overflow-hidden rounded-xl border border-gray-100 dark:divide-gray-800 dark:border-gray-800">
          <% pr_index_entries(record, @category).each do |entry| %>
            <li class="px-3 py-3">
              <div class="flex items-start justify-between gap-3">
                <p class="text-sm font-medium text-gray-800 dark:text-white/90"><%= entry.pr_category.name %></p>
                <%= render "ui/badge", label: t("pr.sentiments.#{entry.sentiment}"), tone: pr_sentiment_tone(entry.sentiment) %>
              </div>
              <p class="mt-1 text-sm text-gray-600 dark:text-gray-300">
                <%= [ entry.platform_name.presence || t("pr.no_platform"), l_day(entry.published_on) ].compact.join(" · ") %>
              </p>
              <div class="mt-2"><%= render "pr_records/links", entry: entry %></div>
            </li>
          <% end %>
        </ul>
      </div>
    <% end %>
    <% if @records.empty? %>
      <p class="px-6 py-16 text-center text-sm text-gray-400"><%= t("pr.none") %></p>
    <% end %>
  </div>

  <%= render "ui/pagination", pagy: @pagy %>
</div>
