<% content_for :title, "#{@record.title} · #{@record.record_number}" %>
<% categories = @record.entries.map(&:pr_category).uniq %>
<% dates = @record.entries.filter_map(&:published_on) %>
<% list_path = categories.one? ? pr_records_path(category: categories.first.slug) : pr_records_path %>
<% breadcrumb t("nav.pr_records"), pr_records_path %>
<% breadcrumb categories.first.name, list_path if categories.one? %>
<% breadcrumb @record.title %>
<% meta = if dates.map(&:to_date).uniq.many?
     t("pr.published_range", from: l_day(dates.min), to: l_day(dates.max), owner: @record.owner.name)
   elsif dates.any?
     t("pr.published_meta", date: l_day(dates.first), owner: @record.owner.name)
   else
     @record.owner.name
   end %>

<%= render layout: "ui/campaign_hero", locals: {
      kicker: t("pr.kicker"),
      title: @record.title,
      subtitle: [ @record.record_number, @record.category_names.join(", ") ].compact_blank.join(" · "),
      meta: meta
    } do %><% end %>

<div class="mt-4 mb-4 flex flex-wrap items-center justify-end gap-2">
  <% if policy(@record).edit? %>
    <%= icon_action_link :edit, edit_pr_record_path(@record) %>
  <% end %>
  <%= link_to t("common.back_to_list"), list_path, class: "#{ta_btn_secondary} min-h-11 cursor-pointer" %>
</div>

<div class="grid grid-cols-1 items-start gap-4 xl:grid-cols-3">
  <div class="order-2 space-y-4 xl:order-1 xl:col-span-2">
    <% @record.entries.each_with_index do |entry, index| %>
      <%= render "pr_records/entry", entry: entry, index: index + 1 %>
    <% end %>
  </div>

  <aside class="order-1 xl:order-2">
    <section class="<%= ta_card_classes %> p-6">
      <h2 class="border-b border-gray-100 pb-3 text-sm font-semibold text-gray-800 dark:border-gray-800 dark:text-white/90"><%= t("pr.where_appeared") %></h2>
      <ol class="mt-4 space-y-3">
        <% @record.entries.each_with_index do |entry, index| %>
          <li>
            <%= link_to "#pr-entry-#{entry.id}", class: "flex items-start gap-3 rounded-xl bg-gray-50 px-4 py-3 hover:bg-gray-100 dark:bg-white/[0.03] dark:hover:bg-white/[0.06]" do %>
              <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-white text-xs font-semibold text-gray-700 ring-1 ring-gray-200 dark:bg-gray-900 dark:text-white/90 dark:ring-gray-700"><%= index + 1 %></span>
              <span class="min-w-0 flex-1">
                <span class="flex items-start justify-between gap-3">
                  <span class="text-sm font-medium text-gray-800 dark:text-white/90"><%= entry.pr_category.name %></span>
                  <%= render "ui/badge", label: t("pr.sentiments.#{entry.sentiment}"), tone: pr_sentiment_tone(entry.sentiment) %>
                </span>
                <span class="mt-1 block text-sm text-gray-500 dark:text-gray-400">
                  <%= [ entry.platform_name, l_day(entry.published_on) ].compact.join(" · ") %>
                </span>
              </span>
            <% end %>
          </li>
        <% end %>
      </ol>
      <p class="mt-4 border-t border-gray-100 pt-4 text-sm text-gray-500 dark:border-gray-800 dark:text-gray-400">
        <%= t("common.logged_by") %> · <%= @record.owner.name %>
      </p>
    </section>
  </aside>
</div>
