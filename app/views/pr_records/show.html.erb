<% content_for :title, "#{@record.title} · #{@record.record_number}" %>
<% list_path = pr_records_path(category: @record.pr_category.slug) %>
<% breadcrumb "PR Records", pr_records_path %>
<% breadcrumb @record.pr_category.name, list_path %>
<% breadcrumb @record.title %>
<% field = "rounded-xl bg-gray-50 px-4 py-3 dark:bg-white/[0.03]" %>
<% label = "text-xs font-medium tracking-wide text-gray-400 uppercase" %>
<% section = "border-b border-gray-100 pb-3 text-sm font-semibold text-gray-800 dark:border-gray-800 dark:text-white/90" %>

<%= render layout: "ui/campaign_hero", locals: {
      kicker: "PR Records",
      title: @record.title,
      subtitle: [ @record.record_number, @record.pr_category.name, @record.sentiment.humanize ].compact.join(" · "),
      meta: "Published #{@record.published_on.strftime("%d %b %Y")} · #{@record.owner.name}"
    } do %><% end %>

<div class="mt-4 mb-4 flex flex-wrap items-center justify-end gap-2">
  <% if policy(@record).edit? %>
    <%= link_to "Edit", edit_pr_record_path(@record), class: "#{ta_btn_secondary} min-h-11 cursor-pointer" %>
  <% end %>
  <%= link_to "Back to list", list_path, class: "#{ta_btn_secondary} min-h-11 cursor-pointer" %>
</div>

<div class="grid grid-cols-1 items-start gap-4 xl:grid-cols-3">
  <div class="space-y-4 xl:col-span-2">
    <section class="<%= ta_card_classes %> p-6">
      <h2 class="<%= section %>">Media Coverage</h2>
      <dl class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-2">
        <div class="<%= field %>">
          <dt class="<%= label %>">Platform</dt>
          <dd class="mt-1 text-sm text-gray-800 dark:text-white/90"><%= @record.media_platform&.name || @record.media_platform_name || "—" %></dd>
        </div>
        <div class="<%= field %>">
          <dt class="<%= label %>">Sentiment</dt>
          <dd class="mt-1 text-sm text-gray-800 dark:text-white/90"><%= @record.sentiment.humanize %></dd>
        </div>
        <div class="<%= field %> sm:col-span-2">
          <dt class="<%= label %>">URL</dt>
          <dd class="mt-1 text-sm text-gray-800 dark:text-white/90">
            <% if @record.url.present? %>
              <%= link_to truncate(@record.url, length: 60), @record.url, target: "_blank", rel: "noopener", class: "text-brand-500 hover:text-brand-600" %>
            <% else %>
              —
            <% end %>
          </dd>
        </div>
        <div class="<%= field %> sm:col-span-2">
          <dt class="<%= label %>">Details</dt>
          <dd class="mt-1 whitespace-pre-line text-sm text-gray-800 dark:text-white/90"><%= @record.description.presence || "—" %></dd>
        </div>
      </dl>
    </section>

    <% if @record.pr_category.slug == "outdoor-media" && @record.outdoor_ad_counts.any? %>
      <section class="<%= ta_card_classes %> p-6">
        <h2 class="<%= section %>">Outdoor Ad Placements</h2>
        <div class="mt-4 space-y-2">
          <% @record.outdoor_ad_counts.each do |count| %>
            <div class="flex justify-between rounded-lg bg-gray-50 px-4 py-2 dark:bg-white/[0.03]">
              <span class="text-sm font-medium text-gray-800 dark:text-white/90"><%= count.outdoor_ad_type.name %></span>
              <span class="text-sm tabular-nums font-semibold text-gray-600 dark:text-gray-400"><%= count.count %> placement<%= count.count == 1 ? "" : "s" %></span>
            </div>
          <% end %>
        </div>
      </section>
    <% end %>

    <% if @record.pr_category.slug == "podcasts-interviews" && @record.podcast %>
      <section class="<%= ta_card_classes %> p-6">
        <h2 class="<%= section %>">Podcast Recording</h2>
        <div class="<%= field %>">
          <dt class="<%= label %>">Recording Date</dt>
          <dd class="mt-1 text-sm text-gray-800 dark:text-white/90"><%= @record.podcast.recording_date.strftime("%d %b %Y") %></dd>
        </div>
      </section>
    <% end %>

    <section class="<%= ta_card_classes %> p-6">
      <h2 class="<%= section %>">Attachments</h2>
      <% if @record.attachments.attached? %>
        <div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-3">
          <% @record.attachments.each do |att| %>
            <% if att.image? %>
              <%= image_tag att, class: "aspect-square w-full rounded-xl object-cover" %>
            <% else %>
              <%= link_to att.filename, rails_blob_path(att, disposition: "attachment"), class: "text-sm text-brand-500 hover:text-brand-600" %>
            <% end %>
          <% end %>
        </div>
      <% else %>
        <p class="mt-4 rounded-xl border border-dashed border-gray-200 px-4 py-8 text-center text-sm text-gray-400 dark:border-gray-700">No attachments.</p>
      <% end %>
    </section>
  </div>
</div>
