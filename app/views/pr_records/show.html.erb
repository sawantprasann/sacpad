<% content_for :title, "#{@record.title} · #{@record.record_number}" %>
<% list_path = pr_records_path(category: @record.pr_category.slug) %>
<% breadcrumb t("nav.pr_records"), pr_records_path %>
<% breadcrumb @record.pr_category.name, list_path %>
<% breadcrumb @record.title %>
<% field = "rounded-xl bg-gray-50 px-4 py-3 dark:bg-white/[0.03]" %>
<% label = "text-xs font-medium tracking-wide text-gray-400 uppercase" %>
<% section = "border-b border-gray-100 pb-3 text-sm font-semibold text-gray-800 dark:border-gray-800 dark:text-white/90" %>

<%= render layout: "ui/campaign_hero", locals: {
      kicker: t("pr.kicker"),
      title: @record.title,
      subtitle: [ @record.record_number, @record.pr_category.name, t("pr.sentiments.#{@record.sentiment}") ].compact.join(" · "),
      meta: t("pr.published_meta", date: l_day(@record.published_on), owner: @record.owner.name)
    } do %><% end %>

<div class="mt-4 mb-4 flex flex-wrap items-center justify-end gap-2">
  <% if policy(@record).edit? %>
    <%= icon_action_link :edit, edit_pr_record_path(@record) %>
  <% end %>
  <%= link_to t("common.back_to_list"), list_path, class: "#{ta_btn_secondary} min-h-11 cursor-pointer" %>
</div>

<div class="grid grid-cols-1 items-start gap-4 xl:grid-cols-3">
  <div class="space-y-4 xl:col-span-2">
    <section class="<%= ta_card_classes %> p-6">
      <h2 class="<%= section %>"><%= t("pr.media_coverage") %></h2>
      <dl class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-2">
        <div class="<%= field %>">
          <dt class="<%= label %>"><%= t("pr.platform") %></dt>
          <dd class="mt-1 text-sm text-gray-800 dark:text-white/90"><%= @record.media_platform&.name || @record.media_platform_name || "—" %></dd>
        </div>
        <div class="<%= field %>">
          <dt class="<%= label %>"><%= t("common.sentiment") %></dt>
          <dd class="mt-1 text-sm text-gray-800 dark:text-white/90"><%= t("pr.sentiments.#{@record.sentiment}") %></dd>
        </div>
        <div class="<%= field %> sm:col-span-2">
          <dt class="<%= label %>"><%= t("pr.links") %></dt>
          <dd class="mt-2 space-y-3 text-sm text-gray-800 dark:text-white/90">
            <% links = @record.links.to_a %>
            <% if links.empty? && @record.url.present? %>
              <% links = [ Struct.new(:url, :thumbnail_url).new(@record.url, @record.thumbnail_url) ] %>
            <% end %>
            <% if links.any? %>
              <% links.each do |link| %>
                <div class="flex items-center gap-3">
                  <% if link.thumbnail_url.present? %>
                    <img src="<%= link.thumbnail_url %>" alt="" class="h-12 w-20 rounded object-cover">
                  <% end %>
                  <%= link_to truncate(link.url, length: 60), link.url, target: "_blank", rel: "noopener", class: ta_text_link %>
                </div>
              <% end %>
            <% else %>
              —
            <% end %>
          </dd>
        </div>
        <div class="<%= field %> sm:col-span-2">
          <dt class="<%= label %>"><%= t("common.details") %></dt>
          <dd class="mt-1 whitespace-pre-line text-sm text-gray-800 dark:text-white/90"><%= @record.description.presence || "—" %></dd>
        </div>
      </dl>
    </section>

    <% if @record.pr_category.slug == "outdoor-media" && @record.outdoor_ad_counts.any? %>
      <section class="<%= ta_card_classes %> p-6">
        <h2 class="<%= section %>"><%= t("pr.outdoor_title") %></h2>
        <div class="mt-4 space-y-2">
          <% @record.outdoor_ad_counts.each do |count| %>
            <div class="flex justify-between rounded-lg bg-gray-50 px-4 py-2 dark:bg-white/[0.03]">
              <span class="text-sm font-medium text-gray-800 dark:text-white/90"><%= count.outdoor_ad_type.name %></span>
              <span class="text-sm tabular-nums font-semibold text-gray-600 dark:text-gray-400"><%= t("pr.placements", count: count.count) %></span>
            </div>
          <% end %>
        </div>
      </section>
    <% end %>

    <% if @record.pr_category.slug == "podcasts" && @record.podcast %>
      <section class="<%= ta_card_classes %> p-6">
        <h2 class="<%= section %>"><%= t("pr.podcast") %></h2>
        <div class="<%= field %>">
          <dt class="<%= label %>"><%= t("pr.recording_date") %></dt>
          <dd class="mt-1 text-sm text-gray-800 dark:text-white/90"><%= l_day(@record.podcast.recording_date) %></dd>
        </div>
      </section>
    <% end %>

    <section class="<%= ta_card_classes %> p-6">
      <h2 class="<%= section %>"><%= t("common.attachments") %></h2>
      <% if @record.attachments.attached? %>
        <div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-3">
          <% @record.attachments.each do |att| %>
            <% if att.image? %>
              <%= image_tag att, class: "aspect-square w-full rounded-xl object-cover" %>
            <% else %>
              <%= link_to att.filename, rails_blob_path(att, disposition: "attachment"), class: "text-sm #{ta_text_link}" %>
            <% end %>
          <% end %>
        </div>
      <% else %>
        <p class="mt-4 rounded-xl border border-dashed border-gray-200 px-4 py-8 text-center text-sm text-gray-400 dark:border-gray-700"><%= t("common.no_attachments") %></p>
      <% end %>
    </section>
  </div>
</div>
