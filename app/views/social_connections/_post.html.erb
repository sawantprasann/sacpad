<% metric = metrics[target.id] %>
<% post = target.bulk_post %>
<% tone = case target.status
   when "published" then "bg-emerald-50 text-emerald-700 ring-emerald-200"
   when "failed" then "bg-red-50 text-red-700 ring-red-200"
   when "processing" then "bg-sky-50 text-sky-700 ring-sky-200"
   else "bg-gray-100 text-gray-600 ring-gray-200"
   end %>
<% figures = [
     [ "likes", t("social.metric_likes"), metric&.likes_count ],
     [ "comments", t("social.metric_comments"), metric&.comments_count ],
     [ "shares", t("social.metric_shares"), metric&.shares_count ],
     [ "views", t("social.metric_views"), metric&.views_count ]
   ] %>
<% figures = figures.reject { |key, _, value| key == "views" && value.nil? } %>
<% picture = target.provider_state.is_a?(Hash) ? target.provider_state["picture_url"].to_s : "" %>
<% picture = nil unless picture.start_with?("https://") %>
<% attached = post.images.attached? ? post.images.first(4) : [] %>

<article class="flex gap-4 rounded-2xl bg-white p-4 shadow-sm ring-1 ring-gray-200 dark:bg-gray-900 dark:ring-white/10">
  <% if attached.any? || picture %>
    <div class="grid shrink-0 grid-cols-2 gap-0.5 overflow-hidden rounded-xl bg-gray-100" style="width:6rem;height:6rem;">
      <% if attached.any? %>
        <% attached.each do |image| %>
          <%= image_tag image, alt: "", style: "width:100%;height:100%;object-fit:cover;#{"grid-column:1 / -1;grid-row:1 / -1;" if attached.one?}" %>
        <% end %>
      <% else %>
        <%= image_tag picture, alt: "", style: "width:100%;height:100%;object-fit:cover;grid-column:1 / -1;" %>
      <% end %>
    </div>
  <% end %>

  <div class="min-w-0 flex-1">
    <header class="flex items-center justify-between gap-3">
      <p class="text-xs text-gray-500"><%= l_stamp(target.published_at || target.created_at) %></p>
      <% unless target.status_published? %>
        <span class="inline-flex rounded-full px-2.5 py-1 text-[11px] font-semibold ring-1 ring-inset <%= tone %>"><%= t("social.target_status.#{target.status}") %></span>
      <% end %>
    </header>

    <% if post.title.present? %>
      <p class="mt-2 text-sm font-semibold text-gray-900 dark:text-white"><%= post.title %></p>
    <% end %>
    <% if post.body.present? %>
      <p class="mt-1 text-sm leading-5 text-gray-800 dark:text-gray-200" style="display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden;"><%= post.body %></p>
    <% elsif post.title.blank? && attached.empty? && picture.blank? && !post.video.attached? %>
      <p class="mt-1 text-sm text-gray-400"><%= t("social.unnamed") %></p>
    <% end %>
    <% if post.video.attached? %>
      <%= video_tag post.video, controls: true, style: "display:block;max-width:16rem;max-height:9rem;margin-top:0.75rem;border-radius:0.75rem;" %>
    <% end %>
    <% if target.status_failed? && target.error_message.present? %>
      <p class="mt-2 text-sm text-red-700"><%= target.error_message %></p>
    <% end %>

    <footer class="mt-3">
      <div class="flex flex-wrap items-center gap-x-4 gap-y-1">
        <% figures.each do |key, label, value| %>
          <p class="inline-flex items-baseline gap-1.5">
            <span class="text-sm font-semibold tabular-nums text-gray-900 dark:text-white" data-metric="<%= key %>"><%= value.nil? ? "—" : number_with_delimiter(value) %></span>
            <span class="text-xs text-gray-400"><%= label %></span>
          </p>
        <% end %>
      </div>
      <% if target.permalink.present? || policy(SocialMedia::SocialPage).publish? %>
        <% quiet = "inline-flex h-8 items-center justify-center rounded-lg border bg-white px-3 text-xs font-medium dark:bg-white/5" %>
        <% action = "#{quiet} border-gray-200 text-gray-700 hover:bg-gray-50 dark:border-gray-700 dark:text-gray-200" %>
        <div class="mt-3 flex flex-wrap items-center justify-end gap-2 border-t border-gray-100 pt-3 dark:border-white/10">
          <% if target.permalink.present? %>
            <%= link_to t("social.open_post"), target.permalink, target: "_blank", rel: "noopener", class: action %>
          <% end %>
          <% if policy(SocialMedia::SocialPage).publish? %>
            <%= link_to t("social.edit_post"), edit_social_post_path(post), class: action %>
            <%= button_to t("social.delete_post"), social_post_path(post), method: :delete,
                  form: { data: { turbo_confirm: t("social.delete_post_confirm") }, style: "display:inline-flex" },
                  class: "#{quiet} cursor-pointer border-red-200 text-red-700 hover:bg-red-50 dark:border-red-500/40 dark:text-red-300" %>
          <% end %>
        </div>
      <% end %>
    </footer>
  </div>
</article>
