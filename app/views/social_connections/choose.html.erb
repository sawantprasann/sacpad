<% content_for :title, t("social.choose_title") %>

<%= render layout: "ui/campaign_hero", locals: {
      kicker: t("social.kicker"),
      title: t("social.choose_title"),
      subtitle: t("social.choose_subtitle"),
      meta: current_user.organization.name
    } do %><% end %>

<%= form_with url: save_social_connections_path, method: :post, class: "mt-5", data: { controller: "filter-list" } do %>
  <%= hidden_field_tag :pending_id, @pending_id %>

  <div class="flex flex-col gap-3 rounded-3xl bg-white p-4 shadow-sm ring-1 ring-gray-200 sm:flex-row sm:items-center dark:bg-gray-900 dark:ring-white/10">
    <%= text_field_tag :page_query, nil,
          class: "h-11 flex-1 rounded-full border border-gray-200 bg-gray-50 px-4 text-sm outline-none focus:border-[var(--org-party-color)] focus:bg-white dark:border-white/10 dark:bg-white/5",
          placeholder: t("social.search"),
          data: { filter_list_target: "input", action: "input->filter-list#filter" },
          autocomplete: "off",
          aria: { label: t("social.search") } %>
    <label class="inline-flex items-center gap-2 text-sm font-medium text-gray-700 dark:text-gray-300">
      <input type="checkbox" class="rounded border-gray-300" data-action="change->filter-list#selectAll">
      <%= t("social.select_all") %>
    </label>
  </div>

  <ul class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-2">
    <% @pages.each do |page| %>
      <li class="rounded-3xl border border-gray-200 bg-white shadow-sm dark:border-white/10 dark:bg-gray-900" data-filter-list-target="item" data-name="<%= page[:name].to_s %> <%= page[:username].to_s %> <%= page.dig(:instagram, :username) %>">
        <label class="flex cursor-pointer items-center gap-4 p-4">
          <%= check_box_tag "page_ids[]", page[:id], false, class: "h-5 w-5 shrink-0 rounded border-gray-300" %>
          <span class="min-w-0">
            <span class="block truncate text-base font-semibold text-gray-900 dark:text-white"><%= page[:name] %></span>
            <span class="mt-0.5 block truncate text-sm text-gray-500">
              <%= page[:username].present? ? "@#{page[:username]}" : page[:category] %>
            </span>
          </span>
        </label>
        <% if page[:instagram] %>
          <% ig_name = page[:instagram][:username].presence || page[:instagram][:name].presence || page[:instagram][:id] %>
          <label class="flex cursor-pointer items-center gap-4 border-t border-gray-100 px-4 py-3 dark:border-white/10">
            <%= check_box_tag "instagram_ids[]", page[:instagram][:id], false, class: "h-5 w-5 shrink-0 rounded border-gray-300" %>
            <span class="min-w-0 text-sm text-gray-700 dark:text-gray-300"><%= t("social.connect_instagram", username: ig_name) %></span>
          </label>
        <% end %>
      </li>
    <% end %>
  </ul>

  <div class="sticky bottom-4 mt-5 flex flex-wrap items-center gap-2 rounded-2xl bg-white/90 p-3 shadow-theme-md ring-1 ring-gray-200 backdrop-blur dark:bg-gray-900/90 dark:ring-white/10">
    <button type="submit" class="<%= ta_btn_primary %> cursor-pointer" style="background: var(--org-party-color); color: var(--org-party-contrast)">
      <%= t("social.save") %>
    </button>
    <%= link_to t("common.cancel"), social_connections_path, class: "#{ta_btn_secondary} inline-flex items-center" %>
  </div>
<% end %>
