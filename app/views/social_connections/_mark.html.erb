<% key = provider.to_s %>
<% ink = {
     "facebook" => "#1877F2",
     "instagram" => "linear-gradient(145deg, #f9ce34 0%, #ee2a7b 52%, #6228d7 100%)",
     "youtube" => "#FF0000",
     "twitter" => "#141414"
   }[key] || "#465FFF" %>
<% size = local_assigns[:size].presence || "h-10 w-10 text-lg" %>
<% fill = local_assigns[:on_color] ? "rgba(255,255,255,0.22)" : ink %>
<span class="inline-flex shrink-0 items-center justify-center rounded-xl text-white <%= "shadow-sm" unless local_assigns[:on_color] %> <%= size %>" style="background: <%= fill %>" aria-hidden="true">
  <% case key %>
  <% when "facebook" %>
    <span class="font-bold leading-none">f</span>
  <% when "instagram" %>
    <svg class="h-[46%] w-[46%]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
      <rect x="4" y="4" width="16" height="16" rx="4"/>
      <circle cx="12" cy="12" r="3.2"/>
      <circle cx="17" cy="7" r="0.8" fill="currentColor" stroke="none"/>
    </svg>
  <% when "youtube" %>
    <svg class="h-[46%] w-[46%]" viewBox="0 0 24 24" fill="currentColor">
      <path d="M9.2 7.4v9.2l8-4.6-8-4.6z"/>
    </svg>
  <% else %>
    <span class="font-bold leading-none">X</span>
  <% end %>
</span>
