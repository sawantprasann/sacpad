<%# Mobile ticket card. Whole card opens the ticket. Color bar is category chrome, not status. %>
<% jewel = dashboard_jewel(ticket.ticket_category.display_order.to_i) %>
<%= link_to kitchen_cabinet_ticket_path(ticket), class: "relative block overflow-hidden rounded-2xl bg-white p-4 pl-5 shadow-sm ring-1 #{jewel[:ring]} dark:bg-gray-900 dark:ring-white/10" do %>
  <span class="absolute inset-y-0 left-0 w-1.5 bg-gradient-to-b <%= jewel[:bar] %>"></span>
  <div class="flex items-start justify-between gap-3">
    <div class="min-w-0">
      <p class="truncate font-medium text-gray-900 dark:text-white/90"><%= ticket.person_name %></p>
      <p class="truncate text-xs text-gray-500"><%= ticket.village.presence || "—" %></p>
    </div>
    <%= render "ui/status_pill", status: ticket.status %>
  </div>
  <div class="mt-2 flex flex-wrap items-center gap-2 text-xs text-gray-500">
    <span class="inline-flex rounded-full px-2 py-0.5 font-semibold text-white <%= jewel[:chip] %>"><%= ticket.ticket_category.name %></span>
    <span class="tabular-nums"><%= ticket.ticket_number %></span>
    <span class="tabular-nums"><%= ticket.reported_at&.strftime("%d %b %Y") %></span>
  </div>
<% end %>
