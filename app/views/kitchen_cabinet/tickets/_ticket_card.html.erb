<%# Mobile row inside the ticket table card. Whole row opens the ticket. %>
<%= link_to kitchen_cabinet_ticket_path(ticket), class: "block px-6 py-4 hover:bg-gray-50 dark:hover:bg-white/[0.03]" do %>
  <div class="flex items-start justify-between gap-3">
    <div class="min-w-0">
      <p class="truncate font-medium text-gray-900 dark:text-white/90"><%= ticket.person_name %></p>
      <p class="truncate text-xs text-gray-500"><%= ticket.village.presence || "—" %></p>
    </div>
    <%= render "ui/status_pill", status: ticket.status %>
  </div>
  <div class="mt-2 flex items-center gap-2 text-xs text-gray-500">
    <span><%= ticket.ticket_category.name %></span>
    <span aria-hidden="true">·</span>
    <span class="tabular-nums"><%= ticket.ticket_number %></span>
    <span aria-hidden="true">·</span>
    <span class="tabular-nums"><%= ticket.reported_at&.strftime("%d %b %Y") %></span>
  </div>
<% end %>
