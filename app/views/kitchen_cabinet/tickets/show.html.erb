<% content_for :title, "Ticket #{@ticket.ticket_number}" %>

<div class="mb-6 flex items-center justify-between">
  <div>
    <h1 class="text-title-sm font-semibold text-gray-800 dark:text-white/90"><%= @ticket.person_name %></h1>
    <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
      <%= @ticket.ticket_number %> · <%= @ticket.ticket_category.name %>
    </p>
  </div>
  <%= render "ui/status_pill", status: @ticket.status %>
</div>

<div class="grid gap-6 lg:grid-cols-3">
  <%# Main: ticket fields + attachments %>
  <div class="lg:col-span-2 space-y-6">
    <div class="<%= ta_card_classes %> p-6">
      <dl class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <div><dt class="<%= ta_label_classes %>">Person / represents</dt><dd class="text-gray-800 dark:text-white/90"><%= @ticket.person_name %></dd></div>
        <div><dt class="<%= ta_label_classes %>">Village / ward</dt><dd class="text-gray-800 dark:text-white/90"><%= @ticket.village.presence || "—" %></dd></div>
        <div><dt class="<%= ta_label_classes %>">Mobile</dt><dd class="text-gray-800 dark:text-white/90"><%= @ticket.mobile.presence || "—" %></dd></div>
        <div><dt class="<%= ta_label_classes %>">Reported date</dt><dd class="text-gray-800 dark:text-white/90"><%= @ticket.reported_at&.strftime("%d %b %Y") %></dd></div>
        <div><dt class="<%= ta_label_classes %>">Nature of issue</dt><dd class="text-gray-800 dark:text-white/90"><%= @ticket.nature_of_issue.presence || "—" %></dd></div>
        <div><dt class="<%= ta_label_classes %>">Reported value</dt><dd class="text-gray-800 dark:text-white/90"><%= @ticket.reported_value.present? ? number_to_currency(@ticket.reported_value, unit: "₹") : "—" %></dd></div>
      </dl>
      <div class="mt-4">
        <dt class="<%= ta_label_classes %>">Description</dt>
        <dd class="whitespace-pre-line text-gray-800 dark:text-white/90"><%= @ticket.description.presence || "—" %></dd>
      </div>
    </div>

    <div class="<%= ta_card_classes %> p-6">
      <h2 class="mb-3 text-sm font-semibold text-gray-700 dark:text-gray-300">Attachments</h2>
      <% if @ticket.attachments.attached? %>
        <div class="flex flex-wrap gap-3">
          <% @ticket.attachments.each do |att| %>
            <% if att.image? %>
              <%= image_tag att, class: "h-24 w-24 rounded-lg object-cover" %>
            <% else %>
              <%= link_to att.filename, rails_blob_path(att, disposition: "attachment"), class: "text-brand-500" %>
            <% end %>
          <% end %>
        </div>
      <% else %>
        <p class="text-sm text-gray-400">No attachments.</p>
      <% end %>
    </div>

    <%# Follow-up action log (Story 1.5) — append-only, newest-first; visually distinct from the
        compact status-change History in the Status card (UX-DR13). %>
    <div class="<%= ta_card_classes %> p-6">
      <h2 class="mb-4 text-sm font-semibold text-gray-700 dark:text-gray-300">Follow-up log</h2>

      <% if policy(@ticket).update? %>
        <%= form_with url: kitchen_cabinet_ticket_follow_ups_path(@ticket), scope: :ticket_follow_up,
              method: :post, multipart: true, class: "mb-6" do |f| %>
          <%= f.text_area :note, rows: 3, placeholder: "What was done about this issue?", class: ta_field_classes %>
          <div class="mt-3 flex flex-wrap items-center justify-between gap-3">
            <%= f.file_field :attachment, accept: "image/*,.pdf",
                  class: "block text-sm text-gray-600 file:mr-3 file:min-h-11 file:rounded-lg file:border-0 file:bg-gray-100 file:px-4 file:py-2 file:text-sm file:font-medium" %>
            <%= f.submit "Add follow-up", class: "#{ta_btn_primary} min-h-11" %>
          </div>
        <% end %>
      <% end %>

      <% entries = @ticket.follow_ups.order(created_at: :desc) %>
      <% if entries.any? %>
        <ol class="space-y-4">
          <% entries.each do |fu| %>
            <li class="rounded-xl border border-gray-100 bg-gray-50 p-4 dark:border-gray-800 dark:bg-white/[0.03]">
              <div class="mb-1 flex items-center justify-between text-xs text-gray-400">
                <span class="font-medium text-gray-600 dark:text-gray-300"><%= fu.created_by.name %></span>
                <span><%= fu.created_at.strftime("%d %b %Y %H:%M") %></span>
              </div>
              <p class="whitespace-pre-line text-sm text-gray-800 dark:text-white/90"><%= fu.note %></p>
              <% if fu.attachment.attached? %>
                <div class="mt-2">
                  <% if fu.attachment.image? %>
                    <%= image_tag fu.attachment, class: "h-20 w-20 rounded-lg object-cover" %>
                  <% else %>
                    <%= link_to fu.attachment.filename, rails_blob_path(fu.attachment, disposition: "attachment"), class: "text-xs text-brand-500" %>
                  <% end %>
                </div>
              <% end %>
            </li>
          <% end %>
        </ol>
      <% else %>
        <p class="text-sm text-gray-400">No follow-ups yet.</p>
      <% end %>
    </div>
  </div>

  <%# Side: placeholders for interactive pieces delivered by later stories. %>
  <div class="space-y-6">
    <div class="<%= ta_card_classes %> p-6">
      <h2 class="mb-2 text-sm font-semibold text-gray-700 dark:text-gray-300">Status</h2>
      <%= render "ui/status_pill", status: @ticket.status %>

      <% allowed = KitchenCabinet::Ticket::TRANSITIONS.fetch(@ticket.status, []) %>
      <% if allowed.any? %>
        <div class="mt-4 flex flex-wrap gap-2">
          <% allowed.each do |to| %>
            <% if to == "closed" %>
              <%# Closing goes through the two-step closure flow (Story 1.7), not a bare status PATCH. %>
              <%= link_to "Close…", new_kitchen_cabinet_ticket_closure_path(@ticket),
                    class: "#{ta_btn_secondary} inline-flex items-center min-h-11" %>
            <% else %>
              <%= button_to to.humanize, status_kitchen_cabinet_ticket_path(@ticket), method: :patch,
                    params: { to_status: to }, class: "#{ta_btn_secondary} min-h-11" %>
            <% end %>
          <% end %>
        </div>
      <% else %>
        <p class="mt-3 text-xs text-gray-400">This ticket is closed.</p>
      <% end %>

      <h3 class="mt-5 mb-2 text-xs font-semibold uppercase tracking-wide text-gray-400">History</h3>
      <% changes = @ticket.status_changes.order(:created_at) %>
      <% if changes.any? %>
        <ul class="space-y-2 text-xs text-gray-500">
          <% changes.each do |c| %>
            <li>
              <%= c.from_status&.humanize || "—" %> → <strong class="text-gray-700 dark:text-gray-300"><%= c.to_status.humanize %></strong>
              · <%= c.actor.name %> · <%= c.created_at.strftime("%d %b %Y %H:%M") %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="text-xs text-gray-400">No changes yet.</p>
      <% end %>
    </div>

    <div class="<%= ta_card_classes %> p-6">
      <h2 class="mb-3 text-sm font-semibold text-gray-700 dark:text-gray-300">Voter ID</h2>
      <%= render "ui/voter_gate_field", ticket: @ticket %>
    </div>

  </div>
</div>

<div class="mt-6">
  <%= link_to "← Back to list", kitchen_cabinet_tickets_path(category: @ticket.ticket_category.slug), class: "text-sm font-medium text-brand-500 hover:text-brand-600" %>
</div>
