<% content_for :title, "#{@ticket.person_name} · #{@ticket.ticket_number}" %>
<% list_path = kitchen_cabinet_tickets_path(category: @ticket.ticket_category.slug) %>
<% breadcrumb t("nav.beneficiaries"), kitchen_cabinet_tickets_path %>
<% breadcrumb @ticket.ticket_category.name, list_path %>
<% breadcrumb @ticket.person_name %>
<% field = "rounded-xl bg-amber-50/70 px-4 py-3 ring-1 ring-amber-100 dark:bg-white/[0.03] dark:ring-white/10" %>
<% label = "text-xs font-medium tracking-wide text-amber-700/80 uppercase dark:text-amber-200" %>
<% village_label = stored_village_label(@ticket.village) %>

<%= render layout: "ui/campaign_hero", locals: {
        kicker: t("nav.beneficiaries"),
        title: @ticket.person_name,
        subtitle: [ @ticket.ticket_number, @ticket.ticket_category.name, (@ticket.village.present? ? village_label : nil) ].compact.join(" · "),
        meta: t("kitchen_cabinet.reported_meta", date: l_day(@ticket.reported_at), owner: @ticket.owner.name)
      } do %><% end %>

  <% unless @ticket.closed? %>
    <% steps = %w[open in_progress closed] %>
    <% here = { "open" => 0, "in_progress" => 1, "blocked" => 1 }[@ticket.status] %>
    <div class="mt-4 <%= ta_card_classes %> p-4 md:p-5">
      <p class="text-xs font-medium tracking-wide text-gray-500 uppercase dark:text-gray-400"><%= t("kitchen_cabinet.next_step") %></p>
      <ol class="mt-3 flex items-center gap-2">
        <% steps.each_with_index do |step, i| %>
          <% current = !@ticket.blocked? && i == here %>
          <% done = i < here %>
          <li class="flex min-w-0 items-center gap-2 <%= "flex-1" unless i == steps.length - 1 %>">
            <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full text-xs font-semibold <%= "text-white" if current %> <%= "bg-gray-900 text-white dark:bg-white dark:text-gray-900" if done && !current %> <%= "bg-gray-100 text-gray-500 dark:bg-white/10 dark:text-gray-400" unless current || done %>"
                  <% if current %>style="background: var(--org-party-color); color: var(--org-party-contrast)"<% end %>><%= i + 1 %></span>
            <span class="truncate text-sm <%= current ? "font-semibold text-gray-900 dark:text-white" : "text-gray-500 dark:text-gray-400" %>"><%= t("kitchen_cabinet.statuses.#{step}") %></span>
            <% if i < steps.length - 1 %>
              <span class="h-px min-w-4 flex-1 <%= done ? "bg-gray-900 dark:bg-white" : "bg-gray-200 dark:bg-gray-700" %>"></span>
            <% end %>
          </li>
        <% end %>
      </ol>
      <p class="mt-3 text-sm text-gray-700 dark:text-gray-300"><%= t("kitchen_cabinet.flow_#{@ticket.status}") %></p>
      <% if policy(@ticket).update? %>
        <div class="mt-4 flex flex-col gap-2 sm:flex-row">
          <% if @ticket.open? %>
            <%= button_to t("kitchen_cabinet.start_work"), status_kitchen_cabinet_ticket_path(@ticket), method: :patch,
                  params: { to_status: "in_progress" },
                  form: { class: "w-full sm:w-auto" },
                  class: "#{ta_btn_primary} w-full min-h-11 cursor-pointer sm:w-auto",
                  style: "background: var(--org-party-color); color: var(--org-party-contrast)" %>
          <% elsif @ticket.in_progress? %>
            <%= link_to t("kitchen_cabinet.close_ticket"), new_kitchen_cabinet_ticket_closure_path(@ticket),
                  class: "#{ta_btn_primary} inline-flex w-full min-h-11 cursor-pointer items-center justify-center sm:w-auto",
                  style: "background: var(--org-party-color); color: var(--org-party-contrast)" %>
            <%= button_to t("kitchen_cabinet.mark_blocked"), status_kitchen_cabinet_ticket_path(@ticket), method: :patch,
                  params: { to_status: "blocked" },
                  form: { class: "w-full sm:w-auto" },
                  class: "#{ta_btn_secondary} w-full min-h-11 cursor-pointer sm:w-auto" %>
          <% elsif @ticket.blocked? %>
            <%= button_to t("kitchen_cabinet.resume_work"), status_kitchen_cabinet_ticket_path(@ticket), method: :patch,
                  params: { to_status: "in_progress" },
                  form: { class: "w-full sm:w-auto" },
                  class: "#{ta_btn_primary} w-full min-h-11 cursor-pointer sm:w-auto",
                  style: "background: var(--org-party-color); color: var(--org-party-contrast)" %>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>

  <div class="mt-4 flex flex-wrap items-center justify-end gap-2">
    <div class="rounded-full bg-white px-1 py-1 shadow-sm">
      <%= render "ui/status_pill", status: @ticket.status %>
    </div>
    <% if policy(@ticket).edit? %>
      <%= icon_action_link :edit, edit_kitchen_cabinet_ticket_path(@ticket) %>
    <% end %>
    <%= link_to t("common.back_to_list"), list_path, class: "#{ta_btn_secondary} min-h-11 cursor-pointer" %>
  </div>

  <div class="mt-6 grid grid-cols-1 items-start gap-4 xl:grid-cols-3">
    <div class="space-y-4 xl:col-span-2">
      <%= render layout: "ui/jewel_card", locals: { accent_index: 0, title: t("kitchen_cabinet.ticket") } do %>
        <dl class="grid grid-cols-1 gap-3 sm:grid-cols-2">
          <div class="<%= field %>">
            <dt class="<%= label %>"><%= t("kitchen_cabinet.beneficiary_name") %></dt>
            <dd class="mt-1 text-sm text-gray-800 dark:text-white/90"><%= @ticket.person_name %></dd>
          </div>
          <div class="<%= field %>">
            <dt class="<%= label %>"><%= t("kitchen_cabinet.representative_name") %></dt>
            <dd class="mt-1 text-sm text-gray-800 dark:text-white/90"><%= @ticket.representative_name.presence || "—" %></dd>
          </div>
          <div class="<%= field %>">
            <dt class="<%= label %>"><%= t("kitchen_cabinet.village_ward") %></dt>
            <dd class="mt-1 text-sm text-gray-800 dark:text-white/90"><%= village_label %></dd>
          </div>
          <div class="<%= field %>">
            <dt class="<%= label %>"><%= t("common.mobile") %></dt>
            <dd class="mt-1 text-sm text-gray-800 dark:text-white/90"><%= @ticket.mobile.presence || "—" %></dd>
          </div>
          <div class="<%= field %>">
            <dt class="<%= label %>"><%= t("common.reported_date") %></dt>
            <dd class="mt-1 text-sm tabular-nums text-gray-800 dark:text-white/90"><%= l_day(@ticket.reported_at) %></dd>
          </div>
          <div class="<%= field %>">
            <dt class="<%= label %>"><%= t("kitchen_cabinet.nature") %></dt>
            <dd class="mt-1 text-sm text-gray-800 dark:text-white/90"><%= @ticket.nature_of_issue.presence || "—" %></dd>
          </div>
          <div class="<%= field %>">
            <dt class="<%= label %>"><%= t("kitchen_cabinet.reported_value") %></dt>
            <dd class="mt-1 text-sm tabular-nums text-gray-800 dark:text-white/90"><%= @ticket.reported_value.present? ? number_to_currency(@ticket.reported_value, unit: "₹") : "—" %></dd>
          </div>
          <div class="<%= field %> sm:col-span-2">
            <dt class="<%= label %>"><%= t("common.description") %></dt>
            <dd class="mt-1 whitespace-pre-line text-sm text-gray-800 dark:text-white/90"><%= @ticket.description.presence || "—" %></dd>
          </div>
        </dl>
      <% end %>

      <%= render layout: "ui/jewel_card", locals: { accent_index: 1, title: t("common.attachments") } do %>
        <% if @ticket.attachments.attached? %>
          <div class="grid grid-cols-2 gap-3 sm:grid-cols-3">
            <% @ticket.attachments.each do |att| %>
              <% if att.image? %>
                <%= image_tag att, class: "aspect-square w-full rounded-xl object-cover" %>
              <% else %>
                <%= link_to att.filename, rails_blob_path(att, disposition: "attachment"), class: "text-sm #{ta_text_link}" %>
              <% end %>
            <% end %>
          </div>
        <% else %>
          <p class="rounded-xl border border-dashed border-cyan-200 px-4 py-8 text-center text-sm text-cyan-800/70 dark:border-cyan-900"><%= t("common.no_attachments") %></p>
        <% end %>
      <% end %>

      <%= render layout: "ui/jewel_card", locals: { accent_index: 2, title: t("kitchen_cabinet.follow_ups") } do %>
        <% if policy(@ticket).update? %>
          <%= form_with url: kitchen_cabinet_ticket_follow_ups_path(@ticket), scope: :ticket_follow_up,
                method: :post, multipart: true, class: "mb-6" do |f| %>
            <%= f.text_area :note, rows: 3, placeholder: t("kitchen_cabinet.follow_up_placeholder"), class: ta_field_classes %>
            <div class="mt-3 flex flex-wrap items-center justify-between gap-3">
              <%= f.file_field :attachment, accept: "image/*,.pdf",
                    class: "block cursor-pointer text-sm text-gray-600 file:mr-3 file:min-h-11 file:cursor-pointer file:rounded-lg file:border-0 file:bg-indigo-50 file:px-4 file:py-2 file:text-sm file:font-medium file:text-indigo-800" %>
              <%= f.submit t("kitchen_cabinet.add_follow_up"), class: "#{ta_btn_primary} min-h-11 cursor-pointer" %>
            </div>
          <% end %>
        <% end %>

        <% entries = @ticket.follow_ups.order(created_at: :desc) %>
        <% if entries.any? %>
          <ol class="space-y-3">
            <% entries.each do |fu| %>
              <li class="rounded-xl bg-indigo-50/70 p-4 ring-1 ring-indigo-100 dark:bg-white/[0.03] dark:ring-white/10">
                <div class="mb-1 flex items-center justify-between text-xs text-gray-400">
                  <span class="font-medium text-gray-600 dark:text-gray-300"><%= fu.created_by.name %></span>
                  <span class="tabular-nums"><%= l_stamp(fu.created_at) %></span>
                </div>
                <p class="whitespace-pre-line text-sm text-gray-800 dark:text-white/90"><%= fu.note %></p>
                <% if fu.attachment.attached? %>
                  <div class="mt-2">
                    <% if fu.attachment.image? %>
                      <%= image_tag fu.attachment, class: "h-20 w-20 rounded-lg object-cover" %>
                    <% else %>
                      <%= link_to fu.attachment.filename, rails_blob_path(fu.attachment, disposition: "attachment"), class: "text-xs #{ta_text_link}" %>
                    <% end %>
                  </div>
                <% end %>
              </li>
            <% end %>
          </ol>
        <% else %>
          <p class="text-sm text-gray-400"><%= t("kitchen_cabinet.no_follow_ups") %></p>
        <% end %>
      <% end %>
    </div>

    <div class="space-y-4">
      <%= render layout: "ui/jewel_card", locals: { accent_index: 4, title: t("common.status") } do %>
        <div><%= render "ui/status_pill", status: @ticket.status %></div>
        <% if @ticket.closed? %>
          <p class="mt-3 text-xs text-gray-400"><%= t("kitchen_cabinet.ticket_closed") %></p>
        <% end %>

        <h3 class="mt-5 mb-2 text-xs font-semibold tracking-wide text-amber-700/80 uppercase"><%= t("kitchen_cabinet.history") %></h3>
        <% changes = @ticket.status_changes.order(:created_at) %>
        <% if changes.any? %>
          <ul class="space-y-2 text-xs text-gray-500">
            <% changes.each do |c| %>
              <li>
                <%= c.from_status.present? ? t("kitchen_cabinet.statuses.#{c.from_status}") : "—" %> → <strong class="text-gray-700 dark:text-gray-300"><%= t("kitchen_cabinet.statuses.#{c.to_status}") %></strong>
                · <%= c.actor.name %> · <span class="tabular-nums"><%= l_stamp(c.created_at) %></span>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="text-xs text-gray-400"><%= t("kitchen_cabinet.no_changes") %></p>
        <% end %>
      <% end %>

      <%= render layout: "ui/jewel_card", locals: { accent_index: 3, title: t("common.voter_id") } do %>
        <% if @voter_matches.to_a.many? && @ticket.voter_id.blank? %>
          <p class="mb-3 text-sm text-gray-600 dark:text-gray-300"><%= t("kitchen_cabinet.several_voters") %></p>
          <ul class="space-y-2">
            <% @voter_matches.each do |voter| %>
              <li class="flex flex-wrap items-center justify-between gap-2 rounded-xl bg-amber-50/70 px-3 py-2 ring-1 ring-amber-100">
                <span class="text-sm text-gray-800">
                  <span class="font-medium"><%= voter.display_name %></span>
                  · <%= voter.voter_id %>
                  · <%= t("kitchen_cabinet.booth_sr", booth: voter.booth&.number || "—") %>
                  <% if voter.sr_no %>· <%= t("kitchen_cabinet.sr", number: voter.sr_no) %><% end %>
                </span>
                <%= button_to t("kitchen_cabinet.select_voter"), match_voter_kitchen_cabinet_ticket_path(@ticket), method: :post,
                      params: { matched_voter_id: voter.id },
                      class: "#{ta_btn_secondary} min-h-9 cursor-pointer text-xs" %>
              </li>
            <% end %>
          </ul>
        <% else %>
          <%= render "ui/voter_gate_field", ticket: @ticket %>
        <% end %>
      <% end %>
    </div>
  </div>
