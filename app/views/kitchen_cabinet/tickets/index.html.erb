<% content_for :title, t("nav.beneficiaries") %>
<% list_params = request.query_parameters.slice("category", "name", "village", "reporter", "status", "q", "from_date", "to_date") %>
<% accent = @category ? dashboard_jewel(@category.display_order.to_i)[:hex] : org_accent_color %>
<% accent_ink = @category ? "#ffffff" : org_accent_foreground %>
<% th = "border-b border-gray-200 px-6 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-500 dark:border-gray-800 dark:text-gray-400" %>
<% td = "border-b border-gray-100 px-6 py-4 align-middle dark:border-gray-800" %>
<% line_colors = category_series_colors(@charts[:line], @categories, fallback: accent) %>
<% bar_colors = category_series_colors(@charts[:bar], @categories, fallback: accent) %>
<% pie_status_colors = status_series_colors(@charts[:pie].keys, fallback: accent) %>
<% pie_category_colors = named_series_colors(@charts[:pie_by_category].keys, @categories, fallback: accent) %>

<%= render layout: "ui/campaign_hero", locals: {
        kicker: t("nav.beneficiaries"),
        title: t("nav.beneficiaries"),
        subtitle: [ @category&.name, t("kitchen_cabinet.beneficiary_count", count: @pagy.count) ].compact.join(" · "),
        meta: current_user.organization.name
      } do %><% end %>

  <div class="mt-4 flex flex-wrap items-center justify-end gap-2">
    <%= render "ui/module_toolbar",
          export_url: kitchen_cabinet_tickets_path(list_params.merge(format: :xlsx)),
          new_url: (new_kitchen_cabinet_ticket_path(category: params[:category]) if current_user.role.can_write?("kitchen_cabinet")),
          new_label: t("nav.create_ticket"),
          accent: accent,
          accent_ink: accent_ink %>
  </div>

  <%= form_with url: kitchen_cabinet_tickets_path, method: :get, class: "mt-6 #{ta_card_classes} p-4 md:p-5" do %>
    <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">
      <div>
        <%= label_tag :category, t("kitchen_cabinet.category"), class: ta_label_classes %>
        <%= select_tag :category,
              options_from_collection_for_select(@categories, :slug, :name, params[:category]),
              include_blank: t("kitchen_cabinet.any_category"),
              class: ta_field_classes %>
      </div>
      <div>
        <%= label_tag :name, t("kitchen_cabinet.beneficiary_name"), class: ta_label_classes %>
        <%= text_field_tag :name, params[:name], class: ta_field_classes, placeholder: t("kitchen_cabinet.beneficiary_name") %>
      </div>
      <div>
        <%= label_tag :village, t("kitchen_cabinet.village"), class: ta_label_classes %>
        <%= render "ui/min_search_select",
              name: :village,
              choices: @villages.map { |village| [ village.display_name, village.name ] },
              selected: params[:village],
              blank: t("kitchen_cabinet.any_village"),
              placeholder: t("kitchen_cabinet.any_village"),
              search_placeholder: t("kitchen_cabinet.search_villages"),
              empty_text: t("kitchen_cabinet.no_villages") %>
      </div>
      <div>
        <%= label_tag :reporter, t("kitchen_cabinet.reporter_name"), class: ta_label_classes %>
        <%= text_field_tag :reporter, params[:reporter], class: ta_field_classes, placeholder: t("kitchen_cabinet.reporter_placeholder") %>
      </div>
      <div>
        <%= label_tag :status, t("kitchen_cabinet.status"), class: ta_label_classes %>
        <%= select_tag :status,
              options_for_select(KitchenCabinet::Ticket.statuses.keys.map { |s| [ t("kitchen_cabinet.statuses.#{s}"), s ] }, params[:status]),
              include_blank: t("kitchen_cabinet.any_status"),
              class: ta_field_classes %>
      </div>
      <div>
        <%= label_tag :from_date, t("kitchen_cabinet.from_date"), class: ta_label_classes %>
        <%= ta_date_picker(name: "from_date", id: "from_date", value: @from_date) %>
      </div>
      <div>
        <%= label_tag :to_date, t("kitchen_cabinet.to_date"), class: ta_label_classes %>
        <%= ta_date_picker(name: "to_date", id: "to_date", value: @to_date) %>
      </div>
      <div class="flex items-end gap-2">
        <button type="submit" class="<%= ta_btn_primary %> min-h-11 cursor-pointer"
                style="background: <%= accent %>; color: <%= accent_ink %>"><%= t("kitchen_cabinet.filter") %></button>
        <%= link_to t("kitchen_cabinet.clear"), kitchen_cabinet_tickets_path, class: "#{ta_btn_secondary} inline-flex min-h-11 items-center" %>
      </div>
    </div>
  <% end %>

  <div class="mt-6 <%= ta_card_classes %>" x-data="{ tab: 'pie' }">
    <div class="border-b border-gray-200 px-4 dark:border-gray-800" role="tablist" aria-label="<%= t("kitchen_cabinet.charts") %>">
      <div class="flex gap-6">
        <% { "pie" => t("kitchen_cabinet.pie"), "bar" => t("kitchen_cabinet.bar"), "line" => t("kitchen_cabinet.line") }.each do |key, label| %>
          <button type="button" role="tab" id="beneficiaries-tab-<%= key %>"
                  @click="tab = '<%= key %>'; $nextTick(() => window.Chartkick && Object.values(Chartkick.charts).forEach((chart) => chart.redraw()))"
                  :aria-selected="(tab === '<%= key %>').toString()"
                  :class="tab === '<%= key %>' ? '' : 'border-transparent text-gray-500 hover:text-gray-800 dark:hover:text-white/90'"
                  :style="tab === '<%= key %>' ? 'color: <%= accent %>; border-color: <%= accent %>' : ''"
                  class="-mb-px cursor-pointer border-b-2 px-1 py-4 text-sm font-semibold">
            <%= label %>
          </button>
        <% end %>
      </div>
    </div>
    <div class="p-4 md:p-6">
      <div x-show="tab === 'pie'" role="tabpanel" aria-labelledby="beneficiaries-tab-pie">
        <div class="grid gap-6 lg:grid-cols-2">
          <div>
            <h3 class="mb-3 text-sm font-semibold text-gray-800 dark:text-white/90"><%= t("kitchen_cabinet.by_status") %></h3>
            <%= pie_chart @charts[:pie], id: "beneficiaries-pie", height: "280px", donut: true,
                  colors: pie_status_colors,
                  empty: t("kitchen_cabinet.no_match_filters") %>
          </div>
          <div>
            <h3 class="mb-3 text-sm font-semibold text-gray-800 dark:text-white/90"><%= t("kitchen_cabinet.by_category") %></h3>
            <%= pie_chart @charts[:pie_by_category], id: "beneficiaries-pie-category", height: "280px", donut: true,
                  colors: pie_category_colors,
                  empty: t("kitchen_cabinet.no_match_filters") %>
          </div>
        </div>
      </div>
      <div x-show="tab === 'bar'" x-cloak role="tabpanel" aria-labelledby="beneficiaries-tab-bar">
        <%= column_chart @charts[:bar], id: "beneficiaries-bar", height: "280px", stacked: true,
              colors: bar_colors, xtitle: t("kitchen_cabinet.date"), ytitle: t("kitchen_cabinet.chart_count"),
              empty: t("kitchen_cabinet.no_match_filters") %>
      </div>
      <div x-show="tab === 'line'" x-cloak role="tabpanel" aria-labelledby="beneficiaries-tab-line">
        <%= line_chart @charts[:line], id: "beneficiaries-line", height: "280px",
              colors: line_colors, xtitle: t("kitchen_cabinet.reported_date"), ytitle: t("kitchen_cabinet.chart_count"),
              empty: t("kitchen_cabinet.no_match_filters") %>
      </div>
    </div>
  </div>

  <% list = capture do %>
      <h2 class="px-6 pt-4 text-sm font-semibold text-gray-800 dark:text-white/90"><%= t("kitchen_cabinet.list") %></h2>
      <div class="hidden xl:block">
        <table class="w-full text-sm">
          <thead class="bg-gray-50 dark:bg-white/[0.03]"<% if @category %> style="background: color-mix(in srgb, <%= accent %> 10%, white)"<% end %>>
            <tr>
              <th class="<%= th %>"><%= t("kitchen_cabinet.beneficiary_name") %></th>
              <th class="<%= th %>"><%= t("kitchen_cabinet.representative") %></th>
              <th class="<%= th %>"><%= t("kitchen_cabinet.ticket") %></th>
              <th class="<%= th %>"><%= t("kitchen_cabinet.category") %></th>
              <th class="<%= th %>"><%= t("kitchen_cabinet.village") %></th>
              <th class="<%= th %>"><%= t("kitchen_cabinet.reporter") %></th>
              <th class="<%= th %>"><%= t("kitchen_cabinet.status") %></th>
              <th class="<%= th %> text-right"><%= t("kitchen_cabinet.reported") %></th>
              <th class="<%= th %> w-12"><span class="sr-only"><%= t("kitchen_cabinet.open_ticket") %></span></th>
            </tr>
          </thead>
          <tbody>
            <% @tickets.each do |ticket| %>
              <tr class="group hover:bg-gray-50 last:[&>td]:border-b-0 dark:hover:bg-white/[0.03]">
                <td class="<%= td %>">
                  <%= link_to kitchen_cabinet_ticket_path(ticket),
                        class: "block #{ta_text_link}" do %>
                    <%= ticket.person_name %>
                  <% end %>
                </td>
                <td class="<%= td %> text-gray-600 dark:text-gray-300"><%= ticket.representative_name.presence || "—" %></td>
                <td class="<%= td %> tabular-nums text-gray-500"><%= ticket.ticket_number %></td>
                <td class="<%= td %>">
                  <span class="inline-flex rounded-full px-2.5 py-0.5 text-xs font-semibold text-white <%= dashboard_jewel(ticket.ticket_category.display_order.to_i)[:chip] %>"><%= ticket.ticket_category.name %></span>
                </td>
                <td class="<%= td %> text-gray-600 dark:text-gray-300"><%= stored_village_label(ticket.village) %></td>
                <td class="<%= td %> text-gray-600 dark:text-gray-300"><%= ticket.owner.name %></td>
                <td class="<%= td %>"><%= render "ui/status_pill", status: ticket.status %></td>
                <td class="<%= td %> text-right tabular-nums text-gray-500"><%= ticket.reported_at&.strftime("%d %b %Y") %></td>
                <td class="<%= td %> text-right">
                  <%= icon_action_link :view, kitchen_cabinet_ticket_path(ticket) %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
        <% if @tickets.empty? %>
          <p class="px-6 py-16 text-center text-sm text-gray-500"><%= t("kitchen_cabinet.no_match") %></p>
        <% end %>
      </div>

      <div class="space-y-3 p-4 xl:hidden">
        <% @tickets.each do |ticket| %>
          <%= render "ticket_card", ticket: ticket %>
        <% end %>
        <% if @tickets.empty? %>
          <p class="px-2 py-12 text-center text-sm text-gray-500"><%= t("kitchen_cabinet.no_match") %></p>
        <% end %>
      </div>

      <%= render "ui/pagination", pagy: @pagy %>
  <% end %>
  <div class="mt-6">
    <% if @category %>
      <%= render layout: "ui/jewel_card", locals: { accent_index: @category.display_order.to_i, flush: true } do %>
        <%= list %>
      <% end %>
    <% else %>
      <div class="<%= ta_card_classes %> overflow-hidden"><%= list %></div>
    <% end %>
  </div>
