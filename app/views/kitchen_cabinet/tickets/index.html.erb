<% content_for :title, @category ? "Kitchen Cabinet — #{@category.name}" : "Kitchen Cabinet" %>
<% new_path = @category ? new_kitchen_cabinet_ticket_path(category: @category.slug) : new_kitchen_cabinet_ticket_path %>
<% list_params = { category: params[:category], status: params[:status], q: params[:q] } %>
<% page_link = "inline-flex h-9 items-center rounded-lg border border-amber-200 bg-white px-3 text-sm font-medium text-gray-700 hover:bg-amber-50 dark:border-gray-700 dark:bg-gray-900 dark:text-gray-200" %>
<% th = "border-b border-amber-100 px-6 py-3 text-left text-xs font-semibold uppercase tracking-wide text-amber-800 dark:border-gray-800 dark:text-amber-200" %>
<% td = "border-b border-amber-50 px-6 py-4 align-middle dark:border-gray-800" %>

<%= render layout: "ui/campaign_hero", locals: {
        kicker: "Kitchen Cabinet",
        title: @category&.name || "People waiting on help",
        subtitle: pluralize(@pagy.count, "ticket"),
        meta: current_user.organization.name
      } do %><% end %>

  <div class="mt-4 flex flex-wrap items-center justify-end gap-2">
    <%= render "ui/module_toolbar",
          export_url: kitchen_cabinet_tickets_path(format: :xlsx, category: params[:category], status: params[:status], q: params[:q]),
          new_url: (new_path if current_user.role.can_write?("kitchen_cabinet")),
          new_label: (@category ? "Create #{@category.name}" : "Create ticket"),
          accent: "#c2410c",
          accent_ink: "#ffffff" %>
  </div>

  <div class="mt-4 flex flex-wrap items-center gap-2">
    <%= link_to "Any status", kitchen_cabinet_tickets_path(category: params[:category]),
          class: "inline-flex items-center rounded-full px-3 py-1 text-xs font-semibold #{params[:status].blank? ? "bg-gray-900 text-white" : "bg-white text-gray-600 ring-1 ring-gray-200"}" %>
    <% KitchenCabinet::Ticket.statuses.each_key do |status| %>
      <%= link_to kitchen_cabinet_tickets_path(category: params[:category], status: status),
            class: "inline-flex rounded-full #{params[:status] == status ? "ring-2 ring-offset-2 ring-gray-400" : ""}" do %>
        <%= render "ui/status_pill", status: status %>
      <% end %>
    <% end %>
  </div>

  <div class="mt-6">
    <%= render layout: "ui/jewel_card", locals: { accent_index: 0, flush: true } do %>
      <div class="hidden xl:block">
        <table class="w-full text-sm">
          <thead class="bg-amber-50/80 dark:bg-white/[0.03]">
            <tr>
              <th class="<%= th %>">Person</th>
              <th class="<%= th %>">Ticket</th>
              <th class="<%= th %>">Category</th>
              <th class="<%= th %>">Status</th>
              <th class="<%= th %> text-right">Reported</th>
              <th class="<%= th %> w-12"><span class="sr-only">Open</span></th>
            </tr>
          </thead>
          <tbody>
            <% @tickets.each do |ticket| %>
              <tr class="group hover:bg-amber-50/60 last:[&>td]:border-b-0 dark:hover:bg-white/[0.03]">
                <td class="<%= td %>">
                  <%= link_to kitchen_cabinet_ticket_path(ticket), class: "block" do %>
                    <span class="font-medium text-gray-900 dark:text-white/90"><%= ticket.person_name %></span>
                    <span class="mt-0.5 block text-xs text-gray-500"><%= ticket.village.presence || "—" %></span>
                  <% end %>
                </td>
                <td class="<%= td %> tabular-nums text-gray-500"><%= ticket.ticket_number %></td>
                <td class="<%= td %>">
                  <span class="inline-flex rounded-full px-2.5 py-0.5 text-xs font-semibold text-white <%= dashboard_jewel(ticket.ticket_category.display_order.to_i)[:chip] %>"><%= ticket.ticket_category.name %></span>
                </td>
                <td class="<%= td %>"><%= render "ui/status_pill", status: ticket.status %></td>
                <td class="<%= td %> text-right tabular-nums text-gray-500"><%= ticket.reported_at&.strftime("%d %b %Y") %></td>
                <td class="<%= td %> text-right">
                  <%= link_to kitchen_cabinet_ticket_path(ticket), class: "inline-flex text-amber-300 group-hover:text-amber-600", aria: { label: "Open #{ticket.person_name}" } do %>
                    <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd"/></svg>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
        <% if @tickets.empty? %>
          <p class="px-6 py-16 text-center text-sm text-amber-800/70">No tickets match.</p>
        <% end %>
      </div>

      <div class="space-y-3 p-4 xl:hidden">
        <% @tickets.each do |ticket| %>
          <%= render "ticket_card", ticket: ticket %>
        <% end %>
        <% if @tickets.empty? %>
          <p class="px-2 py-12 text-center text-sm text-amber-800/70">No tickets match.</p>
        <% end %>
      </div>

      <% if @pagy.last > 1 %>
        <nav class="flex items-center justify-between gap-3 border-t border-amber-100 px-6 py-3 dark:border-gray-800">
          <% if @pagy.previous %>
            <%= link_to "← Prev", kitchen_cabinet_tickets_path(list_params.merge(page: @pagy.previous)), class: page_link %>
          <% else %>
            <span class="text-sm text-gray-300">← Prev</span>
          <% end %>
          <span class="text-sm tabular-nums text-gray-500">Page <%= @pagy.page %> of <%= @pagy.last %></span>
          <% if @pagy.next %>
            <%= link_to "Next →", kitchen_cabinet_tickets_path(list_params.merge(page: @pagy.next)), class: page_link %>
          <% else %>
            <span class="text-sm text-gray-300">Next →</span>
          <% end %>
        </nav>
      <% end %>
    <% end %>
  </div>
