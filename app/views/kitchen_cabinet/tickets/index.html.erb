<% content_for :title, @category ? "Kitchen Cabinet — #{@category.name}" : "Kitchen Cabinet" %>
<% new_path = @category ? new_kitchen_cabinet_ticket_path(category: @category.slug) : new_kitchen_cabinet_ticket_path %>
<% page_link = "inline-flex h-9 items-center rounded-lg border border-gray-200 bg-white px-3 text-sm font-medium text-gray-700 hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-900 dark:text-gray-200" %>
<% th = "border-b border-gray-200 px-6 py-3 text-left text-xs font-medium text-gray-500 dark:border-gray-800 dark:text-gray-400" %>
<% td = "border-b border-gray-100 px-6 py-4 align-middle dark:border-gray-800" %>

<div class="mb-4 flex flex-wrap items-center justify-between gap-4 rounded-2xl border px-6 py-5"
     style="background: color-mix(in srgb, var(--org-party-color) 12%, white); border-color: color-mix(in srgb, var(--org-party-color) 28%, white)">
  <div class="flex min-w-0 items-center gap-3">
    <span class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-xl text-sm font-bold"
          style="background: var(--org-party-color); color: var(--org-party-contrast)">KC</span>
    <div class="min-w-0">
      <h1 class="text-xl font-semibold tracking-tight text-gray-900">Kitchen Cabinet</h1>
      <p class="mt-1 flex flex-wrap items-center gap-2 text-sm text-gray-600">
        <% if @category %><span class="font-medium text-gray-800"><%= @category.name %></span><% end %>
        <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold"
              style="background: var(--org-party-color); color: var(--org-party-contrast)"><%= pluralize(@pagy.count, "ticket") %></span>
      </p>
    </div>
  </div>
  <%= render "ui/module_toolbar",
        export_url: kitchen_cabinet_tickets_path(format: :xlsx, category: params[:category], status: params[:status], q: params[:q]),
        new_url: (new_path if current_user.role.can_write?("kitchen_cabinet")),
        new_label: (@category ? "Create #{@category.name}" : "Create ticket") %>
</div>

<div class="<%= ta_card_classes %> overflow-hidden">
  <div class="hidden xl:block">
    <table class="w-full text-sm">
      <thead class="bg-gray-50 dark:bg-white/[0.03]">
        <tr>
          <th class="<%= th %>">Person</th>
          <th class="<%= th %>">Ticket</th>
          <th class="<%= th %>">Category</th>
          <th class="<%= th %>">Status</th>
          <th class="<%= th %> text-right">Reported</th>
          <th class="<%= th %> w-12"><span class="sr-only">Open</span></th>
        </tr>
      </thead>
      <tbody>
        <% @tickets.each do |ticket| %>
          <tr class="group hover:bg-gray-50 last:[&>td]:border-b-0 dark:hover:bg-white/[0.03]">
            <td class="<%= td %>">
              <%= link_to kitchen_cabinet_ticket_path(ticket), class: "block" do %>
                <span class="font-medium text-gray-900 dark:text-white/90"><%= ticket.person_name %></span>
                <span class="mt-0.5 block text-xs text-gray-500"><%= ticket.village.presence || "—" %></span>
              <% end %>
            </td>
            <td class="<%= td %> tabular-nums text-gray-500"><%= ticket.ticket_number %></td>
            <td class="<%= td %>"><%= render "ui/badge", label: ticket.ticket_category.name, tone: "gray" %></td>
            <td class="<%= td %>"><%= render "ui/status_pill", status: ticket.status %></td>
            <td class="<%= td %> text-right tabular-nums text-gray-500"><%= ticket.reported_at&.strftime("%d %b %Y") %></td>
            <td class="<%= td %> text-right">
              <%= link_to kitchen_cabinet_ticket_path(ticket), class: "inline-flex text-gray-300 group-hover:text-gray-500", aria: { label: "Open #{ticket.person_name}" } do %>
                <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd"/></svg>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <% if @tickets.empty? %>
      <p class="px-6 py-16 text-center text-sm text-gray-400">No tickets match.</p>
    <% end %>
  </div>

  <div class="divide-y divide-gray-100 xl:hidden dark:divide-gray-800">
    <% @tickets.each do |ticket| %>
      <%= render "ticket_card", ticket: ticket %>
    <% end %>
    <% if @tickets.empty? %>
      <p class="px-6 py-16 text-center text-sm text-gray-400">No tickets match.</p>
    <% end %>
  </div>

  <% if @pagy.last > 1 %>
    <nav class="flex items-center justify-between gap-3 border-t border-gray-200 px-6 py-3 dark:border-gray-800">
      <% if @pagy.previous %>
        <%= link_to "← Prev", kitchen_cabinet_tickets_path(category: params[:category], status: params[:status], q: params[:q], page: @pagy.previous), class: page_link %>
      <% else %>
        <span class="text-sm text-gray-300">← Prev</span>
      <% end %>
      <span class="text-sm tabular-nums text-gray-500">Page <%= @pagy.page %> of <%= @pagy.last %></span>
      <% if @pagy.next %>
        <%= link_to "Next →", kitchen_cabinet_tickets_path(category: params[:category], status: params[:status], q: params[:q], page: @pagy.next), class: page_link %>
      <% else %>
        <span class="text-sm text-gray-300">Next →</span>
      <% end %>
    </nav>
  <% end %>
</div>
