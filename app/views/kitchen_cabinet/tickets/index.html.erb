<% content_for :title, @category ? "Kitchen Cabinet — #{@category.name}" : "Kitchen Cabinet" %>
<% new_path = @category ? new_kitchen_cabinet_ticket_path(category: @category.slug) : new_kitchen_cabinet_ticket_path %>

<div class="mb-6 flex flex-wrap items-end justify-between gap-4">
  <div>
    <h1 class="text-title-sm font-semibold text-gray-800 dark:text-white/90">Kitchen Cabinet</h1>
    <% if @category %>
      <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Category: <span class="font-medium text-gray-700 dark:text-gray-300"><%= @category.name %></span></p>
    <% else %>
      <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Tickets in your branch</p>
    <% end %>
  </div>
  <%= render "ui/module_toolbar",
        export_url: kitchen_cabinet_tickets_path(format: :xlsx, category: params[:category], status: params[:status], q: params[:q]),
        new_url: (new_path if current_user.role.can_write?("kitchen_cabinet")),
        new_label: (@category ? "Create #{@category.name}" : "Create ticket") %>
</div>

<%= form_with url: kitchen_cabinet_tickets_path, method: :get, class: "mb-4 flex flex-wrap items-end gap-3" do %>
  <%= hidden_field_tag :category, params[:category] if @category %>
  <div>
    <label class="<%= ta_label_classes %>">Status</label>
    <%= select_tag :status,
          options_for_select([ [ "All", "" ] ] + KitchenCabinet::Ticket.statuses.keys.map { |s| [ s.humanize, s ] }, params[:status]),
          class: "#{ta_field_classes} min-h-11 cursor-pointer" %>
  </div>
  <div class="min-w-48 flex-1">
    <label class="<%= ta_label_classes %>">Search</label>
    <%= text_field_tag :q, params[:q], placeholder: "Person or village", class: "#{ta_field_classes} min-h-11" %>
  </div>
  <%= submit_tag "Filter", class: "#{ta_btn_secondary} min-h-11 cursor-pointer" %>
<% end %>

<% if @status_counts.present? %>
  <div class="<%= ta_card_classes %> mb-4 grid gap-4 p-5 lg:grid-cols-[16rem_1fr] lg:items-center">
    <div>
      <h2 class="mb-3 text-sm font-semibold text-gray-700 dark:text-gray-300">By status</h2>
      <ul class="space-y-1">
        <% @status_counts.each do |label, count| %>
          <li class="flex items-center justify-between text-sm text-gray-600 dark:text-gray-300">
            <span><%= label %></span>
            <span class="tabular-nums font-semibold"><%= count %></span>
          </li>
        <% end %>
      </ul>
    </div>
    <%= pie_chart @status_counts, height: "180px" %>
  </div>
<% end %>

<div class="<%= ta_card_classes %> hidden overflow-hidden xl:block">
  <div class="overflow-x-auto">
    <table class="w-full text-sm">
      <thead class="border-b border-gray-200 text-left text-gray-500 dark:border-gray-800 dark:text-gray-400">
        <tr>
          <th class="px-5 py-3 font-medium">Ticket</th>
          <th class="px-5 py-3 font-medium">Person / village</th>
          <th class="px-5 py-3 font-medium">Category</th>
          <th class="px-5 py-3 font-medium">Status</th>
          <th class="px-5 py-3 font-medium">Reported</th>
        </tr>
      </thead>
      <tbody>
        <% @tickets.each do |ticket| %>
          <tr class="border-b border-gray-100 last:border-0 hover:bg-gray-50 dark:border-gray-800 dark:hover:bg-white/[0.03]">
            <td class="px-5 py-3 font-medium">
              <%= link_to ticket.ticket_number, kitchen_cabinet_ticket_path(ticket),
                    class: "text-gray-800 hover:text-brand-500 dark:text-white/90" %>
            </td>
            <td class="px-5 py-3">
              <div class="text-gray-800 dark:text-white/90"><%= ticket.person_name %></div>
              <div class="text-xs text-gray-500"><%= ticket.village.presence || "—" %></div>
            </td>
            <td class="px-5 py-3"><%= render "ui/badge", label: ticket.ticket_category.name, tone: "brand" %></td>
            <td class="px-5 py-3"><%= render "ui/status_pill", status: ticket.status %></td>
            <td class="px-5 py-3 tabular-nums text-gray-500"><%= ticket.reported_at&.strftime("%d %b %Y") %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <% if @tickets.empty? %>
      <p class="px-5 py-16 text-center text-sm text-gray-400">No tickets match.</p>
    <% end %>
  </div>
</div>

<div class="flex flex-col gap-3 xl:hidden">
  <% @tickets.each do |ticket| %>
    <%= render "ticket_card", ticket: ticket %>
  <% end %>
  <% if @tickets.empty? %>
    <div class="<%= ta_card_classes %> p-10 text-center text-sm text-gray-400">No tickets match.</div>
  <% end %>
</div>

<% if @pagy.last > 1 %>
  <nav class="mt-4 flex items-center justify-between text-sm">
    <% if @pagy.previous %>
      <%= link_to "← Prev", kitchen_cabinet_tickets_path(category: params[:category], status: params[:status], q: params[:q], page: @pagy.previous), class: "font-medium text-brand-500 hover:text-brand-600" %>
    <% else %>
      <span class="text-gray-300">← Prev</span>
    <% end %>
    <span class="text-gray-500">Page <%= @pagy.page %> of <%= @pagy.last %></span>
    <% if @pagy.next %>
      <%= link_to "Next →", kitchen_cabinet_tickets_path(category: params[:category], status: params[:status], q: params[:q], page: @pagy.next), class: "font-medium text-brand-500 hover:text-brand-600" %>
    <% else %>
      <span class="text-gray-300">Next →</span>
    <% end %>
  </nav>
<% end %>
