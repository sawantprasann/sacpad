<% content_for :title, "Beneficiaries" %>
<% list_params = request.query_parameters.slice("category", "name", "village", "reporter", "status", "q") %>
<% page_link = "inline-flex h-9 items-center rounded-lg border border-amber-200 bg-white px-3 text-sm font-medium text-gray-700 hover:bg-amber-50 dark:border-gray-700 dark:bg-gray-900 dark:text-gray-200" %>
<% th = "border-b border-amber-100 px-6 py-3 text-left text-xs font-semibold uppercase tracking-wide text-amber-800 dark:border-gray-800 dark:text-amber-200" %>
<% td = "border-b border-amber-50 px-6 py-4 align-middle dark:border-gray-800" %>
<% tab_btn = "border-b-2 px-4 py-2 text-sm font-semibold" %>

<%= render layout: "ui/campaign_hero", locals: {
        kicker: "Beneficiaries",
        title: "Beneficiaries",
        subtitle: [ @category&.name, pluralize(@pagy.count, "beneficiary") ].compact.join(" · "),
        meta: current_user.organization.name
      } do %><% end %>

  <div class="mt-4 flex flex-wrap items-center justify-end gap-2">
    <%= render "ui/module_toolbar",
          export_url: kitchen_cabinet_tickets_path(list_params.merge(format: :xlsx)),
          new_url: (new_kitchen_cabinet_ticket_path(category: params[:category]) if current_user.role.can_write?("kitchen_cabinet")),
          new_label: "Create ticket",
          accent: "#c2410c",
          accent_ink: "#ffffff" %>
  </div>

  <%= form_with url: kitchen_cabinet_tickets_path, method: :get, class: "mt-6 #{ta_card_classes} p-4 md:p-5" do %>
    <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-6">
      <div>
        <%= label_tag :category, "Category", class: ta_label_classes %>
        <%= select_tag :category,
              options_from_collection_for_select(@categories, :slug, :name, params[:category]),
              include_blank: "Any category",
              class: ta_field_classes %>
      </div>
      <div>
        <%= label_tag :name, "Name", class: ta_label_classes %>
        <%= text_field_tag :name, params[:name], class: ta_field_classes, placeholder: "Person name" %>
      </div>
      <div>
        <%= label_tag :village, "Village", class: ta_label_classes %>
        <%= select_tag :village,
              options_for_select(@villages.map(&:name), params[:village]),
              include_blank: "Any village",
              class: ta_field_classes %>
      </div>
      <div>
        <%= label_tag :reporter, "Reporter name", class: ta_label_classes %>
        <%= text_field_tag :reporter, params[:reporter], class: ta_field_classes, placeholder: "Who reported it" %>
      </div>
      <div>
        <%= label_tag :status, "Status", class: ta_label_classes %>
        <%= select_tag :status,
              options_for_select(KitchenCabinet::Ticket.statuses.keys.map { |s| [ s.humanize, s ] }, params[:status]),
              include_blank: "Any status",
              class: ta_field_classes %>
      </div>
      <div class="flex items-end gap-2">
        <button type="submit" class="<%= ta_btn_primary %> min-h-11 cursor-pointer"
                style="background: var(--org-party-color); color: var(--org-party-contrast)">Filter</button>
        <%= link_to "Clear", kitchen_cabinet_tickets_path, class: "#{ta_btn_secondary} inline-flex min-h-11 items-center" %>
      </div>
    </div>
  <% end %>

  <div class="mt-6" x-data="{ tab: 'line' }">
    <div class="flex gap-1 border-b border-amber-100 dark:border-gray-800" role="tablist" aria-label="Beneficiary charts">
      <% { "line" => "Line", "bar" => "Bar", "pie" => "Pie" }.each do |key, label| %>
        <button type="button" role="tab" id="beneficiaries-tab-<%= key %>"
                @click="tab = '<%= key %>'; $nextTick(() => window.Chartkick && Object.values(Chartkick.charts).forEach((chart) => chart.redraw()))"
                :aria-selected="(tab === '<%= key %>').toString()"
                :class="tab === '<%= key %>' ? 'border-amber-600 text-amber-900 dark:text-amber-200' : 'border-transparent text-gray-500 hover:text-gray-800'"
                class="<%= tab_btn %> cursor-pointer">
          <%= label %>
        </button>
      <% end %>
    </div>
    <div class="mt-4 <%= ta_card_classes %> p-4 md:p-6">
      <div x-show="tab === 'line'" role="tabpanel" aria-labelledby="beneficiaries-tab-line">
        <%= line_chart @charts[:line], id: "beneficiaries-line", height: "280px",
              colors: [ "#c2410c" ], xtitle: "Reported date", ytitle: "Beneficiaries",
              empty: "No beneficiaries match these filters." %>
      </div>
      <div x-show="tab === 'bar'" x-cloak role="tabpanel" aria-labelledby="beneficiaries-tab-bar">
        <%= bar_chart @charts[:bar], id: "beneficiaries-bar", height: "280px",
              colors: [ "#0e7490" ], xtitle: "Category", ytitle: "Beneficiaries",
              empty: "No beneficiaries match these filters." %>
      </div>
      <div x-show="tab === 'pie'" x-cloak role="tabpanel" aria-labelledby="beneficiaries-tab-pie">
        <div class="grid gap-6 lg:grid-cols-2">
          <div>
            <h3 class="mb-3 text-sm font-semibold text-gray-800 dark:text-white/90">By status</h3>
            <%= pie_chart @charts[:pie], id: "beneficiaries-pie", height: "280px", donut: true,
                  empty: "No beneficiaries match these filters." %>
          </div>
          <div>
            <h3 class="mb-3 text-sm font-semibold text-gray-800 dark:text-white/90">By category</h3>
            <%= pie_chart @charts[:pie_by_category], id: "beneficiaries-pie-category", height: "280px", donut: true,
                  empty: "No beneficiaries match these filters." %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="mt-6">
    <%= render layout: "ui/jewel_card", locals: { accent_index: 0, flush: true } do %>
      <h2 class="px-6 pt-4 text-sm font-semibold text-gray-800 dark:text-white/90">List</h2>
      <div class="hidden xl:block">
        <table class="w-full text-sm">
          <thead class="bg-amber-50/80 dark:bg-white/[0.03]">
            <tr>
              <th class="<%= th %>">Name</th>
              <th class="<%= th %>">Ticket</th>
              <th class="<%= th %>">Category</th>
              <th class="<%= th %>">Village</th>
              <th class="<%= th %>">Reporter</th>
              <th class="<%= th %>">Status</th>
              <th class="<%= th %> text-right">Reported</th>
              <th class="<%= th %> w-12"><span class="sr-only">Open</span></th>
            </tr>
          </thead>
          <tbody>
            <% @tickets.each do |ticket| %>
              <tr class="group hover:bg-amber-50/60 last:[&>td]:border-b-0 dark:hover:bg-white/[0.03]">
                <td class="<%= td %>">
                  <%= link_to kitchen_cabinet_ticket_path(ticket), class: "block" do %>
                    <span class="font-medium text-gray-900 dark:text-white/90"><%= ticket.person_name %></span>
                  <% end %>
                </td>
                <td class="<%= td %> tabular-nums text-gray-500"><%= ticket.ticket_number %></td>
                <td class="<%= td %>">
                  <span class="inline-flex rounded-full px-2.5 py-0.5 text-xs font-semibold text-white <%= dashboard_jewel(ticket.ticket_category.display_order.to_i)[:chip] %>"><%= ticket.ticket_category.name %></span>
                </td>
                <td class="<%= td %> text-gray-600 dark:text-gray-300"><%= ticket.village.presence || "—" %></td>
                <td class="<%= td %> text-gray-600 dark:text-gray-300"><%= ticket.owner.name %></td>
                <td class="<%= td %>"><%= render "ui/status_pill", status: ticket.status %></td>
                <td class="<%= td %> text-right tabular-nums text-gray-500"><%= ticket.reported_at&.strftime("%d %b %Y") %></td>
                <td class="<%= td %> text-right">
                  <%= link_to kitchen_cabinet_ticket_path(ticket), class: "inline-flex text-amber-300 group-hover:text-amber-600", aria: { label: "Open #{ticket.person_name}" } do %>
                    <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd"/></svg>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
        <% if @tickets.empty? %>
          <p class="px-6 py-16 text-center text-sm text-amber-800/70">No beneficiaries match.</p>
        <% end %>
      </div>

      <div class="space-y-3 p-4 xl:hidden">
        <% @tickets.each do |ticket| %>
          <%= render "ticket_card", ticket: ticket %>
        <% end %>
        <% if @tickets.empty? %>
          <p class="px-2 py-12 text-center text-sm text-amber-800/70">No beneficiaries match.</p>
        <% end %>
      </div>

      <% if @pagy.last > 1 %>
        <nav class="flex items-center justify-between gap-3 border-t border-amber-100 px-6 py-3 dark:border-gray-800">
          <% if @pagy.previous %>
            <%= link_to "← Prev", kitchen_cabinet_tickets_path(list_params.merge(page: @pagy.previous)), class: page_link %>
          <% else %>
            <span class="text-sm text-gray-300">← Prev</span>
          <% end %>
          <span class="text-sm tabular-nums text-gray-500">Page <%= @pagy.page %> of <%= @pagy.last %></span>
          <% if @pagy.next %>
            <%= link_to "Next →", kitchen_cabinet_tickets_path(list_params.merge(page: @pagy.next)), class: page_link %>
          <% else %>
            <span class="text-sm text-gray-300">Next →</span>
          <% end %>
        </nav>
      <% end %>
    <% end %>
  </div>
