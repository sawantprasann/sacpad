<% content_for :title, t("kitchen_cabinet.edit_title", number: @ticket.ticket_number) %>
<% breadcrumb t("nav.beneficiaries"), kitchen_cabinet_tickets_path %>
<% breadcrumb @ticket.person_name, kitchen_cabinet_ticket_path(@ticket) %>
<% breadcrumb t("nav.edit") %>

<%= render layout: "ui/campaign_hero", locals: {
      kicker: t("nav.beneficiaries"),
      title: t("kitchen_cabinet.edit_title", number: @ticket.ticket_number),
      subtitle: @ticket.person_name
    } do %><% end %>

<div class="mt-6 bg-white dark:bg-gray-900 rounded-lg border border-gray-200 dark:border-gray-700 p-8 max-w-2xl">

  <%= form_with model: @ticket, scope: :ticket, local: true, class: "space-y-6" do |f| %>
    <% if @ticket.errors.any? %>
      <div class="bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-lg p-4">
        <p class="text-red-800 dark:text-red-300 font-semibold"><%= pluralize(@ticket.errors.count, "error") %> prevented saving:</p>
        <ul class="list-disc list-inside text-red-700 dark:text-red-400 mt-2">
          <% @ticket.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <label class="block text-sm font-bold text-gray-700 dark:text-gray-300 mb-2"><%= t("kitchen_cabinet.beneficiary_name") %></label>
      <%= f.text_field :person_name, class: "w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg dark:bg-gray-800 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500" %>
    </div>

    <div>
      <label class="block text-sm font-bold text-gray-700 dark:text-gray-300 mb-2"><%= t("kitchen_cabinet.representative_name") %></label>
      <%= f.text_field :representative_name, class: "w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg dark:bg-gray-800 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500" %>
    </div>

    <div class="grid grid-cols-2 gap-4">
      <div>
        <label class="block text-sm font-bold text-gray-700 dark:text-gray-300 mb-2"><%= t("common.village") %></label>
        <%= render "ui/min_search_select",
              name: "ticket[village]",
              choices: Village.order(:name).pluck(:name),
              selected: @ticket.village,
              blank: t("common.select_village"),
              placeholder: t("common.select_village"),
              search_placeholder: t("kitchen_cabinet.search_villages"),
              empty_text: t("kitchen_cabinet.no_villages") %>
      </div>
      <div>
        <label class="block text-sm font-bold text-gray-700 dark:text-gray-300 mb-2"><%= t("common.mobile") %></label>
        <%= f.telephone_field :mobile, class: "w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg dark:bg-gray-800 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500",
              inputmode: "numeric", pattern: "[0-9]{10}", maxlength: 10, autocomplete: "tel",
              placeholder: t("common.mobile_number_placeholder"), title: t("common.mobile_title"),
              oninput: "this.value = this.value.replace(/\\D/g, '').slice(0, 10)" %>
      </div>
    </div>

    <div>
      <label class="block text-sm font-bold text-gray-700 dark:text-gray-300 mb-2"><%= t("common.description") %></label>
      <%= f.text_area :description, rows: 4, class: "w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg dark:bg-gray-800 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500" %>
    </div>

    <div class="grid grid-cols-2 gap-4">
      <div>
        <label class="block text-sm font-bold text-gray-700 dark:text-gray-300 mb-2"><%= t("kitchen_cabinet.category") %></label>
        <%= f.select :ticket_category_id,
              options_from_collection_for_select(TicketCategory.active.order(:name), :id, :name, @ticket.ticket_category_id),
              {},
              class: "w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg dark:bg-gray-800 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500" %>
      </div>
      <div>
        <label class="block text-sm font-bold text-gray-700 dark:text-gray-300 mb-2"><%= t("kitchen_cabinet.issue_type") %></label>
        <%= f.text_field :nature_of_issue, class: "w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg dark:bg-gray-800 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500" %>
      </div>
    </div>

    <div>
      <label class="block text-sm font-bold text-gray-700 dark:text-gray-300 mb-2"><%= t("common.reported_date") %></label>
      <%= ta_date_picker(form: f, method: :reported_at) %>
    </div>

    <div class="flex gap-3 pt-6 border-t border-gray-200 dark:border-gray-700">
      <%= f.submit t("common.save_changes"), class: "bg-blue-600 hover:bg-blue-700 text-white font-semibold px-6 py-2 rounded-lg transition-colors" %>
      <%= link_to t("common.cancel"), kitchen_cabinet_ticket_path(@ticket), class: "bg-gray-400 hover:bg-gray-500 text-white font-semibold px-6 py-2 rounded-lg transition-colors" %>
    </div>
  <% end %>
</div>
