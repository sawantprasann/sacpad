<% content_for :title, "Edit Ticket #{@ticket.ticket_number}" %>
<% breadcrumb "Kitchen Cabinet", kitchen_cabinet_tickets_path %>
<% breadcrumb @ticket.person_name, kitchen_cabinet_ticket_path(@ticket) %>
<% breadcrumb "Edit" %>

<div class="bg-white dark:bg-gray-900 rounded-lg border border-gray-200 dark:border-gray-700 p-8 max-w-2xl">
  <h1 class="<%= ta_page_title %> mb-6">Edit ticket <%= @ticket.ticket_number %></h1>

  <%= form_with model: @ticket, scope: :ticket, local: true, class: "space-y-6" do |f| %>
    <% if @ticket.errors.any? %>
      <div class="bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-lg p-4">
        <p class="text-red-800 dark:text-red-300 font-semibold"><%= pluralize(@ticket.errors.count, "error") %> prevented saving:</p>
        <ul class="list-disc list-inside text-red-700 dark:text-red-400 mt-2">
          <% @ticket.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <label class="block text-sm font-bold text-gray-700 dark:text-gray-300 mb-2">Person Name</label>
      <%= f.text_field :person_name, class: "w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg dark:bg-gray-800 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500" %>
    </div>

    <div class="grid grid-cols-2 gap-4">
      <div>
        <label class="block text-sm font-bold text-gray-700 dark:text-gray-300 mb-2">Village</label>
        <%= f.select :village,
              options_for_select(Village.order(:name).pluck(:name), @ticket.village),
              { include_blank: "Select a village..." },
              class: "w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg dark:bg-gray-800 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500" %>
      </div>
      <div>
        <label class="block text-sm font-bold text-gray-700 dark:text-gray-300 mb-2">Mobile</label>
        <%= f.text_field :mobile, class: "w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg dark:bg-gray-800 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500" %>
      </div>
    </div>

    <div>
      <label class="block text-sm font-bold text-gray-700 dark:text-gray-300 mb-2">Description</label>
      <%= f.text_area :description, rows: 4, class: "w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg dark:bg-gray-800 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500" %>
    </div>

    <div class="grid grid-cols-2 gap-4">
      <div>
        <label class="block text-sm font-bold text-gray-700 dark:text-gray-300 mb-2">Category</label>
        <%= f.select :ticket_category_id,
              options_from_collection_for_select(TicketCategory.active.order(:name), :id, :name, @ticket.ticket_category_id),
              {},
              class: "w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg dark:bg-gray-800 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500" %>
      </div>
      <div>
        <label class="block text-sm font-bold text-gray-700 dark:text-gray-300 mb-2">Issue Type</label>
        <%= f.text_field :nature_of_issue, class: "w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg dark:bg-gray-800 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500" %>
      </div>
    </div>

    <div>
      <label class="block text-sm font-bold text-gray-700 dark:text-gray-300 mb-2">Reported Date</label>
      <%= f.date_field :reported_at, class: "w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg dark:bg-gray-800 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500" %>
    </div>

    <div class="flex gap-3 pt-6 border-t border-gray-200 dark:border-gray-700">
      <%= f.submit "Save Changes", class: "bg-blue-600 hover:bg-blue-700 text-white font-semibold px-6 py-2 rounded-lg transition-colors" %>
      <%= link_to "Cancel", kitchen_cabinet_ticket_path(@ticket), class: "bg-gray-400 hover:bg-gray-500 text-white font-semibold px-6 py-2 rounded-lg transition-colors" %>
    </div>
  <% end %>
</div>
