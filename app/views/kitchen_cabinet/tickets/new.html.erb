<% action_label = @ticket.ticket_category ? "Create #{@ticket.ticket_category.name}" : "Create ticket" %>
<% content_for :title, action_label %>
<% back_path = @ticket.ticket_category ? kitchen_cabinet_tickets_path(category: @ticket.ticket_category.slug) : kitchen_cabinet_tickets_path %>
<% breadcrumb "Kitchen Cabinet", kitchen_cabinet_tickets_path %>
<% breadcrumb @ticket.ticket_category.name, back_path if @ticket.ticket_category %>
<% breadcrumb action_label %>

<div>
  <div class="mb-6">
    <h1 class="<%= ta_page_title %>"><%= action_label %></h1>
    <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Record the person, the issue, and any photos.</p>
  </div>

  <div class="<%= ta_card_classes %> p-6 md:p-8">
    <%# scope: :ticket — the model is KitchenCabinet::Ticket, so without this the params would be
        nested under `kitchen_cabinet_ticket` and the controller's require(:ticket) would miss them. %>
    <%= form_with model: @ticket, scope: :ticket, url: kitchen_cabinet_tickets_path, method: :post, multipart: true do |f| %>
      <% if @ticket.errors.any? %>
        <div class="mb-6 rounded-lg border border-error-500/30 bg-error-50 px-4 py-2 text-sm text-error-500"><%= @ticket.errors.full_messages.to_sentence %></div>
      <% end %>

      <%= f.hidden_field :ticket_category_id %>

      <div class="mb-6 grid grid-cols-1 gap-4 md:grid-cols-2">
        <div>
          <%= f.label :person_name, "Person / represents", class: ta_label_classes %>
          <%= f.text_field :person_name, class: "#{ta_field_classes} min-h-11", autofocus: true %>
        </div>
        <div>
          <%= f.label :village, "Village / ward", class: ta_label_classes %>
          <%= f.select :village,
                options_for_select(Village.order(:name).pluck(:name), @ticket.village),
                { include_blank: "Select a village..." },
                class: "#{ta_field_classes} min-h-11" %>
        </div>
        <div>
          <%= f.label :mobile, "Mobile number", class: ta_label_classes %>
          <%= f.telephone_field :mobile, class: "#{ta_field_classes} min-h-11" %>
        </div>
        <div>
          <%= f.label :nature_of_issue, class: ta_label_classes %>
          <%= f.text_field :nature_of_issue, class: "#{ta_field_classes} min-h-11" %>
        </div>
        <div>
          <%= f.label :reported_value, "Reported value", class: ta_label_classes %>
          <%= f.number_field :reported_value, step: "0.01", class: "#{ta_field_classes} min-h-11" %>
        </div>
        <div>
          <%= f.label :reported_at, "Reported date", class: ta_label_classes %>
          <%= f.date_field :reported_at, class: "#{ta_field_classes} min-h-11" %>
        </div>
        <div class="md:col-span-2">
          <%= f.label :description, class: ta_label_classes %>
          <%= f.text_area :description, rows: 5, class: ta_field_classes %>
        </div>
        <div class="md:col-span-2">
          <%= f.label :attachments, "Photos", class: ta_label_classes %>
          <div class="rounded-xl border border-dashed border-gray-300 p-4 dark:border-gray-700">
            <%= f.file_field :attachments, multiple: true, accept: "image/*",
                  class: "block w-full cursor-pointer text-sm text-gray-600 file:mr-3 file:min-h-11 file:cursor-pointer file:rounded-lg file:border-0 file:bg-gray-100 file:px-4 file:py-2 file:text-sm file:font-medium" %>
            <p class="mt-2 text-xs text-gray-500">Add one or more photos of the issue.</p>
          </div>
        </div>
      </div>

      <div class="flex flex-wrap gap-3 border-t border-gray-100 pt-6 dark:border-gray-800">
        <button type="submit" class="<%= ta_btn_primary %> min-h-11 cursor-pointer"
                style="background: var(--org-party-color); color: var(--org-party-contrast)"><%= action_label %></button>
        <%= link_to "Cancel", back_path, class: "#{ta_btn_secondary} inline-flex items-center min-h-11 cursor-pointer" %>
      </div>
    <% end %>
  </div>
</div>
