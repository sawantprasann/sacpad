<%# Open tickets by status, scoped to the viewer's subtree. Names sit under the ring, each with an arrow in that status color. %>
<% scope = policy_scope(KitchenCabinet::Ticket) %>
<% counts = KitchenCabinet::Ticket.statuses.keys.index_with { |status| scope.where(status: status).count } %>
<% total = counts.values.sum %>
<% slices = counts.filter_map { |status, count| [ status.humanize, count, status_color(status) ] if count.positive? } %>
<% pie = slices.to_h { |label, count, _color| [ label, count ] } %>

<% if total.positive? %>
  <div class="flex flex-col items-center gap-4 sm:flex-row sm:items-center sm:gap-2">
    <div class="w-full max-w-[13.5rem] shrink-0">
      <%= pie_chart pie, id: "dashboard-tickets-status", height: "200px", donut: true,
            colors: slices.map(&:last),
            library: dashboard_pie_library %>
    </div>
    <%= render "ui/slice_legend", slices: slices, total: total %>
  </div>
<% else %>
  <p class="text-xs text-gray-400">No tickets yet.</p>
<% end %>
<%= link_to "View tickets", kitchen_cabinet_tickets_path,
      class: "mt-3 inline-block text-xs #{ta_text_link}" %>
