<%# Kitchen Cabinet dashboard widget body (Story 1.8, FR50): open tickets by status, scoped to the
    viewer's subtree via policy_scope (org ∩ subtree ∩ kept). Counts use tabular figures (UX-DR6). %>
<% scope = policy_scope(KitchenCabinet::Ticket) %>
<% counts = KitchenCabinet::Ticket.statuses.keys.index_with { |status| scope.where(status: status).count } %>

<% total = counts.values.sum %>
<% bar = { "open" => "#64748b", "in_progress" => "#2970ff", "closed" => "#039855", "blocked" => "#b42318" } %>
<% if total.positive? %>
  <div class="mt-4 flex h-2 overflow-hidden rounded-full bg-gray-100 dark:bg-white/10" role="img" aria-label="Share of tickets by status">
    <% counts.each do |status, count| %>
      <% next if count.zero? %>
      <span class="h-full" style="width: <%= (count.to_f / total * 100).round(1) %>%; background: <%= bar[status] %>"></span>
    <% end %>
  </div>
<% end %>

<ul class="mt-4 space-y-2">
  <% counts.each do |status, count| %>
    <li class="flex items-center justify-between">
      <%= render "ui/status_pill", status: status %>
      <span class="tabular-nums text-sm font-semibold text-gray-700 dark:text-gray-300"><%= count %></span>
    </li>
  <% end %>
</ul>

<%= link_to "View tickets", kitchen_cabinet_tickets_path,
      class: "mt-3 inline-block text-xs font-medium text-brand-500 hover:text-brand-600" %>
