<% content_for :title, t("kitchen_cabinet.close_title", number: @ticket.ticket_number) %>

<%= render layout: "ui/campaign_hero", locals: {
      kicker: t("nav.beneficiaries"),
      title: t("kitchen_cabinet.close_ticket"),
      subtitle: "#{@ticket.ticket_number} · #{@ticket.person_name}"
    } do %><% end %>

<div class="mx-auto mt-6 max-w-xl">

  <%= form_with url: kitchen_cabinet_ticket_closure_path(@ticket), method: :post, class: "space-y-6" do %>
    <div class="<%= ta_card_classes %> p-6">
      <h2 class="mb-2 text-sm font-semibold text-gray-700 dark:text-gray-300"><%= t("kitchen_cabinet.step_one") %></h2>
      <p class="mb-4 text-sm text-gray-500 dark:text-gray-400"><%= t("kitchen_cabinet.step_one_help") %></p>
      <label class="<%= ta_label_classes %>"><%= t("kitchen_cabinet.closure_date") %></label>
      <%= ta_date_picker(name: "closure_date", id: "closure_date", value: Date.current) %>
    </div>

    <div class="<%= ta_card_classes %> p-6">
      <h2 class="mb-2 text-sm font-semibold text-gray-700 dark:text-gray-300"><%= t("kitchen_cabinet.step_two_html", optional: t("common.optional")).html_safe %></h2>
      <p class="mb-4 text-sm text-gray-500 dark:text-gray-400"><%= t("kitchen_cabinet.step_two_help") %></p>
      <div class="mb-4">
        <label class="<%= ta_label_classes %>"><%= t("common.voter_id") %></label>
        <%= text_field_tag :voter_id, @ticket.voter_id, placeholder: t("common.voter_id"), class: "#{ta_field_classes} min-h-11" %>
        <% if @ticket.voter_id.present? %>
          <p class="mt-2 text-xs text-gray-500"><%= t("kitchen_cabinet.matched_help") %></p>
        <% end %>
      </div>
      <%= render "ui/sentiment_picker" %>
    </div>

    <div class="flex gap-3">
      <%= submit_tag t("kitchen_cabinet.close_ticket"), class: "#{ta_btn_primary} min-h-11" %>
      <%= link_to t("common.cancel"), kitchen_cabinet_ticket_path(@ticket), class: "#{ta_btn_secondary} inline-flex items-center min-h-11" %>
    </div>
  <% end %>
</div>
