<div class="campaign-sheet overflow-hidden">
  <div class="border-b border-gray-200 px-5 py-4 dark:border-gray-800">
    <h2 class="text-base font-semibold text-gray-900 dark:text-white/90"><%= election.heading %></h2>
  </div>
  <div class="overflow-x-auto">
    <table class="campaign-table w-full text-sm">
      <thead class="border-b border-gray-200 text-left text-gray-500 dark:border-gray-800 dark:text-gray-400">
        <tr>
          <th class="px-5 py-3 font-medium">Party</th>
          <th class="px-5 py-3 font-medium">Candidate</th>
          <th class="px-5 py-3 text-right font-medium">Votes</th>
          <th class="px-5 py-3 text-right font-medium">%</th>
          <th class="px-5 py-3 text-right font-medium">±%</th>
        </tr>
      </thead>
      <tbody>
        <% election.candidates.each do |candidate| %>
          <tr class="border-b border-gray-100 dark:border-gray-800">
            <td class="px-5 py-3 text-gray-800 dark:text-white/90">
              <span class="inline-flex items-center gap-2">
                <span class="inline-block h-4 w-1.5 rounded-sm" style="background-color: <%= party_swatch(candidate.party) %>"></span>
                <%= candidate.party.abbreviation.presence || candidate.party.name %>
              </span>
            </td>
            <td class="px-5 py-3 text-gray-700 dark:text-gray-300"><%= candidate.candidate_name %></td>
            <td class="px-5 py-3 text-right tabular-nums text-gray-800 dark:text-white/90"><%= election_count(candidate.votes) %></td>
            <td class="px-5 py-3 text-right tabular-nums text-gray-700 dark:text-gray-300"><%= election_percent(candidate.vote_percent) %></td>
            <td class="px-5 py-3 text-right tabular-nums"><%= election_change_tag(candidate.vote_change, fresh: candidate.new_contestant?) %></td>
          </tr>
        <% end %>
        <tr class="border-b border-gray-100 bg-gray-50 dark:border-gray-800 dark:bg-white/[0.02]">
          <td class="px-5 py-3 text-right font-medium text-gray-700 dark:text-gray-300" colspan="2">Margin of victory</td>
          <td class="px-5 py-3 text-right tabular-nums text-gray-800 dark:text-white/90"><%= election_count(election.margin_votes) %></td>
          <td class="px-5 py-3 text-right tabular-nums text-gray-700 dark:text-gray-300"><%= election_percent(election.margin_percent) %></td>
          <td class="px-5 py-3 text-right tabular-nums"><%= election_change_tag(election.margin_change) %></td>
        </tr>
        <tr class="border-b border-gray-100 dark:border-gray-800">
          <td class="px-5 py-3 text-right font-medium text-gray-700 dark:text-gray-300" colspan="2">Turnout</td>
          <td class="px-5 py-3 text-right tabular-nums text-gray-800 dark:text-white/90"><%= election_count(election.turnout_votes) %></td>
          <td class="px-5 py-3 text-right tabular-nums text-gray-700 dark:text-gray-300"><%= election_percent(election.turnout_percent) %></td>
          <td class="px-5 py-3 text-right tabular-nums"><%= election_change_tag(election.turnout_change) %></td>
        </tr>
        <tr class="border-b border-gray-100 dark:border-gray-800">
          <td class="px-5 py-3 text-right font-medium text-gray-700 dark:text-gray-300" colspan="2">Total valid votes</td>
          <td class="px-5 py-3 text-right tabular-nums text-gray-800 dark:text-white/90"><%= election_count(election.valid_votes) %></td>
          <td colspan="2"></td>
        </tr>
        <tr class="border-b border-gray-100 dark:border-gray-800">
          <td class="px-5 py-3 text-right font-medium text-gray-700 dark:text-gray-300" colspan="2">Registered electors</td>
          <td class="px-5 py-3 text-right tabular-nums text-gray-800 dark:text-white/90"><%= election_count(election.registered_electors) %></td>
          <td></td>
          <td class="px-5 py-3 text-right tabular-nums"><%= election_change_tag(election.electors_change) %></td>
        </tr>
        <tr>
          <td class="px-5 py-3 font-semibold text-gray-900 dark:text-white/90" colspan="2">
            <span class="inline-flex items-center gap-2">
              <span class="inline-block h-4 w-1.5 rounded-sm" style="background-color: <%= party_swatch(election.winning_candidate&.party) %>"></span>
              <%= election.result_label || "—" %>
            </span>
          </td>
          <td class="px-5 py-3 text-right font-medium text-gray-700 dark:text-gray-300" colspan="2">Swing</td>
          <td class="px-5 py-3 text-right tabular-nums"><%= election_change_tag(election.swing) %></td>
        </tr>
      </tbody>
    </table>
  </div>
</div>
