<%= turbo_frame_tag "election-result" do %>
<div>
  <%= render layout: "ui/campaign_hero", locals: {
        kicker: t("election.kicker"),
        title: election.heading,
        subtitle: election_outcome_sentence(election),
        meta: election.constituency&.display_name
      } do %><% end %>

  <% if elections.any? %>
    <div class="mt-4 flex flex-wrap gap-2">
      <% elections.each do |item| %>
        <% if item == election %>
          <span class="<%= election_year_selected_class %>" style="<%= election_year_selected_style %>" aria-current="true" aria-disabled="true"><%= item.year %></span>
        <% else %>
          <%= link_to item.year, election_result_path(election_year: item.year), class: election_year_link_class, data: election_year_link_data %>
        <% end %>
      <% end %>
    </div>
  <% end %>

  <% slices = election_share_slices(election) %>
  <% pie = slices.to_h { |label, share, _color| [ label, share ] } %>
  <% winner = election.winning_candidate %>
  <% result_jewel = dashboard_jewel(0) %>
  <% margin_jewel = dashboard_jewel(4) %>
  <% turnout_jewel = dashboard_jewel(1) %>

  <div class="mt-4 grid grid-cols-1 gap-3 lg:grid-cols-3">
    <article class="relative overflow-hidden rounded-2xl bg-white p-5 shadow-theme-md ring-1 <%= result_jewel[:ring] %> dark:bg-gray-900 dark:ring-white/10">
      <span class="absolute inset-x-0 top-0 h-1.5 bg-gradient-to-r <%= result_jewel[:bar] %>"></span>
      <span class="pointer-events-none absolute -top-8 -right-8 h-24 w-24 rounded-full opacity-70 <%= result_jewel[:wash] %>"></span>
      <p class="text-xs font-semibold uppercase tracking-[0.16em] text-amber-800 dark:text-amber-200"><%= t("election.result") %></p>
      <p class="mt-3 text-lg font-semibold text-gray-900 dark:text-white/90"><%= winner&.candidate_name || "—" %></p>
      <p class="mt-1 text-sm text-gray-600 dark:text-gray-300"><%= election_result_line(election) %></p>
      <p class="mt-3 inline-flex items-center gap-2 rounded-full px-2.5 py-1 text-xs font-semibold text-gray-800 <%= result_jewel[:wash] %>">
        <span class="inline-block h-3 w-1.5 rounded-sm" style="background-color: <%= party_swatch(winner&.party) %>"></span>
        <%= election.result_label || "—" %>
      </p>
    </article>
    <article class="relative overflow-hidden rounded-2xl bg-white p-5 shadow-theme-md ring-1 <%= margin_jewel[:ring] %> dark:bg-gray-900 dark:ring-white/10">
      <span class="absolute inset-x-0 top-0 h-1.5 bg-gradient-to-r <%= margin_jewel[:bar] %>"></span>
      <span class="pointer-events-none absolute -top-8 -right-8 h-24 w-24 rounded-full opacity-70 <%= margin_jewel[:wash] %>"></span>
      <p class="text-xs font-semibold uppercase tracking-[0.16em] text-amber-800 dark:text-amber-200"><%= t("election.margin") %></p>
      <p class="mt-3 text-2xl font-semibold tabular-nums text-gray-900 dark:text-white/90"><%= election_count(election.margin_votes) %> <span class="text-base font-medium text-gray-500"><%= t("election.votes") %></span></p>
      <p class="mt-1 text-sm text-gray-600 dark:text-gray-300"><%= t("election.of_valid", percent: election_percent(election.margin_percent)) %></p>
      <p class="mt-3 text-sm text-gray-600 dark:text-gray-300"><%= t("election.since_previous") %> <%= election_change_tag(election.margin_change) %></p>
    </article>
    <article class="relative overflow-hidden rounded-2xl bg-white p-5 shadow-theme-md ring-1 <%= turnout_jewel[:ring] %> dark:bg-gray-900 dark:ring-white/10">
      <span class="absolute inset-x-0 top-0 h-1.5 bg-gradient-to-r <%= turnout_jewel[:bar] %>"></span>
      <span class="pointer-events-none absolute -top-8 -right-8 h-24 w-24 rounded-full opacity-70 <%= turnout_jewel[:wash] %>"></span>
      <p class="text-xs font-semibold uppercase tracking-[0.16em] text-amber-800 dark:text-amber-200"><%= t("election.turnout") %></p>
      <p class="mt-3 text-2xl font-semibold tabular-nums text-gray-900 dark:text-white/90"><%= election_percent(election.turnout_percent) %></p>
      <div class="mt-3 h-2.5 overflow-hidden rounded-full bg-cyan-100 dark:bg-white/10">
        <div class="h-full rounded-full bg-gradient-to-r <%= turnout_jewel[:bar] %>" style="width: <%= election_bar_width(election.turnout_percent) %>%"></div>
      </div>
      <p class="mt-3 text-sm text-gray-600 dark:text-gray-300"><%= t("election.electors_of", votes: election_count(election.turnout_votes), electors: election_count(election.registered_electors)) %></p>
    </article>
  </div>

  <% share_jewel = dashboard_jewel(4) %>
  <div class="relative mt-4 grid grid-cols-1 gap-4 overflow-hidden rounded-2xl bg-white p-5 shadow-theme-md ring-1 <%= share_jewel[:ring] %> dark:bg-gray-900 dark:ring-white/10 lg:grid-cols-[16rem_1fr] lg:items-center">
    <span class="absolute inset-x-0 top-0 h-1.5 bg-gradient-to-r <%= share_jewel[:bar] %>"></span>
    <div>
      <p class="mb-2 text-xs font-semibold uppercase tracking-[0.16em] text-amber-800 dark:text-amber-200"><%= t("election.vote_share") %></p>
      <%= pie_chart pie, id: "election-share-#{election.id}", height: "210px", donut: true,
            colors: slices.map(&:last),
            suffix: "%",
            library: dashboard_pie_library %>
    </div>
    <div class="space-y-3">
      <% election.candidates.each_with_index do |candidate, index| %>
        <% color = slices[index]&.last || party_swatch(candidate.party) %>
        <div>
          <div class="mb-1 flex items-baseline justify-between gap-3">
            <p class="min-w-0 truncate text-sm text-gray-800 dark:text-white/90">
              <span class="font-semibold"><%= candidate.party.abbreviation.presence || candidate.party.name %></span>
              <span class="text-gray-500 dark:text-gray-400"><%= candidate.candidate_name %></span>
            </p>
            <p class="shrink-0 text-sm font-semibold tabular-nums text-gray-900 dark:text-white"><%= election_percent(candidate.vote_percent) %></p>
          </div>
          <div class="h-2.5 overflow-hidden rounded-full bg-gray-100 dark:bg-white/10">
            <div class="h-full rounded-full" style="width: <%= election_bar_width(candidate.vote_percent) %>%; background-color: <%= color %>"></div>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <% if elections.size > 1 %>
    <div class="relative mt-4 overflow-hidden rounded-2xl bg-white p-5 shadow-theme-md ring-1 <%= share_jewel[:ring] %> dark:bg-gray-900 dark:ring-white/10">
      <span class="absolute inset-x-0 top-0 h-1.5 bg-gradient-to-r <%= share_jewel[:bar] %>"></span>
      <p class="text-xs font-semibold uppercase tracking-[0.16em] text-amber-800 dark:text-amber-200"><%= t("election.share_by_year") %></p>
      <div class="mt-3 space-y-3">
        <% elections.each do |item| %>
          <% share = item.winning_candidate&.vote_percent %>
          <% row = capture do %>
            <div class="mb-1 flex items-baseline justify-between gap-3 text-sm">
              <span class="font-medium <%= item == election ? "text-gray-900 dark:text-white" : "text-gray-500" %>"><%= item.year %> · <%= item.result_label || "—" %></span>
              <span class="tabular-nums text-gray-700 dark:text-gray-300"><%= election_percent(share) %></span>
            </div>
            <div class="h-2.5 overflow-hidden rounded-full bg-gray-100 dark:bg-white/10">
              <div class="h-full rounded-full" style="width: <%= election_bar_width(share) %>%; background-color: <%= party_swatch(item.winning_candidate&.party) %>"></div>
            </div>
          <% end %>
          <% if item == election %>
            <div class="block"><%= row %></div>
          <% else %>
            <%= link_to election_result_path(election_year: item.year), class: "block", data: election_year_link_data do %><%= row %><% end %>
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>

  <div class="mt-4">
    <%= render "constituency_elections/result_table", election: election %>
  </div>
</div>
<% end %>
