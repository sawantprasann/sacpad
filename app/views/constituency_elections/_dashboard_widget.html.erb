<%# Latest vote share for the organization's constituency. The full result lives on the election page. %>
<% election = @constituency_election %>
<% slices = election_vote_slices(election) %>
<% total = slices.sum { |_label, votes, _color| votes } %>
<% pie = slices.to_h { |label, votes, _color| [ label, votes ] } %>

<p class="text-sm text-gray-600 dark:text-gray-300"><%= election.year %> · <%= election_outcome_sentence(election) %></p>
<% if total.positive? %>
  <div class="mt-4 flex flex-col items-center gap-4 sm:flex-row sm:items-center sm:gap-2">
    <div class="w-full max-w-[13.5rem] shrink-0">
      <%= pie_chart pie, id: "dashboard-election-share", height: "200px", donut: true,
            colors: slices.map(&:last),
            library: dashboard_pie_library %>
    </div>
    <%= render "ui/slice_legend", slices: slices, total: total %>
  </div>
<% end %>
<%= link_to "View election result", election_result_path, class: "mt-3 inline-block text-xs #{ta_text_link}" %>
