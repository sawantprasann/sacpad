<% headline = @activity.detail_headline.presence || @activity.category_label %>
<% content_for :title, "Edit #{headline}" %>
<% breadcrumb t("nav.cadre_program"), cadre_program_activities_path %>
<% breadcrumb @activity.category_label, cadre_program_activities_path(category: @activity.category) %>
<% breadcrumb headline, cadre_program_activity_path(@activity) %>
<% breadcrumb t("nav.edit") %>

<div x-data='<%= { category: @activity.category.to_s, labels: CadreProgram::CadreActivity.localized_category_labels }.to_json %>'>
  <%= render layout: "ui/campaign_hero", locals: {
        kicker: t("nav.cadre_program"),
        title: "Edit #{headline}",
        subtitle: @activity.category_label
      } do %><% end %>

  <%= render "form",
        url: cadre_program_activity_path(@activity),
        method: :patch,
        submit_label: "Save changes",
        cancel_path: cadre_program_activity_path(@activity) %>
</div>
