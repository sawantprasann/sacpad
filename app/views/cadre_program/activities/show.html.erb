<% headline = @activity.detail_headline.presence || @activity.category_label %>
<% content_for :title, "#{headline} · #{@activity.category_label}" %>
<% list_path = cadre_program_activities_path(category: @activity.category) %>
<% breadcrumb t("nav.cadre_program"), cadre_program_activities_path %>
<% breadcrumb @activity.category_label, list_path %>
<% breadcrumb headline %>

<%= render layout: "ui/campaign_hero", locals: {
      kicker: t("nav.cadre_program"),
      title: headline,
      subtitle: @activity.category_label,
      meta: "Logged by #{@activity.owner.name} · #{@activity.created_at.strftime("%d %b %Y")} · #{pluralize(@activity.photos.size, "photo")}"
    } do %><% end %>

<div class="mt-4 mb-4 flex flex-wrap items-center justify-between gap-3">
  <p class="text-sm text-gray-500 dark:text-gray-400">
    Last updated <%= @activity.updated_at.strftime("%d %b %Y, %H:%M") %>
  </p>
  <div class="flex flex-wrap items-center justify-end gap-2">
    <% if policy(@activity).edit? %>
      <%= icon_action_link :edit, edit_cadre_program_activity_path(@activity) %>
    <% end %>
    <%= link_to "Back to list", list_path, class: "#{ta_btn_secondary} min-h-11 cursor-pointer" %>
  </div>
</div>

<div class="grid grid-cols-1 items-start gap-4 xl:grid-cols-3">
  <div class="xl:col-span-2">
    <%= render "detail", activity: @activity %>
  </div>

  <div class="flex flex-col gap-4">
    <section class="<%= ta_card_classes %> p-6">
      <h2 class="border-b border-gray-100 pb-3 text-sm font-semibold text-gray-800 dark:border-gray-800 dark:text-white/90">Media Value</h2>
      <p class="mt-4 whitespace-pre-line text-sm leading-6 text-gray-800 dark:text-white/90"><%= linkify_text(@activity.impact_notes) || "—" %></p>
    </section>

    <section class="<%= ta_card_classes %> p-6">
      <h2 class="border-b border-gray-100 pb-3 text-sm font-semibold text-gray-800 dark:border-gray-800 dark:text-white/90">Photos</h2>
      <% if @activity.photos.attached? %>
        <div class="mt-4 grid grid-cols-2 gap-3">
          <% @activity.photos.each do |photo| %>
            <% if photo.image? %>
              <%= image_tag photo, class: "aspect-square w-full rounded-xl object-cover" %>
            <% else %>
              <%= link_to photo.filename, rails_blob_path(photo, disposition: "attachment"), class: "text-sm #{ta_text_link}" %>
            <% end %>
          <% end %>
        </div>
      <% else %>
        <p class="mt-4 rounded-xl border border-dashed border-gray-200 px-4 py-8 text-center text-sm text-gray-400 dark:border-gray-700">No photos attached.</p>
      <% end %>
    </section>
  </div>
</div>
