<% headline = @activity.detail_headline.presence || @activity.category_label %>
<% content_for :title, "#{headline} · #{@activity.category_label}" %>
<% list_path = cadre_program_activities_path(category: @activity.category) %>

<nav aria-label="Breadcrumb" class="mb-5">
  <ol class="flex flex-wrap items-center gap-1.5 text-sm">
    <li><%= link_to "Dashboard", root_path, class: "text-gray-500 hover:text-gray-800 dark:text-gray-400 dark:hover:text-white/90" %></li>
    <li aria-hidden="true" class="text-gray-300 dark:text-gray-600">/</li>
    <li><%= link_to "Cadre Program", cadre_program_activities_path, class: "text-gray-500 hover:text-gray-800 dark:text-gray-400 dark:hover:text-white/90" %></li>
    <li aria-hidden="true" class="text-gray-300 dark:text-gray-600">/</li>
    <li><%= link_to @activity.category_label, list_path, class: "text-gray-500 hover:text-gray-800 dark:text-gray-400 dark:hover:text-white/90" %></li>
    <li aria-hidden="true" class="text-gray-300 dark:text-gray-600">/</li>
    <li class="font-medium text-gray-800 dark:text-white/90" aria-current="page"><%= headline %></li>
  </ol>
</nav>

<header class="<%= ta_card_classes %> mb-4 overflow-hidden">
  <div class="h-1" style="background: var(--org-party-color)"></div>
  <div class="flex flex-wrap items-start justify-between gap-4 p-6">
    <div class="min-w-0">
      <div class="flex flex-wrap items-center gap-3">
        <h1 class="text-title-sm font-semibold text-gray-800 dark:text-white/90"><%= headline %></h1>
        <%= render "ui/badge", label: @activity.category_label, tone: "brand" %>
      </div>
      <dl class="mt-4 flex flex-wrap gap-x-8 gap-y-3 text-sm">
        <div>
          <dt class="text-xs font-medium tracking-wide text-gray-400 uppercase">Logged by</dt>
          <dd class="mt-0.5 font-medium text-gray-800 dark:text-white/90"><%= @activity.owner.name %></dd>
        </div>
        <div>
          <dt class="text-xs font-medium tracking-wide text-gray-400 uppercase">Date</dt>
          <dd class="mt-0.5 font-medium tabular-nums text-gray-800 dark:text-white/90"><%= @activity.created_at.strftime("%d %b %Y") %></dd>
        </div>
        <div>
          <dt class="text-xs font-medium tracking-wide text-gray-400 uppercase">Photos</dt>
          <dd class="mt-0.5 font-medium tabular-nums text-gray-800 dark:text-white/90"><%= @activity.photos.size %></dd>
        </div>
      </dl>
    </div>
    <%= link_to "Back to list", list_path, class: "#{ta_btn_secondary} min-h-11 cursor-pointer" %>
  </div>
</header>

<div class="grid grid-cols-1 items-start gap-4 xl:grid-cols-3">
  <div class="xl:col-span-2">
    <%= render "detail", activity: @activity %>
  </div>

  <div class="flex flex-col gap-4">
    <section class="<%= ta_card_classes %> p-6">
      <h2 class="border-b border-gray-100 pb-3 text-sm font-semibold text-gray-800 dark:border-gray-800 dark:text-white/90">Media Value</h2>
      <p class="mt-4 whitespace-pre-line text-sm leading-6 text-gray-800 dark:text-white/90"><%= @activity.impact_notes.presence || "—" %></p>
    </section>

    <section class="<%= ta_card_classes %> p-6">
      <h2 class="border-b border-gray-100 pb-3 text-sm font-semibold text-gray-800 dark:border-gray-800 dark:text-white/90">Photos</h2>
      <% if @activity.photos.attached? %>
        <div class="mt-4 grid grid-cols-2 gap-3">
          <% @activity.photos.each do |photo| %>
            <% if photo.image? %>
              <%= image_tag photo, class: "aspect-square w-full rounded-xl object-cover" %>
            <% else %>
              <%= link_to photo.filename, rails_blob_path(photo, disposition: "attachment"), class: "text-sm text-brand-500 hover:text-brand-600" %>
            <% end %>
          <% end %>
        </div>
      <% else %>
        <p class="mt-4 rounded-xl border border-dashed border-gray-200 px-4 py-8 text-center text-sm text-gray-400 dark:border-gray-700">No photos attached.</p>
      <% end %>
    </section>
  </div>
</div>
