<% detail = activity.matching_detail %>
<% if detail %>
  <% wide = %w[notes point_of_discussion work_submitted resolution] %>
  <div class="<%= ta_card_classes %> p-6">
    <h2 class="border-b border-gray-100 pb-3 text-sm font-semibold text-gray-800 dark:border-gray-800 dark:text-white/90"><%= t("cadre_program.sections.details") %></h2>
    <dl class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-2">
      <% case detail
         when CadreProgram::CadreActivityProgram %>
        <% rows = [
             [ :program_name, detail.program_name ],
             [ :occasion, detail.occasion ],
             [ :location, detail.location ],
             [ :occurred_on, l_day(detail.occurred_on) ],
             [ :host, detail.host ],
             [ :notes, detail.notes ]
           ] %>
      <% when CadreProgram::CadreActivityLeadershipMeet %>
        <% rows = [
             [ :whom_to_meet, detail.whom_to_meet ],
             [ :point_of_discussion, detail.point_of_discussion ],
             [ :work_submitted, detail.work_submitted ],
             [ :submitted_on, l_day(detail.submitted_on) ],
             [ :follow_up_on, l_day(detail.followup_on) ],
             [ :resolution, detail.resolution_notes ]
           ] %>
      <% when CadreProgram::CadreActivityPartyProgramHosted %>
        <% rows = [
             [ :program_name, detail.program_name ],
             [ :hosted_on, l_day(detail.hosted_on) ],
             [ :location, detail.location ],
             [ :total_attendees, detail.total_attendees ],
             [ :print_media, detail.print_media ],
             [ :electronic_media, detail.electronic_media ]
           ] %>
      <% when CadreProgram::CadreActivityOneToOne %>
        <% karyakarta = detail.karyakarta_user&.name || detail.karyakarta_name_text %>
        <% rows = [
             [ :karyakarta, karyakarta ],
             [ :assignment, detail.assignment ],
             [ :resolved, detail.resolved? ? t("common.yes") : t("common.no") ],
             [ :from, l_day(detail.from_date) ],
             [ :to, l_day(detail.to_date) ],
             [ :notes, detail.notes ]
           ] %>
      <% end %>
      <% rows.each do |key, value| %>
        <div class="<%= "sm:col-span-2" if wide.include?(key.to_s) %> rounded-xl bg-gray-50 px-4 py-3 dark:bg-white/[0.03]">
          <dt class="text-xs font-medium tracking-wide text-gray-400 uppercase"><%= t("cadre_program.columns.#{key}") %></dt>
          <dd class="mt-1 whitespace-pre-line text-sm text-gray-800 dark:text-white/90"><%= value.presence || "—" %></dd>
        </div>
      <% end %>
    </dl>
  </div>
<% end %>
