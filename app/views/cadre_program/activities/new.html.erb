<% action_label = @activity.category_label ? "Create #{@activity.category_label}" : "Create activity" %>
<% content_for :title, action_label %>
<% back_path = @activity.category ? cadre_program_activities_path(category: @activity.category) : cadre_program_activities_path %>
<% breadcrumb "Cadre Program", cadre_program_activities_path %>
<% breadcrumb @activity.category_label, back_path if @activity.category_label %>
<% breadcrumb action_label %>

<div x-data='<%= { category: @activity.category.to_s, labels: CadreProgram::CadreActivity::CATEGORY_LABELS }.to_json %>'>
  <%= render layout: "ui/campaign_hero", locals: {
        kicker: "Cadre Program",
        title: action_label,
        subtitle: "Record what happened, the political impact, and any photos.",
        title_bind: "labels[category] ? ('Create ' + labels[category]) : 'Create activity'"
      } do %><% end %>

  <%= render "form",
        url: cadre_program_activities_path,
        method: :post,
        submit_label: action_label,
        cancel_path: back_path %>
</div>
