<% action_label = @activity.category_label ? "#{t("cadre_program.create_prefix")}#{@activity.category_label}" : t("cadre_program.create_activity") %>
<% content_for :title, action_label %>
<% back_path = @activity.category ? cadre_program_activities_path(category: @activity.category) : cadre_program_activities_path %>
<% breadcrumb t("nav.cadre_program"), cadre_program_activities_path %>
<% breadcrumb @activity.category_label, back_path if @activity.category_label %>
<% breadcrumb action_label %>

<div x-data='<%= { category: @activity.category.to_s, labels: CadreProgram::CadreActivity.localized_category_labels, createPrefix: t("cadre_program.create_prefix"), createFallback: t("cadre_program.create_activity") }.to_json %>'>
  <%= render layout: "ui/campaign_hero", locals: {
        kicker: t("nav.cadre_program"),
        title: action_label,
        subtitle: "Record what happened, the political impact, and any photos.",
        title_bind: "labels[category] ? (createPrefix + labels[category]) : createFallback"
      } do %><% end %>

  <%= render "form",
        url: cadre_program_activities_path,
        method: :post,
        submit_label: action_label,
        cancel_path: back_path %>
</div>
