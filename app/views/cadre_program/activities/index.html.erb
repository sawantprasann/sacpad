<% content_for :title, @category_label ? "Cadre Program — #{@category_label}" : "Cadre Program" %>
<% new_path = @category_key ? new_cadre_program_activity_path(category: @category_key) : new_cadre_program_activity_path %>
<% page_link = "inline-flex h-9 items-center rounded-lg border border-gray-200 bg-white px-3 text-sm font-medium text-gray-700 hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-900 dark:text-gray-200" %>
<% th = "border-b border-gray-200 px-6 py-3 text-left text-xs font-medium text-gray-500 dark:border-gray-800 dark:text-gray-400" %>
<% td = "border-b border-gray-100 px-6 py-4 align-middle dark:border-gray-800" %>

<div class="mb-6 flex flex-wrap items-center justify-between gap-4">
  <div class="min-w-0 flex items-center gap-3">
    <div class="<%= module_color("cadre_program") %>">
      <%= raw module_icon("cadre_program", "h-7 w-7") %>
    </div>
    <div>
      <h1 class="<%= ta_page_title %>">Cadre Program</h1>
      <p class="mt-1 text-sm text-gray-500 dark:text-gray-400"><%= pluralize(@pagy.count, "activity") %></p>
    </div>
  </div>
  <%= render "ui/module_toolbar",
        export_url: cadre_program_activities_path(format: :xlsx, category: @category_key),
        new_url: (new_path if current_user.role.can_write?("cadre_program")),
        new_label: (@category_label ? "Create #{@category_label}" : "Create activity") %>
</div>

<div class="<%= ta_card_classes %> overflow-hidden">
  <div class="hidden xl:block">
    <table class="w-full text-sm">
      <thead class="bg-gray-50 dark:bg-white/[0.03]">
        <tr>
          <th class="<%= th %>">Activity</th>
          <th class="<%= th %>">Category</th>
          <th class="<%= th %>">Media value</th>
          <th class="<%= th %>">Logged by</th>
          <th class="<%= th %> text-right">Photos</th>
          <th class="<%= th %> text-right">Date</th>
          <th class="<%= th %> w-12"><span class="sr-only">Open</span></th>
        </tr>
      </thead>
      <tbody>
        <% @activities.each do |activity| %>
          <% headline = activity.detail_headline.presence || activity.category_label %>
          <tr class="group hover:bg-gray-50 last:[&>td]:border-b-0 dark:hover:bg-white/[0.03]">
            <td class="<%= td %> max-w-xs">
              <%= link_to headline, cadre_program_activity_path(activity),
                    class: "font-medium text-gray-900 dark:text-white/90" %>
            </td>
            <td class="<%= td %>"><%= render "ui/badge", label: activity.category_label, tone: "gray" %></td>
            <td class="<%= td %> max-w-sm text-gray-600 dark:text-gray-300">
              <span class="line-clamp-2"><%= activity.impact_notes.presence || "—" %></span>
            </td>
            <td class="<%= td %> text-gray-700 dark:text-gray-300"><%= activity.owner.name %></td>
            <td class="<%= td %> text-right tabular-nums text-gray-500"><%= activity.photos.size %></td>
            <td class="<%= td %> text-right tabular-nums text-gray-500"><%= activity.created_at.strftime("%d %b %Y") %></td>
            <td class="<%= td %> text-right">
              <%= link_to cadre_program_activity_path(activity), class: "inline-flex text-gray-300 group-hover:text-gray-500", aria: { label: "Open #{headline}" } do %>
                <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd"/></svg>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <% if @activities.empty? %>
      <p class="px-6 py-16 text-center text-sm text-gray-400">No cadre activity yet.</p>
    <% end %>
  </div>

  <div class="divide-y divide-gray-100 xl:hidden dark:divide-gray-800">
    <% @activities.each do |activity| %>
      <%= link_to cadre_program_activity_path(activity), class: "block px-6 py-4 hover:bg-gray-50 dark:hover:bg-white/[0.03]" do %>
        <div class="flex items-start justify-between gap-3">
          <div class="min-w-0">
            <p class="truncate font-medium text-gray-900 dark:text-white/90"><%= activity.detail_headline.presence || activity.category_label %></p>
            <p class="mt-1"><%= render "ui/badge", label: activity.category_label, tone: "gray" %></p>
          </div>
          <p class="shrink-0 text-xs tabular-nums text-gray-500"><%= activity.created_at.strftime("%d %b %Y") %></p>
        </div>
        <p class="mt-2 line-clamp-2 text-sm text-gray-600 dark:text-gray-300"><%= activity.impact_notes.presence || "—" %></p>
        <p class="mt-2 text-xs text-gray-500"><%= activity.owner.name %> · <%= pluralize(activity.photos.size, "photo") %></p>
      <% end %>
    <% end %>
    <% if @activities.empty? %>
      <p class="px-6 py-16 text-center text-sm text-gray-400">No cadre activity yet.</p>
    <% end %>
  </div>

  <% if @pagy.last > 1 %>
    <nav class="flex items-center justify-between gap-3 border-t border-gray-200 px-6 py-3 dark:border-gray-800">
      <% if @pagy.previous %>
        <%= link_to "← Prev", cadre_program_activities_path(category: @category_key, page: @pagy.previous), class: page_link %>
      <% else %>
        <span class="text-sm text-gray-300">← Prev</span>
      <% end %>
      <span class="text-sm tabular-nums text-gray-500">Page <%= @pagy.page %> of <%= @pagy.last %></span>
      <% if @pagy.next %>
        <%= link_to "Next →", cadre_program_activities_path(category: @category_key, page: @pagy.next), class: page_link %>
      <% else %>
        <span class="text-sm text-gray-300">Next →</span>
      <% end %>
    </nav>
  <% end %>
</div>
