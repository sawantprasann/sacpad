<% content_for :title, @category_label ? "Cadre Program — #{@category_label}" : "Cadre Program" %>
<% if @category_label %>
  <% breadcrumb "Cadre Program", cadre_program_activities_path %>
  <% breadcrumb @category_label %>
<% end %>
<% new_path = @category_key ? new_cadre_program_activity_path(category: @category_key) : new_cadre_program_activity_path %>
<% th = "border-b border-gray-200 px-6 py-3 text-left text-xs font-medium text-gray-500 dark:border-gray-800 dark:text-gray-400" %>
<% td = "border-b border-gray-100 px-6 py-4 align-middle dark:border-gray-800" %>

<%= render layout: "ui/campaign_hero", locals: {
      kicker: "Cadre Program",
      title: @category_label || "Cadre Program",
      subtitle: pluralize(@pagy.count, "activity"),
      meta: current_user.organization.name
    } do %><% end %>

<div class="mt-4 flex flex-wrap items-center justify-end gap-2">
  <%= render "ui/module_toolbar",
        export_url: cadre_program_activities_path(format: :xlsx, category: @category_key),
        new_url: (new_path if current_user.role.can_write?("cadre_program")),
        new_label: (@category_label ? "Create #{@category_label}" : "Create activity"),
        accent: "#c2410c",
        accent_ink: "#ffffff" %>
</div>

<% columns = CadreProgram::CadreActivity.list_columns(@category_key) %>
<% list_text = ->(value) { value.respond_to?(:strftime) ? value.strftime("%d %b %Y") : value.presence || "—" } %>
<div class="mt-6 <%= ta_card_classes %> overflow-hidden">
  <div class="hidden xl:block">
    <table class="w-full text-sm">
      <thead class="bg-gray-50 dark:bg-white/[0.03]">
        <tr>
          <% columns.each do |label, reader| %>
            <th class="<%= th %>"><%= label %></th>
          <% end %>
          <th class="<%= th %>">Media value</th>
          <th class="<%= th %>">Logged by</th>
          <th class="<%= th %> text-right">Photos</th>
          <th class="<%= th %> w-28"><span class="sr-only">Actions</span></th>
        </tr>
      </thead>
      <tbody>
        <% @activities.each do |activity| %>
          <% headline = activity.detail_headline.presence || activity.category_label %>
          <tr class="group hover:bg-gray-50 last:[&>td]:border-b-0 dark:hover:bg-white/[0.03]">
            <% columns.each_with_index do |(_label, reader), index| %>
              <% value = reader.call(activity) %>
              <% text = list_text.call(value) %>
              <td class="<%= td %> <%= "text-right tabular-nums" if value.respond_to?(:strftime) %> max-w-xs text-gray-700 dark:text-gray-300">
                <% if index.zero? %>
                  <%= link_to text, cadre_program_activity_path(activity),
                        class: ta_text_link %>
                <% else %>
                  <span class="line-clamp-2"><%= text %></span>
                <% end %>
              </td>
            <% end %>
            <td class="<%= td %> max-w-sm text-gray-600 dark:text-gray-300">
              <span class="line-clamp-2"><%= linkify_text(activity.impact_notes) || "—" %></span>
            </td>
            <td class="<%= td %> text-gray-700 dark:text-gray-300"><%= activity.owner.name %></td>
            <td class="<%= td %> text-right tabular-nums text-gray-500"><%= activity.photos.size %></td>
            <td class="<%= td %> text-right">
              <div class="inline-flex items-center justify-end gap-1">
                <%= icon_action_link :view, cadre_program_activity_path(activity) %>
                <% if policy(activity).edit? %>
                  <%= icon_action_link :edit, edit_cadre_program_activity_path(activity) %>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <% if @activities.empty? %>
      <p class="px-6 py-16 text-center text-sm text-gray-400">No cadre activity yet.</p>
    <% end %>
  </div>

  <div class="divide-y divide-gray-100 xl:hidden dark:divide-gray-800">
    <% @activities.each do |activity| %>
      <div class="px-6 py-4 hover:bg-gray-50 dark:hover:bg-white/[0.03]">
        <%= link_to cadre_program_activity_path(activity), class: "block" do %>
          <p class="truncate #{ta_text_link}"><%= list_text.call(columns.first.last.call(activity)) %></p>
          <% unless @category_key %>
            <p class="mt-1"><%= render "ui/badge", label: activity.category_label, tone: "gray" %></p>
          <% end %>
          <dl class="mt-2 space-y-1">
            <% columns.drop(1).each do |label, reader| %>
              <div class="flex justify-between gap-3 text-xs">
                <dt class="text-gray-400"><%= label %></dt>
                <dd class="truncate text-right text-gray-600 dark:text-gray-300"><%= list_text.call(reader.call(activity)) %></dd>
              </div>
            <% end %>
          </dl>
          <p class="mt-2 text-xs text-gray-500"><%= activity.owner.name %> · <%= pluralize(activity.photos.size, "photo") %></p>
        <% end %>
        <p class="mt-2 line-clamp-2 text-sm text-gray-600 dark:text-gray-300"><%= linkify_text(activity.impact_notes) || "—" %></p>
        <div class="mt-2 flex items-center gap-1">
          <%= icon_action_link :view, cadre_program_activity_path(activity) %>
          <% if policy(activity).edit? %>
            <%= icon_action_link :edit, edit_cadre_program_activity_path(activity) %>
          <% end %>
        </div>
      </div>
    <% end %>
    <% if @activities.empty? %>
      <p class="px-6 py-16 text-center text-sm text-gray-400">No cadre activity yet.</p>
    <% end %>
  </div>

  <%= render "ui/pagination", pagy: @pagy %>
</div>
