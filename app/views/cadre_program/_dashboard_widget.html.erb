<%# Recent cadre activity (Story 2.3, FR26/FR50). One policy_scope over cadre_activities —
    not a union of the detail tables. Counts carry a text label (UX-DR6). %>
<% scope = policy_scope(CadreProgram::CadreActivity) %>
<% recent = scope.includes(:owner).order(created_at: :desc, id: :desc).limit(5) %>
<% counts = scope.counts_by_category %>

<% if recent.empty? %>
  <p class="text-xs text-gray-400">No cadre activity yet.</p>
<% else %>
  <ul class="space-y-3">
    <% recent.each do |activity| %>
      <li>
        <%= link_to cadre_program_activity_path(activity), class: "block" do %>
          <div class="flex items-start justify-between gap-2">
            <p class="text-sm font-medium text-gray-800 dark:text-white/90"><%= activity.category_label %></p>
            <p class="shrink-0 text-xs tabular-nums text-gray-500"><%= activity.created_at.strftime("%d %b") %></p>
          </div>
          <p class="mt-0.5 line-clamp-2 text-xs text-gray-500"><%= activity.impact_notes.presence || "—" %></p>
        <% end %>
      </li>
    <% end %>
  </ul>
<% end %>

<% if counts.any? %>
  <% total = counts.values.sum %>
  <% palette = ["#4338ca", "#0e7490", "#b45309", "#be185d", "#7e22ce", "#c2410c"] %>
  <% if total.positive? %>
    <div class="mt-4 flex h-2 overflow-hidden rounded-full bg-gray-100 dark:bg-white/10" role="img" aria-label="Share of activity by category">
      <% counts.each_with_index do |(_label, count), index| %>
        <% next if count.zero? %>
        <span class="h-full" style="width: <%= (count.to_f / total * 100).round(1) %>%; background: <%= palette[index % palette.length] %>"></span>
      <% end %>
    </div>
  <% end %>
  <ul class="mt-4 space-y-1">
    <% counts.each_with_index do |(label, count), index| %>
      <li class="flex items-center justify-between text-xs text-gray-600 dark:text-gray-300">
        <span class="inline-flex items-center gap-1.5">
          <span class="h-1.5 w-1.5 rounded-full" style="background: <%= palette[index % palette.length] %>"></span>
          <%= label %>
        </span>
        <span class="tabular-nums font-semibold"><%= count %></span>
      </li>
    <% end %>
  </ul>
<% end %>

<%= link_to "View activity", cadre_program_activities_path,
      class: "mt-3 inline-block text-xs font-medium text-brand-500 hover:text-brand-600" %>
