<%# Cadre activity by category, scoped to the viewer's subtree. Names sit under the ring, each with an arrow in that category color. %>
<% scope = policy_scope(CadreProgram::CadreActivity) %>
<% counts = scope.counts_by_category %>
<% palette = [ "#4f46e5", "#0891b2", "#d97706", "#e11d48", "#9333ea", "#ea580c" ] %>
<% slices = counts.each_with_index.filter_map do |(label, count), index|
     next if count.zero?

     [ label, count, palette[index % palette.length] ]
   end %>
<% pie = slices.to_h { |label, count, _color| [ label, count ] } %>

<% if pie.empty? %>
  <p class="text-xs text-gray-400"><%= t("cadre_program.no_activity") %></p>
<% else %>
  <div class="flex min-w-0 flex-wrap items-center justify-center gap-x-3 gap-y-3">
    <div class="w-40 max-w-full shrink-0">
      <%= pie_chart pie, id: "dashboard-cadre-categories", height: "180px", donut: true,
            colors: slices.map(&:last),
            library: dashboard_pie_library %>
    </div>
    <div class="min-w-0 max-w-full shrink-0 grow basis-48">
      <%= render "ui/slice_legend", slices: slices, total: counts.values.sum %>
    </div>
  </div>
<% end %>
<%= link_to t("ground_reports.view_activity"), cadre_program_activities_path,
      class: "mt-3 inline-block text-xs #{ta_text_link}" %>
