<%# Recent work inline across the viewer's constituency villages. %>
<% works = policy_scope(GroundReports::VillageWork)
      .kept
      .where(village_id: current_user.organization.villages.select(:id))
      .includes(:village)
      .order(created_at: :desc, id: :desc)
      .limit(5) %>

<% if works.empty? %>
  <p class="text-xs text-gray-400"><%= t("ground_reports.no_work") %></p>
<% else %>
  <div class="overflow-x-auto">
    <table class="w-full text-sm">
      <thead>
        <tr>
          <% [ t("common.title"), t("common.village"), t("ground_reports.concern_person"), t("ground_reports.nidhi_asked"), t("common.category"), t("common.status"), t("common.logged_by") ].each do |heading| %>
            <th class="border-b border-gray-200 px-3 py-2 text-left text-xs font-medium text-gray-500 dark:border-gray-800"><%= heading %></th>
          <% end %>
        </tr>
      </thead>
      <tbody>
        <% works.each do |work| %>
          <tr class="last:[&>td]:border-b-0">
            <td class="border-b border-gray-100 px-3 py-2.5 font-medium dark:border-gray-800">
              <%= link_to work.title, ground_reports_village_path(work.village),
                    class: ta_text_link %>
            </td>
            <td class="border-b border-gray-100 px-3 py-2.5 text-gray-700 dark:border-gray-800 dark:text-gray-300"><%= work.village.display_name %></td>
            <td class="border-b border-gray-100 px-3 py-2.5 text-gray-700 dark:border-gray-800 dark:text-gray-300"><%= work.concern_person %></td>
            <td class="border-b border-gray-100 px-3 py-2.5 tabular-nums text-gray-700 dark:border-gray-800 dark:text-gray-300"><%= format_nidhi(work.nidhi_asked) %></td>
            <td class="border-b border-gray-100 px-3 py-2.5 text-gray-700 dark:border-gray-800 dark:text-gray-300"><%= work.nidhi_label %></td>
            <td class="border-b border-gray-100 px-3 py-2.5 text-gray-700 dark:border-gray-800 dark:text-gray-300"><%= work.status_label %></td>
            <td class="border-b border-gray-100 px-3 py-2.5 tabular-nums text-gray-500 dark:border-gray-800"><%= l(work.created_at.to_date, format: :day_short) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>

<%= link_to t("ground_reports.view_reports"), ground_reports_villages_path,
      class: "mt-3 inline-block text-xs #{ta_text_link}" %>
