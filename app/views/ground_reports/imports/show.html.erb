<% content_for :title, @import.report? ? "Report import" : "Mock poll import" %>
<% breadcrumb "Ground Reports", ground_reports_villages_path %>
<% breadcrumb @import.report? ? "Report import" : "Mock poll import" %>

<div class="mb-4">
  <h1 class="<%= ta_page_title %>"><%= @import.report? ? "Report import" : "Mock poll import" %></h1>
</div>

<div class="<%= ta_card_classes %> p-6">
  <% if @import.pending? %>
    <p class="text-sm text-gray-600">Import is running.</p>
  <% else %>
    <p class="text-sm text-gray-800">Imported <%= pluralize(@import.imported_count, @import.report? ? "report" : "response") %>.</p>
    <% if @import.row_errors.any? %>
      <h2 class="mt-6 text-sm font-semibold text-gray-900">Rows that were not imported</h2>
      <ul class="mt-3 divide-y divide-gray-100">
        <% @import.row_errors.each do |error| %>
          <li class="py-3 text-sm text-gray-700">Row <%= error["row"] %>: <%= error["message"] %></li>
        <% end %>
      </ul>
    <% end %>
  <% end %>
</div>
