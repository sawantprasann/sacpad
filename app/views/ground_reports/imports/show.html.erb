<% content_for :title, @import.report? ? "Report import" : "Mock poll import" %>
<% breadcrumb t("nav.ground_reports"), ground_reports_villages_path %>
<% breadcrumb @import.report? ? "Report import" : "Mock poll import" %>

<%= render layout: "ui/campaign_hero", locals: {
      kicker: "Ground Reports",
      title: @import.report? ? "Report import" : "Mock poll import"
    } do %><% end %>

<div class="mt-6 <%= ta_card_classes %> p-6">
  <% if @import.pending? %>
    <p class="text-sm text-gray-600"><%= t("ground_reports.running") %></p>
  <% else %>
    <p class="text-sm text-gray-800"><%= t("ground_reports.imported", count: t(@import.report? ? "ground_reports.report_count" : "ground_reports.response_count", count: @import.imported_count)) %></p>
    <% if @import.row_errors.any? %>
      <h2 class="mt-6 text-sm font-semibold text-gray-900"><%= t("ground_reports.skipped") %></h2>
      <ul class="mt-3 divide-y divide-gray-100">
        <% @import.row_errors.each do |error| %>
          <li class="py-3 text-sm text-gray-700"><%= t("ground_reports.row_error", row: error["row"], message: error["message"]) %></li>
        <% end %>
      </ul>
    <% end %>
  <% end %>
</div>
