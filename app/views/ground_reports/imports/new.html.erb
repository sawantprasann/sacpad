<% content_for :title, "Import — Ground Reports" %>

<div class="mb-4">
  <%= link_to "← Ground Reports", ground_reports_villages_path, class: "text-sm font-medium text-brand-500 hover:text-brand-600" %>
  <h1 class="mt-2 text-xl font-semibold tracking-tight text-gray-900">Import</h1>
  <p class="mt-1 text-sm text-gray-600">Excel workbook. One sheet. The first row is the column names.</p>
</div>

<div class="<%= ta_card_classes %> p-6">
  <% if @import.errors.any? %>
    <div class="mb-4 rounded-lg border border-error-500/30 bg-error-50 px-4 py-2 text-sm text-error-500"><%= @import.errors.full_messages.to_sentence %></div>
  <% end %>

  <%= form_with model: @import, scope: :import, url: ground_reports_imports_path, class: "space-y-4" do |f| %>
    <div>
      <%= f.label :kind, "What is in the file", class: ta_label_classes %>
      <%= f.select :kind, [ [ "Report", "report" ], [ "Mock poll", "mock_poll" ] ], {}, { class: ta_field_classes } %>
    </div>
    <div>
      <%= f.label :file, "Workbook", class: ta_label_classes %>
      <%= f.file_field :file, accept: ".xlsx", required: true, class: "#{ta_field_classes} py-2" %>
    </div>
    <div class="grid gap-4 text-sm text-gray-600 md:grid-cols-2">
      <p><span class="font-medium text-gray-800">Report columns.</span> village, issue, resolution, reported_at</p>
      <p><span class="font-medium text-gray-800">Mock poll columns.</span> village, politician, respondent_name, respondent_mobile, preference_basis, vote_intent, note</p>
    </div>
    <button type="submit" class="<%= ta_btn_primary %> min-h-11 cursor-pointer"
            style="background: var(--org-party-color); color: var(--org-party-contrast)">Import</button>
  <% end %>
</div>
