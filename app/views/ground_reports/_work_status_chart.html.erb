<%# Nidhi asked, split by work status, for this organization's constituency. %>
<% scope = policy_scope(GroundReports::VillageWork).kept.where(village_id: current_user.organization.villages.select(:id)) %>
<% totals = scope.nidhi_totals_by_status %>
<% colors = { "not_started" => "#64748b", "in_progress" => "#2970ff", "completed" => "#039855" } %>
<% slices = GroundReports::VillageWork.statuses.keys.filter_map do |status|
     amount = totals[status]
     next unless amount.positive?

     [ t("ground_reports.work_statuses.#{status}"), amount, colors[status] ]
   end %>
<% pie = slices.to_h { |label, amount, _color| [ label, amount.to_f ] } %>

<% if pie.empty? %>
  <p class="text-xs text-gray-400"><%= t("ground_reports.no_work") %></p>
<% else %>
  <div class="flex flex-col items-center gap-4 sm:flex-row sm:items-center sm:gap-2">
    <div class="w-full max-w-[13.5rem] shrink-0">
      <%= pie_chart pie, id: "dashboard-work-nidhi", height: "200px", donut: true,
            colors: slices.map(&:last),
            library: dashboard_pie_library %>
    </div>
    <%= render "ui/slice_legend", slices: slices, total: totals.values.sum, value_format: method(:format_nidhi) %>
  </div>
<% end %>
<%= link_to ground_reports_work_inlines_path,
      class: "mt-3 inline-flex min-h-9 cursor-pointer items-center gap-1.5 rounded-lg bg-brand-500 px-3 py-1.5 text-xs font-medium text-white shadow-sm hover:bg-brand-600" do %>
  <svg class="h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2"/>
    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-2a2 2 0 0 1-2-2z"/>
    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6M9 16h6"/>
  </svg>
  <%= t("ground_reports.view_work") %>
<% end %>
