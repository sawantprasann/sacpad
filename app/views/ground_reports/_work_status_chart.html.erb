<%# Nidhi asked, split by work status, for this organization's constituency. %>
<% scope = policy_scope(GroundReports::VillageWork).kept.where(village_id: current_user.organization.villages.select(:id)) %>
<% totals = scope.nidhi_totals_by_status %>
<% colors = { "not_started" => "#64748b", "in_progress" => "#2970ff", "completed" => "#039855" } %>
<% slices = GroundReports::VillageWork.statuses.keys.filter_map do |status|
     amount = totals[status]
     next unless amount.positive?

     [ t("ground_reports.work_statuses.#{status}"), amount, colors[status] ]
   end %>
<% pie = slices.to_h { |label, amount, _color| [ label, amount.to_f ] } %>

<% if pie.empty? %>
  <p class="text-xs text-gray-400"><%= t("ground_reports.no_work") %></p>
<% else %>
  <div class="flex min-w-0 flex-wrap items-center justify-center gap-x-3 gap-y-3">
    <div class="w-40 max-w-full shrink-0">
      <%= pie_chart pie, id: "dashboard-work-nidhi", height: "180px", donut: true,
            colors: slices.map(&:last),
            library: dashboard_pie_library %>
    </div>
    <div class="min-w-0 max-w-full shrink-0 grow basis-48">
      <%= render "ui/slice_legend", slices: slices, total: totals.values.sum, value_format: method(:format_nidhi) %>
    </div>
  </div>
<% end %>
<%= link_to t("ground_reports.view_works"), ground_reports_work_inlines_path,
      class: "mt-3 inline-block text-xs #{ta_text_link}" %>
