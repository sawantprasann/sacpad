<%= render layout: "ground_reports/edit_page", locals: { title: "Edit issue" } do %>
  <%= form_with model: @report, scope: :ground_report,
        url: ground_reports_village_report_path(@village, @report), method: :patch do |f| %>
    <% if @report.errors.any? %>
      <div class="mb-6 rounded-lg border border-error-500/30 bg-error-50 px-4 py-2 text-sm text-error-500"><%= @report.errors.full_messages.to_sentence %></div>
    <% end %>

    <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
      <div class="md:col-span-2">
        <%= f.label :issue_text, "Issue", class: ta_label_classes %>
        <%= f.text_area :issue_text, rows: 4, class: ta_field_classes, autofocus: true %>
      </div>
      <div class="md:col-span-2">
        <%= f.label :resolution_text, "Resolution", class: ta_label_classes %>
        <%= f.text_area :resolution_text, rows: 3, class: ta_field_classes %>
      </div>
      <div>
        <%= f.label :reported_at, "Reported date", class: ta_label_classes %>
        <%= f.date_field :reported_at, class: "#{ta_field_classes} min-h-11" %>
      </div>
      <div>
        <%= f.label :estimated_cost, "Estimated cost", class: ta_label_classes %>
        <%= f.number_field :estimated_cost, min: 0, step: "0.01", class: ta_field_classes %>
      </div>
    </div>

    <div class="mt-6 flex flex-wrap gap-3 border-t border-gray-100 pt-6 dark:border-gray-800">
      <button type="submit" class="<%= ta_btn_primary %> min-h-11 cursor-pointer"
              style="background: var(--org-party-color); color: var(--org-party-contrast)">Save changes</button>
      <%= link_to "Cancel", ground_reports_village_path(@village), class: "#{ta_btn_secondary} inline-flex items-center min-h-11 cursor-pointer" %>
    </div>
  <% end %>
<% end %>
