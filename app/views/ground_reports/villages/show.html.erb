<% content_for :title, @village.display_name %>
<% breadcrumb t("nav.ground_reports"), ground_reports_villages_path %>
<% breadcrumb @village.display_name %>
<% can_write = current_user.role.can_write?("ground_reports") %>
<% snapshot = [
  [ "Worship places", @worship_places.size ],
  [ "Work inline", @works.size ],
  [ "Total nidhi", format_nidhi(@total_nidhi) ],
  [ "Karyakartas", @karyakartas.size ],
  [ "Admin contacts", @admin_contacts.size ],
  [ "Likely winner", @likely_winners.map(&:name).to_sentence.presence || "None" ]
] %>

<%= render layout: "ui/campaign_hero", locals: {
      kicker: "Ground Reports",
      title: @village.display_name,
      subtitle: @village.assembly.display_name,
      meta: pluralize(@pagy.count, "issue")
    } do %><% end %>

<div class="mt-4 mb-4 flex justify-end">
  <%= render "ui/module_toolbar",
        export_url: ground_reports_village_path(@village, format: :xlsx),
        new_url: (new_ground_reports_village_report_path(@village) if can_write),
        new_label: t("ground_reports.create_issue"),
        accent: org_accent_color,
        accent_ink: org_accent_foreground %>
</div>

<div class="mt-6 mb-4 grid grid-cols-2 gap-3 sm:grid-cols-3 xl:grid-cols-6">
  <% snapshot.each do |label, value| %>
    <div class="<%= ta_card_classes %> px-4 py-3">
      <p class="text-xs font-medium text-gray-500"><%= label %></p>
      <p class="mt-1 truncate text-sm font-semibold text-gray-900 dark:text-white/90"><%= value %></p>
    </div>
  <% end %>
</div>

<section class="<%= ta_card_classes %> overflow-hidden">
  <div class="border-b border-gray-100 px-6 py-4 dark:border-gray-800">
    <h2 class="text-sm font-semibold text-gray-900 dark:text-white/90"><%= t("ground_reports.issues") %></h2>
    <p class="mt-0.5 text-xs text-gray-500"><%= pluralize(@pagy.count, "issue") %> logged in this village</p>
  </div>

  <table class="hidden w-full text-sm xl:table">
    <thead class="bg-gray-50 dark:bg-white/[0.03]">
      <tr>
        <th class="border-b border-gray-200 px-6 py-3 text-left text-xs font-medium text-gray-500"><%= t("ground_reports.issue") %></th>
        <th class="border-b border-gray-200 px-6 py-3 text-right text-xs font-medium text-gray-500"><%= t("ground_reports.estimated_cost") %></th>
        <th class="border-b border-gray-200 px-6 py-3 text-left text-xs font-medium text-gray-500"><%= t("common.logged_by") %></th>
        <th class="border-b border-gray-200 px-6 py-3 text-right text-xs font-medium text-gray-500"><%= t("ground_reports.testimonials") %></th>
        <th class="border-b border-gray-200 px-6 py-3 text-right text-xs font-medium text-gray-500"><%= t("common.reported") %></th>
        <% if can_write %>
          <th class="border-b border-gray-200 px-6 py-3 text-right text-xs font-medium text-gray-500"><span class="sr-only"><%= t("common.actions") %></span></th>
        <% end %>
      </tr>
    </thead>
    <tbody>
      <% @reports.each do |report| %>
        <tr class="hover:bg-gray-50 last:[&>td]:border-b-0 dark:hover:bg-white/[0.03]">
          <td class="border-b border-gray-100 px-6 py-4 dark:border-gray-800">
            <%= link_to truncate(report.issue_text, length: 80), ground_reports_village_report_path(@village, report),
                  class: ta_text_link %>
          </td>
          <td class="border-b border-gray-100 px-6 py-4 text-right tabular-nums text-gray-700 dark:border-gray-800"><%= format_estimated_cost(report.estimated_cost) %></td>
          <td class="border-b border-gray-100 px-6 py-4 text-gray-700 dark:border-gray-800"><%= report.owner.name %></td>
          <td class="border-b border-gray-100 px-6 py-4 text-right tabular-nums text-gray-500"><%= report.testimonials.size %></td>
          <td class="border-b border-gray-100 px-6 py-4 text-right tabular-nums text-gray-500"><%= report.reported_at.strftime("%d %b %Y") %></td>
          <% if can_write %>
            <td class="border-b border-gray-100 px-6 py-4 text-right dark:border-gray-800">
              <%= render "ground_reports/row_actions",
                    can_write: can_write,
                    edit_path: edit_ground_reports_village_report_path(@village, report),
                    delete_path: ground_reports_village_report_path(@village, report),
                    label: t("ground_reports.records.issue") %>
            </td>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>

  <div class="divide-y divide-gray-100 xl:hidden dark:divide-gray-800">
    <% @reports.each do |report| %>
      <div class="flex items-start justify-between gap-3 px-6 py-4 hover:bg-gray-50">
        <%= link_to ground_reports_village_report_path(@village, report), class: "min-w-0" do %>
          <p class="#{ta_text_link}"><%= truncate(report.issue_text, length: 90) %></p>
          <p class="mt-1 text-xs text-gray-500"><%= report.owner.name %> · <%= format_estimated_cost(report.estimated_cost) %> · <%= pluralize(report.testimonials.size, "testimonial") %> · <%= report.reported_at.strftime("%d %b %Y") %></p>
        <% end %>
        <%= render "ground_reports/row_actions",
              can_write: can_write,
              edit_path: edit_ground_reports_village_report_path(@village, report),
              delete_path: ground_reports_village_report_path(@village, report),
              label: t("ground_reports.records.issue") %>
      </div>
    <% end %>
  </div>

  <% if @reports.empty? %>
    <p class="px-6 py-10 text-center text-sm text-gray-400"><%= t("ground_reports.no_issues") %></p>
  <% end %>

  <%= render "ui/pagination", pagy: @pagy %>
</section>

<h2 class="mb-3 mt-8 border-b border-gray-200 pb-2 text-base font-semibold text-gray-900 dark:border-gray-700 dark:text-white"><%= t("ground_reports.village_record") %></h2>
<%= render "ground_reports/villages/work_inline", village: @village, works: @works, can_write: can_write %>
<div class="mt-4 grid gap-4 xl:grid-cols-2">
  <section class="<%= ta_card_classes %> overflow-hidden">
    <div class="px-5 py-4">
      <h3 class="text-sm font-semibold text-gray-900 dark:text-white/90"><%= t("ground_reports.worship_places") %></h3>
      <p class="mt-0.5 text-xs text-gray-500"><%= pluralize(@worship_places.size, "place") %></p>
    </div>
    <% if @worship_places.any? %>
      <ul class="divide-y divide-gray-100 border-t border-gray-100 dark:divide-gray-800 dark:border-gray-800">
        <% @worship_places.each do |place| %>
          <li class="flex items-start justify-between gap-3 px-5 py-3">
            <div class="min-w-0">
              <p class="font-medium text-gray-900 dark:text-white/90"><%= place.name %></p>
              <p class="mt-0.5 text-xs text-gray-500"><%= place.place_type %></p>
              <% if place.notes.present? %>
                <p class="mt-1 text-sm text-gray-600 dark:text-gray-400"><%= place.notes %></p>
              <% end %>
            </div>
            <%= render "ground_reports/row_actions",
                  can_write: can_write,
                  edit_path: edit_ground_reports_village_worship_place_path(@village, place),
                  delete_path: ground_reports_village_worship_place_path(@village, place),
                  label: t("ground_reports.records.worship_place") %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="border-t border-gray-100 px-5 py-8 text-center text-sm text-gray-400 dark:border-gray-800"><%= t("ground_reports.no_worship") %></p>
    <% end %>
    <% if can_write %>
      <%= render "ground_reports/villages/add_panel", label: t("ground_reports.add_place") do %>
        <%= form_with model: GroundReports::WorshipPlace.new, scope: :worship_place,
              url: ground_reports_village_worship_places_path(@village), class: "space-y-3" do |f| %>
          <div>
            <%= f.label :name, class: ta_label_classes %>
            <%= f.text_field :name, required: true, class: ta_field_classes %>
          </div>
          <div>
            <%= f.label :place_type, "Type", class: ta_label_classes %>
            <%= f.select :place_type,
                  [ "Temple", "Mosque", "Church", "Gurudwara", "Yatra", "Other" ],
                  { prompt: "Select a type" },
                  required: true, class: ta_field_classes %>
          </div>
          <div>
            <%= f.label :notes, class: ta_label_classes %>
            <%= f.text_area :notes, rows: 2, class: "#{ta_field_classes} h-auto" %>
          </div>
          <button type="submit" class="<%= ta_btn_primary %> min-h-11 cursor-pointer"
                  style="background: var(--org-party-color); color: var(--org-party-contrast)"><%= t("ground_reports.add_place") %></button>
        <% end %>
      <% end %>
    <% end %>
  </section>

  <section class="<%= ta_card_classes %> overflow-hidden">
    <div class="px-5 py-4">
      <h3 class="text-sm font-semibold text-gray-900 dark:text-white/90"><%= t("ground_reports.political_position") %></h3>
      <p class="mt-0.5 text-xs text-gray-500"><%= pluralize(@positions.size, "record") %></p>
    </div>
    <% if @positions.any? %>
      <ul class="divide-y divide-gray-100 border-t border-gray-100 dark:divide-gray-800 dark:border-gray-800">
        <% @positions.each do |position| %>
          <li class="flex items-start justify-between gap-3 px-5 py-3">
            <div class="min-w-0">
            <div class="flex items-center justify-between gap-2">
              <p class="font-medium text-gray-900 dark:text-white/90"><%= position.representative_name %></p>
              <% if position.ended_at.nil? %>
                <span class="rounded-full bg-success-50 px-2 py-0.5 text-xs font-medium text-success-700"><%= t("common.current") %></span>
              <% end %>
            </div>
            <p class="mt-0.5 text-xs text-gray-500">
              <%= position.position_title %> · <%= position.party.name %> ·
              <%= position.started_at.strftime("%d %b %Y") %>
              <% if position.ended_at %>– <%= position.ended_at.strftime("%d %b %Y") %><% end %>
            </p>
            </div>
            <%= render "ground_reports/row_actions",
                  can_write: can_write,
                  edit_path: edit_ground_reports_village_political_position_path(@village, position),
                  delete_path: ground_reports_village_political_position_path(@village, position),
                  label: t("ground_reports.records.political_position") %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="border-t border-gray-100 px-5 py-8 text-center text-sm text-gray-400 dark:border-gray-800"><%= t("ground_reports.no_politics") %></p>
    <% end %>
    <% if can_write %>
      <%= render "ground_reports/villages/add_panel", label: t("ground_reports.record_position") do %>
        <%= form_with model: GroundReports::VillagePoliticalPosition.new, scope: :village_political_position,
              url: ground_reports_village_political_positions_path(@village), class: "space-y-3" do |f| %>
          <div>
            <%= f.label :party_id, "Party", class: ta_label_classes %>
            <%= f.collection_select :party_id, @parties, :id, :name, { prompt: "Select a party" }, { required: true, class: ta_field_classes } %>
          </div>
          <div>
            <%= f.label :representative_name, "Representative", class: ta_label_classes %>
            <%= f.text_field :representative_name, required: true, class: ta_field_classes %>
          </div>
          <div>
            <%= f.label :position_title, "Title", class: ta_label_classes %>
            <%= f.text_field :position_title, required: true, placeholder: "Sarpanch", class: ta_field_classes %>
          </div>
          <div>
            <%= f.label :started_at, "Started", class: ta_label_classes %>
            <%= ta_date_picker(form: f, method: :started_at, required: true, value: (f.object.started_at || Date.current)) %>
          </div>
          <button type="submit" class="<%= ta_btn_primary %> min-h-11 cursor-pointer"
                  style="background: var(--org-party-color); color: var(--org-party-contrast)"><%= t("ground_reports.record_position") %></button>
        <% end %>
      <% end %>
    <% end %>
  </section>
</div>

<h2 class="mb-3 mt-8 border-b border-gray-200 pb-2 text-base font-semibold text-gray-900 dark:border-gray-700 dark:text-white"><%= t("ground_reports.people") %></h2>
<div class="grid gap-4 xl:grid-cols-2">
  <section class="<%= ta_card_classes %> overflow-hidden">
    <div class="px-5 py-4">
      <h3 class="text-sm font-semibold text-gray-900 dark:text-white/90"><%= t("ground_reports.karyakartas") %></h3>
      <p class="mt-0.5 text-xs text-gray-500"><%= t("ground_reports.karyakarta_help") %></p>
    </div>
    <% if @karyakartas.any? %>
      <ul class="divide-y divide-gray-100 border-t border-gray-100 dark:divide-gray-800 dark:border-gray-800">
        <% @karyakartas.each do |contact| %>
          <li class="flex items-start justify-between gap-3 px-5 py-3">
            <div class="min-w-0">
              <p class="font-medium text-gray-900 dark:text-white/90"><%= contact.name %></p>
              <% if contact.address.present? %>
                <p class="mt-0.5 text-xs text-gray-500"><%= contact.address %></p>
              <% end %>
              <% if contact.phone.present? %>
                <p class="mt-0.5 text-xs tabular-nums text-gray-500"><%= contact.phone %></p>
              <% end %>
              <% if contact.notes.present? %>
                <p class="mt-1 text-sm text-gray-600 dark:text-gray-400"><%= contact.notes %></p>
              <% end %>
            </div>
            <%= render "ground_reports/row_actions",
                  can_write: can_write,
                  edit_path: edit_ground_reports_village_local_karyakarta_path(@village, contact),
                  delete_path: ground_reports_village_local_karyakarta_path(@village, contact),
                  label: t("ground_reports.records.karyakarta") %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="border-t border-gray-100 px-5 py-8 text-center text-sm text-gray-400 dark:border-gray-800"><%= t("ground_reports.no_karyakartas") %></p>
    <% end %>
    <% if can_write %>
      <%= render "ground_reports/villages/add_panel", label: t("ground_reports.add_karyakarta") do %>
        <%= form_with model: GroundReports::VillageLocalKaryakarta.new, scope: :village_local_karyakarta,
              url: ground_reports_village_local_karyakartas_path(@village), class: "space-y-3" do |f| %>
          <div>
            <%= f.label :name, class: ta_label_classes %>
            <%= f.text_field :name, required: true, class: ta_field_classes %>
          </div>
          <div>
            <%= f.label :phone, class: ta_label_classes %>
            <%= f.telephone_field :phone, class: ta_field_classes %>
          </div>
          <div>
            <%= f.label :address, class: ta_label_classes %>
            <%= f.text_field :address, class: ta_field_classes %>
          </div>
          <div>
            <%= f.label :notes, class: ta_label_classes %>
            <%= f.text_area :notes, rows: 2, class: "#{ta_field_classes} h-auto" %>
          </div>
          <button type="submit" class="<%= ta_btn_primary %> min-h-11 cursor-pointer"
                  style="background: var(--org-party-color); color: var(--org-party-contrast)"><%= t("ground_reports.add_karyakarta") %></button>
        <% end %>
      <% end %>
    <% end %>
  </section>

  <section class="<%= ta_card_classes %> overflow-hidden">
    <div class="px-5 py-4">
      <h3 class="text-sm font-semibold text-gray-900 dark:text-white/90"><%= t("ground_reports.administrative_contacts") %></h3>
      <p class="mt-0.5 text-xs text-gray-500"><%= pluralize(@admin_contacts.size, "contact") %></p>
    </div>
    <% if @admin_contacts.any? %>
      <ul class="divide-y divide-gray-100 border-t border-gray-100 dark:divide-gray-800 dark:border-gray-800">
        <% @admin_contacts.each do |contact| %>
          <li class="flex items-start justify-between gap-3 px-5 py-3">
            <div class="min-w-0">
              <p class="font-medium text-gray-900 dark:text-white/90"><%= contact.name %></p>
              <p class="mt-0.5 text-xs text-gray-500"><%= contact.admin_contact_role&.name || contact.role_title %><% if contact.phone.present? %> · <span class="tabular-nums"><%= contact.phone %></span><% end %></p>
              <% if contact.notes.present? %>
                <p class="mt-1 text-sm text-gray-600 dark:text-gray-400"><%= contact.notes %></p>
              <% end %>
            </div>
            <%= render "ground_reports/row_actions",
                  can_write: can_write,
                  edit_path: edit_ground_reports_village_local_admin_contact_path(@village, contact),
                  delete_path: ground_reports_village_local_admin_contact_path(@village, contact),
                  label: t("ground_reports.records.administrative_contact") %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="border-t border-gray-100 px-5 py-8 text-center text-sm text-gray-400 dark:border-gray-800"><%= t("ground_reports.no_admin_contacts") %></p>
    <% end %>
    <% if can_write %>
      <%= render "ground_reports/villages/add_panel", label: t("ground_reports.add_contact") do %>
        <%= form_with model: GroundReports::VillageLocalAdminContact.new, scope: :village_local_admin_contact,
              url: ground_reports_village_local_admin_contacts_path(@village), class: "space-y-3" do |f| %>
          <div>
            <%= f.label :name, class: ta_label_classes %>
            <%= f.text_field :name, required: true, class: ta_field_classes %>
          </div>
          <div>
            <%= f.label :admin_contact_role_id, "Role", class: ta_label_classes %>
            <%= f.collection_select :admin_contact_role_id, @admin_roles, :id, :name,
                  { prompt: "Select a role" },
                  required: true, class: ta_field_classes %>
          </div>
          <div>
            <%= f.label :phone, class: ta_label_classes %>
            <%= f.telephone_field :phone, class: ta_field_classes %>
          </div>
          <div>
            <%= f.label :notes, class: ta_label_classes %>
            <%= f.text_area :notes, rows: 2, class: "#{ta_field_classes} h-auto" %>
          </div>
          <button type="submit" class="<%= ta_btn_primary %> min-h-11 cursor-pointer"
                  style="background: var(--org-party-color); color: var(--org-party-contrast)"><%= t("ground_reports.add_contact") %></button>
        <% end %>
      <% end %>
    <% end %>
  </section>
</div>

<section class="<%= ta_card_classes %> mt-8 overflow-hidden">
  <div class="flex flex-wrap items-end justify-between gap-3 px-6 py-4">
    <div>
      <h2 class="text-sm font-semibold text-gray-900 dark:text-white/90"><%= t("ground_reports.mock_poll") %></h2>
      <p class="mt-0.5 text-xs text-gray-500"><%= t("ground_reports.mock_poll_help") %></p>
    </div>
    <div class="flex flex-wrap items-center gap-3">
      <% if @likely_winners.any? %>
        <p class="text-sm font-medium text-gray-800 dark:text-white/90"><%= t("ground_reports.likely_to_win", names: @likely_winners.map(&:name).to_sentence) %></p>
      <% end %>
      <% if can_write %>
        <%= link_to "Upload", new_ground_reports_import_path(kind: "mock_poll", village_id: @village.id),
              class: "inline-flex min-h-11 cursor-pointer items-center rounded-lg bg-brand-500 px-4 text-sm font-medium text-white hover:bg-brand-600" %>
      <% end %>
    </div>
  </div>

  <% if @poll_tally.any? %>
    <table class="w-full text-sm">
      <thead class="bg-gray-50 dark:bg-white/[0.03]">
        <tr>
          <th class="border-y border-gray-200 px-6 py-3 text-left text-xs font-medium text-gray-500"><%= t("common.politician") %></th>
          <th class="border-y border-gray-200 px-6 py-3 text-right text-xs font-medium text-gray-500">Yes</th>
          <th class="border-y border-gray-200 px-6 py-3 text-right text-xs font-medium text-gray-500">No</th>
          <th class="border-y border-gray-200 px-6 py-3 text-right text-xs font-medium text-gray-500"><%= t("common.undecided") %></th>
        </tr>
      </thead>
      <tbody>
        <% @poll_tally.each do |row| %>
          <tr data-politician="<%= row[:politician].id %>">
            <td class="border-b border-gray-100 px-6 py-3 font-medium text-gray-900 dark:border-gray-800 dark:text-white/90">
              <%= row[:politician].name %>
              <% if @likely_winners.include?(row[:politician]) %>
                <span class="ml-2 rounded-full bg-success-50 px-2 py-0.5 text-xs font-medium text-success-700"><%= t("common.likely") %></span>
              <% end %>
            </td>
            <td class="border-b border-gray-100 px-6 py-3 text-right tabular-nums text-gray-700 dark:border-gray-800" data-count="yes"><%= row[:yes] %></td>
            <td class="border-b border-gray-100 px-6 py-3 text-right tabular-nums text-gray-700 dark:border-gray-800" data-count="no"><%= row[:no] %></td>
            <td class="border-b border-gray-100 px-6 py-3 text-right tabular-nums text-gray-700 dark:border-gray-800" data-count="undecided"><%= row[:undecided] %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="border-t border-gray-100 px-6 py-8 text-center text-sm text-gray-400 dark:border-gray-800"><%= t("ground_reports.no_surveys") %></p>
  <% end %>

  <% if @poll_responses.any? %>
    <ul class="divide-y divide-gray-100 border-t border-gray-100 dark:divide-gray-800 dark:border-gray-800">
      <% @poll_responses.each do |survey| %>
        <li class="flex items-start justify-between gap-3 px-6 py-3">
          <div class="min-w-0">
            <p class="font-medium text-gray-900 dark:text-white/90"><%= survey.respondent_name %></p>
            <p class="mt-0.5 text-xs text-gray-500">
              <%= survey.politician.name %> · <%= survey.preference_basis.humanize %> · <%= survey.vote_label %>
              <% if survey.respondent_mobile.present? %> · <span class="tabular-nums"><%= survey.respondent_mobile %></span><% end %>
            </p>
            <% if survey.note.present? %>
              <p class="mt-1 text-sm text-gray-600 dark:text-gray-400"><%= survey.note %></p>
            <% end %>
          </div>
          <%= render "ground_reports/row_actions",
                can_write: can_write,
                edit_path: edit_ground_reports_village_mock_poll_response_path(@village, survey),
                delete_path: ground_reports_village_mock_poll_response_path(@village, survey),
                label: t("ground_reports.records.survey_response") %>
        </li>
      <% end %>
    </ul>
  <% end %>

  <% if can_write %>
    <% if @politicians.any? %>
      <%= render "ground_reports/villages/add_panel", label: t("ground_reports.record_response") do %>
        <%= form_with model: GroundReports::MockPollResponse.new, scope: :mock_poll_response,
              url: ground_reports_village_mock_poll_responses_path(@village), class: "space-y-3" do |f| %>
          <div class="grid gap-3 md:grid-cols-2">
            <div>
              <%= f.label :politician_id, "Politician", class: ta_label_classes %>
              <%= f.collection_select :politician_id, @politicians, :id, :name, { prompt: "Select a politician" }, { required: true, class: ta_field_classes } %>
            </div>
            <div>
              <%= f.label :respondent_name, "Respondent", class: ta_label_classes %>
              <%= f.text_field :respondent_name, required: true, class: ta_field_classes %>
            </div>
            <div>
              <%= f.label :respondent_mobile, "Mobile", class: ta_label_classes %>
              <%= f.telephone_field :respondent_mobile, class: ta_field_classes %>
            </div>
            <div>
              <%= f.label :preference_basis, "Leaning because of", class: ta_label_classes %>
              <%= f.select :preference_basis, GroundReports::MockPollResponse.preference_bases.keys.map { |key| [ key.humanize, key ] }, { prompt: "Select" }, { required: true, class: ta_field_classes } %>
            </div>
            <div>
              <%= f.label :vote_choice, "Vote", class: ta_label_classes %>
              <%= f.select :vote_choice, [ [ "Yes", "yes" ], [ "No", "no" ], [ "Undecided", "undecided" ] ], { prompt: "Select" }, { required: true, class: ta_field_classes } %>
            </div>
            <div>
              <%= f.label :note, class: ta_label_classes %>
              <%= f.text_area :note, rows: 2, class: "#{ta_field_classes} h-auto" %>
            </div>
          </div>
          <button type="submit" class="<%= ta_btn_primary %> min-h-11 cursor-pointer"
                  style="background: var(--org-party-color); color: var(--org-party-contrast)"><%= t("ground_reports.record_response") %></button>
        <% end %>
      <% end %>
    <% else %>
      <p class="border-t border-gray-100 px-6 py-4 text-sm text-gray-500 dark:border-gray-800"><%= t("ground_reports.no_politicians") %></p>
    <% end %>
  <% end %>
</section>
