<% content_for :title, "Ground Reports" %>
<% page_link = "inline-flex h-9 items-center rounded-lg border border-gray-200 bg-white px-3 text-sm font-medium text-gray-700 hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-900 dark:text-gray-200" %>

<%= render layout: "ui/campaign_hero", locals: {
      kicker: "Ground Reports",
      title: "Ground Reports",
      subtitle: pluralize(@pagy.count, "village"),
      meta: current_user.organization.name
    } do %><% end %>

<% if current_user.role.can_import? %>
  <div class="mt-4 flex justify-end">
    <%= link_to "Import", new_ground_reports_import_path, class: "#{page_link} min-h-11 cursor-pointer" %>
  </div>
<% end %>

<%= form_with url: ground_reports_villages_path, method: :get,
      class: "#{current_user.role.can_import? ? "mt-4" : "mt-6"} #{ta_card_classes} p-4 md:p-5" do %>
  <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-[minmax(0,16rem)_minmax(0,16rem)_auto] lg:items-end">
    <div>
      <%= label_tag :taluka_id, "Taluka", class: ta_label_classes %>
      <%= select_tag :taluka_id,
            options_from_collection_for_select(@talukas, :id, :name, params[:taluka_id]),
            include_blank: "All talukas",
            class: ta_field_classes %>
    </div>
    <div>
      <%= label_tag :village_id, "Village", class: ta_label_classes %>
      <%= select_tag :village_id,
            options_from_collection_for_select(@filter_villages, :id, :name, params[:village_id]),
            include_blank: "All villages",
            class: ta_field_classes %>
    </div>
    <div class="flex items-end gap-2">
      <button type="submit" class="<%= ta_btn_primary %> min-h-11 cursor-pointer"
              style="background: var(--org-party-color); color: var(--org-party-contrast)">Filter</button>
      <%= link_to "Clear", ground_reports_villages_path, class: "#{ta_btn_secondary} inline-flex min-h-11 items-center" %>
    </div>
  </div>
<% end %>

<div class="mt-4 <%= ta_card_classes %> overflow-hidden">
  <div class="overflow-x-auto">
    <table class="w-full text-sm">
      <thead class="bg-gray-50 dark:bg-white/[0.03]">
        <tr>
          <th class="border-b border-gray-200 px-6 py-3 text-left text-xs font-medium text-gray-500 dark:border-gray-800">Village</th>
          <th class="border-b border-gray-200 px-6 py-3 text-left text-xs font-medium text-gray-500 dark:border-gray-800">Taluka</th>
          <th class="border-b border-gray-200 px-6 py-3 text-right text-xs font-medium text-gray-500 dark:border-gray-800">Total nidhi</th>
          <th class="border-b border-gray-200 px-6 py-3 text-right text-xs font-medium text-gray-500 dark:border-gray-800"><span class="sr-only">Actions</span></th>
        </tr>
      </thead>
      <tbody>
        <% @villages.each do |village| %>
          <tr class="hover:bg-gray-50 last:[&>td]:border-b-0 dark:hover:bg-white/[0.03]">
            <td class="border-b border-gray-100 px-6 py-4 dark:border-gray-800">
              <%= link_to village.name, ground_reports_village_path(village),
                    class: "font-medium text-gray-900 hover:text-brand-600 dark:text-white/90" %>
            </td>
            <td class="border-b border-gray-100 px-6 py-4 text-gray-600 dark:border-gray-800 dark:text-gray-300"><%= village.taluka&.name || "—" %></td>
            <td class="border-b border-gray-100 px-6 py-4 text-right tabular-nums text-gray-700 dark:border-gray-800 dark:text-gray-300"><%= format_nidhi(@nidhi_totals[village.id]) %></td>
            <td class="border-b border-gray-100 px-6 py-4 text-right dark:border-gray-800">
              <%= icon_action_link :view, ground_reports_village_path(village) %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <% if @villages.empty? %>
    <p class="px-6 py-16 text-center text-sm text-gray-400">
      <% if params[:village_id].present? %>
        No villages match this filter.
      <% elsif params[:taluka_id].present? %>
        No villages match this taluka.
      <% else %>
        No villages in this constituency.
      <% end %>
    </p>
  <% end %>

  <%= render "ui/pagination", pagy: @pagy %>
</div>
