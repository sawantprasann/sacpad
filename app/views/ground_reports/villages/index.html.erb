<% content_for :title, "Ground Reports" %>
<% page_link = "inline-flex h-9 items-center rounded-lg border border-gray-200 bg-white px-3 text-sm font-medium text-gray-700 hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-900 dark:text-gray-200" %>

<div class="mb-4 flex flex-wrap items-center justify-between gap-4 rounded-2xl border px-6 py-5"
     style="background: color-mix(in srgb, var(--org-party-color) 12%, white); border-color: color-mix(in srgb, var(--org-party-color) 28%, white)">
  <div class="flex min-w-0 items-center gap-3">
    <span class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-xl text-sm font-bold"
          style="background: var(--org-party-color); color: var(--org-party-contrast)">GR</span>
    <div class="min-w-0">
      <h1 class="text-xl font-semibold tracking-tight text-gray-900">Ground Reports</h1>
      <p class="mt-1 text-sm text-gray-600">
        <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold"
              style="background: var(--org-party-color); color: var(--org-party-contrast)"><%= pluralize(@pagy.count, "village") %></span>
      </p>
    </div>
  </div>
  <% if current_user.role.can_import? %>
    <%= link_to "Import", new_ground_reports_import_path, class: "#{page_link} min-h-11 cursor-pointer" %>
  <% end %>
</div>

<div class="<%= ta_card_classes %> overflow-hidden">
  <table class="w-full text-sm">
    <thead class="bg-gray-50 dark:bg-white/[0.03]">
      <tr>
        <th class="border-b border-gray-200 px-6 py-3 text-left text-xs font-medium text-gray-500 dark:border-gray-800">Village</th>
        <th class="border-b border-gray-200 px-6 py-3 text-left text-xs font-medium text-gray-500 dark:border-gray-800">Assembly</th>
      </tr>
    </thead>
    <tbody>
      <% @villages.each do |village| %>
        <tr class="hover:bg-gray-50 last:[&>td]:border-b-0 dark:hover:bg-white/[0.03]">
          <td class="border-b border-gray-100 px-6 py-4 dark:border-gray-800">
            <%= link_to village.name, ground_reports_village_path(village),
                  class: "font-medium text-gray-900 hover:text-brand-600 dark:text-white/90" %>
          </td>
          <td class="border-b border-gray-100 px-6 py-4 text-gray-600 dark:border-gray-800 dark:text-gray-300"><%= village.assembly.name %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <% if @villages.empty? %>
    <p class="px-6 py-16 text-center text-sm text-gray-400">No villages in this constituency.</p>
  <% end %>

  <% if @pagy.last > 1 %>
    <nav class="flex items-center justify-between gap-3 border-t border-gray-200 px-6 py-3 dark:border-gray-800">
      <% if @pagy.previous %>
        <%= link_to "← Prev", ground_reports_villages_path(page: @pagy.previous), class: page_link %>
      <% else %>
        <span class="text-sm text-gray-300">← Prev</span>
      <% end %>
      <span class="text-sm tabular-nums text-gray-500">Page <%= @pagy.page %> of <%= @pagy.last %></span>
      <% if @pagy.next %>
        <%= link_to "Next →", ground_reports_villages_path(page: @pagy.next), class: page_link %>
      <% else %>
        <span class="text-sm text-gray-300">Next →</span>
      <% end %>
    </nav>
  <% end %>
</div>
