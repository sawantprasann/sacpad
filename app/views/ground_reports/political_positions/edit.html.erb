<%= render layout: "ground_reports/edit_page", locals: { title: "Edit political position" } do %>
  <%= form_with model: @position, scope: :village_political_position,
        url: ground_reports_village_political_position_path(@village, @position), method: :patch do |f| %>
    <% if @position.errors.any? %>
      <div class="mb-6 rounded-lg border border-error-500/30 bg-error-50 px-4 py-2 text-sm text-error-500"><%= @position.errors.full_messages.to_sentence %></div>
    <% end %>

    <div class="space-y-3">
      <div>
        <%= f.label :party_id, "Party", class: ta_label_classes %>
        <%= f.collection_select :party_id, @parties, :id, :name, { prompt: "Select a party" }, { required: true, class: ta_field_classes } %>
      </div>
      <div>
        <%= f.label :representative_name, "Representative", class: ta_label_classes %>
        <%= f.text_field :representative_name, required: true, class: ta_field_classes %>
      </div>
      <div>
        <%= f.label :position_title, "Title", class: ta_label_classes %>
        <%= f.text_field :position_title, required: true, class: ta_field_classes %>
      </div>
      <div>
        <%= f.label :started_at, "Started", class: ta_label_classes %>
        <%= f.date_field :started_at, required: true, class: ta_field_classes %>
      </div>
      <div>
        <%= f.label :ended_at, "Ended", class: ta_label_classes %>
        <%= f.date_field :ended_at, class: ta_field_classes %>
      </div>
    </div>

    <div class="mt-6 flex flex-wrap gap-3 border-t border-gray-100 pt-6 dark:border-gray-800">
      <button type="submit" class="<%= ta_btn_primary %> min-h-11 cursor-pointer"
              style="background: var(--org-party-color); color: var(--org-party-contrast)">Save changes</button>
      <%= link_to "Cancel", ground_reports_village_path(@village), class: "#{ta_btn_secondary} inline-flex items-center min-h-11 cursor-pointer" %>
    </div>
  <% end %>
<% end %>
