<template data-assistant-chat-target="thinking">
  <div id="assistant-thinking" class="flex items-end gap-2" data-failed="<%= t("assistant.unavailable") %>">
    <span class="mb-1 inline-flex h-7 w-7 shrink-0 items-center justify-center" aria-hidden="true">
      <%= render "ui/ai_spark", class_name: "h-5 w-5" %>
    </span>
    <div class="rounded-2xl rounded-bl-md border border-gray-200 bg-white px-3.5 py-3 shadow-sm dark:border-gray-800 dark:bg-gray-900">
      <p class="flex items-center gap-1 text-sm text-gray-400" data-thinking-label>
        <span class="inline-block h-1.5 w-1.5 animate-pulse rounded-full bg-gray-300"></span>
        <span class="inline-block h-1.5 w-1.5 animate-pulse rounded-full bg-gray-300 [animation-delay:150ms]"></span>
        <span class="inline-block h-1.5 w-1.5 animate-pulse rounded-full bg-gray-300 [animation-delay:300ms]"></span>
        <span class="sr-only"><%= t("assistant.thinking") %></span>
      </p>
    </div>
  </div>
</template>
