<% if message.from_user? %>
  <div id="<%= dom_id(message) %>" class="flex justify-end">
    <p class="max-w-xl rounded-2xl bg-gray-100 px-4 py-3 text-sm leading-6 text-gray-700 dark:bg-gray-800 dark:text-gray-200"><%= message.body %></p>
  </div>
<% else %>
  <div id="<%= dom_id(message) %>" class="flex gap-3">
    <span class="mt-0.5 inline-flex h-6 w-6 shrink-0 items-center justify-center text-[#465fff]" aria-hidden="true">
      <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path d="M10 1.5l1.2 4.3a2 2 0 001.4 1.4L17 8.4l-4.4 1.2a2 2 0 00-1.4 1.4L10 15.3l-1.2-4.3a2 2 0 00-1.4-1.4L3 8.4l4.4-1.2a2 2 0 001.4-1.4L10 1.5z"/></svg>
    </span>
    <div class="min-w-0">
      <p class="text-sm font-medium text-gray-800 dark:text-white/90"><%= t("assistant.nav") %></p>
      <% if message.draft? %>
        <p class="mt-1 text-xs font-medium text-amber-700 dark:text-amber-300"><%= t("assistant.draft_label") %></p>
      <% end %>
      <div class="mt-2 text-sm leading-6 whitespace-pre-wrap text-gray-700 dark:text-gray-300"><%= message.body %></div>
      <% if message.link_path.present? %>
        <%= link_to message.link_label.presence || t("assistant.open_list"), message.link_path, class: "mt-3 inline-flex text-sm font-medium text-[#465fff] hover:underline" %>
      <% end %>
    </div>
  </div>
<% end %>
