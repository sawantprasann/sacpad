<% content_for :title, "Style guide" %>
<%= render "ui/breadcrumb", title: "Style guide" %>

<div class="grid grid-cols-1 gap-5 lg:grid-cols-2">
  <%= render layout: "ui/card", locals: { title: "Buttons & toolbar" } do %>
    <div class="flex flex-wrap items-center gap-2">
      <button class="rounded-lg px-3 py-1.5 text-sm font-medium text-white" style="background: var(--org-party-color)">Primary (party accent)</button>
      <button class="rounded-lg border border-gray-200 bg-white px-3 py-1.5 text-sm font-medium text-gray-600">Secondary</button>
    </div>
    <div class="mt-4"><%= render "ui/module_toolbar" %></div>
  <% end %>

  <%= render layout: "ui/card", locals: { title: "Badges" } do %>
    <div class="flex flex-wrap gap-2">
      <%= render "ui/badge", label: "Neutral", tone: "gray" %>
      <%= render "ui/badge", label: "Brand", tone: "brand" %>
    </div>
  <% end %>

  <%= render layout: "ui/card", locals: { title: "Ticket status (cool pills, never solid)" } do %>
    <div class="flex flex-wrap gap-2">
      <% %w[open in_progress closed blocked].each do |s| %><%= render "ui/status_pill", status: s %><% end %>
    </div>
  <% end %>

  <%= render layout: "ui/card", locals: { title: "Voter sentiment / RAG (solid, reserved, labelled)" } do %>
    <div class="flex flex-wrap gap-2">
      <% %w[green amber red].each do |c| %><%= render "ui/rag_chip", color: c %><% end %>
    </div>
  <% end %>

  <%= render layout: "ui/card", locals: { title: "Alerts" } do %>
    <div class="space-y-2">
      <%= render "ui/alert", tone: "success", message: "Resolved. This is now on record as help delivered." %>
      <%= render "ui/alert", tone: "warning", message: "This issue is blocked — note why in a follow-up." %>
    </div>
  <% end %>
</div>
