<% content_for :title, t("nav.dashboard") %>
<% party = current_user.organization.current_party %>
<% desks = [] %>
<% if current_user.role.can_access?("kitchen_cabinet") %>
  <% desks << { title: t("nav.beneficiaries"), blurb: t("dashboard.beneficiaries_blurb"), path: kitchen_cabinet_tickets_path, mark: "kitchen_cabinet", jewel: 0 } %>
<% end %>
<% if current_user.role.can_access?("cadre_program") %>
  <% desks << { title: t("nav.cadre_program"), blurb: t("dashboard.cadre_blurb"), path: cadre_program_activities_path, mark: "cadre_program", jewel: 1 } %>
<% end %>
<% if current_user.role.can_access?("ground_reports") %>
  <% desks << { title: t("nav.ground_reports"), blurb: t("dashboard.ground_reports_blurb"), path: ground_reports_villages_path, mark: "ground_reports", jewel: 2 } %>
<% end %>
<% if current_user.role.can_access?("pr") %>
  <% desks << { title: t("nav.pr_records"), blurb: t("dashboard.pr_blurb"), path: pr_records_path, mark: "pr", jewel: 3 } %>
<% end %>
<% if current_user.role.can_access?("voter_lists") %>
  <% desks << { title: t("nav.voter_lists"), blurb: t("dashboard.voter_lists_blurb"), path: voters_path, mark: "voters", jewel: 4 } %>
  <% desks << { title: t("nav.taluka"), blurb: t("dashboard.taluka_blurb"), path: voter_lists_talukas_path, mark: "taluka", jewel: 6 } %>
<% end %>
<% if current_user.role.can_access?("booth_management") %>
  <% desks << { title: t("nav.booth_management"), blurb: t("dashboard.booth_blurb"), path: booths_path, mark: "booths", jewel: 5 } %>
<% end %>
<% if @constituency_election %>
  <% desks << { title: t("dashboard.election_result"), blurb: t("dashboard.election_blurb"), path: election_result_path, mark: "constituency_elections", jewel: 4 } %>
<% end %>

<%= render layout: "ui/campaign_hero", locals: {
        kicker: t("dashboard.namaste"),
        title: "#{dashboard_greeting}, #{current_user.name}",
        subtitle: [ current_user.organization.name, current_user.role.name, party&.name ].compact.join(" · "),
        meta: l(dashboard_now, format: "%A, %-d %B %Y")
      } do %><% end %>

  <% if desks.any? %>
    <div class="mt-6">
      <h2 class="text-sm font-semibold uppercase tracking-[0.16em] text-amber-800 dark:text-amber-200"><%= t("dashboard.open_a_desk") %></h2>
      <div class="mt-3 grid grid-cols-1 gap-3 sm:grid-cols-2 xl:grid-cols-3 2xl:grid-cols-5">
        <% desks.each do |desk| %>
          <% jewel = dashboard_jewel(desk[:jewel]) %>
          <%= link_to desk[:path],
                class: "group relative overflow-hidden rounded-2xl bg-white p-4 shadow-theme-md ring-1 #{jewel[:ring]} transition hover:-translate-y-0.5 hover:shadow-theme-lg dark:bg-gray-900 dark:ring-white/10" do %>
            <span class="absolute inset-x-0 top-0 h-1.5 bg-gradient-to-r <%= jewel[:bar] %>"></span>
            <div class="mt-1 flex items-center gap-3">
              <%= render "ui/desk_mark", name: desk[:mark], chip_class: jewel[:chip] %>
              <div>
                <p class="text-sm font-semibold text-gray-900 group-hover:text-gray-950 dark:text-white/90"><%= desk[:title] %></p>
                <p class="mt-0.5 text-xs text-gray-500 dark:text-gray-400"><%= desk[:blurb] %></p>
              </div>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>

  <div class="mt-8 mb-4 flex flex-col gap-1 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <h2 class="text-lg font-semibold text-gray-900 dark:text-white/90"><%= t("dashboard.at_a_glance") %></h2>
      <p class="text-sm text-gray-500 dark:text-gray-400"><%= t("dashboard.glance_subtitle") %></p>
    </div>
  </div>

  <% indexed = @widgets.each_with_index.to_a %>
  <% charts, rest = indexed.partition { |widget, _index| %w[kitchen_cabinet cadre_program].include?(widget[:mod]) } %>
  <% glance = charts.size + (@constituency_election ? 1 : 0) %>
  <% if glance.positive? %>
    <div class="grid grid-cols-1 gap-6 <%= "lg:grid-cols-2" if glance > 1 %>">
      <% charts.each do |widget, index| %>
        <%= render "ui/dashboard_widget", widget: widget, accent_index: index %>
      <% end %>
      <% if @constituency_election %>
        <%= render "ui/dashboard_widget", widget: { title: t("nav.election_result"), mod: "constituency_elections" }, accent_index: 4 %>
      <% end %>
    </div>
  <% end %>
  <% if rest.any? %>
    <div class="<%= "mt-6" if glance.positive? %> grid grid-cols-1 gap-6">
      <% rest.each do |widget, index| %>
        <%= render "ui/dashboard_widget", widget: widget, accent_index: index %>
      <% end %>
    </div>
  <% end %>
  <% if @widgets.empty? && @constituency_election.blank? %>
    <div class="rounded-2xl border border-dashed border-amber-300 bg-white/80 px-5 py-8 text-center text-sm text-amber-900 dark:border-amber-700/40 dark:bg-gray-900 dark:text-amber-100">
      <%= t("dashboard.no_modules") %>
    </div>
  <% end %>

