<% content_for :title, "Dashboard" %>

<div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
  <div>
    <h1 class="<%= ta_page_title %>">Dashboard</h1>
    <p class="mt-1 text-sm text-gray-500 dark:text-gray-400"><%= current_user.organization.name %></p>
  </div>
  <%= render "ui/module_toolbar" %>
</div>

<% if @widgets.any? %>
  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3 md:gap-6">
    <% @widgets.each do |widget| %>
      <%= render "ui/dashboard_widget", widget: widget %>
    <% end %>
  </div>
<% else %>
  <p class="text-sm text-gray-500">No modules are available to your role yet.</p>
<% end %>
