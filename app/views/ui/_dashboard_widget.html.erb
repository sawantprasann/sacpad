<%# Dashboard widget card (FR50). Jewel chrome is decorative; RAG colors stay inside module bodies. %>
<% jewel = dashboard_jewel(local_assigns[:accent_index] || 0) %>
<% mark = widget[:mod].presence || "admin" %>
<article class="group relative overflow-hidden rounded-2xl bg-white shadow-theme-md ring-1 <%= jewel[:ring] %> transition hover:-translate-y-0.5 hover:shadow-theme-lg dark:bg-gray-900 dark:ring-white/10">
  <div class="h-1.5 bg-gradient-to-r <%= jewel[:bar] %>"></div>
  <div class="pointer-events-none absolute -top-8 -right-8 h-24 w-24 rounded-full opacity-70 <%= jewel[:wash] %>"></div>
  <div class="relative p-5">
    <div class="flex items-start justify-between gap-3">
      <div class="flex items-center gap-3">
        <%= render "ui/desk_mark", name: mark, chip_class: jewel[:chip] %>
        <p class="text-sm font-semibold text-gray-800 dark:text-white/90"><%= widget[:title] %></p>
      </div>
      <% if widget[:admin_only] %>
        <span class="inline-flex shrink-0 rounded-full bg-amber-100 px-2.5 py-0.5 text-xs font-semibold text-amber-800">Org admin</span>
      <% end %>
    </div>
    <%# Each module supplies its own body at app/views/<mod>/_dashboard_widget.html.erb. The framework
        stays generic (FR50) — no module-specific code here. %>
    <% body = widget[:mod] && "#{widget[:mod]}/dashboard_widget" %>
    <% if body && lookup_context.exists?(body, [], true) %>
      <div class="mt-4"><%= render body, widget: widget %></div>
    <% else %>
      <p class="mt-4 text-xs text-gray-400">Nothing on this desk yet.</p>
    <% end %>
  </div>
</article>
