<%# Reusable dashboard widget shell (FR50). Content is filled per-module as modules are built. %>
<div class="rounded-2xl border border-gray-200 bg-white p-4">
  <div class="flex items-center justify-between">
    <p class="text-sm font-medium text-gray-700"><%= widget[:title] %></p>
    <% if widget[:admin_only] %><span class="rounded-full bg-gray-100 px-2 py-0.5 text-xs text-gray-500">org admin</span><% end %>
  </div>
  <p class="mt-2 text-xs text-gray-400">Widget content is populated by its module epic.</p>
</div>
