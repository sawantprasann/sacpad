<%# Dashboard widget card (FR50). Content filled per-module as modules are built. %>
<div class="rounded-2xl border border-gray-200 bg-white p-5 shadow-sm transition hover:shadow-md">
  <div class="flex items-center justify-between">
    <p class="text-sm font-semibold text-gray-700"><%= widget[:title] %></p>
    <% if widget[:admin_only] %><%= render "ui/badge", label: "Org admin", tone: "brand" %><% end %>
  </div>
  <p class="mt-3 text-xs text-gray-400">Populated by its module epic.</p>
</div>
