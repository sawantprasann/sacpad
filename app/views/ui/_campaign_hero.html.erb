<%# Festive page banner. The wash matches the Kitchen Cabinet banner unless a page passes its own. %>
<% wash = local_assigns[:wash].presence || "linear-gradient(125deg, #06eff4 0%, #ea580c 48%, #f59e0b 100%)" %>
<section
  class="relative overflow-hidden rounded-3xl shadow-theme-xl ring-1 ring-white/40"
  style="background:
    radial-gradient(circle at 92% 0%, rgba(255,255,255,0.28), transparent 26%),
    radial-gradient(circle at 0% 100%, rgba(255,214,10,0.35), transparent 34%),
    <%= wash %>;"
>
  <%# Ashoka Chakra in the flag navy (#000080), centered on the right so the whole wheel stays inside the banner. %>
  <svg class="pointer-events-none absolute" style="top: 50%; right: 1.75rem; width: 6.25rem; height: 6.25rem; transform: translateY(-50%); color: #000080;" viewBox="0 0 120 120" fill="none" aria-hidden="true">
    <circle cx="60" cy="60" r="52" stroke="currentColor" stroke-width="4"/>
    <circle cx="60" cy="60" r="8" fill="currentColor"/>
    <g stroke="currentColor" stroke-width="2.4">
      <% 24.times do |i| %>
        <line x1="60" y1="11" x2="60" y2="51" transform="rotate(<%= i * 15 %> 60 60)"/>
      <% end %>
    </g>
  </svg>

  <div class="relative px-5 py-6 sm:px-8 sm:py-8">
    <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
      <div class="min-w-0 max-w-2xl pr-28">
        <% if local_assigns[:kicker].present? %>
          <p class="text-xs font-semibold uppercase tracking-[0.28em] text-white/80"><%= kicker %></p>
        <% end %>
        <h1 class="mt-2 text-3xl font-bold tracking-tight text-white sm:text-4xl"<% if local_assigns[:title_bind].present? %> x-text="<%= title_bind %>"<% end %>><%= title %></h1>
        <% if local_assigns[:subtitle].present? %>
          <p class="mt-3 text-base font-medium text-white/95"><%= subtitle %></p>
        <% end %>
        <% if local_assigns[:meta].present? %>
          <p class="mt-1 text-sm text-white/80"><%= meta %></p>
        <% end %>
      </div>
      <% actions = yield %>
      <% if actions.present? %>
        <div class="shrink-0 rounded-2xl bg-white/15 p-2 ring-1 ring-white/30 backdrop-blur-sm">
          <%= actions %>
        </div>
      <% end %>
    </div>

    <div class="mt-6 flex h-2 overflow-hidden rounded-full shadow-sm" style="margin-right: 9rem;" aria-hidden="true">
      <span class="flex-1 bg-[#FF9933]"></span>
      <span class="flex-1 bg-white"></span>
      <span class="flex-1 bg-[#138808]"></span>
    </div>
  </div>
</section>
