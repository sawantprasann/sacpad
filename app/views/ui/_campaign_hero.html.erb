<%# Festive page banner. Height is fixed so every page matches. The photo is contained, not cropped. %>
<% wash = local_assigns[:wash].presence || "linear-gradient(125deg, #06eff4 0%, #ea580c 48%, #f59e0b 100%)" %>
<% banner = campaign_banner_photo %>
<section
  class="flex h-64 items-stretch overflow-hidden rounded-3xl shadow-theme-xl ring-1 ring-white/40"
  style="background:
    radial-gradient(circle at 92% 0%, rgba(255,255,255,0.28), transparent 26%),
    radial-gradient(circle at 0% 100%, rgba(255,214,10,0.35), transparent 34%),
    <%= wash %>;"
>
  <div class="flex min-w-0 flex-1 flex-col justify-center px-5 py-5 sm:px-8">
    <div class="flex items-center justify-between gap-4">
      <div class="min-w-0 max-w-2xl">
        <% if local_assigns[:kicker].present? %>
          <p class="text-xs font-semibold uppercase tracking-[0.28em] text-white/80"><%= kicker %></p>
        <% end %>
        <h1 class="mt-2 line-clamp-2 text-3xl font-bold tracking-tight text-white sm:text-4xl"<% if local_assigns[:title_bind].present? %> x-text="<%= title_bind %>"<% end %>><%= title %></h1>
        <% if local_assigns[:subtitle].present? %>
          <p class="mt-2 line-clamp-2 text-base font-medium text-white/95"><%= subtitle %></p>
        <% end %>
        <% if local_assigns[:meta].present? %>
          <p class="mt-1 line-clamp-1 text-sm text-white/80"><%= meta %></p>
        <% end %>
      </div>
      <% actions = yield %>
      <% if actions.present? %>
        <div class="shrink-0 rounded-2xl bg-white/15 p-2 ring-1 ring-white/30 backdrop-blur-sm">
          <%= actions %>
        </div>
      <% end %>
    </div>

    <div class="mt-4 flex h-2 overflow-hidden rounded-full shadow-sm" aria-hidden="true">
      <span class="flex-1 bg-[#FF9933]"></span>
      <span class="flex-1 bg-white"></span>
      <span class="flex-1 bg-[#138808]"></span>
    </div>
  </div>
  <% if banner %>
    <%= image_tag banner,
          class: "h-full w-40 shrink-0 object-contain object-center p-3 sm:w-64",
          style: "background: transparent;",
          alt: campaign_banner_organization.name %>
  <% end %>
</section>
