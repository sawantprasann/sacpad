<div class="flex items-center gap-1" role="group" aria-label="<%= t("nav.language") %>">
  <% I18n.available_locales.each do |code| %>
    <% active = I18n.locale == code %>
    <%= button_to t("locales.#{code}"), locale_path, method: :patch, params: { locale: code },
          form: { class: "inline", data: { turbo: false } },
          class: "cursor-pointer rounded-lg px-2.5 py-1 text-xs font-semibold #{active ? "bg-[#0b1f44] text-white" : "text-gray-600 hover:bg-amber-50 dark:text-gray-300 dark:hover:bg-white/5"}" %>
  <% end %>
</div>
