<%# TailAdmin sidebar: real structure + .menu-item component classes. Collapses on mobile via
    Alpine sidebarToggle (body x-data). Our nav + PolitoMatrix branding (not TailAdmin's logo). %>
<aside
  :class="sidebarToggle ? 'translate-x-0' : '-translate-x-full'"
  class="campaign-sidebar sidebar fixed top-0 left-0 z-50 flex h-screen w-[290px] flex-col overflow-y-auto px-5 transition-all duration-300 xl:static xl:translate-x-0"
  @click.outside="if (window.innerWidth < 1280) sidebarToggle = false"
>
  <div class="flex items-center gap-2 pt-8 pb-7">
    <%= link_to root_path, class: "flex items-center gap-2" do %>
      <span class="inline-flex h-9 w-9 items-center justify-center rounded-xl text-sm font-bold" style="background: #f59e0b; color: #0b1f44">PM</span>
      <span class="campaign-wordmark text-lg font-semibold">PolitoMatrix</span>
    <% end %>
  </div>

  <div class="no-scrollbar flex flex-col overflow-y-auto duration-300 ease-linear">
    <nav>
      <div>
        <h3 class="campaign-nav-label mb-4 text-xs leading-5 font-semibold uppercase tracking-[0.16em]"><%= t("nav.menu") %></h3>
        <ul class="mb-6 flex flex-col gap-1">
          <li>
            <%= link_to root_path, class: "menu-item group #{current_page?(root_path) ? "menu-item-active" : "menu-item-inactive"}" do %>
              <%= menu_desk_icon("dashboard") %>
              <span class="menu-item-text"><%= t("nav.dashboard") %></span>
            <% end %>
          </li>
          <% if user_signed_in? && current_user.can_use_calendar? %>
            <li>
              <%= link_to calendar_events_path, class: "menu-item group #{controller_name == "calendar_events" ? "menu-item-active" : "menu-item-inactive"}" do %>
                <%= menu_desk_icon("calendar") %>
                <span class="menu-item-text"><%= t("nav.calendar") %></span>
              <% end %>
            </li>
          <% end %>
          <% if user_signed_in? && current_user.role.can_create_users? %>
            <li>
              <%= link_to users_path, class: "menu-item group #{controller_name == "users" ? "menu-item-active" : "menu-item-inactive"}" do %>
                <%= menu_desk_icon("team") %>
                <span class="menu-item-text"><%= t("nav.team") %></span>
              <% end %>
            </li>
          <% end %>
        </ul>

        <h3 class="campaign-nav-label mb-4 text-xs leading-5 font-semibold uppercase tracking-[0.16em]"><%= t("nav.modules") %></h3>
        <ul class="flex flex-col gap-1">
          <% if user_signed_in? && election_result_nav? %>
            <li>
              <%= link_to election_result_path,
                    class: "menu-item group #{params[:controller] == "election_results" ? "menu-item-active" : "menu-item-inactive"}" do %>
                <%= menu_desk_icon("constituency_elections") %>
                <span class="menu-item-text"><%= t("nav.election_result") %></span>
              <% end %>
            </li>
          <% end %>
          <%# Beneficiaries (formerly Kitchen Cabinet). One link — category is chosen on the
              ticket form and in the list filters, not as sidebar items. %>
          <% if user_signed_in? && current_user.role.can_access?("kitchen_cabinet") %>
            <li>
              <%= link_to kitchen_cabinet_tickets_path,
                    class: "menu-item group #{params[:controller].to_s.start_with?("kitchen_cabinet/") ? "menu-item-active" : "menu-item-inactive"}" do %>
                <%= menu_desk_icon("kitchen_cabinet") %>
                <span class="menu-item-text"><%= t("nav.beneficiaries") %></span>
              <% end %>
            </li>
          <% end %>

          <%# Cadre Program: expandable submenu of the five fixed categories, each driving the
              ?category= filter. Same pattern as Kitchen Cabinet. Shown only with module access. %>
          <% if user_signed_in? && current_user.role.can_access?("cadre_program") %>
            <% on_cadre_program = params[:controller] == "cadre_program/activities" %>
            <% cadre_category = cadre_nav_category %>
            <li x-data="{ open: <%= on_cadre_program %> }">
              <button type="button" @click="open = !open"
                class="menu-item group w-full <%= on_cadre_program ? "menu-item-active" : "menu-item-inactive" %>"
                :class="open ? 'menu-item-active' : 'menu-item-inactive'">
                <%= menu_desk_icon("cadre_program") %>
                <span class="menu-item-text"><%= t("nav.cadre_program") %></span>
                <svg class="ml-auto h-4 w-4 transition-transform" :class="{ 'rotate-180': open }"
                     viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd"/>
                </svg>
              </button>
              <ul x-show="open" x-cloak class="mt-1 ml-5 flex flex-col gap-1 border-l border-gray-100 pl-3 dark:border-gray-800">
                <% CadreProgram::CadreActivity::CATEGORY_LABELS.each_key do |key| %>
                  <% label = CadreProgram::CadreActivity.localized_category(key) %>
                  <% cat_path = cadre_program_activities_path(category: key) %>
                  <% active_category = cadre_category == key %>
                  <li>
                    <%= link_to label, cat_path,
                          class: "menu-dropdown-item #{active_category ? "menu-dropdown-item-active" : "menu-dropdown-item-inactive"}",
                          aria: (active_category ? { current: "page" } : {}) %>
                  </li>
                <% end %>
              </ul>
            </li>
          <% end %>

          <% if user_signed_in? && current_user.role.can_access?("ground_reports") %>
            <li>
              <%= link_to ground_reports_villages_path,
                    class: "menu-item group #{params[:controller].to_s.start_with?("ground_reports/") ? "menu-item-active" : "menu-item-inactive"}" do %>
                <%= menu_desk_icon("ground_reports") %>
                <span class="menu-item-text"><%= t("nav.ground_reports") %></span>
              <% end %>
            </li>
          <% end %>

          <%# PR Records: one link. Category is chosen on the list, the same way Beneficiaries works. %>
          <% if user_signed_in? && current_user.role.can_access?("pr") %>
            <li>
              <%= link_to pr_records_path,
                    class: "menu-item group #{params[:controller] == "pr_records" ? "menu-item-active" : "menu-item-inactive"}" do %>
                <%= menu_desk_icon("pr") %>
                <span class="menu-item-text"><%= t("nav.pr_records") %></span>
              <% end %>
            </li>
          <% end %>

          <% if user_signed_in? && current_user.role.can_access?("voter_lists") %>
            <li>
              <%= link_to voters_path,
                    class: "menu-item group #{params[:controller] == "voters" ? "menu-item-active" : "menu-item-inactive"}" do %>
                <%= menu_desk_icon("voters") %>
                <span class="menu-item-text"><%= t("nav.voter_lists") %></span>
              <% end %>
            </li>
            <li>
              <%= link_to voter_lists_talukas_path,
                    class: "menu-item group #{params[:controller].to_s.start_with?("voter_lists/") ? "menu-item-active" : "menu-item-inactive"}" do %>
                <%= menu_desk_icon("taluka") %>
                <span class="menu-item-text"><%= t("nav.taluka") %></span>
              <% end %>
            </li>
          <% end %>

          <% if user_signed_in? && current_user.role.can_access?("booth_management") %>
            <li>
              <%= link_to booths_path,
                    class: "menu-item group #{params[:controller].to_s.start_with?("booth_management/") ? "menu-item-active" : "menu-item-inactive"}" do %>
                <%= menu_desk_icon("booths") %>
                <span class="menu-item-text"><%= t("nav.booth_management") %></span>
              <% end %>
            </li>
          <% end %>

          <% if user_signed_in? && current_user.role.can_access?("social_media") %>
            <li>
              <%= link_to social_connections_path,
                    class: "menu-item group #{params[:controller] == "social_connections" ? "menu-item-active" : "menu-item-inactive"}" do %>
                <%= menu_desk_icon("social_media") %>
                <span class="menu-item-text"><%= t("nav.social_media") %></span>
              <% end %>
            </li>
          <% end %>
        </ul>

        <% if user_signed_in? %>
          <h3 class="campaign-nav-label mt-6 mb-4 text-xs leading-5 font-semibold uppercase tracking-[0.16em]"><%= t("nav.help") %></h3>
          <ul class="flex flex-col gap-1">
            <li>
              <%= link_to support_tickets_path,
                    class: "menu-item group #{params[:controller] == "support_tickets" ? "menu-item-active" : "menu-item-inactive"}" do %>
                <%= menu_desk_icon("support") %>
                <span class="menu-item-text"><%= t("nav.support") %></span>
              <% end %>
            </li>
          </ul>
        <% end %>
      </div>
    </nav>
  </div>
</aside>
