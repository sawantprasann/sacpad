<% if message.present? %>
  <% dialog_id = local_assigns[:dialog_id] || "flash-dialog-title" %>
  <div x-data="{ open: true }">
    <template x-teleport="body">
      <div x-show="open" x-cloak @keydown.escape.window="open = false"
           class="fixed inset-0 z-[9999] flex items-center justify-center p-4">
        <div class="absolute inset-0 bg-gray-900/50" @click="open = false"></div>
        <div role="<%= local_assigns[:role] || "dialog" %>" aria-modal="true" aria-labelledby="<%= dialog_id %>"
             class="relative w-full max-w-md rounded-2xl bg-white p-6 shadow-theme-xl dark:bg-gray-900">
          <h4 id="<%= dialog_id %>" class="text-lg font-bold text-gray-900 dark:text-white"><%= title %></h4>
          <p class="mt-2 text-sm leading-6 text-gray-600 dark:text-gray-300"><%= message %></p>
          <div class="mt-5 flex justify-end">
            <button type="button" @click="open = false" autofocus class="<%= ta_btn_primary %> cursor-pointer">OK</button>
          </div>
        </div>
      </div>
    </template>
  </div>
<% end %>
