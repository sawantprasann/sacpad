<%# Dropdown whose choices can show a colored dot. The native select is submitted.
    locals: name, choices ([[label, value, color], ...]), selected, blank, field_class %>
<% choices = local_assigns.fetch(:choices, []) %>
<% blank = local_assigns[:blank] %>
<% selected = local_assigns[:selected].to_s %>
<% field_class = local_assigns.fetch(:field_class, ta_field_classes) %>
<% select_id = local_assigns[:id] %>

<div class="relative w-full min-w-0"
     data-controller="colored-select"
     data-action="focusout->colored-select#focusOut">
  <select name="<%= name %>" <% if select_id.present? %>id="<%= select_id %>"<% end %> data-colored-select-target="select" class="<%= field_class %>">
    <% if blank.present? %>
      <option value=""><%= blank %></option>
    <% end %>
    <% choices.each do |label, value, color| %>
      <option value="<%= value %>" <% if color.present? %>data-color="<%= color %>"<% end %> <%= "selected" if selected == value.to_s %>><%= label %></option>
    <% end %>
  </select>

  <div data-colored-select-target="ui" class="relative hidden">
    <button type="button"
            class="<%= field_class %> flex cursor-pointer items-center gap-2 text-left"
            data-colored-select-target="toggle"
            data-action="click->colored-select#toggle keydown->colored-select#keydown"
            aria-haspopup="listbox"
            aria-expanded="false">
      <span data-colored-select-target="swatch" class="hidden h-2.5 w-2.5 shrink-0 rounded-full" aria-hidden="true"></span>
      <span data-colored-select-target="label" class="min-w-0 flex-1 truncate text-gray-400 dark:text-gray-500"></span>
      <span class="inline-flex shrink-0 text-gray-500 dark:text-gray-400" aria-hidden="true">
        <svg width="16" height="16" viewBox="0 0 20 20" fill="none">
          <path d="M6 8l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
    </button>
    <div data-colored-select-target="dropdown"
         hidden
         class="z-50 overflow-y-auto rounded-lg border border-gray-200 bg-white p-1 shadow-lg dark:border-gray-700 dark:bg-gray-900">
      <div data-colored-select-target="list"
           data-action="mousedown->colored-select#keepFocus click->colored-select#choose"
           role="listbox"
           class="space-y-0.5"></div>
    </div>
  </div>
</div>
