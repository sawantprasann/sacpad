<%# TailAdmin-style top bar (brief §5): app subtitle, session info, user area (NFR26). %>
<header class="sticky top-0 z-10 flex h-16 items-center justify-between border-b border-gray-200 bg-white/90 px-4 backdrop-blur sm:px-6">
  <div class="flex items-center gap-2">
    <span class="lg:hidden inline-flex h-7 w-7 items-center justify-center rounded-lg text-xs font-bold text-white"
          style="background: var(--org-party-color)">SP</span>
    <span class="text-sm font-medium text-gray-600">Constituency Management</span>
  </div>
  <div class="flex items-center gap-3 text-sm">
    <% if user_signed_in? %>
      <span class="hidden text-gray-500 sm:inline">
        <%= current_user.name %>
        · logins: <span class="tabular-nums"><%= current_user.sign_in_count %></span>
        <% if current_user.current_sign_in_at %>· <%= current_user.current_sign_in_at.strftime("%d %b %H:%M") %><% end %>
      </span>
      <% if current_user.photo.attached? %>
        <%= image_tag current_user.photo, class: "h-9 w-9 rounded-full object-cover ring-2 ring-gray-100" %>
      <% else %>
        <span class="inline-flex h-9 w-9 items-center justify-center rounded-full bg-gray-100 text-xs font-semibold text-gray-500"><%= current_user.name.to_s.first %></span>
      <% end %>
      <%= button_to "Sign out", destroy_user_session_path, method: :delete,
            class: "rounded-lg bg-gray-100 px-3 py-1.5 font-medium text-gray-700 hover:bg-gray-200" %>
    <% else %>
      <%= link_to "Sign in", new_user_session_path, class: "font-medium text-brand-600 hover:text-brand-700" %>
    <% end %>
  </div>
</header>
