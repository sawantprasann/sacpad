<div id="confirm-dialog" hidden
     data-title="<%= t("common.confirm_title") %>"
     data-accept="<%= t("common.confirm_action") %>"
     data-ok="OK">
  <div class="fixed inset-0 z-[9999] flex items-center justify-center p-4">
    <div class="absolute inset-0 bg-gray-900/50" data-confirm-backdrop></div>
    <div role="alertdialog" aria-modal="true" aria-labelledby="confirm-dialog-title"
         class="relative w-full max-w-md rounded-2xl bg-white p-6 shadow-theme-xl dark:bg-gray-900">
      <h4 id="confirm-dialog-title" data-confirm-title class="text-lg font-bold text-gray-900 dark:text-white"></h4>
      <p data-confirm-message class="mt-2 text-sm leading-6 text-gray-600 dark:text-gray-300"></p>
      <div class="mt-5 flex justify-end gap-2">
        <button type="button" data-confirm-cancel class="<%= ta_btn_secondary %> cursor-pointer"><%= t("common.cancel") %></button>
        <button type="button" data-confirm-accept class="inline-flex cursor-pointer items-center justify-center rounded-lg bg-error-500 px-4 py-2.5 text-sm font-medium text-white transition hover:bg-error-600"></button>
        <button type="button" data-confirm-ok hidden class="<%= ta_btn_primary %> cursor-pointer">OK</button>
      </div>
    </div>
  </div>
</div>
