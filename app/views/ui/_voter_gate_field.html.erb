<%# Voter-gate field (Story 1.6, UX-DR11). Always visible; LOCKED (disabled + lock glyph + helper)
    until status=closed; then editable. Normal styling, not error. voter_id is a loose lookup. %>
<% if ticket.closed? && policy(ticket).update? %>
  <%= form_with url: voter_kitchen_cabinet_ticket_path(ticket), method: :patch, class: "flex items-center gap-2" do %>
    <%= text_field_tag :voter_id, ticket.voter_id, placeholder: "Voter ID", class: "#{ta_field_classes} min-h-11" %>
    <%= submit_tag "Save", class: "#{ta_btn_secondary} min-h-11" %>
  <% end %>
  <% if (voter = ticket.matched_voter) %>
    <p class="mt-2 text-xs text-gray-500">Matches voter: <span class="font-medium text-gray-700 dark:text-gray-300"><%= voter.name %></span></p>
  <% elsif ticket.voter_id.present? %>
    <p class="mt-2 text-xs text-gray-400">No voter record matches this ID (loose lookup).</p>
  <% end %>
<% else %>
  <div class="flex items-center gap-2">
    <input type="text" value="<%= ticket.voter_id %>" disabled placeholder="Voter ID"
           class="<%= ta_field_classes %> min-h-11 cursor-not-allowed opacity-60">
    <svg class="h-4 w-4 shrink-0 text-gray-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
      <path fill-rule="evenodd" d="M10 2a4 4 0 00-4 4v2H5a2 2 0 00-2 2v6a2 2 0 002 2h10a2 2 0 002-2v-6a2 2 0 00-2-2h-1V6a4 4 0 00-4-4zm2 6V6a2 2 0 10-4 0v2h4z" clip-rule="evenodd"/>
    </svg>
  </div>
  <% unless ticket.closed? %>
    <p class="mt-2 text-xs text-gray-400">Voter ID unlocks once this issue is closed</p>
  <% end %>
<% end %>
