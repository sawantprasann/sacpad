<%# Voter id is read-only on the ticket. A matched voter is linked at create time.
    The close form is the last place a voter id or sentiment can be written. %>
<div class="flex items-center gap-2">
  <input type="text" value="<%= ticket.voter_id %>" disabled placeholder="<%= t("common.voter_id") %>"
         class="<%= ta_field_classes %> min-h-11 cursor-not-allowed opacity-60">
  <svg class="h-4 w-4 shrink-0 text-gray-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
    <path fill-rule="evenodd" d="M10 2a4 4 0 00-4 4v2H5a2 2 0 00-2 2v6a2 2 0 002 2h10a2 2 0 002-2v-6a2 2 0 00-2-2h-1V6a4 4 0 00-4-4zm2 6V6a2 2 0 10-4 0v2h4z" clip-rule="evenodd"/>
  </svg>
</div>
<% if (voter = ticket.matched_voter) %>
  <p class="mt-2 text-xs text-gray-500"><%= t("kitchen_cabinet.matches_voter", name: "") %><span class="font-medium text-gray-700 dark:text-gray-300"><%= voter.name %></span></p>
  <% unless ticket.closed? %>
    <p class="mt-1 text-xs text-gray-400"><%= t("kitchen_cabinet.sentiment_transit") %></p>
  <% end %>
<% elsif ticket.voter_id.present? %>
  <p class="mt-2 text-xs text-gray-400"><%= t("kitchen_cabinet.no_voter_match") %></p>
<% elsif ticket.closed? %>
  <p class="mt-2 text-xs text-gray-400"><%= t("kitchen_cabinet.ticket_closed") %></p>
<% else %>
  <p class="mt-2 text-xs text-gray-400"><%= t("kitchen_cabinet.voter_unlocks") %></p>
<% end %>
