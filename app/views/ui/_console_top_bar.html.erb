<%# Platform Console top bar — steel operator identity. %>
<header class="sticky top-0 z-30 flex w-full border-gray-200 bg-white xl:border-b dark:border-gray-800 dark:bg-gray-900">
  <div class="flex grow items-center justify-between px-3 py-3 sm:gap-4 lg:py-4 xl:px-6">
    <div class="flex items-center gap-3">
      <button
        @click.stop="sidebarToggle = !sidebarToggle"
        aria-label="Toggle sidebar"
        class="z-50 flex h-10 w-10 items-center justify-center rounded-lg border-gray-200 text-gray-500 xl:h-11 xl:w-11 xl:border dark:border-gray-800 dark:text-gray-400"
      >
        <svg class="fill-current" width="20" height="14" viewBox="0 0 16 12" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M0.583 1A.75.75 0 011.333.25h13.334a.75.75 0 110 1.5H1.333A.75.75 0 01.583 1zm0 10a.75.75 0 01.75-.75h13.334a.75.75 0 110 1.5H1.333a.75.75 0 01-.75-.75zM1.333 5.25a.75.75 0 100 1.5h6.667a.75.75 0 100-1.5H1.333z" fill=""/>
        </svg>
      </button>
      <span class="inline-flex items-center gap-2 rounded-lg px-2.5 py-1 text-xs font-semibold uppercase tracking-wider text-white" style="background: var(--console-accent)">Platform Console</span>
    </div>

    <div class="flex items-center gap-3 text-sm">
      <% if admin_signed_in? %>
        <%# Avatar dropdown — email/tier + sign out live inside the menu %>
        <div class="relative" x-data="{ open: false }">
          <button @click="open = !open" class="flex items-center gap-2 rounded-full p-1 pr-2 hover:bg-gray-50 dark:hover:bg-white/5" aria-label="Account menu">
            <span class="inline-flex h-9 w-9 items-center justify-center rounded-full bg-gray-100 text-xs font-semibold text-gray-600 dark:bg-white/10 dark:text-white/80"><%= current_admin.email.to_s.first&.upcase %></span>
            <svg class="fill-current text-gray-400" :class="open ? 'rotate-180' : ''" width="16" height="16" viewBox="0 0 20 20"><path d="M6 8l4 4 4-4" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>

          <div x-show="open" @click.outside="open = false" x-transition x-cloak
               class="absolute right-0 z-50 mt-2 w-60 rounded-xl border border-gray-200 bg-white p-2 shadow-lg dark:border-gray-800 dark:bg-gray-900">
            <div class="px-3 py-2">
              <p class="truncate text-sm font-medium text-gray-800 dark:text-white/90"><%= current_admin.email %></p>
              <p class="text-xs text-gray-400"><%= current_admin.tier %> tier · Platform operator</p>
            </div>
            <hr class="my-1 border-gray-100 dark:border-gray-800">
            <%= button_to "Sign out", destroy_admin_session_path, method: :delete,
                  class: "block w-full rounded-lg px-3 py-2 text-left text-sm font-medium text-gray-700 hover:bg-gray-50 dark:text-white/80 dark:hover:bg-white/5" %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</header>
