<% items = breadcrumb_items %>
<nav aria-label="Breadcrumb" class="min-w-0 flex-1">
  <ol class="flex min-w-0 items-center gap-1.5 overflow-hidden text-sm">
    <% items.each_with_index do |item, index| %>
      <% last = index == items.length - 1 %>
      <% if index.positive? %>
        <li aria-hidden="true" class="shrink-0 text-gray-300 dark:text-gray-600">/</li>
      <% end %>
      <li class="<%= last ? "min-w-0 truncate font-medium text-gray-900 dark:text-white/90" : "shrink-0" %>">
        <% if item[:path].present? && !last %>
          <%= link_to item[:label], item[:path], class: "text-gray-500 hover:text-gray-800 dark:text-gray-400 dark:hover:text-white/90" %>
        <% else %>
          <span<% if last %> aria-current="page"<% end %>><%= item[:label] %></span>
        <% end %>
      </li>
    <% end %>
  </ol>
</nav>
