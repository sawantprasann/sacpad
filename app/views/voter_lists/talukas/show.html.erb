<% content_for :title, @taluka.display_name %>
<% breadcrumb t("nav.talukas"), voter_lists_talukas_path %>
<% breadcrumb @taluka.display_name %>
<% th = "border-b border-gray-200 px-6 py-3 text-left text-xs font-medium text-gray-500 dark:border-gray-800" %>
<% td = "border-b border-gray-100 px-6 py-4 align-middle text-sm dark:border-gray-800" %>

<%= render layout: "ui/campaign_hero", locals: {
      kicker: t("common.talukas"),
      title: @taluka.display_name,
      subtitle: @taluka.district.display_name,
      meta: current_user.organization.name
    } do %><% end %>

<div class="<%= ta_card_classes %> mt-6 p-6">
  <dl class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    <div>
      <dt class="text-xs font-medium uppercase text-gray-500 dark:text-gray-400"><%= t("common.district") %></dt>
      <dd class="mt-1 text-sm text-gray-800 dark:text-white/90"><%= @taluka.district.display_name %></dd>
    </div>
    <div>
      <dt class="text-xs font-medium uppercase text-gray-500 dark:text-gray-400"><%= t("common.villages") %></dt>
      <dd class="mt-1 text-sm text-gray-800 dark:text-white/90"><%= @village_total %></dd>
    </div>
  </dl>
</div>

<%= form_with url: voter_lists_taluka_path(@taluka), method: :get, class: "mt-6 #{ta_card_classes} p-4 md:p-5" do %>
  <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">
    <% unless current_user.booth_manager? %>
      <div>
        <%= label_tag :village_id, t("common.village"), class: ta_label_classes %>
        <%= render "ui/min_search_select",
              name: :village_id,
              choices: @village_choices.map { |village| [ village.display_name, village.id ] },
              selected: params[:village_id],
              blank: t("common.all_villages"),
              placeholder: t("common.all_villages"),
              search_placeholder: t("kitchen_cabinet.search_villages"),
              empty_text: t("kitchen_cabinet.no_villages") %>
      </div>
    <% end %>
    <div>
      <%= label_tag :police_station, t("common.police_station"), class: ta_label_classes %>
      <%= text_field_tag :police_station, params[:police_station], class: ta_field_classes %>
    </div>
    <div>
      <%= label_tag :pin_code, t("common.pin_code"), class: ta_label_classes %>
      <%= text_field_tag :pin_code, params[:pin_code], class: ta_field_classes %>
    </div>
    <div class="flex items-end gap-2">
      <button type="submit" class="<%= ta_btn_primary %> min-h-11 cursor-pointer" style="background: var(--org-party-color); color: var(--org-party-contrast)"><%= t("common.filter") %></button>
      <%= link_to t("common.clear"), voter_lists_taluka_path(@taluka), class: "#{ta_btn_secondary} inline-flex min-h-11 items-center" %>
    </div>
  </div>
<% end %>

<div class="mt-6 <%= ta_card_classes %> overflow-hidden">
  <div class="border-b border-gray-200 px-6 py-4 dark:border-gray-800">
    <h2 class="text-base font-semibold text-gray-900 dark:text-white/90"><%= t("common.villages") %></h2>
  </div>
  <div class="overflow-x-auto">
    <table class="w-full text-sm">
      <thead class="bg-gray-50 dark:bg-white/[0.03]">
        <tr>
          <th class="<%= th %>"><%= t("common.village") %></th>
          <th class="<%= th %>"><%= t("common.assembly") %></th>
          <th class="<%= th %>"><%= t("common.voters") %></th>
          <th class="<%= th %>"><%= t("common.police_station") %></th>
          <th class="<%= th %>"><%= t("common.pin_code") %></th>
          <th class="<%= th %> w-12"><span class="sr-only"><%= t("common.open") %></span></th>
        </tr>
      </thead>
      <tbody>
        <% @villages.each do |village| %>
          <% village_url = voter_lists_taluka_village_path(@taluka, village) %>
          <%= clickable_row village_url, class: "hover:bg-gray-50 last:[&>td]:border-b-0 dark:hover:bg-white/[0.03]" do %>
            <td class="<%= td %>">
              <%= link_to village.display_name, village_url, class: ta_text_link %>
            </td>
            <td class="<%= td %> text-gray-600 dark:text-gray-300"><%= village.assembly.display_name %></td>
            <td class="<%= td %> tabular-nums text-gray-700 dark:text-gray-300"><%= village.voters_count %></td>
            <td class="<%= td %> text-gray-700 dark:text-gray-300"><%= village.police_station_display_name.presence || "—" %></td>
            <td class="<%= td %> text-gray-700 dark:text-gray-300"><%= village.pin_code.presence || "—" %></td>
            <td class="<%= td %> text-right"><%= icon_action_link :view, village_url %></td>
          <% end %>
        <% end %>
      </tbody>
    </table>
    <% if @villages.empty? %>
      <p class="px-6 py-16 text-center text-sm text-gray-400">
        <%= village_filters.values.any?(&:present?) ? t("voter_lists.no_villages_match") : t("voter_lists.no_villages") %>
      </p>
    <% end %>
  </div>
  <%= render "ui/pagination", pagy: @pagy %>
</div>
