# Village voter export. Rows follow the same filters and booth-then-serial order as the list.
wb = xlsx_package.workbook
wb.add_worksheet(name: "Voters") do |sheet|
  sheet.add_row [ t("common.sr_no"), t("common.voter_id"), t("common.name"), t("common.booth_no"), t("common.village"), t("common.sentiment"), t("common.voted") ]
  @voters.each do |voter|
    sentiment = @sentiments[voter.id]
    turnout = @turnouts[voter.id]
    name = begin
      [ voter.first_name, voter.middle_name, voter.last_name ].compact.join(" ")
    rescue ActiveRecord::Encryption::Errors::Decryption
      ""
    end
    voter_id = begin
      voter.voter_id
    rescue ActiveRecord::Encryption::Errors::Decryption
      ""
    end
    sheet.add_row [
      voter.sr_no,
      voter_id,
      name,
      voter.booth&.number,
      voter.village&.display_name,
      sentiment&.sentiment_status&.humanize,
      turnout&.voted? ? "Voted" : "Not voted"
    ]
  end
end
