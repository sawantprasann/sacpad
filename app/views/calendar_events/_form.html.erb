<dialog
  class="max-h-[calc(100dvh-2rem)] w-[calc(100%-2rem)] max-w-xl overflow-y-auto rounded-2xl border border-gray-200 bg-white p-0 text-gray-800 shadow-theme-xl backdrop:bg-gray-900/60 dark:border-gray-800 dark:bg-gray-900 dark:text-white/90"
  data-calendar-target="dialog"
  data-action="click->calendar#backdrop"
  aria-labelledby="calendar-event-heading"
>
  <div class="p-5 sm:p-7">
    <div class="flex items-start justify-between gap-4">
      <div>
        <h2 id="calendar-event-heading" class="text-lg font-semibold text-gray-900 dark:text-white/90" data-calendar-target="heading">
          <%= @event.persisted? ? t("calendar.edit_event") : t("calendar.add_event") %>
        </h2>
        <p class="mt-1 text-sm text-gray-500 dark:text-gray-400"><%= t("calendar.modal_hint") %></p>
      </div>
      <button type="button" class="inline-flex h-9 w-9 items-center justify-center rounded-lg text-gray-500 hover:bg-gray-100 dark:hover:bg-white/5" data-action="calendar#close" aria-label="<%= t("calendar.cancel") %>">
        <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path d="M6.28 5.22a.75.75 0 00-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 101.06 1.06L10 11.06l3.72 3.72a.75.75 0 101.06-1.06L11.06 10l3.72-3.72a.75.75 0 00-1.06-1.06L10 8.94 6.28 5.22z"/>
        </svg>
      </button>
    </div>

    <%= form_with model: @event, html: { id: "calendar-event-form", class: "mt-5", data: { calendar_target: "form", create_url: calendar_events_path } } do |f| %>
      <%= hidden_field_tag :month, @month.strftime("%Y-%m") %>
      <% if @event.errors.any? %>
        <div class="mb-4 rounded-lg border border-error-500/30 bg-error-50 px-4 py-2 text-sm text-error-600 dark:bg-error-500/10" data-calendar-target="error">
          <%= @event.errors.full_messages.to_sentence %>
        </div>
      <% end %>

      <div>
        <%= f.label :title, t("calendar.event_title"), class: ta_label_classes %>
        <%= f.text_field :title, required: true, maxlength: 140, autocomplete: "off",
              placeholder: t("calendar.title_placeholder"),
              class: ta_field_classes,
              data: { calendar_target: "title" } %>
      </div>

      <fieldset class="mt-4">
        <legend class="<%= ta_label_classes %>"><%= t("calendar.event_color") %></legend>
        <div class="flex flex-wrap gap-2">
          <% calendar_color_choices.each do |color| %>
            <label class="inline-flex cursor-pointer items-center gap-2 rounded-full border border-gray-200 px-3 py-1.5 text-sm font-medium text-gray-700 ring-1 ring-transparent dark:border-gray-700 dark:text-gray-200 <%= calendar_swatch_class(color) %>">
              <%= f.radio_button :color, color, class: "sr-only", checked: @event.color == color, data: { calendar_target: "color" } %>
              <span class="h-2.5 w-2.5 rounded-full <%= calendar_dot_class(color) %>" aria-hidden="true"></span>
              <%= t("calendar.colors.#{color}") %>
            </label>
          <% end %>
        </div>
      </fieldset>

      <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2">
        <div>
          <%= f.label :starts_on, t("calendar.start_date"), class: ta_label_classes %>
          <%= ta_date_picker form: f, method: :starts_on, placeholder: t("calendar.select_date"), input_data: { calendar_target: "startsOn" } %>
        </div>
        <div>
          <%= f.label :starts_time, t("calendar.start_time"), class: ta_label_classes %>
          <%= f.time_field :starts_time, required: true, class: ta_field_classes, data: { calendar_target: "startsTime" } %>
        </div>
        <div>
          <%= f.label :ends_on, t("calendar.end_date"), class: ta_label_classes %>
          <%= ta_date_picker form: f, method: :ends_on, placeholder: t("calendar.select_date"), input_data: { calendar_target: "endsOn" } %>
        </div>
        <div>
          <%= f.label :ends_time, t("calendar.end_time"), class: ta_label_classes %>
          <%= f.time_field :ends_time, required: true, class: ta_field_classes, data: { calendar_target: "endsTime" } %>
        </div>
        <div class="sm:col-span-2">
          <%= f.label :location, t("calendar.location"), class: ta_label_classes %>
          <%= f.text_field :location, maxlength: 160, autocomplete: "off",
                placeholder: t("calendar.location_placeholder"),
                class: ta_field_classes,
                data: { calendar_target: "location" } %>
        </div>
        <div class="sm:col-span-2">
          <%= f.label :notes, t("calendar.notes"), class: ta_label_classes %>
          <%= f.text_area :notes, rows: 3, maxlength: 2000,
                placeholder: t("calendar.notes_placeholder"),
                class: "#{ta_field_classes.sub("h-11 ", "")} min-h-24 py-3",
                data: { calendar_target: "notes" } %>
        </div>
      </div>
    <% end %>

    <%= form_with url: (@event.persisted? ? calendar_event_path(@event) : calendar_events_path), method: :delete,
          html: { id: "calendar-destroy-form", class: "hidden", data: { calendar_target: "destroyForm", turbo_confirm: t("calendar.delete_confirm") } } do %><% end %>

    <div class="mt-6 flex items-center gap-3 border-t border-gray-100 pt-5 dark:border-gray-800">
      <div class="<%= @event.persisted? ? "" : "hidden" %>" data-calendar-target="destroyWrap">
        <button type="submit" form="calendar-destroy-form"
                class="inline-flex min-h-11 items-center text-sm font-medium text-error-600 hover:text-error-700"
                data-calendar-target="destroyButton"
                <%= "disabled" unless @event.persisted? %>>
          <%= t("calendar.delete") %>
        </button>
      </div>
      <div class="ml-auto flex gap-3">
        <button type="button" class="<%= ta_btn_secondary %> min-h-11" data-action="calendar#close"><%= t("calendar.cancel") %></button>
        <button type="submit" form="calendar-event-form"
                class="<%= ta_btn_primary %> min-h-11 cursor-pointer"
                style="background: var(--org-party-color); color: var(--org-party-contrast)"
                data-calendar-target="submit">
          <%= @event.persisted? ? t("calendar.update") : t("calendar.save") %>
        </button>
      </div>
    </div>
  </div>
</dialog>
