<% content_for :title, t("booths.booth_title", number: @booth.number) %>
<% breadcrumb t("nav.booth_management"), booths_path %>
<% breadcrumb "#{t("nav.booth")} #{@booth.number}" %>

<%= render layout: "ui/campaign_hero", locals: {
      kicker: t("booths.title"),
      title: t("booths.booth_title", number: @booth.number),
      subtitle: [ @booth.display_name, @booth.village.display_name ].compact_blank.join(" · "),
      meta: t("booths.voted_meta", voted: @voted_count, total: @voter_count, election: @election.name)
    } do %><% end %>

<div class="mt-4 flex justify-end">
  <%= link_to t("booths.voter_list"), voters_path(booth: @booth.number, village_id: @booth.village_id), class: "#{ta_btn_secondary} inline-flex min-h-11 items-center" %>
</div>

<section class="<%= ta_card_classes %> mt-6 p-6">
  <dl class="grid grid-cols-1 gap-4 sm:grid-cols-2">
    <div>
      <dt class="text-xs font-medium uppercase text-gray-500"><%= t("common.booth_no") %></dt>
      <dd class="mt-1 text-sm text-gray-900 dark:text-white/90"><%= @booth.number %></dd>
    </div>
    <div>
      <dt class="text-xs font-medium uppercase text-gray-500"><%= t("common.name") %></dt>
      <dd class="mt-1 text-sm text-gray-900 dark:text-white/90"><%= @booth.display_name.presence || "—" %></dd>
    </div>
    <div>
      <dt class="text-xs font-medium uppercase text-gray-500"><%= t("common.village") %></dt>
      <dd class="mt-1 text-sm text-gray-900 dark:text-white/90"><%= @booth.village.display_name %></dd>
    </div>
    <div>
      <dt class="text-xs font-medium uppercase text-gray-500"><%= t("booths.station_type") %></dt>
      <dd class="mt-1 text-sm text-gray-900 dark:text-white/90"><%= @booth.station_type.presence || "—" %></dd>
    </div>
    <div class="sm:col-span-2">
      <dt class="text-xs font-medium uppercase text-gray-500"><%= t("common.address") %></dt>
      <dd class="mt-1 text-sm text-gray-900 dark:text-white/90"><%= @booth.address.presence || "—" %></dd>
    </div>
  </dl>
  <p class="mt-6 text-sm text-gray-500"><%= t("booths.marks_belong", election: @election.name) %></p>
</section>

<section class="<%= ta_card_classes %> mt-6 overflow-hidden">
  <div class="px-6 py-4">
    <h2 class="text-sm font-semibold text-gray-900 dark:text-white/90"><%= t("booths.manager") %></h2>
    <p class="mt-0.5 text-xs text-gray-500"><%= t("booths.manager_help") %></p>
  </div>

  <% if @managers.any? %>
    <div class="overflow-x-auto border-t border-gray-100 dark:border-gray-800">
      <table class="w-full text-sm">
        <thead class="bg-gray-50 dark:bg-white/[0.03]">
          <tr>
            <th class="border-b border-gray-200 px-5 py-3 text-left text-xs font-medium text-gray-500"><%= t("common.name") %></th>
            <th class="border-b border-gray-200 px-5 py-3 text-left text-xs font-medium text-gray-500"><%= t("common.email") %></th>
            <th class="border-b border-gray-200 px-5 py-3 text-left text-xs font-medium text-gray-500"><%= t("common.phone") %></th>
            <th class="border-b border-gray-200 px-5 py-3 text-left text-xs font-medium text-gray-500"><%= t("common.status") %></th>
          </tr>
        </thead>
        <tbody>
          <% @managers.each do |manager| %>
            <tr class="last:[&>td]:border-b-0">
              <td class="border-b border-gray-100 px-5 py-3 font-medium text-gray-900 dark:border-gray-800 dark:text-white/90"><%= manager.name %></td>
              <td class="border-b border-gray-100 px-5 py-3 text-gray-700 dark:border-gray-800"><%= manager.email %></td>
              <td class="border-b border-gray-100 px-5 py-3 tabular-nums text-gray-700 dark:border-gray-800"><%= manager.phone.presence || "—" %></td>
              <td class="border-b border-gray-100 px-5 py-3 text-gray-700 dark:border-gray-800"><%= manager.active? ? "—" : t("common.inactive") %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="border-t border-gray-100 px-6 py-8 text-center text-sm text-gray-400 dark:border-gray-800"><%= t("booths.no_manager") %></p>
  <% end %>

  <% if current_user.can_add_booth_manager? %>
    <%= render "ground_reports/villages/add_panel", label: t("booths.add_manager") do %>
      <%= form_with scope: :user, url: booth_managers_path(@booth), class: "space-y-3" do |f| %>
        <div class="grid gap-3 md:grid-cols-2">
          <div>
            <%= f.label :name, t("common.name"), class: ta_label_classes %>
            <%= f.text_field :name, class: ta_field_classes, required: true %>
          </div>
          <div>
            <%= f.label :email, t("common.email"), class: ta_label_classes %>
            <%= f.email_field :email, class: ta_field_classes, required: true %>
          </div>
          <div>
            <%= f.label :phone, t("common.phone"), class: ta_label_classes %>
            <%= f.telephone_field :phone, class: ta_field_classes %>
          </div>
          <div>
            <%= f.label :password, t("team.initial_password"), class: ta_label_classes %>
            <%= f.password_field :password, class: ta_field_classes, required: true, autocomplete: "new-password" %>
          </div>
        </div>
        <button type="submit" class="<%= ta_btn_primary %> min-h-11 cursor-pointer"
                style="background: var(--org-party-color); color: var(--org-party-contrast)"><%= t("booths.add_manager") %></button>
      <% end %>
    <% end %>
  <% end %>
</section>
