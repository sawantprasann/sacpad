<% content_for :title, "Election result" %>
<% breadcrumb "Election result" %>

<% if @constituency_election %>
  <%= render "constituency_elections/dashboard", election: @constituency_election, elections: @constituency_elections %>
<% else %>
  <%= render layout: "ui/campaign_hero", locals: {
        kicker: "Election result",
        title: "Election result",
        subtitle: current_user.organization.constituency&.name,
        meta: current_user.organization.name
      } do %><% end %>
  <div class="mt-8 rounded-2xl border border-dashed border-amber-300 bg-white/80 px-5 py-8 text-center text-sm text-amber-900 dark:border-amber-700/40 dark:bg-gray-900 dark:text-amber-100">
    No election result is stored for this constituency yet.
  </div>
<% end %>
