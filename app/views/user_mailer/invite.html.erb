<%# Navy rail and amber mark match the campaign sidebar. Tables and inline styles survive email clients. %>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#f2f4f7; margin:0; padding:0;">
  <tr>
    <td align="center" style="padding:32px 16px;">
      <table role="presentation" width="560" cellpadding="0" cellspacing="0" border="0" style="width:100%; max-width:560px; background-color:#ffffff; border-radius:16px; overflow:hidden;">
        <tr>
          <td style="background-color:#0b1f44; padding:28px 32px;">
            <table role="presentation" cellpadding="0" cellspacing="0" border="0">
              <tr>
                <td width="36" height="36" align="center" valign="middle" style="width:36px; height:36px; background-color:#f59e0b; border-radius:10px; font-family:Arial, Helvetica, sans-serif; font-size:14px; font-weight:700; color:#0b1f44; line-height:36px;">PM</td>
                <td style="padding-left:12px; font-family:Arial, Helvetica, sans-serif; font-size:18px; font-weight:600; color:#ffffff; line-height:24px;">PolitoMatrix</td>
              </tr>
            </table>
          </td>
        </tr>
        <tr>
          <td style="background-color:#f59e0b; height:4px; font-size:0; line-height:0;">&nbsp;</td>
        </tr>
        <tr>
          <td style="padding:36px 32px 8px; font-family:Arial, Helvetica, sans-serif; color:#101828;">
            <p style="margin:0 0 16px; font-size:22px; line-height:30px; font-weight:600; color:#101828;"><%= t("invite.email_greeting", name: @user.name) %></p>
            <p style="margin:0 0 12px; font-size:15px; line-height:24px; color:#475467;"><span style="font-weight:600; color:#101828;"><%= @user.organization.name %></span> has invited you to PolitoMatrix.</p>
            <p style="margin:0; font-size:15px; line-height:24px; color:#475467;"><%= t("invite.email_next") %></p>
          </td>
        </tr>
        <tr>
          <td align="left" style="padding:24px 32px 8px;">
            <table role="presentation" cellpadding="0" cellspacing="0" border="0">
              <tr>
                <td align="center" bgcolor="#0b1f44" style="background-color:#0b1f44; border-radius:8px;">
                  <a href="<%= @url %>" style="display:inline-block; padding:14px 28px; font-family:Arial, Helvetica, sans-serif; font-size:15px; font-weight:600; color:#ffffff; text-decoration:none;"><%= t("invite.email_link") %></a>
                </td>
              </tr>
            </table>
          </td>
        </tr>
        <tr>
          <td style="padding:16px 32px 32px; font-family:Arial, Helvetica, sans-serif;">
            <p style="margin:0 0 16px; font-size:13px; line-height:20px; color:#667085;"><%= t("invite.email_expiry") %></p>
            <p style="margin:0; font-size:12px; line-height:18px; color:#98a2b3; word-break:break-all;"><%= @url %></p>
          </td>
        </tr>
      </table>
      <p style="margin:20px 0 0; font-family:Arial, Helvetica, sans-serif; font-size:12px; line-height:18px; color:#98a2b3;">PolitoMatrix</p>
    </td>
  </tr>
</table>
