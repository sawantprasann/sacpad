<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "SAC-PAD · Platform Console" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="application-name" content="SAC-PAD Console">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <%# Platform Console: TailAdmin shell, but a constant STEEL operator identity (never party-themed,
      DESIGN.md UX-DR15). --console-accent drives the operator brand mark. %>
  <body class="font-outfit text-sm text-gray-800 dark:text-white/90" style="--console-accent:#1d2939" x-data="{ sidebarToggle: false, darkMode: false }" :class="{ 'dark bg-gray-900': darkMode }">
    <div class="flex h-screen overflow-hidden">
      <%= render "ui/console_sidebar" %>

      <div class="relative flex flex-1 flex-col overflow-x-hidden overflow-y-auto">
        <div x-show="sidebarToggle" @click="sidebarToggle = false" class="fixed inset-0 z-40 bg-gray-900/50 xl:hidden" x-cloak></div>
        <%= render "ui/console_top_bar" %>

        <main>
          <div class="mx-auto max-w-(--breakpoint-2xl) p-4 md:p-6">
            <% if notice %><div class="mb-4"><%= render "ui/alert", tone: "success", message: notice %></div><% end %>
            <% if alert %><div class="mb-4"><%= render "ui/alert", tone: "error", message: alert %></div><% end %>
            <%= yield %>
          </div>
        </main>
      </div>
    </div>
  </body>
</html>
