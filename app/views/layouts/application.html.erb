<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= document_title %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="PolitoMatrix">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= action_cable_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/favicon.ico?v=2" sizes="48x48">
    <link rel="icon" href="/icon.svg?v=2" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2">
    <%= stylesheet_link_tag "flatpickr", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <%# TailAdmin shell. Alpine drives the mobile sidebar. Party accent (UX-DR3)
      resolved per org as a CSS var — accent-only, AA-safe; reserved RAG palette is never overridden. %>
  <body
    class="font-outfit text-sm text-gray-800"
    style="--org-party-color:<%= org_accent_color %>; --org-party-contrast:<%= org_accent_foreground %>"
    x-data="{ sidebarToggle: false }"
  >
    <div class="flex h-screen overflow-hidden">
      <%= render "ui/sidebar" %>

      <div class="relative flex flex-1 flex-col overflow-hidden bg-gray-50 dark:bg-gray-900">
        <%# Mobile overlay when sidebar is open %>
        <div x-show="sidebarToggle" @click="sidebarToggle = false"
             class="fixed inset-0 z-40 bg-gray-900/50 xl:hidden" x-cloak></div>

        <%= render "ui/top_bar" %>

        <main class="flex min-h-0 flex-1 flex-col overflow-hidden">
          <% page = yield %>
          <% if content_for?(:full_bleed) %>
            <% if notice %><div class="px-4 pt-4 md:px-6"><%= render "ui/alert", tone: "success", message: notice %></div><% end %>
            <% if alert %><div class="px-4 pt-4 md:px-6"><%= render "ui/alert", tone: "error", message: alert %></div><% end %>
            <div class="min-h-0 flex-1"><%= page %></div>
          <% else %>
            <div class="min-h-0 flex-1 overflow-y-auto">
              <div class="mx-auto max-w-(--breakpoint-2xl) p-4 md:p-6">
                <% if notice %><div class="mb-4"><%= render "ui/alert", tone: "success", message: notice %></div><% end %>
                <% if alert %><div class="mb-4"><%= render "ui/alert", tone: "error", message: alert %></div><% end %>
                <%= page %>
              </div>
            </div>
          <% end %>
        </main>
        <%= render "ui/copyright_footer" %>
      </div>
    </div>
    <% if user_signed_in? && !controller_path.start_with?("assistant/") && Assistant::Catalog.available?(current_user) %>
      <%= render "ui/assistant_launcher" %>
    <% end %>
    <%= render "ui/confirm_dialog" %>
  </body>
</html>
