<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= document_title %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="SAC-PAD">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <%# TailAdmin shell. Alpine drives sidebarToggle + darkMode (body x-data). Party accent (UX-DR3)
      resolved per org as a CSS var — accent-only, AA-safe; reserved RAG palette is never overridden. %>
  <body
    class="font-outfit text-sm text-gray-800 dark:text-white/90"
    style="--org-party-color:<%= org_accent_color %>; --org-party-contrast:<%= org_accent_foreground %>"
    x-data="{ sidebarToggle: false, darkMode: false }"
    :class="{ 'dark bg-gray-900': darkMode }"
  >
    <div class="flex h-screen overflow-hidden">
      <%= render "ui/sidebar" %>

      <div class="relative flex flex-1 flex-col overflow-x-hidden overflow-y-auto bg-gray-50 dark:bg-gray-900">
        <%# Mobile overlay when sidebar is open %>
        <div x-show="sidebarToggle" @click="sidebarToggle = false"
             class="fixed inset-0 z-40 bg-gray-900/50 xl:hidden" x-cloak></div>

        <%= render "ui/top_bar" %>

        <main>
          <div class="mx-auto max-w-(--breakpoint-2xl) p-4 md:p-6">
            <% if notice %><div class="mb-4"><%= render "ui/alert", tone: "success", message: notice %></div><% end %>
            <% if alert %><div class="mb-4"><%= render "ui/alert", tone: "error", message: alert %></div><% end %>
            <%= yield %>
          </div>
        </main>
      </div>
    </div>
  </body>
</html>
