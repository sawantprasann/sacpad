<% content_for :title, t("social.posts") %>
<% can_publish = policy(SocialMedia::SocialPage).publish? %>
<% th = "whitespace-nowrap px-5 py-3 text-left text-xs font-medium text-gray-500" %>
<% td = "border-t border-gray-100 px-5 py-4 align-middle dark:border-white/10" %>
<% quiet = "inline-flex h-8 items-center justify-center rounded-lg border bg-white px-3 text-xs font-medium dark:bg-white/5" %>
<% action = "#{quiet} border-gray-200 text-gray-700 hover:bg-gray-50 dark:border-gray-700 dark:text-gray-200" %>

<%= render layout: "ui/campaign_hero", locals: {
      kicker: t("social.kicker"),
      title: t("social.posts"),
      subtitle: [ t("social.posts_count", count: @pagy.count), t("social.posts_one_place") ].join(" · "),
      meta: current_user.organization.name
    } do %><% end %>

<section class="mt-6 overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-gray-200 dark:bg-gray-900 dark:ring-white/10">
  <div class="flex items-center justify-between gap-3 px-5 py-4">
    <h2 class="text-base font-semibold text-gray-900 dark:text-white/90"><%= t("social.posts_count", count: @pagy.count) %></h2>
    <div class="flex items-center gap-2">
      <%= link_to t("social.connected"), social_connections_path, class: "#{ta_btn_secondary} min-h-11" %>
      <% if can_publish %>
        <%= link_to new_social_connection_path,
              class: "inline-flex h-11 w-11 items-center justify-center rounded-full text-white shadow-sm transition hover:opacity-90",
              style: "background: #2563eb;",
              aria: { label: t("social.composer_new") } do %>
          <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path d="M10 4a1 1 0 011 1v4h4a1 1 0 110 2h-4v4a1 1 0 11-2 0v-4H5a1 1 0 110-2h4V5a1 1 0 011-1z"/>
          </svg>
        <% end %>
      <% end %>
    </div>
  </div>

  <% if @posts.empty? %>
    <div class="border-t border-gray-100 px-6 py-14 text-center dark:border-white/10">
      <p class="text-base font-semibold text-gray-900 dark:text-white"><%= t("social.no_sent_posts_title") %></p>
      <p class="mx-auto mt-2 max-w-md text-sm leading-6 text-gray-500"><%= t("social.no_sent_posts_body") %></p>
    </div>
  <% else %>
    <div class="overflow-x-auto">
      <table class="w-full min-w-[760px] border-collapse text-sm">
        <thead>
          <tr class="border-t border-gray-100 bg-gray-50 dark:border-white/10 dark:bg-white/[0.03]">
            <th class="<%= th %>"><%= t("social.posts") %></th>
            <th class="<%= th %>"><%= t("social.sent_to") %></th>
            <th class="<%= th %>"><%= t("common.status") %></th>
            <% if can_publish %>
              <th class="<%= th %>"><span class="sr-only"><%= t("common.actions") %></span></th>
            <% end %>
          </tr>
        </thead>
        <tbody>
          <% @posts.each do |post| %>
            <% names = post.targets.map { |target| target.social_page.name.presence || t("social.unnamed") } %>
            <% when_at = post.targets.filter_map { |target| target.published_at || target.created_at }.max %>
            <tr class="hover:bg-gray-50 dark:hover:bg-white/[0.03]">
              <td class="<%= td %> max-w-md">
                <p class="font-medium text-gray-900 dark:text-white" style="display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;"><%= post.body.presence || post.title.presence || t("social.unnamed") %></p>
                <p class="mt-1 text-xs text-gray-500"><%= l_stamp(when_at || post.created_at) %></p>
                <% opens = post.targets.select { |target| target.status_published? && target.permalink.to_s.start_with?("https://") && target.social_page.provider.in?(%w[facebook instagram]) } %>
                <% unless opens.empty? %>
                  <div class="mt-2 flex flex-wrap items-center gap-1.5">
                    <% opens.group_by { |target| target.social_page.provider }.values_at("facebook", "instagram").compact.each do |group| %>
                      <% group = group.sort_by { |target| target.published_at || target.created_at }.reverse %>
                      <% visible = group.size > 3 ? group.first(1) : group %>
                      <% visible.each do |target| %>
                        <% label = "#{t("social.networks.#{target.social_page.provider}")} · #{target.social_page.name.presence || t("social.unnamed")}" %>
                        <%= link_to target.permalink, target: "_blank", rel: "noopener", class: "inline-flex rounded-xl", title: label, aria: { label: label } do %>
                          <%= render "social_connections/mark", provider: target.social_page.provider, size: "h-7 w-7 text-xs" %>
                        <% end %>
                      <% end %>
                      <% if group.size > 3 %>
                        <span class="text-xs font-medium text-gray-500"><%= t("social.sent_to_count", count: group.size) %></span>
                      <% end %>
                    <% end %>
                  </div>
                <% end %>
              </td>
              <td class="<%= td %> text-gray-700 dark:text-gray-300">
                <% if names.size > 3 %>
                  <span title="<%= names.join(", ") %>"><%= t("social.sent_to_count", count: names.size) %></span>
                <% else %>
                  <%= names.join(", ") %>
                <% end %>
              </td>
              <td class="<%= td %> text-gray-700 dark:text-gray-300"><%= t("social.publish_status.#{post.status}") %></td>
              <% if can_publish %>
                <td class="<%= td %>">
                  <div class="flex items-center justify-end gap-2">
                    <%= link_to t("social.edit_post"), edit_social_post_path(post), class: action %>
                    <%= button_to t("social.delete_post"), social_post_path(post), method: :delete,
                          form: { data: { turbo_confirm: t("social.delete_post_confirm") }, style: "display:inline-flex" },
                          class: "#{quiet} cursor-pointer border-red-200 text-red-700 hover:bg-red-50 dark:border-red-500/40 dark:text-red-300" %>
                  </div>
                </td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <%= render "ui/pagination", pagy: @pagy %>
  <% end %>
</section>
