<% content_for :title, "Sign In · SAC-PAD" %>
<% console = resource_name.to_s == "admin" %>
<div class="flex min-h-screen w-full">
  <div class="flex w-full flex-1 flex-col justify-center bg-gray-50 px-6 py-12 lg:w-1/2 dark:bg-gray-900">
    <div class="mx-auto w-full max-w-md">
      <div class="mb-8 flex items-center gap-3">
        <span class="inline-flex h-11 w-11 items-center justify-center rounded-2xl text-sm font-bold" style="background: #f59e0b; color: #0b1f44;">SP</span>
        <div>
          <p class="text-sm font-semibold" style="color: #0b1f44;">SAC-PAD</p>
          <p class="text-xs font-semibold uppercase tracking-[0.16em] text-amber-800 dark:text-amber-200"><%= console ? "Platform Console" : "Campaign desk" %></p>
        </div>
      </div>

      <div class="mb-5 sm:mb-8">
        <h1 class="text-title-sm sm:text-title-md mb-2 font-semibold text-gray-900 dark:text-white/90">Sign In</h1>
        <p class="text-sm text-gray-500 dark:text-gray-400">
          <%= console ? "Enter your console email and password." : "Enter your email and password to sign in." %>
        </p>
      </div>

      <% if flash[:alert] %>
        <div class="mb-4 rounded-lg border border-error-500/30 bg-error-50 px-4 py-2 text-sm text-error-500"><%= flash[:alert] %></div>
      <% end %>
      <% if flash[:notice] %>
        <div class="mb-4 rounded-lg border border-success-500/30 bg-success-50 px-4 py-2 text-sm text-success-600"><%= flash[:notice] %></div>
      <% end %>

      <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
        <div class="space-y-5">
          <div>
            <label class="mb-1.5 block text-sm font-medium text-gray-700 dark:text-gray-400">Email<span class="text-error-500">*</span></label>
            <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "you@example.com",
                  class: "shadow-theme-xs h-11 w-full rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-sm text-gray-800 placeholder:text-gray-400 focus:border-orange-400 focus:ring-3 focus:ring-orange-500/10 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/90" %>
          </div>
          <div>
            <label class="mb-1.5 block text-sm font-medium text-gray-700 dark:text-gray-400">Password<span class="text-error-500">*</span></label>
            <div x-data="{ showPassword: false }" class="relative">
              <%= f.password_field :password, autocomplete: "current-password", placeholder: "Enter your password",
                    "x-bind:type": "showPassword ? 'text' : 'password'",
                    class: "shadow-theme-xs h-11 w-full rounded-lg border border-gray-300 bg-white py-2.5 ps-4 pe-11 text-sm text-gray-800 placeholder:text-gray-400 focus:border-orange-400 focus:ring-3 focus:ring-orange-500/10 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/90" %>
              <span @click="showPassword = !showPassword" class="absolute top-1/2 right-4 z-30 -translate-y-1/2 cursor-pointer text-gray-500 dark:text-gray-400" x-text="showPassword ? 'Hide' : 'Show'" style="font-size:12px"></span>
            </div>
          </div>

          <div class="flex items-center justify-between">
            <% if devise_mapping.rememberable? %>
              <label class="flex cursor-pointer items-center gap-2 text-sm font-normal text-gray-700 select-none dark:text-gray-400">
                <%= f.check_box :remember_me, class: "h-4 w-4 rounded border-gray-300", style: "accent-color: #c2410c;" %>
                Keep me logged in
              </label>
            <% else %>
              <span></span>
            <% end %>
            <% if devise_mapping.recoverable? %>
              <%= link_to "Forgot password?", new_password_path(resource_name), class: "text-sm font-medium", style: "color: #c2410c;" %>
            <% end %>
          </div>

          <div>
            <%= f.submit "Sign In",
                  class: "campaign-btn flex w-full cursor-pointer items-center justify-center rounded-lg px-4 py-3 text-sm font-medium transition" %>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <div
    class="relative hidden min-h-screen w-full overflow-hidden lg:flex lg:w-1/2 lg:items-center"
    style="background:
      radial-gradient(circle at 92% 0%, rgba(255,255,255,0.28), transparent 26%),
      radial-gradient(circle at 0% 100%, rgba(255,214,10,0.35), transparent 34%),
      linear-gradient(125deg, #06eff4 0%, #ea580c 48%, #f59e0b 100%);"
  >
    <svg class="pointer-events-none absolute" style="top: 50%; right: 2.5rem; width: 11rem; height: 11rem; transform: translateY(-50%); color: #000080;" viewBox="0 0 120 120" fill="none" aria-hidden="true">
      <circle cx="60" cy="60" r="52" stroke="currentColor" stroke-width="4"/>
      <circle cx="60" cy="60" r="8" fill="currentColor"/>
      <g stroke="currentColor" stroke-width="2.4">
        <% 24.times do |i| %>
          <line x1="60" y1="11" x2="60" y2="51" transform="rotate(<%= i * 15 %> 60 60)"/>
        <% end %>
      </g>
    </svg>

    <div class="relative px-12" style="padding-right: 15rem;">
      <p class="text-xs font-semibold uppercase tracking-[0.28em] text-white/80"><%= console ? "Platform Console" : "Namaste" %></p>
      <p class="mt-3 text-4xl font-bold tracking-tight text-white">SAC-PAD</p>
      <p class="mt-3 text-base font-medium text-white/95">Special Administration Cadre · Political Acceleration &amp; Development</p>
    </div>

    <div class="absolute right-0 bottom-0 left-0 flex h-2" style="margin-right: 16rem;" aria-hidden="true">
      <span class="flex-1 bg-[#FF9933]"></span>
      <span class="flex-1 bg-white"></span>
      <span class="flex-1 bg-[#138808]"></span>
    </div>
  </div>
</div>
