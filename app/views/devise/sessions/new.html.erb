<% content_for :title, "Sign In · SAC-PAD" %>
<div class="relative z-1 bg-white p-6 sm:p-0 dark:bg-gray-900">
  <div class="relative flex h-screen w-full flex-col justify-center sm:p-0 lg:flex-row dark:bg-gray-900">
    <!-- Form -->
    <div class="flex w-full flex-1 flex-col lg:w-1/2">
      <div class="mx-auto flex w-full max-w-md flex-1 flex-col justify-center">
        <div class="mb-5 sm:mb-8">
          <h1 class="text-title-sm sm:text-title-md mb-2 font-semibold text-gray-800 dark:text-white/90">Sign In</h1>
          <p class="text-sm text-gray-500 dark:text-gray-400">Enter your email and password to sign in.</p>
        </div>

        <% if flash[:alert] %>
          <div class="mb-4 rounded-lg border border-error-500/30 bg-error-50 px-4 py-2 text-sm text-error-500"><%= flash[:alert] %></div>
        <% end %>
        <% if flash[:notice] %>
          <div class="mb-4 rounded-lg border border-success-500/30 bg-success-50 px-4 py-2 text-sm text-success-600"><%= flash[:notice] %></div>
        <% end %>

        <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
          <div class="space-y-5">
            <div>
              <label class="mb-1.5 block text-sm font-medium text-gray-700 dark:text-gray-400">Email<span class="text-error-500">*</span></label>
              <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "you@example.com",
                    class: "shadow-theme-xs focus:border-brand-300 focus:ring-brand-500/10 h-11 w-full rounded-lg border border-gray-300 bg-transparent px-4 py-2.5 text-sm text-gray-800 placeholder:text-gray-400 focus:ring-3 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/90" %>
            </div>
            <div>
              <label class="mb-1.5 block text-sm font-medium text-gray-700 dark:text-gray-400">Password<span class="text-error-500">*</span></label>
              <div x-data="{ showPassword: false }" class="relative">
                <%= f.password_field :password, autocomplete: "current-password", placeholder: "Enter your password",
                      "x-bind:type": "showPassword ? 'text' : 'password'",
                      class: "shadow-theme-xs focus:border-brand-300 focus:ring-brand-500/10 h-11 w-full rounded-lg border border-gray-300 bg-transparent py-2.5 ps-4 pe-11 text-sm text-gray-800 placeholder:text-gray-400 focus:ring-3 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/90" %>
                <span @click="showPassword = !showPassword" class="absolute top-1/2 right-4 z-30 -translate-y-1/2 cursor-pointer text-gray-500 dark:text-gray-400" x-text="showPassword ? 'Hide' : 'Show'" style="font-size:12px"></span>
              </div>
            </div>

            <div class="flex items-center justify-between">
              <% if devise_mapping.rememberable? %>
                <label class="flex cursor-pointer items-center gap-2 text-sm font-normal text-gray-700 select-none dark:text-gray-400">
                  <%= f.check_box :remember_me, class: "h-4 w-4 rounded border-gray-300 text-brand-500 focus:ring-brand-500/20" %>
                  Keep me logged in
                </label>
              <% else %>
                <span></span>
              <% end %>
              <% if devise_mapping.recoverable? %>
                <%= link_to "Forgot password?", new_password_path(resource_name), class: "text-brand-500 hover:text-brand-600 dark:text-brand-400 text-sm" %>
              <% end %>
            </div>

            <div>
              <%= f.submit "Sign In",
                    class: "bg-brand-500 shadow-theme-xs hover:bg-brand-600 flex w-full cursor-pointer items-center justify-center rounded-lg px-4 py-3 text-sm font-medium text-white transition" %>
            </div>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Brand panel -->
    <div class="bg-brand-950 relative hidden h-full w-full items-center lg:grid lg:w-1/2 dark:bg-white/5">
      <div class="absolute inset-0 opacity-20" style="background-image:url('<%= image_path("shape/grid-01.svg") %>'); background-size:cover;"></div>
      <div class="z-1 flex items-center justify-center">
        <div class="flex max-w-xs flex-col items-center">
          <span class="mb-4 inline-flex h-12 w-12 items-center justify-center rounded-xl text-lg font-bold text-white" style="background: var(--color-brand-500)">SP</span>
          <p class="text-center text-xl font-semibold text-white">SAC-PAD</p>
          <p class="mt-2 text-center text-gray-400 dark:text-white/60">Special Administration Cadre · Political Acceleration &amp; Development</p>
        </div>
      </div>
    </div>
  </div>
</div>
