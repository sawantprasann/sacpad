<% content_for :title, "#{t("account.reset_password")} · PolitoMatrix" %>
<div class="flex h-screen w-full overflow-hidden">
  <div class="flex h-full min-h-0 w-full flex-col bg-gray-50 lg:w-1/2 dark:bg-gray-900">
    <div class="flex min-h-0 flex-1 flex-col justify-center overflow-y-auto px-6 py-8">
      <div class="mx-auto w-full max-w-md">
        <div class="mb-8 flex items-center gap-3">
          <span class="inline-flex h-11 w-11 items-center justify-center rounded-2xl text-sm font-bold" style="background: #f59e0b; color: #0b1f44;">PM</span>
          <div>
            <p class="text-sm font-semibold" style="color: #0b1f44;">PolitoMatrix</p>
            <p class="text-xs font-medium leading-snug text-amber-800 dark:text-amber-200"><%= t("account.tagline") %></p>
          </div>
        </div>

        <div class="mb-5 sm:mb-8">
          <div class="mb-4 flex items-center justify-between gap-3">
            <h1 class="text-title-sm sm:text-title-md font-semibold text-gray-900 dark:text-white/90"><%= t("account.reset_title") %></h1>
            <%= render "ui/locale_switcher" %>
          </div>
          <p class="text-sm text-gray-500 dark:text-gray-400"><%= t("account.reset_subtitle") %></p>
        </div>

        <% if resource.errors.any? %>
          <div class="mb-4 rounded-lg border border-error-500/30 bg-error-50 px-4 py-2 text-sm text-error-500"><%= resource.errors.full_messages.to_sentence %></div>
        <% end %>

        <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
          <%= f.hidden_field :reset_password_token %>
          <div class="space-y-5">
            <div>
              <label class="mb-1.5 block text-sm font-medium text-gray-700 dark:text-gray-400"><%= t("account.new_password") %><span class="text-error-500">*</span></label>
              <%= f.password_field :password, autocomplete: "new-password", placeholder: t("account.new_password_placeholder"),
                    class: "shadow-theme-xs h-11 w-full rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-sm text-gray-800 placeholder:text-gray-400 focus:border-orange-400 focus:ring-3 focus:ring-orange-500/10 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/90" %>
            </div>
            <div>
              <label class="mb-1.5 block text-sm font-medium text-gray-700 dark:text-gray-400"><%= t("account.confirm_password") %><span class="text-error-500">*</span></label>
              <%= f.password_field :password_confirmation, autocomplete: "new-password", placeholder: t("account.confirm_placeholder"),
                    class: "shadow-theme-xs h-11 w-full rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-sm text-gray-800 placeholder:text-gray-400 focus:border-orange-400 focus:ring-3 focus:ring-orange-500/10 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/90" %>
            </div>
            <div>
              <%= f.submit t("account.reset_password"),
                    class: "campaign-btn flex w-full cursor-pointer items-center justify-center rounded-lg px-4 py-3 text-sm font-medium transition" %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
    <%= render "ui/copyright_footer" %>
  </div>

  <div
    class="relative hidden h-full min-h-0 w-full overflow-hidden lg:flex lg:w-1/2 lg:items-center"
    style="background:
      radial-gradient(circle at 92% 0%, rgba(255,255,255,0.28), transparent 26%),
      radial-gradient(circle at 0% 100%, rgba(255,214,10,0.35), transparent 34%),
      linear-gradient(125deg, #06eff4 0%, #ea580c 48%, #f59e0b 100%);"
  >
    <svg class="pointer-events-none absolute" style="top: 50%; right: 2.5rem; width: 11rem; height: 11rem; transform: translateY(-50%); color: #000080;" viewBox="0 0 120 120" fill="none" aria-hidden="true">
      <circle cx="60" cy="60" r="52" stroke="currentColor" stroke-width="4"/>
      <circle cx="60" cy="60" r="8" fill="currentColor"/>
      <g stroke="currentColor" stroke-width="2.4">
        <% 24.times do |i| %>
          <line x1="60" y1="11" x2="60" y2="51" transform="rotate(<%= i * 15 %> 60 60)"/>
        <% end %>
      </g>
    </svg>

    <div class="relative px-12" style="padding-right: 15rem;">
      <p class="text-xs font-semibold uppercase tracking-[0.28em] text-white/80"><%= t("dashboard.namaste") %></p>
      <p class="mt-3 text-4xl font-bold tracking-tight text-white">PolitoMatrix</p>
      <p class="mt-3 text-base font-medium text-white/95"><%= t("account.tagline") %></p>
    </div>

    <div class="absolute right-0 bottom-0 left-0 flex h-2" style="margin-right: 16rem;" aria-hidden="true">
      <span class="flex-1 bg-[#FF9933]"></span>
      <span class="flex-1 bg-white"></span>
      <span class="flex-1 bg-[#138808]"></span>
    </div>
  </div>
</div>
