<% content_for :title, t("privacy.title") %>

<div class="min-h-screen bg-gray-50 px-6 py-10 dark:bg-gray-900">
  <article class="<%= ta_card_classes %> mx-auto max-w-3xl p-8 sm:p-10">
    <%= image_tag "logo/politomatrix.png", alt: "PolitoMatrix", class: "h-16 w-auto" %>

    <%= link_to new_user_session_path, class: "#{ta_text_link} mt-6 inline-flex text-sm" do %>
      <%= t("privacy.back_to_sign_in") %>
    <% end %>

    <h1 class="mt-6 text-2xl font-semibold text-gray-900 dark:text-white/90"><%= t("privacy.title") %></h1>
    <p class="mt-2 text-xs font-medium text-gray-500"><%= t("privacy.updated") %></p>
    <p class="mt-4 text-sm leading-6 text-gray-600 dark:text-gray-300"><%= t("privacy.intro") %></p>

    <h2 class="mt-8 text-base font-semibold text-gray-900 dark:text-white/90"><%= t("privacy.accounts_heading") %></h2>
    <p class="mt-2 text-sm leading-6 text-gray-600 dark:text-gray-300"><%= t("privacy.accounts_body") %></p>

    <h2 class="mt-8 text-base font-semibold text-gray-900 dark:text-white/90"><%= t("privacy.google_heading") %></h2>
    <p class="mt-2 text-sm leading-6 text-gray-600 dark:text-gray-300"><%= t("privacy.google_body") %></p>
    <p class="mt-3 text-sm leading-6 text-gray-600 dark:text-gray-300">
      <%= t("privacy.limited_use") %>
      <%= link_to t("privacy.google_api_policy"), "https://developers.google.com/terms/api-services-user-data-policy", class: ta_text_link, target: "_blank", rel: "noopener" %>.
    </p>

    <h2 class="mt-8 text-base font-semibold text-gray-900 dark:text-white/90"><%= t("privacy.other_heading") %></h2>
    <p class="mt-2 text-sm leading-6 text-gray-600 dark:text-gray-300"><%= t("privacy.other_body") %></p>

    <h2 class="mt-8 text-base font-semibold text-gray-900 dark:text-white/90"><%= t("privacy.youtube_heading") %></h2>
    <p class="mt-2 text-sm leading-6 text-gray-600 dark:text-gray-300"><%= t("privacy.youtube_body") %></p>
    <p class="mt-3 flex flex-col gap-1 text-sm">
      <%= link_to t("privacy.youtube_terms"), "https://www.youtube.com/t/terms", class: ta_text_link, target: "_blank", rel: "noopener" %>
      <%= link_to t("privacy.google_privacy"), "https://policies.google.com/privacy", class: ta_text_link, target: "_blank", rel: "noopener" %>
    </p>

    <h2 class="mt-8 text-base font-semibold text-gray-900 dark:text-white/90"><%= t("privacy.disconnect_heading") %></h2>
    <p class="mt-2 text-sm leading-6 text-gray-600 dark:text-gray-300"><%= t("privacy.disconnect_body") %></p>

    <h2 class="mt-8 text-base font-semibold text-gray-900 dark:text-white/90"><%= t("privacy.contact_heading") %></h2>
    <p class="mt-2 text-sm leading-6 text-gray-600 dark:text-gray-300">
      <%= t("privacy.contact_body") %>
      <%= mail_to t("privacy.contact_email"), t("privacy.contact_email"), class: ta_text_link %>
    </p>
  </article>
</div>
