<% content_for :title, t("team.new_user") %>
<%= render layout: "ui/campaign_hero", locals: {
      kicker: t("team.kicker"),
      title: t("team.new_user"),
      subtitle: t("team.subtitle")
    } do %><% end %>

<div class="mt-6 <%= ta_card_classes %> p-6">
  <%= form_with model: @user, url: users_path do |f| %>
    <% if @user.errors.any? %>
      <div class="mb-4 rounded-lg border border-error-500/30 bg-error-50 px-4 py-2 text-sm text-error-500"><%= @user.errors.full_messages.to_sentence %></div>
    <% end %>
    <div class="grid gap-4 sm:grid-cols-2">
      <div><label class="<%= ta_label_classes %>"><%= t("common.name") %></label><%= f.text_field :name, class: ta_field_classes %></div>
      <div><label class="<%= ta_label_classes %>"><%= t("common.email") %></label><%= f.email_field :email, class: ta_field_classes %></div>
      <div><label class="<%= ta_label_classes %>"><%= t("common.phone") %></label><%= f.text_field :phone, class: ta_field_classes %></div>
      <div><label class="<%= ta_label_classes %>"><%= t("common.role") %></label><%= f.collection_select :role_id, Role.where.not(slug: "booth_manager").order(:name), :id, :name, {}, class: ta_field_classes %></div>
      <div><label class="<%= ta_label_classes %>"><%= t("team.initial_password") %></label><%= f.password_field :password, class: ta_field_classes %></div>
    </div>
    <div class="mt-6">
      <%= f.submit t("team.create_user"), class: "inline-flex items-center justify-center rounded-lg px-4 py-2.5 text-sm font-medium text-white", style: "background: var(--org-party-color)" %>
    </div>
  <% end %>
</div>
