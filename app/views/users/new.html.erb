<% content_for :title, "New user" %>
<div class="mx-auto max-w-3xl">
  <h1 class="text-xl font-semibold text-gray-900">New user</h1>
  <%= form_with model: @user, url: users_path do |f| %>
    <% if @user.errors.any? %>
      <div class="mb-3 text-sm text-rose-700"><%= @user.errors.full_messages.to_sentence %></div>
    <% end %>
    <div class="mb-3"><label class="block text-sm text-gray-600">Name</label><%= f.text_field :name, class: "rounded border px-2 py-1" %></div>
    <div class="mb-3"><label class="block text-sm text-gray-600">Email</label><%= f.email_field :email, class: "rounded border px-2 py-1" %></div>
    <div class="mb-3"><label class="block text-sm text-gray-600">Phone</label><%= f.text_field :phone, class: "rounded border px-2 py-1" %></div>
    <div class="mb-3"><label class="block text-sm text-gray-600">Role</label><%= f.collection_select :role_id, Role.order(:name), :id, :name, {}, class: "rounded border px-2 py-1" %></div>
    <div class="mb-3"><label class="block text-sm text-gray-600">Initial password</label><%= f.password_field :password, class: "rounded border px-2 py-1" %></div>
    <%= f.submit "Create user", class: "rounded bg-gray-900 px-3 py-1 text-sm text-white" %>
  <% end %>
</div>
