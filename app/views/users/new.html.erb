<% content_for :title, "New user" %>
<%= render layout: "ui/campaign_hero", locals: {
      kicker: "Team",
      title: "New user",
      subtitle: "Add someone who can sign in to this organization."
    } do %><% end %>

<div class="mt-6 <%= ta_card_classes %> p-6">
  <%= form_with model: @user, url: users_path do |f| %>
    <% if @user.errors.any? %>
      <div class="mb-4 rounded-lg border border-error-500/30 bg-error-50 px-4 py-2 text-sm text-error-500"><%= @user.errors.full_messages.to_sentence %></div>
    <% end %>
    <div class="grid gap-4 sm:grid-cols-2">
      <div><label class="<%= ta_label_classes %>">Name</label><%= f.text_field :name, class: ta_field_classes %></div>
      <div><label class="<%= ta_label_classes %>">Email</label><%= f.email_field :email, class: ta_field_classes %></div>
      <div><label class="<%= ta_label_classes %>">Phone</label><%= f.text_field :phone, class: ta_field_classes %></div>
      <div><label class="<%= ta_label_classes %>">Role</label><%= f.collection_select :role_id, Role.order(:name), :id, :name, {}, class: ta_field_classes %></div>
      <div><label class="<%= ta_label_classes %>">Initial password</label><%= f.password_field :password, class: ta_field_classes %></div>
    </div>
    <div class="mt-6">
      <%= f.submit "Create user", class: "inline-flex items-center justify-center rounded-lg px-4 py-2.5 text-sm font-medium text-white", style: "background: var(--org-party-color)" %>
    </div>
  <% end %>
</div>
