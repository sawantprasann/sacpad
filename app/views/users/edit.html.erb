<% content_for :title, t("team.edit_user") %>
<%= render layout: "ui/campaign_hero", locals: {
      kicker: t("team.kicker"),
      title: t("team.edit_user"),
      subtitle: t("team.edit_subtitle")
    } do %><% end %>

<div class="mt-6 <%= ta_card_classes %> p-6">
  <%= form_with model: @user do |f| %>
    <% if @user.errors.any? %>
      <div class="mb-4 rounded-lg border border-error-500/30 bg-error-50 px-4 py-2 text-sm text-error-500"><%= @user.errors.full_messages.to_sentence %></div>
    <% end %>
    <div class="grid gap-4 sm:grid-cols-2">
      <div><label class="<%= ta_label_classes %>"><%= t("common.name") %></label><%= f.text_field :name, class: ta_field_classes %></div>
      <div><label class="<%= ta_label_classes %>"><%= t("common.email") %></label><%= f.email_field :email, class: ta_field_classes %></div>
      <div><label class="<%= ta_label_classes %>"><%= t("common.phone") %></label><%= f.text_field :phone, class: ta_field_classes %></div>
      <div><label class="<%= ta_label_classes %>"><%= t("common.role") %></label><%= f.collection_select :role_id, @roles, :id, :name, {}, class: ta_field_classes %></div>
    </div>
    <div class="mt-6 flex items-center gap-3">
      <%= f.button t("common.save_changes"), class: "inline-flex cursor-pointer items-center justify-center rounded-lg px-4 py-2.5 text-sm font-medium text-white", style: "background: var(--org-party-color)" %>
      <%= link_to t("common.cancel"), users_path, class: ta_btn_secondary %>
    </div>
  <% end %>
</div>
