<% content_for :title, t("nav.team") %>
<%= render layout: "ui/campaign_hero", locals: {
      kicker: t("team.kicker"),
      title: t("nav.team"),
      subtitle: t("team.count", count: @users.size),
      meta: current_user.organization.name
    } do %><% end %>
<% if policy(User).create? %>
  <div class="mt-4 flex justify-end">
    <%= link_to t("team.new_user"), new_user_path, class: "inline-flex items-center justify-center rounded-lg px-4 py-2.5 text-sm font-medium text-white transition", style: "background: #c2410c" %>
  </div>
<% end %>

<div class="<%= policy(User).create? ? "mt-4" : "mt-6" %> <%= ta_card_classes %> overflow-hidden">
  <div class="overflow-x-auto">
    <table class="w-full text-sm">
      <thead class="border-b border-gray-200 text-left text-gray-500 dark:border-gray-800 dark:text-gray-400">
        <tr>
          <th class="px-5 py-3 font-medium"><%= t("common.name") %></th>
          <th class="px-5 py-3 font-medium"><%= t("common.email") %></th>
          <th class="px-5 py-3 font-medium"><%= t("common.role") %></th>
          <th class="px-5 py-3 font-medium"><%= t("common.parent") %></th>
          <th class="px-5 py-3 font-medium"><%= t("common.status") %></th>
          <% if policy(User).create? %>
            <th class="px-5 py-3 font-medium"><%= t("common.actions") %></th>
          <% end %>
        </tr>
      </thead>
      <tbody>
        <% @users.each do |u| %>
          <tr class="border-b border-gray-100 last:border-0 dark:border-gray-800">
            <td class="px-5 py-3 font-medium text-gray-800 dark:text-white/90"><%= u.name %></td>
            <td class="px-5 py-3 text-gray-500"><%= u.email %></td>
            <td class="px-5 py-3"><%= render "ui/badge", label: u.role.name, tone: "brand" %></td>
            <td class="px-5 py-3 text-gray-500"><%= u.parent&.name || "—" %></td>
            <td class="px-5 py-3">
              <% if !u.active? %>
                <%= render "ui/badge", label: t("common.inactive"), tone: "gray" %>
              <% elsif u.pending_invitation? %>
                <%= render "ui/badge", label: t("team.invited"), tone: "amber" %>
              <% else %>
                <%= render "ui/badge", label: t("team.active"), tone: "green" %>
              <% end %>
            </td>
            <% if policy(User).create? %>
              <td class="px-5 py-3">
                <% if policy(u).edit? %>
                  <div class="flex flex-nowrap items-center gap-1.5">
                    <%= render "action", action: :edit, url: edit_user_path(u), label: t("common.edit") %>
                    <% if policy(u).deactivate? %>
                      <%= render "action", action: :deactivate, url: deactivate_user_path(u), label: t("team.deactivate"),
                            method: :patch, confirm: t("team.deactivate_confirm", name: u.name) %>
                    <% elsif policy(u).reactivate? %>
                      <%= render "action", action: :reactivate, url: reactivate_user_path(u), label: t("team.reactivate"),
                            method: :patch %>
                    <% end %>
                    <% if policy(u).resend_invitation? %>
                      <%= render "action", action: :resend, url: resend_invitation_user_path(u), label: t("team.resend_invite"),
                            method: :post %>
                    <% elsif policy(u).send_password_reset? %>
                      <%= render "action", action: :reset, url: send_password_reset_user_path(u), label: t("team.send_reset"),
                            method: :post %>
                    <% end %>
                  </div>
                <% else %>
                  <span class="text-gray-400">—</span>
                <% end %>
              </td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
