<% content_for :title, t("nav.social_outreach") %>
<% can_send = policy(Outreach::Campaign).create? %>
<% channels = [
     { key: "sms", wash: "linear-gradient(135deg, #7ee0c8 0%, #3ec6a8 100%)", count: @campaigns.size, detail: can_send ? t("outreach.send_bulk") : t("social.coming_next") },
     { key: "whatsapp", wash: "linear-gradient(135deg, #86efac 0%, #22c55e 100%)", count: 0, detail: t("social.coming_next") },
     { key: "ivrs", wash: "linear-gradient(135deg, #c4b5fd 0%, #7c6cf0 100%)", count: 0, detail: t("social.coming_next") }
   ] %>

<%= render layout: "ui/campaign_hero", locals: {
      kicker: t("social.kicker"),
      title: t("nav.social_outreach"),
      subtitle: t("outreach.subtitle"),
      meta: current_user.organization.name
    } do %><% end %>

<div class="mt-6 flex flex-wrap items-center justify-between gap-3">
  <h2 class="text-lg font-semibold text-gray-900 dark:text-white/90"><%= t("social.outreach") %></h2>
  <% if can_send %>
    <%= link_to t("outreach.send_bulk"), new_outreach_campaign_path, class: "#{ta_btn_primary} min-h-11", style: "background: #2563eb; color: #fff" %>
  <% end %>
</div>

<section class="mt-4 grid grid-cols-2 gap-4 xl:grid-cols-4">
  <% channels.each do |channel| %>
    <article class="relative min-h-36 overflow-hidden rounded-2xl px-5 py-4 text-white shadow-sm" style="background: <%= channel[:wash] %>">
      <span class="pointer-events-none absolute rounded-full" style="width: 8.5rem; height: 8.5rem; right: -2.4rem; bottom: -2.8rem; background: rgba(255,255,255,0.28);" aria-hidden="true"></span>
      <span class="pointer-events-none absolute rounded-full" style="width: 6.25rem; height: 6.25rem; right: 1.4rem; top: -2.1rem; background: rgba(255,255,255,0.2);" aria-hidden="true"></span>
      <span class="pointer-events-none absolute rounded-full" style="width: 4.25rem; height: 4.25rem; right: 3.1rem; bottom: 0.15rem; background: rgba(255,255,255,0.22);" aria-hidden="true"></span>
      <div class="relative flex items-start justify-between gap-3">
        <p class="text-sm font-medium text-white/95"><%= t("social.channels.#{channel[:key]}") %></p>
        <%= render "social_connections/mark", provider: channel[:key], size: "h-8 w-8 text-sm", on_color: true %>
      </div>
      <p class="relative mt-5 text-3xl font-semibold leading-none tabular-nums"><%= channel[:count] %></p>
      <p class="relative mt-3 text-sm text-white/90"><%= channel[:detail] %> · <%= t("social.live_count", count: channel[:count]) %></p>
    </article>
  <% end %>
</section>

<section class="mt-6 overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-gray-200 dark:bg-gray-900 dark:ring-white/10">
  <div class="px-5 py-4">
    <h2 class="text-base font-semibold text-gray-900 dark:text-white/90"><%= t("outreach.sent_messages") %></h2>
  </div>
  <% if @campaigns.empty? %>
    <div class="border-t border-gray-100 px-6 py-10 text-center dark:border-white/10">
      <p class="text-sm text-gray-500"><%= t("outreach.empty") %></p>
    </div>
  <% else %>
    <ul class="divide-y divide-gray-100 border-t border-gray-100 dark:divide-white/10 dark:border-white/10">
      <% @campaigns.each do |campaign| %>
        <li>
          <%= link_to outreach_campaign_path(campaign), class: "block px-5 py-4 hover:bg-gray-50 dark:hover:bg-white/[0.03]" do %>
            <p class="line-clamp-2 text-sm font-medium text-gray-900 dark:text-white"><%= campaign.body %></p>
            <p class="mt-1 text-xs text-gray-500">
              <%= l_stamp(campaign.created_at) %>
              · <%= t("outreach.received_count", received: campaign.delivered_count, total: campaign.total_count) %>
              · <%= t("outreach.statuses.#{campaign.status}") %>
            </p>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>
</section>
