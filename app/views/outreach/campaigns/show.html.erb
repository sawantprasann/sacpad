<% content_for :title, t("outreach.message") %>

<%= render layout: "ui/campaign_hero", locals: {
      kicker: t("nav.social_outreach"),
      title: t("outreach.received_count", received: @campaign.delivered_count, total: @campaign.total_count),
      subtitle: t("outreach.statuses.#{@campaign.status}"),
      meta: current_user.organization.name
    } do %><% end %>

<div class="mt-4 flex flex-wrap items-center justify-end gap-2">
  <% if policy(@campaign).send_messages? && (@campaign.prepared? || @campaign.failed?) && @campaign.recipients.pending.any? %>
    <% if @sms_ready %>
      <%= button_to t("outreach.send_now"), send_messages_outreach_campaign_path(@campaign), class: "#{ta_btn_primary} cursor-pointer", style: "background: #2563eb; color: #fff" %>
    <% else %>
      <p class="text-sm text-amber-800"><%= t("outreach.not_configured") %></p>
    <% end %>
  <% end %>
  <%= link_to t("common.back_to_list"), outreach_campaigns_path, class: "#{ta_btn_secondary} min-h-11" %>
</div>

<section class="mt-4 grid grid-cols-2 gap-px overflow-hidden rounded-2xl bg-gray-100 shadow-sm ring-1 ring-gray-200 dark:bg-white/10 dark:ring-white/10 lg:grid-cols-4">
  <% [
       [ t("outreach.numbers"), @campaign.total_count ],
       [ t("outreach.sent"), @campaign.sent_count ],
       [ t("outreach.received"), @campaign.delivered_count ],
       [ t("outreach.failed"), @campaign.failed_count ]
     ].each do |label, value| %>
    <article class="bg-white px-5 py-4 dark:bg-gray-900">
      <p class="text-xs font-medium text-gray-500"><%= label %></p>
      <p class="mt-2 text-2xl font-semibold leading-none tabular-nums text-gray-900 dark:text-white"><%= number_with_delimiter(value) %></p>
    </article>
  <% end %>
</section>

<section class="mt-6 overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-gray-200 dark:bg-gray-900 dark:ring-white/10">
  <div class="px-5 py-4">
    <h2 class="text-sm font-semibold text-gray-900 dark:text-white/90"><%= t("outreach.message") %></h2>
    <p class="mt-2 whitespace-pre-wrap text-sm leading-6 text-gray-800 dark:text-gray-200"><%= @campaign.body %></p>
    <% if @campaign.last_error.present? %>
      <p class="mt-3 text-sm text-red-700"><%= @campaign.last_error %></p>
    <% end %>
    <p class="mt-3 break-all text-xs leading-5 text-gray-500"><%= t("outreach.delivery_hook") %> <%= outreach_delivery_url(@campaign.webhook_token) %></p>
  </div>
  <div class="overflow-x-auto border-t border-gray-100 dark:border-white/10">
    <table class="w-full border-collapse text-sm">
      <thead>
        <tr class="bg-gray-50 dark:bg-white/[0.03]">
          <th class="whitespace-nowrap px-5 py-3 text-left text-xs font-medium text-gray-500"><%= t("outreach.number") %></th>
          <th class="whitespace-nowrap px-5 py-3 text-left text-xs font-medium text-gray-500"><%= t("common.status") %></th>
        </tr>
      </thead>
      <tbody>
        <% @recipients.each do |recipient| %>
          <tr>
            <td class="border-t border-gray-100 px-5 py-3 tabular-nums text-gray-800 dark:border-white/10 dark:text-gray-200"><%= recipient.phone %></td>
            <td class="border-t border-gray-100 px-5 py-3 text-gray-700 dark:border-white/10 dark:text-gray-300"><%= t("outreach.recipient_statuses.#{recipient.status}") %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <%= render "ui/pagination", pagy: @pagy %>
</section>
